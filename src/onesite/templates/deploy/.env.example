# Copy this file to .env and replace production values before deployment.
PROJECT_NAME=onesite
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Optional database override
# DATABASE_URI=postgresql+asyncpg://postgres:change-me@db:5432/app

# Optional MQTT overrides
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=admin
# MQTT_PASSWORD=change-me
# MQTT_CLIENT_ID=onesite_backend

# Optional Kafka overrides. Brokers must be a JSON array. Callback indexes
# follow their order in site_config.py/site_config.json.
# KAFKA_BROKERS=["localhost:9092"]
# KAFKA_CALLBACK_0_TOPIC=devices.telemetry
# KAFKA_CALLBACK_0_GROUP_ID=onesite_backend
