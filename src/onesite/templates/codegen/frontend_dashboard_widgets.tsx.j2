import type { ComponentType } from 'react';
{% for widget in widgets %}
import Widget{{ loop.index }} from './custom/features/{{ widget.feature_name }}/{{ widget.component }}';
{% endfor %}

export type GeneratedDashboardWidget = {
  id: string;
  titleKey: string;
  fallbackTitle: string;
  spanClass: string;
  order: number;
  access: string[];
  frame: boolean;
  Component: ComponentType;
};

export const GeneratedDashboardWidgets: GeneratedDashboardWidget[] = [
{% for widget in widgets %}
  {
    id: {{ widget.id | tojson }},
    titleKey: {{ widget.title_key | tojson }},
    fallbackTitle: {{ widget.title.en | tojson }},
    spanClass: {{ widget.span_class | tojson }},
    order: {{ widget.order }},
    access: {{ widget.access | tojson }},
    frame: {{ widget.frame | tojson }},
    Component: Widget{{ loop.index }},
  },
{% endfor %}
];

export function isDashboardWidgetVisible(
  widget: GeneratedDashboardWidget,
  role: string,
): boolean {
  return widget.access.includes(role);
}
