"""Generated policy registry; all role grants are exact, not hierarchical."""
POLICIES = {
{% for model in models if not model.frontend_only %}
    {{ model.module_name | tojson }}: {
        "permissions": {{ model.role_permissions | tojson }},
        "fields": {
{% for field in model.fields if field.name != 'id' %}
            {{ field.name | tojson }}: {{ (field.role_permissions or {}) | tojson }},
{% endfor %}
        },
        "owner_field": {{ ('id' if model.module_name == 'user' else ('user_id' if model.is_notification_table else (model.owner_field or ''))) | tojson }},
    },
{% endfor %}
}
