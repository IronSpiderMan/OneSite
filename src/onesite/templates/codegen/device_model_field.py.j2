"""Field definitions owned by a device model."""

from enum import Enum
from typing import Optional

from onesite.config import OneSiteConfig
from pydantic import model_validator
from sqlalchemy import CheckConstraint, Column, JSON, UniqueConstraint
from sqlmodel import Field, SQLModel, select


class DeviceDataType(str, Enum):
    STR = "str"
    BOOL = "bool"
    FLOAT32 = "float32"
    FLOAT64 = "float64"
    INT8 = "int8"
    INT32 = "int32"
    INT64 = "int64"
    UINT8 = "uint8"
    ENUM = "enum"


NUMERIC_TYPES = {
    DeviceDataType.FLOAT32,
    DeviceDataType.FLOAT64,
    DeviceDataType.INT8,
    DeviceDataType.INT32,
    DeviceDataType.INT64,
    DeviceDataType.UINT8,
}


class DeviceModelField(SQLModel, table=True):
    __tablename__ = "device_model_field"
    __onesite__ = OneSiteConfig(
        icon="ListTree",
        visible=[],
        standalone=False,
        permissions={"user": "r", "admin": "crud", "developer": "crud"},
        translations={
            "zh": {
                "name": "设备模型字段",
                "fields": {
                    "device_model_id": "设备模型",
                    "name": "字段名",
                    "dtype": "数据类型",
                    "unit": "单位",
                    "enum_values": "枚举值",
                    "min_value": "最小值",
                    "max_value": "最大值",
                },
            }
        },
    )
    __table_args__ = (
        UniqueConstraint("device_model_id", "name", name="uq_device_model_field_name"),
        CheckConstraint(
            "min_value IS NULL OR max_value IS NULL OR min_value <= max_value",
            name="ck_device_model_field_range",
        ),
    )

    id: Optional[int] = Field(default=None, primary_key=True)
    device_model_id: int = Field(
        foreign_key="device_model.id",
        index=True,
        sa_column_kwargs={"info": {"site_props": {
            "reverse": {
                "editor": "inline",
                "layout": "table",
                "allow_existing": False,
                "on_remove": "delete",
            },
        }}},
    )
    name: str
    dtype: DeviceDataType
    unit: Optional[str] = None
    enum_values: Optional[list[str]] = Field(
        default=None, sa_column=Column(
            JSON(none_as_null=True),
            info={
                "site_props": {
                    "visible_when": {"dtype": ["enum"]},
                    "required_when": {"dtype": ["enum"]},
                    "clear_when_hidden": True,
                }
            }
        )
    )
    min_value: Optional[float] = Field(default=None, sa_column_kwargs={"info": {"site_props": {
        "visible_when": {"dtype": [item.value for item in NUMERIC_TYPES]},
        "clear_when_hidden": True,
    }}})
    max_value: Optional[float] = Field(default=None, sa_column_kwargs={"info": {"site_props": {
        "visible_when": {"dtype": [item.value for item in NUMERIC_TYPES]},
        "clear_when_hidden": True,
    }}})

    @model_validator(mode="after")
    def validate_definition(self):
        if self.dtype == DeviceDataType.ENUM:
            if not isinstance(self.enum_values, list) or not self.enum_values:
                raise ValueError("enum 类型必须提供非空 enum_values")
        elif self.enum_values is not None:
            raise ValueError("只有 enum 类型可以设置 enum_values")
        if self.dtype not in NUMERIC_TYPES and (
                self.min_value is not None or self.max_value is not None
        ):
            raise ValueError("只有数值类型可以设置 min_value/max_value")
        if (
                self.min_value is not None
                and self.max_value is not None
                and self.min_value > self.max_value
        ):
            raise ValueError("min_value 不能大于 max_value")
        return self

    @staticmethod
    async def _lock_models(session, model_ids) -> None:
        from app.models.device_model import DeviceModel

        statement = (
            select(DeviceModel.id)
            .where(DeviceModel.id.in_(model_ids))
            .order_by(DeviceModel.id)
            .with_for_update()
        )
        if set((await session.exec(statement)).all()) != model_ids:
            raise ValueError("设备模型不存在")

    async def _lock_existing_models(self, session, changes) -> set[int]:
        statement = select(DeviceModelField.device_model_id).where(DeviceModelField.id == self.id)
        current_id = (await session.exec(statement)).one_or_none()
        if current_id is None:
            raise ValueError("设备模型字段不存在")
        model_ids = {current_id, changes.get("device_model_id", current_id)}
        await self._lock_models(session, model_ids)
        # Standalone CRUD may have loaded this row before a concurrent edit committed.
        await session.refresh(self)
        if self.device_model_id != current_id:
            raise ValueError("设备模型字段已被移动，请重试")
        return model_ids

    @staticmethod
    async def _ensure_models_unused(session, model_ids) -> None:
        from app.models.device import Device

        statement = select(Device.id).where(Device.device_model_id.in_(model_ids)).limit(1)
        if (await session.exec(statement)).first() is not None:
            raise ValueError("设备模型已被设备使用，不能移动或删除字段")

    async def on_before_create(self, session) -> None:
        await self._lock_models(session, {self.device_model_id})
        self.validate_definition()

    async def on_after_create(self, session) -> None:
        from app.models.device import Device
        from app.models.device_field import DeviceField

        dtype = DeviceDataType(self.dtype).value
        existing = select(DeviceField.device_id).where(DeviceField.device_model_field_id == self.id)
        statement = (
            select(Device.id)
            .where(Device.device_model_id == self.device_model_id, ~Device.id.in_(existing))
            .order_by(Device.id)
            .with_for_update(read=True, key_share=True)
        )
        session.add_all(
            DeviceField(
                device_id=device_id,
                device_model_field_id=self.id,
                name=self.name,
                dtype=dtype,
                unit=self.unit,
                address=self.name,
            )
            for device_id in (await session.exec(statement)).all()
        )

    async def on_before_update(self, session, changes) -> None:
        model_ids = await self._lock_existing_models(session, changes)
        if len(model_ids) > 1:
            await self._ensure_models_unused(session, model_ids)

    async def on_after_update(self, session, changes) -> None:
        from app.models.device import Device
        from app.models.device_field import DeviceField

        self.validate_definition()
        if not {"name", "dtype", "unit"}.intersection(changes):
            return

        device_ids = select(DeviceField.device_id).where(DeviceField.device_model_field_id == self.id)
        await session.exec(
            select(Device.id).where(Device.id.in_(device_ids))
            .order_by(Device.id).with_for_update(read=True, key_share=True)
        )
        statement = (
            select(DeviceField)
            .where(DeviceField.device_model_field_id == self.id)
            .order_by(DeviceField.device_id)
            .with_for_update()
            .execution_options(populate_existing=True)
        )
        fields = (await session.exec(statement)).all()
        dtype = DeviceDataType(self.dtype).value
        if any(field.dtype != dtype for field in fields):
            await self._validate_stored_values(session, dtype, fields)
        for field in fields:
            # The composite foreign keys cascade a name change to history and latest.
            field.name = self.name
            field.dtype = dtype
            field.unit = self.unit

    async def _validate_stored_values(self, session, dtype, fields) -> None:
        from app.models.device_field import DeviceField, _validate_write_value
        from app.models.device_history import DeviceHistory
        from app.models.device_history_latest import DeviceLatest

        def validate(payload):
            if payload is None:
                return
            if not isinstance(payload, dict) or "value" not in payload:
                raise ValueError("已有值的格式与新数据类型不兼容")
            value = payload["value"]
            if value is None:
                return
            try:
                _validate_write_value(dtype, value)
                if self.dtype == DeviceDataType.ENUM and value not in self.enum_values:
                    raise ValueError("已有值不在新枚举范围内")
            except ValueError as exc:
                raise ValueError(f"已有值与新数据类型不兼容：{exc}") from exc

        for field in fields:
            if field.dtype != dtype:
                validate(field.value)
        for table in (DeviceLatest, DeviceHistory):
            statement = select(table.value).join(
                DeviceField,
                (DeviceField.device_id == table.device_id) & (DeviceField.name == table.metric),
            ).where(
                DeviceField.device_model_field_id == self.id,
                DeviceField.dtype != dtype,
            )
            values = await session.stream_scalars(statement)
            try:
                async for payload in values:
                    validate(payload)
            finally:
                await values.close()

    async def on_before_delete(self, session) -> None:
        model_ids = await self._lock_existing_models(session, {})
        await self._ensure_models_unused(session, model_ids)
