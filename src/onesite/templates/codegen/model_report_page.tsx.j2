{% for field in model.fields %}
{% if 'r' in field.permissions | default('r') %}
    { key: '{{ field.name }}', labelKey: '{{ field.label_key | default("models." ~ model.module_name ~ ".fields." ~ field.name) }}', hiddenForUser: {{ 'true' if field.name == model.owner_field else 'false' }}, permissions: {{ (field.role_permissions or {}) | tojson }}, render: (item, t, timeZone) => <>
