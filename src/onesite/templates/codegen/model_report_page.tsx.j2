type TableSource = { key: string; visible: Record<string, boolean>; permissions: Record<string, string>; fields: TableField[]; Filters: React.FC<ReportTableFilterProps>; buildFilters: (values: Record<string, any>, role: string) => Record<string, any>; load: (page: number, size: number, filters?: Record<string, any>) => Promise<{ items: any[]; total: number; total_pages: number }> };
const tableSources: TableSource[] = [
