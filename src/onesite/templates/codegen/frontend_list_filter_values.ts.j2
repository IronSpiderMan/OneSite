    {% for field in model.fields %}
    {% if field.is_search_field %}
    {% if field.ui_type == 'bool' %}
    if (searchValues['{{ field.name }}'] === 'true') next['{{ field.name }}'] = true;
    if (searchValues['{{ field.name }}'] === 'false') next['{{ field.name }}'] = false;
    {% elif field.ui_type in ['datetime', 'date'] %}
    if (searchValues['{{ field.name }}_from']) next['{{ field.name }}_from'] = `${searchValues['{{ field.name }}_from']}{% if field.ui_type == 'datetime' %}T00:00:00{% endif %}`;
    if (searchValues['{{ field.name }}_to']) next['{{ field.name }}_to'] = `${searchValues['{{ field.name }}_to']}{% if field.ui_type == 'datetime' %}T23:59:59{% endif %}`;
    {% elif field.ui_type == 'time' %}
    if (searchValues['{{ field.name }}']) next['{{ field.name }}'] = searchValues['{{ field.name }}'];
    {% elif field.is_enum %}
    {
      const value = searchValues['{{ field.name }}'];
      const values = Array.isArray(value) ? value : value != null && value !== '' && value !== '__all__' ? [String(value)] : [];
      if (values.length > 0) next['{{ field.name }}'] = values;
    }
    {% elif field.ui_type == 'str' %}
    if (searchValues['{{ field.name }}']) next['{{ field.name }}'] = searchValues['{{ field.name }}'];
    {% endif %}
    {% endif %}
    {% endfor %}
    {% for field in model.fields %}
    {% if field.fk_info and field.is_search_field %}
    if (searchValues['{{ field.name }}']) next['{{ field.name }}'] = {% if field.fk_info.target_id_type == 'str' %}String{% else %}Number{% endif %}(searchValues['{{ field.name }}']);
    {% endif %}
    {% endfor %}
