import React, { useEffect, useMemo, useState } from 'react';
import { useTranslation } from 'react-i18next';
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { ImageUpload } from '../components/ui/image-upload';
import { ImagesUpload } from '../components/ui/images-upload';
import { FileUpload } from '../components/ui/file-upload';
import { VideoStreamInput } from '../components/ui/video-stream-input';
import { VideoStreamPlayer } from '../components/ui/video-stream-player';
import { Switch } from '../components/ui/switch';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../components/ui/select';
import { LocationInput } from '../components/ui/location-input';
import { JsonInput } from '../components/ui/json-input';
import { JsonModelEditor, JsonModelArrayEditor, JsonModelDictEditor, JsonModelDetail, JsonScalarArrayEditor, validateJsonModelValue, validateJsonModelCollectionValue } from '../components/ui/json-model-editor';
import { getMe, updateMe } from '../services/user';
import { toast } from 'sonner';
import { getErrorMessage } from '../utils/request';

type Me = {
  id: number;
{% for field in model.fields %}
  {% if 'r' in field.permissions and field.name != 'hashed_password' and field.name != 'id' %}
  {{ field.name }}{% if not field.required %}?{% endif %}: {% if field.ui_type == 'int' or field.ui_type == 'float' %}number{% elif field.ui_type == 'bool' %}boolean{% elif field.ui_type == 'images' %}string[]{% elif field.is_enum %}string{% elif field.ui_type in ['json', 'location'] %}any{% else %}string{% endif %} | null;
  {% endif %}
{% endfor %}
};

export default function ProfilePage() {
  const { t } = useTranslation();
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [me, setMe] = useState<Me | null>(null);

  // Password change state
  const [oldPassword, setOldPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');

  // Field-level role-based permissions (Layer 2)
  const userRole = (localStorage.getItem('user_role') || 'user') as 'user' | 'admin' | 'developer';
  const fieldRolePerms: Record<string, Record<string, string>> = {
  {% for field in model.fields %}
  {% if field.role_permissions %}
    "{{ field.name }}": {{ field.role_permissions | tojson }},
  {% endif %}
  {% endfor %}
  };
  const hasFieldPerm = (fieldName: string, perm: 'c' | 'r' | 'u') => {
    const fp = fieldRolePerms[fieldName];
    if (!fp) return true;
    return (fp[userRole] || '').includes(perm);
  };

  const displayName = useMemo(() => {
    if (!me) return '';
    return (me.full_name || me.email || '').trim();
  }, [me]);

  useEffect(() => {
    let mounted = true;
    (async () => {
      try {
        setLoading(true);
        const data = await getMe();
        if (!mounted) return;
        setMe(data as any);
      } catch (e) {
        console.error(e);
      } finally {
        if (mounted) setLoading(false);
      }
    })();
    return () => {
      mounted = false;
    };
  }, []);

  const handleSave = async () => {
    if (!me) return;
{% for field in model.fields %}
  {% if 'u' in field.permissions and field.name not in ['password', 'hashed_password'] %}
    if (hasFieldPerm('{{ field.name }}', 'u')) {
    {% if field.required and not field.update_optional %}
    if (me.{{ field.name }} === undefined || me.{{ field.name }} === null || me.{{ field.name }} === '') {
      toast.error(`${t('{{ field.label_key }}')} ${t('common.required', 'is required')}`);
      return;
    }
    {% endif %}
    {% if field.minimum is not none %}
    if (typeof me.{{ field.name }} === 'number' && me.{{ field.name }} < {{ field.minimum }}) {
      toast.error(`${t('{{ field.label_key }}')} >= {{ field.minimum }}`);
      return;
    }
    {% endif %}
    {% if field.maximum is not none %}
    if (typeof me.{{ field.name }} === 'number' && me.{{ field.name }} > {{ field.maximum }}) {
      toast.error(`${t('{{ field.label_key }}')} <= {{ field.maximum }}`);
      return;
    }
    {% endif %}
    {% if field.json_model_schema %}
    {
      const validation = validateJsonModelValue({{ field.json_model_schema | tojson }}, me.{{ field.name }}, me);
      if (validation !== true) { toast.error(validation); return; }
    }
    {% elif field.json_item_schema %}
    {
      const validation = validateJsonModelCollectionValue({{ field.json_item_schema | tojson }}, me.{{ field.name }}, me);
      if (validation !== true) { toast.error(validation); return; }
    }
    {% endif %}
    }
  {% endif %}
{% endfor %}
    try {
      setSaving(true);

      // Collect all updatable fields
      const updateData: Record<string, any> = {};
{% for field in model.fields %}
  {% if 'u' in field.permissions and field.name != 'password' and field.name != 'hashed_password' %}
      if (hasFieldPerm('{{ field.name }}', 'u')) updateData.{{ field.name }} = me.{{ field.name }};
  {% endif %}
{% endfor %}

      // Handle password change
      if (newPassword) {
        if (newPassword !== confirmPassword) {
          toast.error(t('profile.password_mismatch'));
          setSaving(false);
          return;
        }
        updateData.old_password = oldPassword;
        updateData.password = newPassword;
      }

      const updated = await updateMe(updateData);
      setMe(updated as any);
      localStorage.setItem('user_name', (updated as any).full_name || (updated as any).email || '');
      localStorage.setItem('user_avatar', (updated as any).avatar || '');
      window.dispatchEvent(new Event('onesite:user_updated'));

      // Reset password fields on success
      setOldPassword('');
      setNewPassword('');
      setConfirmPassword('');

      toast.success(t('toast.update_success'));
    } catch (e: any) {
      console.error(e);
      toast.error(getErrorMessage(e, t('toast.save_failed')));
    } finally {
      setSaving(false);
    }
  };

  return (
    <div
      className="{{ page_shell_class | default('max-w-3xl space-y-6') }}"
      data-codegen-theme="{{ codegen_theme | default('normal') }}"
      data-page-kind="profile"
    >
      <div className="flex items-center justify-between">
        <div>
          <div className="text-sm text-muted-foreground">{t('common.profile')}</div>
          <div className="text-2xl font-semibold">{displayName}</div>
        </div>
        <Button type="button" onClick={handleSave} disabled={loading || saving || !me}>
          {saving ? t('common.loading') : t('common.save')}
        </Button>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>{t('profile.basic')}</CardTitle>
        </CardHeader>
        <CardContent className="space-y-6">
          {loading ? (
            <div className="text-muted-foreground">{t('common.loading')}</div>
          ) : me ? (
            <>
{% for field in model.fields %}
  {% if 'r' in field.permissions and field.name not in ['hashed_password', 'password', 'id'] %}{hasFieldPerm('{{ field.name }}', 'r') && (
              <div className="space-y-2">
                <Label>{t('{{ field.label_key }}')}{ {{ 'true' if field.required and not field.update_optional else 'false' }} && <span className="text-destructive"> *</span>}</Label>
    {% if 'u' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'u') ? (
      {% if field.ui_type == 'image' %}
                <ImageUpload
                  value={me.{{ field.name }} || ''}
                  onChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                />
      {% elif field.ui_type == 'images' %}
                <ImagesUpload
                  id="{{ field.name }}"
                  value={Array.isArray(me.{{ field.name }}) ? me.{{ field.name }} : []}
                  onChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                />
      {% elif field.ui_type == 'file' %}
                <FileUpload
                  value={me.{{ field.name }} || ''}
                  onChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                />
      {% elif field.ui_type == 'video_stream' %}
                <VideoStreamInput
                  value={me.{{ field.name }} || ''}
                  onChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                  protocol="{{ field.stream_protocol }}"
                />
      {% elif field.ui_type == 'bool' %}
                <div className="flex items-center space-x-2">
                  <Switch
                    checked={!!me.{{ field.name }}}
                    onCheckedChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                    id="{{ field.name }}"
                  />
                  <Label htmlFor="{{ field.name }}" className="font-normal text-muted-foreground">
                    {t('{{ field.label_key }}')}
                  </Label>
                </div>
      {% elif field.is_enum %}
                <Select
                  value={me.{{ field.name }} || ''}
                  onValueChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                >
                  <SelectTrigger>
                    <SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
                  </SelectTrigger>
                  <SelectContent>
      {% for enum_val in field.enum_values %}
                    <SelectItem value="{{ enum_val }}">{
                      t('models.{{ model.module_name }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}')
                    }</SelectItem>
      {% endfor %}
                  </SelectContent>
                </Select>
      {% elif field.ui_type == 'datetime' %}
                <Input
                  type="datetime-local"
                  value={me.{{ field.name }} ? me.{{ field.name }}.slice(0, 16) : ''}
                  onChange={(e) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: e.target.value } : prev))}
                />
      {% elif field.ui_type == 'date' %}
                <Input
                  type="date"
                  value={me.{{ field.name }} || ''}
                  onChange={(e) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: e.target.value } : prev))}
                />
      {% elif field.ui_type == 'int' or field.ui_type == 'float' %}
                <Input
                  type="number"
                  {% if field.minimum is not none %}min={ {{ field.minimum }} }{% endif %}
                  {% if field.maximum is not none %}max={ {{ field.maximum }} }{% endif %}
                  value={me.{{ field.name }} ?? ''}
                  onChange={(e) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: Number(e.target.value) } : prev))}
                />
      {% elif field.ui_type == 'location' %}
                <LocationInput
                  value={me.{{ field.name }}}
                  onChange={(v) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: v } : prev))}
                />
      {% elif field.ui_type == 'json' %}
        {% if field.json_model_schema %}
                <JsonModelEditor
                  schema={ {{ field.json_model_schema | tojson }} }
                  value={me.{{ field.name }}}
                  onChange={(value) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: value } : prev))}
                  rootValue={me}
                />
        {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
                <JsonModelDictEditor
                  itemSchema={ {{ field.json_item_schema | tojson }} }
                  value={me.{{ field.name }}}
                  onChange={(value) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: value } : prev))}
                  rootValue={me}
                  {% if field.json_fixed_keys %}fixedKeys={ {{ field.json_fixed_keys | tojson }} }{% endif %}
                  {% if field.json_lock_keys %}lockKeys{% endif %}
                />
        {% elif field.json_item_kind %}
                <JsonScalarArrayEditor
                  itemKind="{{ field.json_item_kind }}"
                  value={me.{{ field.name }}}
                  onChange={(value) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: value } : prev))}
                />
        {% elif field.json_item_schema %}
                <JsonModelArrayEditor
                  itemSchema={ {{ field.json_item_schema | tojson }} }
                  value={me.{{ field.name }}}
                  onChange={(value) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: value } : prev))}
                  rootValue={me}
                />
        {% else %}
                <JsonInput
                  value={me.{{ field.name }}}
                  onChange={(value) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: value } : prev))}
                  jsonKind="{{ field.json_kind or 'object' }}"
                />
        {% endif %}
      {% else %}
                <Input
                  value={me.{{ field.name }} || ''}
                  onChange={(e) => setMe((prev) => (prev ? { ...prev, {{ field.name }}: e.target.value } : prev))}
        {% if field.name == 'full_name' %}
                  placeholder={t('profile.full_name_placeholder')}
        {% endif %}
                />
      {% endif %}
    ) : (<>
      {# Read-only field display #}
      {% if field.ui_type == 'bool' %}
                <div className="font-medium">
                  {me.{{ field.name }} ? '{{ 'Yes' }}' : '{{ 'No' }}'}
                </div>
      {% elif field.ui_type == 'image' %}
                {me.{{ field.name }} ? (
                  <div className="relative aspect-video w-full max-w-sm overflow-hidden rounded-lg border bg-muted">
                    <img src={me.{{ field.name }}} alt="{{ field.name }}" className="h-full w-full object-cover" />
                  </div>
                ) : (
                  <span className="text-muted-foreground italic">No image</span>
                )}
      {% elif field.ui_type == 'images' %}
                {Array.isArray(me.{{ field.name }}) && me.{{ field.name }}.length ? (
                  <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    {me.{{ field.name }}.map((url: string, index: number) => (
                      <div key={`${url}-${index}`} className="aspect-video overflow-hidden rounded-lg border bg-muted">
                        <img src={url} alt={`{{ field.name }} ${index + 1}`} className="h-full w-full object-cover" />
                      </div>
                    ))}
                  </div>
                ) : <span className="text-muted-foreground italic">No images</span>}
      {% elif field.ui_type == 'video_stream' %}
                {me.{{ field.name }} ? (
                  <VideoStreamPlayer
                    src={me.{{ field.name }}}
                    protocol="{{ field.stream_protocol }}"
                    autoPlay={ {{ "true" if field.stream_autoplay else "false" }} }
                    muted={ {{ "true" if field.stream_muted else "false" }} }
                    controls={ {{ "true" if field.stream_controls else "false" }} }
                    reconnect={ {{ "true" if field.stream_reconnect else "false" }} }
                    className="max-w-3xl"
                  />
                ) : <span className="text-muted-foreground italic">{t('video_stream.empty')}</span>}
      {% elif field.is_enum %}
                <div className="font-medium">{me.{{ field.name }} ? t(`models.{{ model.module_name }}.enums.{{ field.name }}.${me.{{ field.name }}}`, me.{{ field.name }}) : '-'}</div>
      {% elif field.ui_type == 'datetime' %}
                <div className="text-muted-foreground">{me.{{ field.name }} || '-'}</div>
      {% elif field.ui_type == 'location' %}
                <div className="text-muted-foreground">
                  {me.{{ field.name }}?.latitude != null && me.{{ field.name }}?.longitude != null
                    ? `${me.{{ field.name }}.latitude}, ${me.{{ field.name }}.longitude}`
                    : '-'}
                </div>
      {% elif field.ui_type == 'json' %}
        {% if field.json_model_schema %}
                <JsonModelDetail schema={ {{ field.json_model_schema | tojson }} } value={me.{{ field.name }}} rootValue={me} />
        {% else %}
                <pre className="whitespace-pre-wrap break-words rounded-md border bg-muted/40 p-2 text-sm">
                  {me.{{ field.name }} !== undefined && me.{{ field.name }} !== null
                    ? JSON.stringify(me.{{ field.name }}, null, 2)
                    : '-'}
                </pre>
        {% endif %}
      {% else %}
                <Input value={me.{{ field.name }} || ''} disabled />
      {% endif %}
    </>)}{% else %}
      {# Read-only field display #}
      {% if field.ui_type == 'bool' %}
                <div className="font-medium">
                  {me.{{ field.name }} ? '{{ 'Yes' }}' : '{{ 'No' }}'}
                </div>
      {% elif field.ui_type == 'image' %}
                {me.{{ field.name }} ? (
                  <div className="relative aspect-video w-full max-w-sm overflow-hidden rounded-lg border bg-muted">
                    <img src={me.{{ field.name }}} alt="{{ field.name }}" className="h-full w-full object-cover" />
                  </div>
                ) : (
                  <span className="text-muted-foreground italic">No image</span>
                )}
      {% elif field.ui_type == 'images' %}
                {Array.isArray(me.{{ field.name }}) && me.{{ field.name }}.length ? (
                  <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
                    {me.{{ field.name }}.map((url: string, index: number) => (
                      <div key={`${url}-${index}`} className="aspect-video overflow-hidden rounded-lg border bg-muted">
                        <img src={url} alt={`{{ field.name }} ${index + 1}`} className="h-full w-full object-cover" />
                      </div>
                    ))}
                  </div>
                ) : <span className="text-muted-foreground italic">No images</span>}
      {% elif field.ui_type == 'video_stream' %}
                {me.{{ field.name }} ? (
                  <VideoStreamPlayer
                    src={me.{{ field.name }}}
                    protocol="{{ field.stream_protocol }}"
                    autoPlay={ {{ "true" if field.stream_autoplay else "false" }} }
                    muted={ {{ "true" if field.stream_muted else "false" }} }
                    controls={ {{ "true" if field.stream_controls else "false" }} }
                    reconnect={ {{ "true" if field.stream_reconnect else "false" }} }
                    className="max-w-3xl"
                  />
                ) : <span className="text-muted-foreground italic">{t('video_stream.empty')}</span>}
      {% elif field.is_enum %}
                <div className="font-medium">{me.{{ field.name }} ? t(`models.{{ model.module_name }}.enums.{{ field.name }}.${me.{{ field.name }}}`, me.{{ field.name }}) : '-'}</div>
      {% elif field.ui_type == 'datetime' %}
                <div className="text-muted-foreground">{me.{{ field.name }} || '-'}</div>
      {% elif field.ui_type == 'location' %}
                <div className="text-muted-foreground">
                  {me.{{ field.name }}?.latitude != null && me.{{ field.name }}?.longitude != null
                    ? `${me.{{ field.name }}.latitude}, ${me.{{ field.name }}.longitude}`
                    : '-'}
                </div>
      {% elif field.ui_type == 'json' %}
        {% if field.json_model_schema %}
                <JsonModelDetail schema={ {{ field.json_model_schema | tojson }} } value={me.{{ field.name }}} rootValue={me} />
        {% else %}
                <pre className="whitespace-pre-wrap break-words rounded-md border bg-muted/40 p-2 text-sm">
                  {me.{{ field.name }} !== undefined && me.{{ field.name }} !== null
                    ? JSON.stringify(me.{{ field.name }}, null, 2)
                    : '-'}
                </pre>
        {% endif %}
      {% else %}
                <Input value={me.{{ field.name }} || ''} disabled />
      {% endif %}
    {% endif %}
              </div>
  )}{% endif %}
{% endfor %}
            </>
          ) : (
            <div className="text-muted-foreground">{t('toast.save_failed')}</div>
          )}
        </CardContent>
      </Card>

{% set has_password = model.fields | selectattr('name', 'equalto', 'password') | list %}
{% if has_password %}
      <Card>
        <CardHeader>
          <CardTitle>{t('profile.change_password')}</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="space-y-2">
            <Label>{t('profile.old_password')}</Label>
            <Input
              type="password"
              value={oldPassword}
              onChange={(e) => setOldPassword(e.target.value)}
              placeholder={t('profile.old_password')}
            />
          </div>
          <div className="space-y-2">
            <Label>{t('profile.new_password')}</Label>
            <Input
              type="password"
              value={newPassword}
              onChange={(e) => setNewPassword(e.target.value)}
              placeholder={t('profile.new_password')}
            />
          </div>
          <div className="space-y-2">
            <Label>{t('profile.confirm_password')}</Label>
            <Input
              type="password"
              value={confirmPassword}
              onChange={(e) => setConfirmPassword(e.target.value)}
              placeholder={t('profile.confirm_password')}
            />
          </div>
        </CardContent>
      </Card>
{% endif %}
    </div>
  );
}
