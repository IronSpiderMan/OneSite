async def get_dashboard_metrics(
    self,
    session: AsyncSession,
    *,
    role: str,
) -> dict:
    """Return the Dashboard KPI values visible to ``role``."""
    import json
    from datetime import timedelta
    from sqlalchemy import func

    model = {{ model.name }}
    now_local = datetime.now(SYSTEM_TIMEZONE)

    def _period_bounds(period: str):
        today = now_local.replace(hour=0, minute=0, second=0, microsecond=0)
        if period == "today":
            start, end = today, today + timedelta(days=1)
        elif period == "yesterday":
            start, end = today - timedelta(days=1), today
        elif period == "this_week":
            start = (now_local - timedelta(days=now_local.weekday())).replace(
                hour=0, minute=0, second=0, microsecond=0
            )
            end = start + timedelta(days=7)
        elif period == "last_week":
            end = (now_local - timedelta(days=now_local.weekday())).replace(
                hour=0, minute=0, second=0, microsecond=0
            )
            start = end - timedelta(days=7)
        elif period == "this_month":
            start = now_local.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
            if start.month == 12:
                end = start.replace(year=start.year + 1, month=1)
            else:
                end = start.replace(month=start.month + 1)
        elif period == "last_month":
            end = now_local.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
            if end.month == 1:
                start = end.replace(year=end.year - 1, month=12)
            else:
                start = end.replace(month=end.month - 1)
        elif period == "last_7_days":
            start, end = now_local - timedelta(days=7), now_local
        elif period == "last_30_days":
            start, end = now_local - timedelta(days=30), now_local
        else:
            return None, None
        return to_utc(start), to_utc(end)

    def _relative_time_filter(metric: dict) -> tuple[str | None, str | None]:
        for field_name, value in metric.get("where", {}).items():
            if isinstance(value, dict) and "period" in value:
                return field_name, value["period"]
        return None, None

    async def _aggregate(
        metric: dict,
        start: datetime | None,
        end: datetime | None,
        time_field: str | None,
    ):
        aggregation = metric["aggregation"]
        field_name = metric.get("field")
        regular_where = {
            field: value
            for field, value in metric.get("where", {}).items()
            if not isinstance(value, dict)
        }
        {% set ts_lifecycle = model.get('timescaledb_lifecycle', {}) %}
        {% if model.is_timescaledb and ts_lifecycle.get('bucket_interval') %}
        if (
            aggregation == "count"
            and field_name is None
            and not regular_where
            and time_field == "{{ model.timescaledb_time_column }}"
            and start is not None
            and end is not None
        ):
            # Count the two partial edge buckets from raw rows and all complete
            # interior buckets from the continuous aggregate. This remains
            # exact for non-bucket-aligned ranges without scanning the period.
            from sqlalchemy import text
            result = await session.execute(text("""
                WITH bounds AS (
                    SELECT
                        CAST(:start AS TIMESTAMPTZ) AS start_at,
                        CAST(:end AS TIMESTAMPTZ) AS end_at,
                        time_bucket(
                            INTERVAL '{{ ts_lifecycle.bucket_interval }}',
                            CAST(:start AS TIMESTAMPTZ)
                        ) AS start_bucket,
                        time_bucket(
                            INTERVAL '{{ ts_lifecycle.bucket_interval }}',
                            CAST(:end AS TIMESTAMPTZ)
                        ) AS end_bucket
                )
                SELECT
                    COALESCE((
                        SELECT COUNT(*)
                        FROM {{ model.table_name }}, bounds
                        WHERE {{ model.timescaledb_time_column }} >= start_at
                          AND {{ model.timescaledb_time_column }} < LEAST(
                              end_at,
                              start_bucket + INTERVAL '{{ ts_lifecycle.bucket_interval }}'
                          )
                    ), 0)
                    + COALESCE((
                        SELECT SUM(sample_count)
                        FROM {{ model.timescaledb_continuous_aggregate_name }}, bounds
                        WHERE bucket >= start_bucket + INTERVAL '{{ ts_lifecycle.bucket_interval }}'
                          AND bucket < end_bucket
                    ), 0)
                    + COALESCE((
                        SELECT COUNT(*)
                        FROM {{ model.table_name }}, bounds
                        WHERE end_bucket > start_bucket
                          AND {{ model.timescaledb_time_column }} >= GREATEST(start_at, end_bucket)
                          AND {{ model.timescaledb_time_column }} < end_at
                    ), 0)
            """), {"start": start, "end": end})
            return float(result.scalar_one())
        {% endif %}
        value_col = getattr(model, field_name) if field_name else None
        if aggregation == "count":
            expression = func.count()
        elif aggregation == "distinct_count":
            expression = func.count(func.distinct(value_col))
        elif aggregation == "sum":
            expression = func.coalesce(func.sum(value_col), 0)
        elif aggregation == "avg":
            expression = func.avg(value_col)
        elif aggregation == "min":
            expression = func.min(value_col)
        else:
            expression = func.max(value_col)

        stmt = select(expression).select_from(model)
        for field, value in regular_where.items():
            column = getattr(model, field)
            if isinstance(value, list):
                stmt = stmt.where(column.in_(value))
            elif value is None:
                stmt = stmt.where(column.is_(None))
            else:
                stmt = stmt.where(column == value)
        if time_field and start is not None:
            time_col = getattr(model, time_field)
            stmt = stmt.where(time_col >= start)
            if end is not None:
                stmt = stmt.where(time_col < end)
        result = await session.exec(stmt)
        value = result.one()
        return float(value) if value is not None else None

    definitions = json.loads(r'''{{ model.dashboard_metrics | tojson }}''')
    metrics = []
    for metric in definitions:
        if role not in metric.get("permitted_roles", []):
            continue
        if metric.get("items"):
            values = []
            for calculation in metric["items"]:
                time_field, period = _relative_time_filter(calculation)
                start, end = _period_bounds(period) if period else (None, None)
                values.append({
                    "value": await _aggregate(calculation, start, end, time_field),
                    "format": calculation["format"],
                })
            metrics.append({
                "key": metric["key"],
                "i18n_key": metric["i18n_key"],
                "title": metric["title"],
                "value": None,
                "values": values,
                "separator": metric["separator"],
                "previous_value": None,
                "change": None,
                "format": {"type": "number"},
                "icon": metric["icon"],
                "color": metric["color"],
                "link": metric.get("link"),
            })
            continue
        time_field, period = _relative_time_filter(metric)
        start, end = _period_bounds(period) if period else (None, None)
        value = await _aggregate(metric, start, end, time_field)
        previous_value = None
        change = None
        if metric.get("compare") == "previous_period" and start and end:
            span = end - start
            previous_value = await _aggregate(metric, start - span, start, time_field)
            if previous_value:
                change = ((value or 0) - previous_value) / abs(previous_value) * 100
            elif not value:
                change = 0.0
        metrics.append({
            "key": metric["key"],
            "i18n_key": metric["i18n_key"],
            "title": metric["title"],
            "value": value,
            "previous_value": previous_value,
            "change": change,
            "format": metric["format"],
            "icon": metric["icon"],
            "color": metric["color"],
            "link": metric.get("link"),
        })
    return {"metrics": metrics}
