from app.models.user import User

AGENTS = json.loads({{ agents_json | tojson }})
MODELS = json.loads({{ models_json | tojson }})
OPERATIONS = {
    "list": ("get", "/", "r"), "get": ("get", "/{id}", "r"),
    "create": ("post", "/", "c"), "update": ("put", "/{id}", "u"),
    "delete": ("delete", "/{id}", "d"), "bulk_delete": ("post", "/bulk_delete", "d"),
    "import": ("post", "/import", "cu"),
}


def agent_tool(*, args_model: type[BaseModel], roles=None):
    def decorate(fn):
        if not inspect.iscoroutinefunction(fn):
            raise TypeError("Agent tools must be async functions")
        fn.agent_args_model = args_model
        fn.agent_roles = roles or ["user", "admin", "developer"]
        return fn
    return decorate


def load_hooks(config):
    return {point: getattr(importlib.import_module("app.agent_hooks"), handler.split(".")[1])
            for point, handler in config["hooks"].items()}


def dereference(value, document, seen=()):
    if isinstance(value, list):
        return [dereference(item, document, seen) for item in value]
    if not isinstance(value, dict):
        return value
    if "$ref" in value:
        ref = value["$ref"]
        if ref in seen or not ref.startswith("#/"):
            raise ValueError(f"Unsupported recursive/external tool schema: {ref}")
        target = document
        for part in ref[2:].split("/"):
            target = target[part.replace("~1", "/").replace("~0", "~")]
        return dereference({**target, **{k: v for k, v in value.items() if k != "$ref"}},
                           document, (*seen, ref))
    return {key: dereference(item, document, seen) for key, item in value.items()}


class ToolRegistry:
    def __init__(self, app, config, context, authorization, confirm=None, request_input=None):
        self.app, self.config, self.context = app, config, context
        self.authorization = authorization
        self.confirm = confirm
        self.request_input = request_input
        self.tools = {}
        document = app.openapi()
        for model_name, operations in config["model_tools"].items():
            model = MODELS[model_name]
            for operation in operations:
                method, suffix, permission = OPERATIONS[operation]
                path = settings.API_V1_STR + model["path"] + suffix
                endpoint = document["paths"].get(path, {}).get(method)
                if endpoint is None:
                    raise ValueError(f"Agent API unavailable: {method} {path}")
                properties, required, locations = {}, [], {}
                for raw in endpoint.get("parameters", []):
                    param = dereference(raw, document)
                    if param["in"] not in {"path", "query"}:
                        continue
                    name = param["name"]
                    properties[name] = param["schema"]
                    locations[name] = param["in"]
                    if param.get("required"):
                        required.append(name)
                if operation == "import":
                    properties["file_content"] = {"type": "string", "maxLength": 1000000,
                        "description": "UTF-8 text file contents (CSV for the standard importer)."}
                    properties["file_name"] = {"type": "string", "default": "import.csv",
                        "pattern": r"^[^/\\\r\n]+$", "minLength": 1, "maxLength": 255}
                    required.append("file_content")
                elif "requestBody" in endpoint:
                    body = dereference(endpoint["requestBody"], document)
                    properties["body"] = body["content"]["application/json"]["schema"]
                    if body.get("required"):
                        required.append("body")
                schema = {"type": "object", "properties": properties,
                          "required": required, "additionalProperties": False}
                self.tools[f"{model_name}_{operation}"] = {
                    "schema": schema, "model": model, "method": method, "path": path,
                    "operation": operation, "permission": permission, "locations": locations,
                    "description": f"{operation} {model_name}. Uses the current user's API permissions.",
                }
        for name in config["custom_tools"]:
            handler = getattr(importlib.import_module(f"app.agent_tools.{name}"), name)
            args_model = getattr(handler, "agent_args_model", None)
            if args_model is None or not inspect.iscoroutinefunction(handler):
                raise ValueError(f"Custom tool {name} must use @agent_tool and be async")
            schema = dereference(args_model.model_json_schema(), args_model.model_json_schema())
            schema["additionalProperties"] = False
            self.tools[name] = {"schema": schema, "handler": handler,
                                "description": inspect.getdoc(handler) or name}
        self.tools["request_input"] = {
            "input": True,
            "description": "Ask the user to fill a form for missing or uncertain tool arguments. "
                "Use an available tool_name, fields from its body (or root parameters if no body), "
                "and partial arguments containing known values. Returns completed arguments; "
                "arguments must preserve the target tool's parameter structure: for create use "
                '{"body": {"name": "prefill"}}, for update use {"id": 1, "body": {"name": "prefill"}}. '
                "fields contains body field names without a body. prefix. Omit unknown values. "
                "does NOT execute or approve the target tool. Never invent unknown values.",
            "schema": {"type": "object", "properties": {
                "tool_name": {"type": "string"},
                "title": {"type": "string", "minLength": 1, "maxLength": 200},
                "fields": {"type": "array", "items": {"type": "string"},
                           "minItems": 1, "maxItems": 30, "uniqueItems": True},
                "arguments": {"type": "object", "description":
                    "Partial target-tool arguments, including the body wrapper when present. "
                    "Keep path/query parameters such as id at the root. Provide required values "
                    "not requested in fields; requested fields may be omitted or prefilled."},
            }, "required": ["tool_name", "title", "fields", "arguments"], "additionalProperties": False},
        }

    async def user(self):
        async with AsyncSession(db.engine) as session:
            user = await session.get(User, self.context.user.id)
            if not user or not user.is_active:
                raise AgentBlocked("User is inactive or unavailable")
            role = getattr(user.role, "value", user.role)
            if role not in self.config["roles"]:
                raise AgentBlocked("Agent access denied")
            return user, role

    def permitted(self, tool, role):
        if tool.get("input"):
            return self.request_input is not None
        if "handler" in tool:
            return role in tool["handler"].agent_roles
        return all(p in tool["model"]["roles"].get(role, "") for p in tool["permission"])

    def requires_confirmation(self, name):
        if name == "request_input":
            return False
        setting = self.config.get("require_confirmation", False)
        operation = self.tools[name].get("operation")
        if isinstance(setting, bool):
            return setting and operation not in {"list", "get"}
        return name in setting or operation in setting

    def schema(self, tool, role):
        schema = copy.deepcopy(tool["schema"])
        if "model" in tool and tool["operation"] == "list":
            fields = tool["model"]["fields"]
            for name in list(schema["properties"]):
                field = name if name in fields else name.removesuffix("_from").removesuffix("_to")
                if field in fields and "r" not in fields[field].get(role, ""):
                    del schema["properties"][name]
        if "model" in tool and tool["operation"] in {"create", "update"}:
            body = schema["properties"].get("body", {})
            allowed = {name for name, roles in tool["model"]["fields"].items()
                       if tool["permission"] in roles.get(role, "")}
            body["properties"] = {k: v for k, v in body.get("properties", {}).items() if k in allowed}
            body["required"] = [k for k in body.get("required", []) if k in allowed]
            body["additionalProperties"] = False
        return schema

    async def definitions(self):
        _, role = await self.user()
        return [{"type": "function", "function": {
            "name": name, "description": tool["description"], "parameters": self.schema(tool, role),
        }} for name, tool in self.tools.items() if self.permitted(tool, role)]

    async def validate(self, name, arguments):
        _, role = await self.user()
        tool = self.tools.get(name)
        if tool is None or not self.permitted(tool, role):
            raise AgentBlocked("Tool is unavailable or permission denied")
        errors = list(Draft202012Validator(self.schema(tool, role)).iter_errors(arguments))
        if errors:
            # Avoid dumping potentially sensitive input into model-visible error messages.
            raise AgentBlocked("Invalid tool parameters: " + ", ".join(
                ".".join(map(str, error.path)) or "arguments" for error in errors[:5]))
        if tool.get("operation") == "list":
            if not 1 <= arguments.get("size", 20) <= 100 or arguments.get("page", 1) < 1:
                raise AgentBlocked("Use page >= 1 and size between 1 and 100")

    async def call(self, model, operation, arguments):
        """Custom tools use the same whitelist, validation and identity boundary."""
        return await self.execute(f"{model}_{operation}", arguments)

    async def input_form(self, arguments):
        """Only registered, currently permitted schemas can become forms."""
        _, role = await self.user()
        tool = self.tools.get(arguments["tool_name"])
        if tool is None or tool.get("input") or not self.permitted(tool, role):
            raise AgentBlocked("Form target is unavailable or permission denied")
        schema = self.schema(tool, role)
        body = "body" in schema.get("properties", {})
        fields_schema = schema["properties"]["body"] if body else schema
        fields = arguments["fields"]
        if set(fields) - fields_schema.get("properties", {}).keys():
            raise AgentBlocked("Unknown or inaccessible form fields")
        # Missing and uncertain values may be fixed by the form. Other parameters must be valid.
        normalized = copy.deepcopy(arguments["arguments"])
        if body and "body" not in normalized:
            # Only repair unambiguous body fields. Preserve root parameters and reject
            # unknown/inaccessible fields through the normal permission-filtered schema.
            root_names = schema["properties"].keys()
            body_names = fields_schema.get("properties", {}).keys()
            if any(name in root_names and name in body_names for name in normalized):
                raise AgentBlocked("Ambiguous form parameters: put body fields in arguments.body "
                                   "and keep path/query parameters at the root")
            normalized["body"] = {name: normalized.pop(name)
                                  for name in list(normalized) if name in body_names and name not in root_names}
        partial = copy.deepcopy(normalized)
        values = partial.setdefault("body", {}) if body else partial
        if not isinstance(values, dict):
            raise AgentBlocked("Form arguments must be an object")
        for name in fields:
            values.pop(name, None)
        partial_schema = copy.deepcopy(schema)
        editable = partial_schema["properties"]["body"] if body else partial_schema
        editable["required"] = [name for name in editable.get("required", []) if name not in fields]
        errors = list(Draft202012Validator(partial_schema).iter_errors(partial))
        if errors:
            # Report locations and constraint names, never input values or raw validator messages.
            details = []
            for error in errors[:5]:
                path = ".".join(["arguments", *map(str, error.path)])
                if error.validator == "required":
                    missing = [name for name in error.validator_value if name not in error.instance]
                    details.append(path + ": missing required " + ", ".join(missing))
                else:
                    details.append(path + ": violates " + str(error.validator))
            hint = (" Put body fields in arguments.body; keep path/query parameters at the root."
                    if body else " Use the target tool's root parameters.")
            raise AgentBlocked("Invalid known form parameters: " + "; ".join(details) + hint)
        form_schema = {"type": "object", "properties": {
            name: fields_schema["properties"][name] for name in fields
        }, "required": [name for name in fields if name in fields_schema.get("required", [])],
            "additionalProperties": False}
        initial = normalized.get("body", {}) if body else normalized
        return {"kind": "form", "name": arguments["tool_name"], "title": arguments["title"],
                "arguments": normalized, "fields": fields, "schema": form_schema,
                "initial": {name: initial[name] for name in fields if name in initial}, "body": body,
                "ui": {"fields": {name: relation for name, relation in
                    tool.get("model", {}).get("relations", {}).items() if name in fields}}}

    async def input_result(self, form, values):
        # Recheck the target and its fields using today's permissions, not the saved schema alone.
        current = await self.input_form({"tool_name": form["name"], "title": form["title"],
            "arguments": form["arguments"], "fields": form["fields"]})
        errors = list(Draft202012Validator(current["schema"]).iter_errors(values))
        if errors:
            raise AgentBlocked("Invalid form fields: " + ", ".join(
                ".".join(map(str, error.path)) or "required fields" for error in errors[:5]))
        arguments = copy.deepcopy(form["arguments"])
        target = arguments.setdefault("body", {}) if current["body"] else arguments
        for name in form["fields"]:
            target.pop(name, None)
        target.update(values)
        await self.validate(form["name"], arguments)
        return {"tool_name": form["name"], "arguments": arguments}

    async def execute(self, name, arguments):
        arguments = copy.deepcopy(arguments)
        await self.validate(name, arguments)
        if name == "request_input":
            form = await self.input_form(arguments)
            values = await self.request_input(form)
            return await self.input_result(form, values)
        if self.requires_confirmation(name):
            if self.confirm is None:
                raise AgentBlocked("User confirmation is required")
            await self.confirm(name, copy.deepcopy(arguments))
            # Roles can change while waiting. Approval never grants API permissions.
            await self.validate(name, arguments)
        tool = self.tools[name]
        if "handler" in tool:
            try:
                args = tool["handler"].agent_args_model.model_validate(arguments)
            except ValidationError as exc:
                raise AgentBlocked("Invalid custom tool parameters") from exc
            return await tool["handler"](args, self.context)
        path = tool["path"]
        query = {}
        for key, location in tool["locations"].items():
            if key not in arguments:
                continue
            if location == "path":
                value = str(arguments[key])
                if value in {".", ".."} or "/" in value:
                    raise AgentBlocked("Invalid record identifier")
                path = path.replace("{" + key + "}", quote(value, safe=""))
            else:
                query[key] = arguments[key]
        async with httpx.AsyncClient(transport=httpx.ASGITransport(app=self.app),
                                     base_url="http://onesite.internal") as client:
            body = {"json": arguments["body"]} if "body" in arguments else {}
            if tool["operation"] == "import":
                body = {"files": {"file": (arguments.get("file_name", "import.csv"),
                    arguments["file_content"].encode("utf-8"), "text/plain")}}
            response = await client.request(tool["method"], path, params=query,
                **body,
                headers={"Authorization": self.authorization})
        if response.is_error:
            raise AgentBlocked(f"Business API rejected the request (HTTP {response.status_code})")
        result = response.json() if response.content else None
        if tool["operation"] in {"list", "get", "create", "update"}:
            _, role = await self.user()
            allowed = {field for field, roles in tool["model"]["fields"].items()
                       if "r" in roles.get(role, "")}
            def clean(row):
                return {k: v for k, v in row.items() if k in allowed} if isinstance(row, dict) else row
            if tool["operation"] == "list" and isinstance(result, dict):
                result = {k: v for k, v in result.items() if k in {"items", "total", "page", "size", "pages"}}
                result["items"] = [clean(row) for row in result.get("items", [])]
            else:
                result = clean(result)
        return jsonable_encoder(result)
