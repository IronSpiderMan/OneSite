import React, { useEffect, useRef, useState } from 'react';
import { ArrowRight, Loader2, Pencil, Play, Power, PowerOff, RefreshCw } from 'lucide-react';
import { useTranslation } from 'react-i18next';
import { Link } from 'react-router-dom';
import { toast } from 'sonner';

import { TypedToolFields } from '../components/tools/ToolFields';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Modal } from '../components/ui/modal';
import type { ScheduledTaskExecution, Task } from '../services/tasks';
import { useTaskStore } from '../stores/useTaskStore';

const taskExecutionMessageKeys: Record<string, string> = {
    Queued: 'scheduled_tasks.execution_messages.queued',
    Running: 'scheduled_tasks.execution_messages.running',
    Completed: 'scheduled_tasks.execution_messages.completed',
    'Not implemented': 'scheduled_tasks.execution_messages.not_implemented',
};

const formatLocalDateTime = (dateStr: string | null): string => {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        return date.toLocaleString(undefined, {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
        });
    } catch {
        return dateStr;
    }
};

const formatInterval = (seconds: number, t: (key: string, fallback: string) => string): string => {
    if (seconds <= 0) return '';
    const every = t('scheduled_tasks.every', 'Every');
    if (seconds < 60) return `${every} ${seconds}${t('scheduled_tasks.seconds_short', 's')}`;
    if (seconds < 3600) return `${every} ${Math.floor(seconds / 60)}${t('scheduled_tasks.minutes_short', 'm')}`;
    if (seconds < 86400) return `${every} ${Math.floor(seconds / 3600)}${t('scheduled_tasks.hours_short', 'h')}`;
    return `${every} ${Math.floor(seconds / 86400)}${t('scheduled_tasks.days_short', 'd')}`;
};

const parseCronToTimes = (cron: string): string[] => {
    if (!cron || cron === '* * * * *') return [];
    const parts = cron.trim().split(/\s+/);
    if (parts.length < 2) return [];
    const minutePart = parts[0];
    const hourPart = parts[1];
    if (minutePart === '*' || hourPart === '*') return [];
    const hours = hourPart.split(',').filter(h => h !== '*');
    const minutes = minutePart.split(',').filter(m => m !== '*');
    const times: string[] = [];
    for (const h of hours) {
        for (const m of minutes) {
            times.push(`${h.padStart(2, '0')}:${m.padStart(2, '0')}`);
        }
    }
    return times.length > 0 ? times : [];
};

const timesToCron = (times: string[]): string => {
    if (times.length === 0) return '* * * * *';
    const hours = [...new Set(times.map(t => t.split(':')[0]))].sort();
    const minutes = [...new Set(times.map(t => t.split(':')[1]))].sort();
    return `${minutes.join(',')} ${hours.join(',')} * * *`;
};

const formatCron = (cron: string, t: (key: string, fallback: string) => string): string => {
    if (!cron) return '';
    const times = parseCronToTimes(cron);
    if (times.length === 0) return cron;
    const prefix = t('scheduled_tasks.every_day_at', 'Every day at');
    if (times.length === 1) return `${prefix} ${times[0]}`;
    return `${prefix} ${times.join(', ')}`;
};

const ScheduledTasksPage: React.FC = () => {
    const { t } = useTranslation();
    const [runningTasks, setRunningTasks] = useState<Set<string>>(new Set());
    const [initialLoad, setInitialLoad] = useState(true);
    const {
        tasks,
        loading: taskLoading,
        error: taskError,
        fetchTasks,
        runTask,
        enableTask,
        disableTask,
        updateTask,
    } = useTaskStore();

    const [editingTask, setEditingTask] = useState<Task | null>(null);
    const [scheduleMode, setScheduleMode] = useState<'cron' | 'interval'>('cron');
    const [intervalValue, setIntervalValue] = useState(5);
    const [intervalUnit, setIntervalUnit] = useState<'seconds' | 'minutes' | 'hours' | 'days'>('minutes');
    const [taskInputOverrides, setTaskInputOverrides] = useState<Record<string, unknown>>({});
    const [taskEditorError, setTaskEditorError] = useState('');
    const [cronExpression, setCronExpression] = useState('');
    const taskInputContainer = useRef<HTMLDivElement>(null);
    const [cronTimes, setCronTimes] = useState<string[]>([]);

    useEffect(() => {
        let mounted = true;
        void fetchTasks({ clearCache: true }).then(() => {
            if (mounted) setInitialLoad(false);
        });
        const timer = window.setInterval(() => { void fetchTasks(); }, 5000);
        return () => {
            mounted = false;
            window.clearInterval(timer);
        };
    }, [fetchTasks]);

    useEffect(() => {
        const listener = (event: Event) => {
            const execution = (event as CustomEvent<ScheduledTaskExecution>).detail;
            if (execution?.status === 'succeeded' || execution?.status === 'failed') {
                fetchTasks();
            }
        };
        window.addEventListener('onesite:scheduled-task-status', listener);
        return () => window.removeEventListener('onesite:scheduled-task-status', listener);
    }, [fetchTasks]);

    const handleRunTask = async (name: string) => {
        setRunningTasks(prev => new Set(prev).add(name));
        try {
            await runTask(name);
            toast.success(t('scheduled_tasks.task_queued', { name }));
        } catch (error: any) {
            toast.error(t('scheduled_tasks.task_run_error', { name, message: error.message }));
        } finally {
            setRunningTasks(prev => {
                const next = new Set(prev);
                next.delete(name);
                return next;
            });
        }
    };

    const handleEnableTask = async (name: string) => {
        try {
            await enableTask(name);
            toast.success(t('scheduled_tasks.task_enabled', { name }));
        } catch (error: any) {
            toast.error(error.message);
        }
    };

    const handleDisableTask = async (name: string) => {
        try {
            await disableTask(name);
            toast.success(t('scheduled_tasks.task_disabled', { name }));
        } catch (error: any) {
            toast.error(error.message);
        }
    };

    return (
        <div className="mx-auto w-full max-w-[1600px] space-y-6">
            <header className="flex flex-wrap items-center justify-between gap-3">
                <h1 className="text-3xl font-bold tracking-tight">{t('menu.scheduled_tasks', 'Scheduled Tasks')}</h1>
                <div className="flex flex-wrap items-center gap-2">
                    <Button
                        variant="outline"
                        onClick={() => { void fetchTasks(); }}
                        disabled={initialLoad || taskLoading}
                    >
                        <RefreshCw className={`mr-2 h-4 w-4 ${taskLoading ? 'animate-spin' : ''}`} />
                        {t('scheduled_tasks.refresh', 'Refresh')}
                    </Button>
                    <Link to="/task-center" className="inline-flex h-10 shrink-0 items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent/50 hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                        {t('menu.task_center', 'Task Center')}<ArrowRight className="ml-2 h-4 w-4" />
                    </Link>
                </div>
            </header>

            {!initialLoad && taskError && <p role="alert" className="text-sm text-destructive">{taskError}</p>}
            <div aria-busy={initialLoad || taskLoading} className="space-y-3">
                {initialLoad || (taskLoading && tasks.length === 0) ? (
                    <div role="status" className="flex h-32 items-center justify-center rounded-xl border bg-card">
                        <Loader2 className="h-6 w-6 animate-spin text-muted-foreground" />
                        <span className="sr-only">{t('common.loading', 'Loading...')}</span>
                    </div>
                ) : tasks.length === 0 ? (
                    !taskError && <div className="rounded-xl border bg-card py-8 text-center text-muted-foreground">
                        {t('scheduled_tasks.no_tasks', 'No scheduled tasks available')}
                    </div>
                ) : (
                    tasks.map((task) => (
                        <div
                            key={task.name}
                            className="flex flex-col gap-3 rounded-xl border bg-card p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between"
                        >
                            <div className="min-w-0 flex-1 break-words">
                                <div className="flex flex-wrap items-center gap-2">
                                    <span className="font-medium">{t(`scheduled_task_definitions.${task.name}.title`, task.title || task.name)}</span>
                                    <span
                                        className={`px-2 py-0.5 rounded text-xs ${
                                            task.enabled
                                                ? 'bg-green-100 text-green-700'
                                                : 'bg-gray-100 text-gray-500'
                                        }`}
                                    >
                                        {task.enabled
                                            ? t('scheduled_tasks.enabled', 'Enabled')
                                            : t('scheduled_tasks.disabled', 'Disabled')}
                                    </span>
                                </div>
                                <div className="text-sm text-muted-foreground mt-1">
                                    <span>
                                        {task.interval > 0 ? formatInterval(task.interval, t) : formatCron(task.cron, t)}
                                    </span>
                                    {task.description && (
                                        <span className="ml-2">- {task.class_path && task.description === task.source_description ? t(`scheduled_task_definitions.${task.name}.description`, task.description) : task.description}</span>
                                    )}
                                </div>
                                {task.params && Object.keys(task.params).length > 0 && (
                                    <div className="text-xs text-muted-foreground mt-1 font-mono">
                                        {Object.entries(task.params).map(([k, v]) => `${k}: ${String(v.value)}`).join(' | ')}
                                    </div>
                                )}
                                {task.next_run && task.enabled && (
                                    <div className="text-xs text-muted-foreground mt-1">
                                        {t('scheduled_tasks.next_run', 'Next run')}: {formatLocalDateTime(task.next_run)}
                                    </div>
                                )}
                                {task.configuration_error && <p role="alert" className="text-sm text-destructive">{task.configuration_error}</p>}
                                {task.last_execution && (
                                    <div className="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                                        <span>{t('scheduled_tasks.last_execution', 'Last execution')}:</span>
                                        <span className={
                                            task.last_execution.status === 'succeeded' ? 'text-green-600' :
                                            task.last_execution.status === 'failed' ? 'text-red-600' :
                                            'text-blue-600'
                                        }>
                                            {t(`scheduled_tasks.execution_status.${task.last_execution.status}`, task.last_execution.status)}
                                        </span>
                                        {(task.last_execution.status === 'queued' || task.last_execution.status === 'running') && (
                                            <span>{task.last_execution.progress}%</span>
                                        )}
                                        {task.last_execution.message && <span>- {taskExecutionMessageKeys[task.last_execution.message]
                                            ? t(taskExecutionMessageKeys[task.last_execution.message], task.last_execution.message)
                                            : task.last_execution.message}</span>}
                                    </div>
                                )}
                            </div>
                            <div className="flex shrink-0 items-center gap-2">
                                <Button
                                    variant="outline"
                                    size="sm"
                                    onClick={() => handleRunTask(task.name)}
                                    disabled={runningTasks.has(task.name)}
                                    aria-label={t('scheduled_tasks.run_now', 'Run now')}
                                    title={t('scheduled_tasks.run_now', 'Run now')}
                                >
                                    {runningTasks.has(task.name) ? (
                                        <Loader2 className="w-4 h-4 animate-spin" />
                                    ) : (
                                        <Play className="w-4 h-4" />
                                    )}
                                </Button>
                                <Button
                                    variant="outline"
                                    size="sm"
                                    onClick={() => {
                                        setEditingTask(task);
                                        setTaskInputOverrides({ ...task.input_overrides });
                                        setTaskEditorError('');
                                        setCronExpression(task.cron);
                                        if (task.interval > 0) {
                                            setScheduleMode('interval');
                                            if (task.class_path && task.interval % 60 !== 0) {
                                                setIntervalValue(task.interval);
                                                setIntervalUnit('seconds');
                                            } else if (task.interval % 86400 === 0) {
                                                setIntervalValue(task.interval / 86400);
                                                setIntervalUnit('days');
                                            } else if (task.interval % 3600 === 0) {
                                                setIntervalValue(task.interval / 3600);
                                                setIntervalUnit('hours');
                                            } else {
                                                setIntervalValue(Math.max(1, Math.floor(task.interval / 60)));
                                                setIntervalUnit('minutes');
                                            }
                                            setCronTimes([]);
                                        } else {
                                            setScheduleMode('cron');
                                            setCronTimes(parseCronToTimes(task.cron));
                                            setIntervalValue(5);
                                            setIntervalUnit('minutes');
                                        }
                                    }}
                                    aria-label={t('common.edit', 'Edit')}
                                    title={t('common.edit', 'Edit')}
                                >
                                    <Pencil className="w-4 h-4" />
                                </Button>
                                {task.enabled ? (
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => handleDisableTask(task.name)}
                                        aria-label={t('common.disable', 'Disable')}
                                        title={t('common.disable', 'Disable')}
                                    >
                                        <PowerOff className="w-4 h-4" />
                                    </Button>
                                ) : (
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => handleEnableTask(task.name)}
                                        aria-label={t('common.enable', 'Enable')}
                                        title={t('common.enable', 'Enable')}
                                    >
                                        <Power className="w-4 h-4" />
                                    </Button>
                                )}
                            </div>
                        </div>
                    ))
                )}
            </div>

            {editingTask && (
                <Modal
                    isOpen
                    onClose={() => setEditingTask(null)}
                    title={t('scheduled_tasks.edit_task', 'Edit Task')}
                    footer={(
                        <div className="flex flex-wrap justify-end gap-2">
                            <Button variant="outline" onClick={() => setEditingTask(null)}>
                                {t('common.cancel', 'Cancel')}
                            </Button>
                            <Button
                                onClick={async () => {
                                    const controls = taskInputContainer.current?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select');
                                    if (controls && !Array.from(controls).every((control) => control.reportValidity())) return;
                                    setTaskEditorError('');
                                    const descInput = document.getElementById('description') as HTMLInputElement;
                                    const params: Record<string, unknown> = editingTask.class_path ? { ...taskInputOverrides } : {};
                                    for (const [key, param] of Object.entries(editingTask.class_path ? {} : editingTask.params || {})) {
                                        const el = document.getElementById(`param-${key}`) as HTMLInputElement;
                                        if (el) {
                                            if (param.type === 'bool') {
                                                params[key] = el.checked;
                                            } else if (param.type === 'number') {
                                                params[key] = parseFloat(el.value) || 0;
                                            } else if (param.type === 'multi_select') {
                                                params[key] = el.value.split(',').map(s => s.trim()).filter(Boolean);
                                            } else {
                                                params[key] = el.value;
                                            }
                                        }
                                    }
                                    let interval = 0;
                                    let cron = '';
                                    if (scheduleMode === 'interval') {
                                        const multipliers: Record<string, number> = { seconds: 1, minutes: 60, hours: 3600, days: 86400 };
                                        interval = intervalValue * (multipliers[intervalUnit] || 60);
                                    } else {
                                        cron = editingTask.class_path ? cronExpression : cronTimes.length > 0 ? timesToCron(cronTimes) : '* * * * *';
                                    }
                                    try {
                                        await updateTask(editingTask.name, {
                                            cron,
                                            interval,
                                            description: descInput.value,
                                            params,
                                        });
                                        setEditingTask(null);
                                        toast.success(t('scheduled_tasks.task_updated', { name: editingTask.name }));
                                    } catch (error: any) {
                                        const detail = error?.response?.data?.detail;
                                        setTaskEditorError(Array.isArray(detail) ? detail.map((item: any) => `${(item.loc || []).join('.')}: ${item.msg}`).join('\n') : typeof detail === 'string' ? detail : error.message);
                                    }
                                }}
                            >
                                {t('common.save', 'Save')}
                            </Button>
                        </div>
                    )}
                >
                    <div className="space-y-4">
                        <div>
                            <Label>{t('scheduled_tasks.task_name', 'Task Name')}</Label>
                            <div className="font-medium">{t(`scheduled_task_definitions.${editingTask.name}.title`, editingTask.title || editingTask.name)}</div>
                        </div>
                        <div>
                            <Label>{t('scheduled_tasks.schedule_type', 'Schedule Type')}</Label>
                            <div className="flex gap-4 mt-1">
                                <label className="flex items-center gap-2">
                                    <input
                                        type="radio"
                                        name="taskType"
                                        value="cron"
                                        checked={scheduleMode === 'cron'}
                                        onChange={() => setScheduleMode('cron')}
                                    />
                                    {t('scheduled_tasks.type_cron', 'Scheduled Time')}
                                </label>
                                <label className="flex items-center gap-2">
                                    <input
                                        type="radio"
                                        name="taskType"
                                        value="interval"
                                        checked={scheduleMode === 'interval'}
                                        onChange={() => setScheduleMode('interval')}
                                    />
                                    {t('scheduled_tasks.type_interval', 'Interval')}
                                </label>
                            </div>
                        </div>
                        {scheduleMode === 'cron' && editingTask.class_path ? (
                            <div><Label>Cron</Label><Input value={cronExpression} onChange={(event) => setCronExpression(event.target.value)} placeholder="0 3 * * *" /></div>
                        ) : scheduleMode === 'cron' ? (
                            <div>
                                <Label>{t('scheduled_tasks.scheduled_times', 'Scheduled Times')}</Label>
                                <div className="space-y-2 mt-1">
                                    {cronTimes.map((time, idx) => (
                                        <div key={idx} className="flex items-center gap-2">
                                            <Input
                                                type="time"
                                                value={time}
                                                className="w-32"
                                                onChange={(e) => {
                                                    const newTimes = [...cronTimes];
                                                    newTimes[idx] = e.target.value;
                                                    setCronTimes(newTimes);
                                                }}
                                            />
                                            <Button
                                                variant="outline"
                                                size="sm"
                                                onClick={() => {
                                                    const newTimes = cronTimes.filter((_, i) => i !== idx);
                                                    setCronTimes(newTimes);
                                                }}
                                            >
                                                {t('common.remove', 'Remove')}
                                            </Button>
                                        </div>
                                    ))}
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => setCronTimes([...cronTimes, '08:00'])}
                                    >
                                        + {t('scheduled_tasks.add_time', 'Add Time')}
                                    </Button>
                                </div>
                                <p className="text-xs text-muted-foreground mt-1">
                                    {t('scheduled_tasks.cron_help', 'Select the times to run each day')}
                                </p>
                            </div>
                        ) : (
                            <div>
                                <Label>{t('scheduled_tasks.interval_value', 'Run Every')}</Label>
                                <div className="flex items-center gap-2 mt-1">
                                    <Input
                                        type="number"
                                        min="1"
                                        className="w-24"
                                        value={intervalValue}
                                        onChange={(e) => setIntervalValue(Math.max(1, parseInt(e.target.value) || 1))}
                                    />
                                    <select
                                        className="border rounded px-3 py-2 bg-background text-sm"
                                        value={intervalUnit}
                                        onChange={(e) => setIntervalUnit(e.target.value as 'seconds' | 'minutes' | 'hours' | 'days')}
                                    >
                                        <option value="seconds">{t('scheduled_tasks.seconds', 'seconds')}</option>
                                        <option value="minutes">{t('scheduled_tasks.minutes', 'minutes')}</option>
                                        <option value="hours">{t('scheduled_tasks.hours', 'hours')}</option>
                                        <option value="days">{t('scheduled_tasks.days', 'days')}</option>
                                    </select>
                                </div>
                            </div>
                        )}
                        <div>
                            <Label>{t('scheduled_tasks.description', 'Description')}</Label>
                            <Input
                                id="description"
                                defaultValue={editingTask.description}
                                placeholder={t('scheduled_tasks.description_placeholder', 'Task description')}
                            />
                        </div>
                        {taskEditorError && <p role="alert" className="whitespace-pre-wrap text-sm text-destructive">{taskEditorError}</p>}
                        {editingTask.class_path ? (
                            <div ref={taskInputContainer} className="border-t pt-4">
                                <TypedToolFields fields={editingTask.inputs || []} values={taskInputOverrides} defaults={editingTask.defaults || {}} onChange={setTaskInputOverrides} t={t} prefix={`scheduled_task_definitions.${editingTask.name}.inputs`} id={`scheduled-${editingTask.name}`} />
                            </div>
                        ) : editingTask.params && Object.keys(editingTask.params).length > 0 && (
                            <div className="border-t pt-4">
                                <Label className="mb-2 block">{t('scheduled_tasks.parameters', 'Parameters')}</Label>
                                <div className="space-y-3">
                                    {Object.entries(editingTask.params).map(([key, param]) => (
                                        <div key={key}>
                                            <Label className="text-sm">{param.label || key}</Label>
                                            {param.type === 'bool' ? (
                                                <div className="flex items-center gap-2 mt-1">
                                                    <input
                                                        type="checkbox"
                                                        id={`param-${key}`}
                                                        defaultChecked={!!param.value}
                                                        className="h-4 w-4"
                                                    />
                                                </div>
                                            ) : param.type === 'multi_select' ? (
                                                <Input
                                                    id={`param-${key}`}
                                                    defaultValue={Array.isArray(param.value) ? param.value.join(', ') : String(param.value ?? '')}
                                                    placeholder="a, b, c"
                                                    className="mt-1"
                                                />
                                            ) : (
                                                <Input
                                                    id={`param-${key}`}
                                                    defaultValue={String(param.value ?? '')}
                                                    type={param.type === 'number' ? 'number' : 'text'}
                                                    className="mt-1"
                                                />
                                            )}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                    </div>
                </Modal>
            )}
        </div>
    );
};

export default ScheduledTasksPage;
