@asynccontextmanager
async def lifespan(app: FastAPI):
    # Initialize DB
    await init_db()
    # Initialize Data
    await init_data()
    logger.info(f"Loaded CORS Origins: {settings.BACKEND_CORS_ORIGINS}")

    {% if config.rabbitmq %}
    # Initialize RabbitMQ
    if rabbitmq_manager:
        await rabbitmq_manager.connect()
    {% endif %}

    {% if config.mqtt %}
    # Initialize MQTT
    if mqtt_manager:
        {% if config.mqtt.callbacks %}
        register_mqtt_handlers()
        {% endif %}
        await mqtt_manager.connect()
    {% endif %}

    {% if config.scheduled_tasks %}
    # Start scheduler
    task_registry.start()
    logger.info("Scheduler started")
    {% endif %}

    # Start background task worker
    _task_queue_worker = asyncio.create_task(task_queue.run())
    logger.info("Task queue worker started")

    yield

    # Shutdown background task worker
    _task_queue_worker.cancel()
    logger.info("Task queue worker stopped")

    {% if config.scheduled_tasks %}
    # Stop scheduler
    task_registry.stop()
    logger.info("Scheduler stopped")
    {% endif %}

    {% if config.rabbitmq %}
    # Disconnect RabbitMQ
    if rabbitmq_manager:
        await rabbitmq_manager.disconnect()
    {% endif %}

    {% if config.mqtt %}
    # Disconnect MQTT
    if mqtt_manager:
        await mqtt_manager.disconnect()
    {% endif %}

app = FastAPI(
    title=settings.PROJECT_NAME,
    openapi_url=f"{settings.API_V1_STR}/openapi.json",
    lifespan=lifespan
)

# Set all CORS enabled origins
if settings.BACKEND_CORS_ORIGINS:
    app.add_middleware(
        CORSMiddleware,
        allow_origins=[str(origin).rstrip("/") for origin in settings.BACKEND_CORS_ORIGINS],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

# Mount static files
static_path = Path("static")
static_path.mkdir(exist_ok=True)
app.mount("/static", StaticFiles(directory="static"), name="static")

# Mount uploads
# Use configured upload directory from settings
uploads_path = Path(settings.UPLOAD_DIR)
uploads_path.mkdir(parents=True, exist_ok=True)

# Determine mount path based on config or convention
# For now we stick to /uploads as the URL prefix, but the directory is configurable
# If user wants a different URL prefix, we might need more config.
# Assuming /uploads prefix maps to settings.UPLOAD_DIR
app.mount("/uploads", StaticFiles(directory=settings.UPLOAD_DIR), name="uploads")

app.include_router(api_router, prefix=settings.API_V1_STR)
