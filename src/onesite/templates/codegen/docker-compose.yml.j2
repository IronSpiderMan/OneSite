version: '3.8'

services:
  backend:
    image: {{ backend_image }}
    container_name: {{ project_name }}-backend
    restart: always
    ports:
      - "8000:80"
    environment:
      - PROJECT_NAME={{ project_name }}
      - TIMEZONE={{ config.get('extra', {}).get('TIMEZONE', 'Asia/Shanghai') }}
      - BACKEND_CORS_ORIGINS=${BACKEND_CORS_ORIGINS:-{{ config.allowed_origins | tojson }}}
      {% if config.get('video_stream', {}).get('rtsp', {}).get('enabled', False) %}
      - RTSP_PREVIEW_ENABLED=true
      - MEDIA_MTX_API_URL=http://mediamtx:9997
      - MEDIA_HLS_PUBLIC_PREFIX=/media-hls
      {% endif %}
      # If using PG, override DATABASE_URI
      {% if use_pg %}
      - DATABASE_URI=postgresql+asyncpg://postgres:postgres@db:5432/app
      {% else %}
      - DATABASE_URI=sqlite+aiosqlite:////app/data/app.db
      {% endif %}
    volumes:
      - {{ project_root_prefix | default('.') }}/uploads:/app/uploads # Persist uploads
      {% if not use_pg %}
      - sqlite_data:/app/data # Persist SQLite DB directory
      {% endif %}
    networks:
      - {{ project_name }}-network
    {% if use_pg or config.get('video_stream', {}).get('rtsp', {}).get('enabled', False) %}
    depends_on:
      {% if use_pg %}
      - db
      {% endif %}
      {% if config.get('video_stream', {}).get('rtsp', {}).get('enabled', False) %}
      - mediamtx
      {% endif %}
    {% endif %}

  frontend:
    image: {{ frontend_image }}
    container_name: {{ project_name }}-frontend
    restart: always
    ports:
      - "{{ frontend_port }}:80"
    environment:
      - API_URL=http://localhost:{{ frontend_port }}/api/v1
    depends_on:
      - backend
      {% if config.get('video_stream', {}).get('rtsp', {}).get('enabled', False) %}
      - mediamtx
      {% endif %}
    networks:
      - {{ project_name }}-network

{% if config.get('video_stream', {}).get('rtsp', {}).get('enabled', False) %}
  mediamtx:
    image: bluenviron/mediamtx:1.19.3
    container_name: {{ project_name }}-mediamtx
    restart: always
    environment:
      - MTX_API=yes
      - MTX_APIADDRESS=:9997
      - MTX_HLS=yes
      - MTX_HLSADDRESS=:8888
      - MTX_HLSALLOWORIGINS=*
      - MTX_HLSVARIANT=fmp4
    ports:
      - "127.0.0.1:8888:8888"
    networks:
      - {{ project_name }}-network
{% endif %}

{% if use_pg %}
  db:
    image: postgres:15-alpine
    container_name: {{ project_name }}-db
    restart: always
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB=app
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    networks:
      - {{ project_name }}-network
{% endif %}

volumes:
{% if use_pg %}
  postgres_data:
{% else %}
  sqlite_data:
{% endif %}

networks:
  {{ project_name }}-network:
    driver: bridge
