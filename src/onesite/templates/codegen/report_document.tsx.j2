const safeReportUrl = (value: string): string | undefined => {
  const url = value.trim();
  if (/^(https?:\/\/|mailto:|#|\/(?!\/))/i.test(url) && !/[\u0000-\u0020\u007f]/.test(url)) return url;
  return undefined;
};
const renderReportHtml = (html: string): React.ReactNode => {
  const doc = new DOMParser().parseFromString(html, 'text/html');
  const tags = new Set(['p', 'div', 'span', 'section', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'strong', 'b', 'em', 'i', 'u', 's', 'del', 'small', 'mark', 'sub', 'sup', 'br', 'hr', 'ul', 'ol', 'li', 'blockquote', 'pre', 'code', 'table', 'caption', 'thead', 'tbody', 'tfoot', 'tr', 'th', 'td', 'a', 'img']);
  const blocked = new Set(['script', 'style', 'iframe', 'object', 'embed', 'svg', 'math', 'template', 'link', 'meta', 'base', 'form', 'input', 'button', 'textarea', 'select', 'video', 'audio']);
  const render = (node: Node, key: number): React.ReactNode => {
    if (node.nodeType === 3) return node.textContent;
    if (node.nodeType !== 1) return null;
    const element = node as HTMLElement, tag = element.tagName.toLowerCase();
    if (blocked.has(tag)) return null;
    const children = Array.from(element.childNodes).map(render);
    if (!tags.has(tag)) return React.createElement(React.Fragment, { key }, children);
    const props: Record<string, any> = { key };
    // Build fresh React elements with an explicit attribute list: no raw HTML, events or arbitrary CSS.
    if (tag === 'a') { props.href = safeReportUrl(element.getAttribute('href') || ''); props.rel = 'noopener noreferrer'; props.target = '_blank'; }
    if (tag === 'img') {
      const src = safeReportUrl(element.getAttribute('src') || '');
      if (!src || src.startsWith('mailto:') || src.startsWith('#')) return null;
      props.src = src; props.alt = element.getAttribute('alt') || ''; props.referrerPolicy = 'no-referrer';
    }
    if (tag === 'td' || tag === 'th') {
      for (const [attr, prop] of [['colspan', 'colSpan'], ['rowspan', 'rowSpan']]) {
        const value = Number(element.getAttribute(attr)); if (Number.isInteger(value) && value > 0 && value <= 100) props[prop] = value;
      }
    }
    if (tag === 'ol') { const start = Number(element.getAttribute('start')); if (Number.isInteger(start) && element.hasAttribute('start')) props.start = start; }
    const style: Record<string, string> = {};
    if (/^(left|center|right|justify)$/.test(element.style.textAlign)) style.textAlign = element.style.textAlign;
    for (const property of ['color', 'backgroundColor'] as const) {
      const value = element.style[property]; if (/^(#[\da-f]{3,8}|[a-z]+|rgba?\([\d.,%\s]+\))$/i.test(value)) style[property] = value;
    }
    if (Object.keys(style).length) props.style = style;
    return ['br', 'hr', 'img'].includes(tag) ? React.createElement(tag, props) : React.createElement(tag, props, children);
  };
  return Array.from(doc.body.childNodes).map(render);
};
const ReportContent: React.FC<{ text: string; format: ReportFormat; alt?: string; visualTitle?: string }> = ({ text, format, alt, visualTitle }) => {
  const html = useMemo(() => format === 'html' ? renderReportHtml(text) : null, [text, format]);
  if (isReportVisual(format)) return <div className="report-visual">
    {format === 'mermaid' ? <ReportMermaid text={text} alt={alt} /> : <ReportImage key={text} text={text} format={format} alt={alt} />}
    {visualTitle?.trim() && <h3 className="report-visual-title">{visualTitle.trim()}</h3>}
  </div>;
  if (!text) return null;
  return <div className="report-rich-text">{format === 'html' ? html : format === 'markdown' ? <ReactMarkdown remarkPlugins={[remarkGfm]} skipHtml components={ { a: ({ href, children }) => <a href={safeReportUrl(href || '')} target="_blank" rel="noopener noreferrer">{children}</a>, img: ({ src, alt }) => { const safe = safeReportUrl(src || ''); return safe && /^(https?:\/\/|\/(?!\/))/i.test(safe) ? <img src={safe} alt={alt || ''} referrerPolicy="no-referrer" /> : null; } } }>{text}</ReactMarkdown> : <p className="report-plain-text">{text}</p>}</div>;
};

// SVG is rendered in an image context, never inserted into the document DOM.
const ReportImage: React.FC<{ text: string; format: ReportFormat; alt?: string }> = ({ text, format, alt }) => {
  const { t } = useTranslation();
  const [failed, setFailed] = useState('');
  let src: string | undefined;
  if (format === 'svg') {
    const doc = new DOMParser().parseFromString(text, 'image/svg+xml');
    if (!doc.querySelector('parsererror') && doc.documentElement.localName === 'svg' && doc.documentElement.namespaceURI === 'http://www.w3.org/2000/svg')
      src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(text)}`;
  } else {
    const safe = safeReportUrl(text);
    if (safe && /^https?:\/\//i.test(safe)) src = safe;
  }
  if (!text.trim()) return null;
  return !src || failed === src ? <p role="alert">{t('reports.editor.image_error', 'Invalid image source or image could not be loaded.')}</p> :
    <div className="report-mermaid"><img src={src} alt={alt || ''} referrerPolicy="no-referrer" onError={() => setFailed(src!)} /></div>;
};

// Load the diagram engine only when a report actually contains Mermaid.
let reportMermaidEngine: Promise<typeof import('mermaid')['default']> | undefined;
const loadReportMermaid = () => reportMermaidEngine ||= import('mermaid').then(({ default: engine }) => {
  engine.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'default', htmlLabels: false, suppressErrorRendering: true, secure: ['secure', 'securityLevel', 'startOnLoad', 'maxTextSize', 'suppressErrorRendering', 'maxEdges', 'htmlLabels'] });
  return engine;
}).catch((error) => { reportMermaidEngine = undefined; throw error; });
const ReportMermaid: React.FC<{ text: string; alt?: string }> = ({ text, alt }) => {
  const { t } = useTranslation();
  const [rendered, setRendered] = useState<{ source: string; image?: string; error?: string } | null>(null);
  useEffect(() => {
    let cancelled = false;
    void (async () => {
      try {
        const engine = await loadReportMermaid();
        const { svg } = await engine.render(`mermaid-${reportId()}`, text);
        // Native SVG labels avoid HTML <br> tags that cannot be decoded as XML images.
        // An SVG image keeps diagram markup isolated and survives the print document clone.
        const image = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
        const decoded = new Image(); decoded.src = image; await decoded.decode();
        if (!cancelled) setRendered({ source: text, image });
      } catch (error) {
        if (!cancelled) setRendered({ source: text, error: error instanceof Error ? error.message : String(error) });
      }
    })();
    return () => { cancelled = true; };
  }, [text]);
  const current = rendered?.source === text ? rendered : null;
  return <div className="report-mermaid" data-mermaid-ready={current?.image ? 'true' : 'false'}>
    {current?.image ? <img src={current.image} alt={alt || 'Mermaid'} /> : current?.error ? <div role="alert"><p>{t('reports.editor.mermaid_error', 'Could not display Mermaid. See the error details below.')}</p><pre>{current.error}</pre></div> : <p role="status">{t('reports.editor.loading', 'Loading…')}</p>}
  </div>;
};

