"""Explicit post-commit background hooks for {{ model.name }}.

Auto-generated from ``on_background_after_*`` model methods.
"""

import logging

from app.core.db import engine
from app.core.model_hooks import ModelHookContext, invoke_model_hook
from app.core.task_queue import task_queue
from app.models.{{ model.module_name }} import {{ model.name }}
from sqlmodel.ext.asyncio.session import AsyncSession

logger = logging.getLogger(__name__)

{% for hook in model.background_hooks %}

@task_queue.handler("{{ model.module_name }}.background_after_{{ hook.operation }}")
async def handle_{{ model.module_name }}_background_after_{{ hook.operation }}(payload: dict):
    context = ModelHookContext(
        operation="{{ hook.operation }}",
        input_data=payload.get("input_data", {}),
        changed_fields=frozenset(payload.get("changed_fields", [])),
    )
    old = payload.get("old")
    changes = payload.get("changes")

    async with AsyncSession(engine) as session:
        try:
{% if hook.operation == "delete" %}
            target = {{ model.name }}(**(old or {}))
{% else %}
            target = await session.get({{ model.name }}, payload.get("id"))
            if target is None:
                logger.warning(
                    "{{ model.name }} %s not found for background {{ hook.operation }} hook",
                    payload.get("id"),
                )
                return
{% endif %}
            await invoke_model_hook(
                target,
                "on_background_after_{{ hook.operation }}",
                session=session,
                old=old,
                changes=changes,
                context=context,
            )
            await session.commit()
        except Exception:
            await session.rollback()
            raise
{% endfor %}
