"""Generated scheduled task definitions and handler bindings. Do not edit."""

import json

from app.core.scheduler import task_registry
{% for task in tasks %}
{% if task.class_path is defined %}
from {{ task.class_path.split(':')[0] }} import {{ task.class_path.split(':')[1] }} as _task_{{ loop.index }}
{% else %}
from app.tasks.{{ task.handler }} import {{ task.handler }}
{% endif %}
{% endfor %}

SCHEDULED_TASK_DEFINITIONS = json.loads({{ tasks_json | tojson }})
SCHEDULED_TASKS_BY_NAME = {
    task["name"]: task for task in SCHEDULED_TASK_DEFINITIONS
}
SCHEDULED_TASK_HANDLERS = {
{% for task in tasks %}
{% if task.class_path is not defined %}
    "{{ task.name }}": {{ task.handler }},
{% endif %}
{% endfor %}
}

SCHEDULED_TASK_CLASSES = {
{% for task in tasks %}
{% if task.class_path is defined %}
    "{{ task.name }}": _task_{{ loop.index }},
{% endif %}
{% endfor %}
}

_registered = False


def register_scheduled_tasks() -> None:
    global _registered
    if _registered:
        return
    for task in SCHEDULED_TASK_DEFINITIONS:
        config = dict(task)
        config["func"] = task.get("class_path", f"app.tasks.{task['handler']}:{task['handler']}")
        task_registry.register(config)
    _registered = True
