"""Generated MQTT callback bindings. Do not edit this file directly."""

from app.core.mqtt import mqtt_manager
{% for handler in handlers %}
from app.integrations.mqtt.{{ handler }} import {{ handler }}
{% endfor %}

_registered = False


def register_mqtt_handlers() -> None:
    """Register configured topic-to-handler bindings exactly once."""
    global _registered
    if _registered or mqtt_manager is None:
        return

{% for callback in callbacks %}
    mqtt_manager.register_handler(
        "{{ callback.topic }}",
        {{ callback.handler }},
        qos={{ callback.qos }},
    )
{% endfor %}
    _registered = True
