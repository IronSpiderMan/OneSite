"""Runtime types exposed to developer-owned tool handlers."""

import asyncio
import json
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable

from sqlmodel.ext.asyncio.session import AsyncSession
from sqlmodel import select

from app.core.config import settings
from app.core.background_execution import BackgroundExecution
from app.core.ws import manager
from app.core.db import engine


@dataclass
class ToolResult:
    message: str = "Completed"
    data: Any = None
    download_path: str | Path | None = None


@dataclass
class ToolContext:
    task_id: str
    user_id: int
    current_user: Any
    session: AsyncSession

    @property
    def output_dir(self) -> Path:
        path = Path(settings.UPLOAD_DIR) / "tools" / self.task_id / "outputs"
        path.mkdir(parents=True, exist_ok=True)
        return path

    def output_path(self, filename: str) -> Path:
        safe_name = Path(filename).name
        if not safe_name:
            raise ValueError("Output filename cannot be empty")
        return self.output_dir / safe_name

    async def run_sync(self, function: Callable[..., Any], *args, **kwargs) -> Any:
        return await asyncio.to_thread(function, *args, **kwargs)

    async def set_progress(self, progress: int, message: str | None = None) -> None:
        execution = await self.session.get(BackgroundExecution, self.task_id)
        if execution is None:
            return
        execution.progress = max(0, min(100, int(progress)))
        if message is not None:
            execution.message = message
        self.session.add(execution)
        await self.session.commit()
        await manager.send_personal_message(
            {
                "type": "tool_status",
                "data": {
                    "task_id": self.task_id,
                    "tool_name": execution.name,
                    "status": execution.status,
                    "progress": execution.progress,
                    "message": execution.message,
                },
            },
            self.user_id,
        )


def normalize_tool_result(value: Any) -> ToolResult:
    if isinstance(value, ToolResult):
        return value
    if isinstance(value, str):
        return ToolResult(message=value)
    if value is None:
        return ToolResult()
    return ToolResult(data=value)


def serialize_result(value: Any) -> str | None:
    if value is None:
        return None
    return json.dumps(value, ensure_ascii=False, default=str)


def download_url_for(task_id: str, download_path: str | Path | None) -> str | None:
    if download_path is None:
        return None
    upload_root = Path(settings.UPLOAD_DIR).resolve()
    path = Path(download_path).resolve()
    if not path.is_file():
        raise ValueError(f"Tool output does not exist: {path}")
    expected_root = (upload_root / "tools" / task_id / "outputs").resolve()
    try:
        relative = path.relative_to(expected_root)
    except ValueError as exc:
        raise ValueError("Tool output must be created inside context.output_dir") from exc
    return f"/uploads/tools/{task_id}/outputs/{relative.as_posix()}"


async def reconcile_interrupted_tool_executions() -> None:
    """Mark process-local tool work interrupted by a restart as failed."""
    async with AsyncSession(engine) as session:
        statement = select(BackgroundExecution).where(
            BackgroundExecution.kind == "tool",
            BackgroundExecution.status.in_(["queued", "running"]),
        )
        executions = (await session.exec(statement)).all()
        for execution in executions:
            execution.status = "failed"
            execution.error = "Tool execution was interrupted by an application restart"
            execution.completed_at = datetime.now(timezone.utc)
            session.add(execution)
        if executions:
            await session.commit()
