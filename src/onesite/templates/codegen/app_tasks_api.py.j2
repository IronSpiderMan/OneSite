import json
from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query
from pydantic import BaseModel, Field, ValidationError
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core import db, deps
from app.core.background_execution import BackgroundExecution
from app.core.scheduler import task_registry
from app.core.scheduled_task_runtime import execution_to_dict
from app.models.user import User

router = APIRouter()


class TaskUpdate(BaseModel):
    cron: str | None = None
    interval: int | None = Field(default=None, ge=0, strict=True)
    description: str | None = None
    enabled: bool | None = None
    params: dict[str, Any] | None = None


def _role_name(user: User) -> str:
    return getattr(user.role, "value", str(user.role))


def _invalid_configuration(exc: ValueError) -> HTTPException:
    detail = json.loads(exc.json(include_url=False, include_context=False, include_input=False)) if isinstance(exc, ValidationError) else str(exc)
    return HTTPException(status_code=422, detail=detail)


def _assert_manage_allowed(task: dict, user: User) -> None:
    if _role_name(user) not in task.get("manual_permissions", ["admin", "developer"]):
        raise HTTPException(status_code=403, detail="Permission denied")


async def _latest_execution(session: AsyncSession, name: str):
    statement = (
        select(BackgroundExecution)
        .where(
            BackgroundExecution.kind == "scheduled_task",
            BackgroundExecution.name == name,
        )
        .order_by(BackgroundExecution.created_at.desc())
        .limit(1)
    )
    return (await session.exec(statement)).first()


@router.get("/tasks/")
async def list_tasks(
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
) -> list[dict[str, Any]]:
    result = []
    for task in task_registry.get_tasks():
        if _role_name(current_user) not in task.get("manual_permissions", []):
            continue
        latest = await _latest_execution(session, task["name"])
        task["last_execution"] = execution_to_dict(latest) if latest else None
        result.append(task)
    return result


@router.get("/tasks/executions")
async def list_task_executions(
    task_name: str | None = None,
    limit: int = Query(20, ge=1, le=100),
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
) -> list[dict]:
    allowed_names = [
        task["name"]
        for task in task_registry.get_tasks()
        if _role_name(current_user) in task.get("manual_permissions", [])
    ]
    statement = select(BackgroundExecution).where(
        BackgroundExecution.kind == "scheduled_task",
        BackgroundExecution.name.in_(allowed_names),
    )
    if task_name:
        task = task_registry.get_task(task_name)
        if not task:
            raise HTTPException(status_code=404, detail=f"Task '{task_name}' not found")
        _assert_manage_allowed(task, current_user)
        statement = statement.where(BackgroundExecution.name == task_name)
    statement = statement.order_by(BackgroundExecution.created_at.desc()).limit(limit)
    return [execution_to_dict(item) for item in (await session.exec(statement)).all()]


@router.get("/tasks/executions/{execution_id}")
async def get_task_execution(
    execution_id: str,
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
) -> dict:
    execution = await session.get(BackgroundExecution, execution_id)
    if execution is None or execution.kind != "scheduled_task":
        raise HTTPException(status_code=404, detail="Scheduled task execution not found")
    task = task_registry.get_task(execution.name)
    if not task:
        raise HTTPException(status_code=404, detail="Scheduled task not found")
    _assert_manage_allowed(task, current_user)
    return execution_to_dict(execution)


@router.get("/tasks/{name}")
async def get_task(
    name: str,
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
) -> dict[str, Any]:
    task = task_registry.get_task(name)
    if not task:
        raise HTTPException(status_code=404, detail=f"Task '{name}' not found")
    _assert_manage_allowed(task, current_user)
    latest = await _latest_execution(session, name)
    task["last_execution"] = execution_to_dict(latest) if latest else None
    return task


@router.post("/tasks/{name}/run", status_code=202)
async def run_task(
    name: str,
    current_user: User = Depends(deps.get_current_user),
) -> dict:
    task = task_registry.get_task(name)
    if not task:
        raise HTTPException(status_code=404, detail=f"Task '{name}' not found")
    _assert_manage_allowed(task, current_user)
    try:
        execution = await task_registry.run(name, requested_by=current_user.id)
    except ValueError as exc:
        raise _invalid_configuration(exc) from exc
    return execution_to_dict(execution)


@router.post("/tasks/{name}/enable")
def enable_task(
    name: str,
    current_user: User = Depends(deps.get_current_user),
) -> dict[str, str]:
    task = task_registry.get_task(name)
    if not task:
        raise HTTPException(status_code=404, detail=f"Task '{name}' not found")
    _assert_manage_allowed(task, current_user)
    try:
        task_registry.enable(name)
    except ValueError as exc:
        raise _invalid_configuration(exc) from exc
    return {"status": "ok", "message": f"Task '{name}' enabled"}


@router.post("/tasks/{name}/disable")
def disable_task(
    name: str,
    current_user: User = Depends(deps.get_current_user),
) -> dict[str, str]:
    task = task_registry.get_task(name)
    if not task:
        raise HTTPException(status_code=404, detail=f"Task '{name}' not found")
    _assert_manage_allowed(task, current_user)
    task_registry.disable(name)
    return {"status": "ok", "message": f"Task '{name}' disabled"}


@router.put("/tasks/{name}")
def update_task(
    name: str,
    config: TaskUpdate,
    current_user: User = Depends(deps.get_current_user),
) -> dict[str, str]:
    task = task_registry.get_task(name)
    if not task:
        raise HTTPException(status_code=404, detail=f"Task '{name}' not found")
    _assert_manage_allowed(task, current_user)
    try:
        task_registry.update(name, config.model_dump(exclude_unset=True))
    except ValueError as exc:
        raise _invalid_configuration(exc) from exc
    return {"status": "ok", "message": f"Task '{name}' updated"}
