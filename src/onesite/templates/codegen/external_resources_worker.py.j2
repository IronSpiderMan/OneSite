"""Standalone external-resource reconciler process."""

from __future__ import annotations

import asyncio
import signal

from fastapi import FastAPI

from app.core.external_resources import external_resource_manager, init_external_resource_db
from app.core.external_resource_provider_registry import init_external_resource_providers
from app.resources import destroy_resources, init_resources


async def run() -> None:
    app = FastAPI()
    stopped = asyncio.Event()
    loop = asyncio.get_running_loop()
    for name in ("SIGINT", "SIGTERM"):
        if hasattr(signal, name):
            loop.add_signal_handler(getattr(signal, name), stopped.set)
    # The worker owns only its runtime schema. Application and TimescaleDB
    # schemas are initialized by the deployment or the web application.
    await init_external_resource_db()
    await init_resources(app)
    init_external_resource_providers()
    try:
        await external_resource_manager.start()
        await stopped.wait()
    finally:
        await external_resource_manager.stop()
        await destroy_resources(app)


if __name__ == "__main__":
    asyncio.run(run())
