from typing import Optional
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession
from sqlalchemy.exc import IntegrityError
from app.models.{{ model.source_module }} import {{ model.name }}
from app.schemas.{{ model.module_name }} import {{ model.name }}Update
from app.core.model_hooks import ModelHookContext, invoke_model_hook, snapshot_model
from app.core.db import transactional_write

{% set scalar_json_arrays = model.fields | selectattr('json_item_kind') | list %}
{% if scalar_json_arrays %}
def _serialize_json_scalar_arrays(data: dict) -> dict:
    {% for field in scalar_json_arrays %}
    if isinstance(data.get("{{ field.name }}"), list):
        data["{{ field.name }}"] = [value.isoformat() if hasattr(value, "isoformat") else value for value in data["{{ field.name }}"]]
    {% endfor %}
    return data

{% endif %}

async def get(session: AsyncSession) -> {{ model.name }}:
    statement = select({{ model.name }}).where({{ model.name }}.id == 1)
    result = await session.exec(statement)
    db_obj = result.first()
    
    if not db_obj:
        # Create default config if not exists
        db_obj = {{ model.name }}(id=1)
        session.add(db_obj)
        try:
            await session.commit()
            await session.refresh(db_obj)
        except IntegrityError as e:
            await session.rollback()
            raise RuntimeError(
                "Failed to create default singleton config. This is usually caused by a database schema mismatch "
                "(e.g. you changed fields in the config model). For SQLite, delete the database file and restart "
                "the backend to recreate tables."
            ) from e
        
    return db_obj

@transactional_write
async def update(session: AsyncSession, obj_in: {{ model.name }}Update, *, auto_commit: bool = True) -> {{ model.name }}:
    db_obj = await get(session)
    old = snapshot_model(db_obj)
    {% if scalar_json_arrays %}
    obj_data = _serialize_json_scalar_arrays(obj_in.dict(exclude_unset=True))
    {% else %}
    obj_data = obj_in.dict(exclude_unset=True)
    {% endif %}

    hook_context = ModelHookContext(
        operation="update",
        input_data=dict(obj_data),
        changed_fields=frozenset(obj_data),
    )
    await invoke_model_hook(
        db_obj,
        "on_before_update",
        session=session,
        old=old,
        changes=obj_data,
        context=hook_context,
    )
    
    for key, value in obj_data.items():
        setattr(db_obj, key, value)
        
    session.add(db_obj)
    await session.flush()
    await session.refresh(db_obj)
    await invoke_model_hook(
        db_obj,
        "on_after_update",
        session=session,
        old=old,
        changes=obj_data,
        context=hook_context,
    )
    await session.flush()
    return db_obj
