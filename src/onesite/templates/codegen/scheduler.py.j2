import json
import os
import logging
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional
from zoneinfo import ZoneInfo

from apscheduler.schedulers.asyncio import AsyncIOScheduler
from apscheduler.triggers.cron import CronTrigger
from apscheduler.triggers.interval import IntervalTrigger
from app.core.config import settings


logger = logging.getLogger(__name__)


class TaskRegistry:
    """Task registry with JSON persistence"""

    def __init__(self):
        self._tasks: Dict[str, dict] = {}
        self._timezone = ZoneInfo(settings.TIMEZONE)
        self._scheduler = AsyncIOScheduler(timezone=self._timezone)
        default_path = Path(__file__).resolve().parent.parent.parent / "tasks_state.json"
        self._state_file = Path(os.environ.get("TASKS_STATE_FILE", str(default_path)))

    def load_state(self):
        """Load persisted task state and merge into registered tasks."""
        if not self._state_file.exists():
            return
        try:
            with open(self._state_file, "r", encoding="utf-8") as f:
                saved = json.load(f)
        except (json.JSONDecodeError, OSError):
            return
        if not isinstance(saved, dict):
            return
        for name, state in saved.items():
            if name in self._tasks and isinstance(state, dict):
                self._tasks[name].update({
                    "cron": state.get("cron", self._tasks[name]["cron"]),
                    "interval": state.get("interval", self._tasks[name]["interval"]),
                    "description": state.get("description", self._tasks[name]["description"]),
                    "enabled": state.get("enabled", self._tasks[name]["enabled"]),
                })
                task = self._tasks[name]
                if task.get("class_path"):
                    overrides = state.get("input_overrides")
                    if overrides is None:
                        overrides = {key: param["value"] for key, param in state.get("params", {}).items() if isinstance(param, dict) and "value" in param}
                    task["input_overrides"] = overrides
                else:
                    task["params"] = state.get("params", task.get("params", {}))

    def save_state(self):
        """Persist current task state to JSON file."""
        data = {}
        for name, t in self._tasks.items():
            data[name] = {
                "cron": t["cron"],
                "interval": t["interval"],
                "description": t.get("description", ""),
                "enabled": t["enabled"],
            }
            if t.get("class_path"):
                data[name]["input_overrides"] = t.get("input_overrides", {})
            else:
                data[name]["params"] = t.get("params", {})
        try:
            self._state_file.parent.mkdir(parents=True, exist_ok=True)
            with open(self._state_file, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except OSError as e:
            print(f"Failed to save task state: {e}")

    def _get_param_values(self, params: Dict[str, dict]) -> Dict[str, Any]:
        """Extract current param values from params dict."""
        return {k: v["value"] for k, v in params.items()}

    def _make_wrapper(self, name: str):
        """Create a lightweight scheduler callback that only enqueues work."""
        async def wrapper():
            from app.core.scheduled_task_runtime import enqueue_scheduled_task

            task = self._tasks[name]
            await enqueue_scheduled_task(
                task,
                params=self._input_values(task),
                trigger="schedule",
                requested_by=None,
            )
        return wrapper

    def register(self, config: dict) -> bool:
        """Register a task. Returns True if successful."""
        name = config["name"]
        func_path = config["func"]

        self._tasks[name] = {
            **config,
            "input_overrides": {},
            "configuration_error": None,
            "source_description": config.get("description", ""),
            "name": name,
            "func_path": func_path,
            "cron": config.get("cron", ""),
            "interval": config.get("interval", 0),  # 0 means cron task, >0 means interval in seconds
            "description": config.get("description", ""),
            "enabled": config.get("enabled", True),
            "params": config.get("params", {}),
            "title": config.get("title", name),
            "handler": config.get("handler", name),
            "timeout_seconds": config.get("timeout_seconds", 600),
            "overlap": config.get("overlap", "skip"),
            "manual_permissions": config.get("manual_permissions", ["admin", "developer"]),
            "_job": None,
        }

        return True

    def _add_to_scheduler(self, name: str):
        task = self._tasks.get(name)
        if not task or not task["enabled"]:
            return

        # Remove existing job if any
        if task["_job"]:
            try:
                self._scheduler.remove_job(name)
            except Exception:
                pass

        try:
            wrapper = self._make_wrapper(name)
            if task["interval"] > 0:
                # Interval task
                job = self._scheduler.add_job(
                    wrapper,
                    trigger=IntervalTrigger(
                        seconds=task["interval"],
                        timezone=self._timezone,
                    ),
                    id=name,
                    replace_existing=True,
                )
            else:
                # Cron task
                job = self._scheduler.add_job(
                    wrapper,
                    trigger=CronTrigger.from_crontab(
                        task["cron"],
                        timezone=self._timezone,
                    ),
                    id=name,
                    replace_existing=True,
                )
            task["_job"] = job
        except Exception as e:
            task["enabled"] = False
            task["_job"] = None
            task["configuration_error"] = str(e)
            logger.exception("Failed to add task %s to scheduler", name)

    def enable(self, name: str) -> bool:
        """Enable a task"""
        if name not in self._tasks:
            return False
        self._validate_inputs(self._tasks[name])
        self._tasks[name]["configuration_error"] = None
        self._tasks[name]["enabled"] = True
        self.save_state()
        if self._scheduler.running:
            self._add_to_scheduler(name)
        return True

    def disable(self, name: str) -> bool:
        """Disable a task"""
        if name not in self._tasks:
            return False
        self._tasks[name]["enabled"] = False
        if self._tasks[name]["_job"]:
            try:
                self._scheduler.remove_job(name)
            except Exception:
                pass
            self._tasks[name]["_job"] = None
        self.save_state()
        return True

    def update_cron(self, name: str, cron: str) -> bool:
        """Update task cron expression"""
        if name not in self._tasks:
            return False
        self._tasks[name]["cron"] = cron
        self._tasks[name]["interval"] = 0  # Switch to cron mode
        self.save_state()
        if self._tasks[name]["enabled"] and self._scheduler.running:
            self._add_to_scheduler(name)
        return True

    def update_interval(self, name: str, interval: int) -> bool:
        """Update task interval in seconds"""
        if name not in self._tasks:
            return False
        self._tasks[name]["interval"] = interval
        if interval > 0:
            self._tasks[name]["cron"] = ""  # Clear cron when using interval
        self.save_state()
        if self._tasks[name]["enabled"] and self._scheduler.running:
            self._add_to_scheduler(name)
        return True

    def update_description(self, name: str, description: str) -> bool:
        """Update task description"""
        if name not in self._tasks:
            return False
        self._tasks[name]["description"] = description
        self.save_state()
        return True

    def update_params(self, name: str, new_values: Dict[str, Any]) -> bool:
        """Update task param runtime values. Only updates 'value' key, preserves type/label/default."""
        if name not in self._tasks:
            return False
        if self._tasks[name].get("class_path"):
            candidate = {**self._tasks[name], "input_overrides": new_values}
            self._validate_inputs(candidate)
            self._tasks[name]["input_overrides"] = dict(new_values)
            self._tasks[name]["configuration_error"] = None
            self.save_state()
            return True
        params = self._tasks[name].get("params", {})
        for key, val in new_values.items():
            if key in params:
                params[key]["value"] = val
        self.save_state()
        return True

    def _input_values(self, task: dict) -> dict:
        if task.get("class_path"):
            return {**task.get("defaults", {}), **task.get("input_overrides", {})}
        return self._get_param_values(task.get("params", {}))

    def _validate_inputs(self, task: dict) -> None:
        if task.get("class_path"):
            from app.core.scheduled_task_runtime import validate_scheduled_inputs
            validate_scheduled_inputs(task, self._input_values(task))

    def _typed_metadata(self, task: dict) -> dict:
        if not task.get("class_path"):
            return {}
        return {key: task.get(key) for key in (
            "class_path", "inputs", "result", "result_ui", "defaults", "input_overrides", "configuration_error", "source_description",
        )}

    def update(self, name: str, changes: dict) -> bool:
        """Validate an entire edit before publishing any changed state."""
        if name not in self._tasks:
            return False
        task = self._tasks[name]
        candidate = dict(task)
        if changes.get("interval") is not None and changes["interval"] > 0:
            candidate.update(interval=changes["interval"], cron="")
        elif changes.get("cron") is not None:
            CronTrigger.from_crontab(changes["cron"], timezone=self._timezone)
            candidate.update(cron=changes["cron"], interval=0)
        for key in ("enabled", "description"):
            if changes.get(key) is not None:
                candidate[key] = changes[key]
        if changes.get("params") is not None:
            if task.get("class_path"):
                candidate["input_overrides"] = dict(changes["params"])
            else:
                candidate["params"] = {key: {**param, "value": changes["params"].get(key, param["value"])} for key, param in task.get("params", {}).items()}
        self._validate_inputs(candidate)
        candidate["configuration_error"] = None
        task.update(candidate)
        self.save_state()
        if task["enabled"] and self._scheduler.running:
            self._add_to_scheduler(name)
        elif task["_job"]:
            self._scheduler.remove_job(name)
            task["_job"] = None
        return True

    def _format_next_run(self, job) -> Optional[str]:
        """Format next_run time in the configured system timezone."""
        if not job or not job.next_run_time:
            return None
        dt = job.next_run_time
        if dt.tzinfo is not None:
            dt = dt.astimezone(self._timezone)
        return dt.strftime("%Y-%m-%d %H:%M:%S")

    def get_tasks(self) -> List[dict]:
        """Get all registered tasks"""
        return [
            {
                "name": t["name"],
                "func": t["func_path"],
                "cron": t["cron"],
                "interval": t["interval"],
                "description": t.get("description", ""),
                "enabled": t["enabled"],
                "params": t.get("params", {}),
                "title": t.get("title", t["name"]),
                "handler": t.get("handler", t["name"]),
                "timeout_seconds": t.get("timeout_seconds", 600),
                "overlap": t.get("overlap", "skip"),
                "manual_permissions": t.get("manual_permissions", ["admin", "developer"]),
                **self._typed_metadata(t),
                "next_run": self._format_next_run(t["_job"]) if t["_job"] else None,
            }
            for t in self._tasks.values()
        ]

    def get_task(self, name: str) -> Optional[dict]:
        """Get a single task by name"""
        t = self._tasks.get(name)
        if not t:
            return None
        return {
            "name": t["name"],
            "func": t["func_path"],
            "cron": t["cron"],
            "interval": t["interval"],
            "description": t.get("description", ""),
            "enabled": t["enabled"],
            "params": t.get("params", {}),
            "title": t.get("title", t["name"]),
            "handler": t.get("handler", t["name"]),
            "timeout_seconds": t.get("timeout_seconds", 600),
            "overlap": t.get("overlap", "skip"),
            "manual_permissions": t.get("manual_permissions", ["admin", "developer"]),
            **self._typed_metadata(t),
            "next_run": self._format_next_run(t["_job"]) if t["_job"] else None,
        }

    async def run(self, name: str, requested_by: int | None = None):
        """Enqueue a manual task execution."""
        if name not in self._tasks:
            return None
        from app.core.scheduled_task_runtime import enqueue_scheduled_task

        task = self._tasks[name]
        return await enqueue_scheduled_task(
            task,
            params=self._input_values(task),
            trigger="manual",
            requested_by=requested_by,
        )

    def start(self):
        """Start the scheduler and add all enabled tasks"""
        self.load_state()
        if not self._scheduler.running:
            self._scheduler.start()
        for name in self._tasks:
            if self._tasks[name]["enabled"]:
                try:
                    self._validate_inputs(self._tasks[name])
                except Exception as exc:
                    self._tasks[name]["enabled"] = False
                    self._tasks[name]["configuration_error"] = str(exc)
                    logger.exception("Scheduled task %s has invalid inputs and was disabled", name)
                    continue
                self._add_to_scheduler(name)

    def stop(self):
        """Stop the scheduler"""
        if self._scheduler.running:
            self._scheduler.shutdown()


# Global singleton instance
task_registry = TaskRegistry()
