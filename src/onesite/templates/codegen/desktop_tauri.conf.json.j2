{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": {{ config.project_name | tojson }},
  "version": {{ desktop.version | tojson }},
  "identifier": {{ desktop.identifier | tojson }},
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": {{ config.project_name | tojson }},
        "width": {{ desktop.width }},
        "height": {{ desktop.height }},
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
