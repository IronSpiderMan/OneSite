from datetime import datetime, timezone
from typing import Optional

from sqlmodel import Field, SQLModel


class AppLog(SQLModel, table=True):
    __tablename__ = "app_log"

    __onesite__ = {
        "permissions": {
            "developer": "r",
            "admin": "r",
            "user": "",
        },
        "visible": ["admin", "developer"],
        "icon": "Terminal",
        "translations": {
            "zh": {"name": "应用日志", "fields": {
                "level": "级别", "message": "消息", "source": "来源",
                "created_at": "时间", "user_id": "用户",
            }},
            "en": {"name": "App Log", "fields": {
                "level": "Level", "message": "Message", "source": "Source",
                "created_at": "Time", "user_id": "User",
            }},
        },
    }

    id: Optional[int] = Field(default=None, primary_key=True)
    level: str = Field(
        sa_column_kwargs={"info": {"site_props": {"is_search_field": True}}}
    )
    message: str
    source: str = Field(
        default="",
        sa_column_kwargs={"info": {"site_props": {"is_search_field": True}}}
    )
    created_at: datetime = Field(
        default_factory=lambda: datetime.now(timezone.utc)
    )
    user_id: Optional[int] = Field(default=None, foreign_key="user.id")
