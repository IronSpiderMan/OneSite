import React, { useEffect, useState } from 'react';
import { ArrowLeft, Loader2, Save } from 'lucide-react';
import { useForm, Controller } from 'react-hook-form';
import { useNavigate } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import { toast } from 'sonner';
import { getErrorMessage } from '../../utils/request';
import { use{{ model.name }}Store } from '../../stores/use{{ model.name }}Store';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { JsonInput } from '../../components/ui/json-input';
import { JsonModelEditor, JsonModelArrayEditor, JsonModelTableEditor, JsonScalarArrayEditor, validateJsonModelValue, validateJsonModelCollectionValue } from '../../components/ui/json-model-editor';
import { Card, CardContent, CardHeader, CardTitle } from '../../components/ui/card';
import { Label } from '../../components/ui/label';
import { Switch } from '../../components/ui/switch';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../components/ui/select';
import { ImageUpload } from '../../components/ui/image-upload';
import { ImagesUpload } from '../../components/ui/images-upload';
import { FileUpload } from '../../components/ui/file-upload';
import { VideoStreamInput } from '../../components/ui/video-stream-input';
import { SearchableSelect } from '../../components/ui/searchable-select';
import { LinkTableOrderedSelect } from '../../components/ui/link-table-ordered-select';
import { TimePicker } from '../../components/ui/time-picker';
import { LocationInput } from '../../components/ui/location-input';
{% if model.dict_key_reference_meta %}
import {
{% for reference in model.dict_key_reference_meta %}
  get{{ model.name }}{{ reference.field|replace('_', ' ')|title|replace(' ', '') }}KeyOptions,
{% endfor %}
} from '../../services/{{ model.module_name }}';
{% endif %}
{% for fk in model.foreign_keys %}
import { get{{ fk.target_model }}s } from '../../services/{{ fk.target_service }}';
{% endfor %}
{% for field in model.fields %}
{% if field.composite_selector %}
import * as {{ field.name|replace('_', ' ')|title|replace(' ', '') }}CompositeOptionService from '../../services/{{ field.composite_selector.target_service }}';
{% endif %}
{% endfor %}
{% if model.m2m_fields %}
{% for m2m in model.m2m_fields %}
import { get{{ m2m.target_model }}s } from '../../services/{{ m2m.target_service }}';
{% if m2m.editor == 'inline' %}
{% for field in m2m.inline_schema.fields %}
{% if field.foreignKey %}
import * as {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService from '../../services/{{ field.foreignKey.targetService }}';
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% for rfk in model.reverse_foreign_keys %}
{% if rfk.editor == 'inline' %}
{% for field in rfk.inline_schema.fields %}
{% if field.foreignKey %}
import * as {{ rfk.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService from '../../services/{{ field.foreignKey.targetService }}';
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

const Create{{ model.name }}Page: React.FC = () => {
  const { t } = useTranslation();
  const navigate = useNavigate();
  const { createItem } = use{{ model.name }}Store();
  const [submitting, setSubmitting] = useState(false);

  // Role-based permissions
  const userRole = (localStorage.getItem('user_role') || 'user') as 'user' | 'admin' | 'developer';
  const rolePermissions: Record<string, string> = {{ model.role_permissions | tojson }};
  const userPerms = rolePermissions[userRole] || '';

  // Field-level role-based permissions (Layer 2)
  const fieldRolePerms: Record<string, Record<string, string>> = {
  {% for field in model.fields %}
  {% if field.role_permissions %}
    "{{ field.name }}": {{ field.role_permissions | tojson }},
  {% endif %}
  {% endfor %}
  };
  const hasFieldPerm = (fieldName: string, perm: 'c' | 'r' | 'u') => {
    const fp = fieldRolePerms[fieldName];
    if (!fp) return true;
    return (fp[userRole] || '').includes(perm);
  };

  {% for field in model.fields %}
  {% if field.fk_info %}
  const [{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels, set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels] = useState<Record<string, string>>({});
  {% endif %}
  {% endfor %}
  {% if model.m2m_fields %}
  {% for m2m in model.m2m_fields %}
  const [{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels, set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels] = useState<Record<string, string>>({});
  {% endfor %}
  {% endif %}

  const { register, handleSubmit, reset, setValue, control, watch } = useForm();
  const rootValue = watch();

  const onSubmit = async (values: any) => {
    setSubmitting(true);
    try {
      await createItem(values);
      toast.success(t('toast.create_success', 'Created'));
      navigate('/{{ model.module_name }}s');
    } catch (error) {
      toast.error(getErrorMessage(error, t('toast.save_failed', 'Save failed')));
      console.error(error);
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div
      className="{{ page_shell_class | default('space-y-6') }}"
      data-codegen-theme="{{ codegen_theme | default('normal') }}"
      data-page-kind="create"
    >
      <div className="flex flex-wrap items-center justify-between gap-3" data-page-region="page-header">
        <div className="flex min-w-0 items-center gap-4">
          <Button variant="ghost" size="icon" onClick={() => navigate('/{{ model.module_name }}s')}>
            <ArrowLeft className="h-4 w-4" />
          </Button>
          <h1 className="text-3xl font-bold tracking-tight">{t('common.create')} {t('models.{{ model.module_name }}.name')}</h1>
        </div>

        <div className="flex min-w-0 flex-wrap items-center justify-end gap-3" data-page-region="page-controls">
          <Button variant="outline" type="button" onClick={() => navigate('/{{ model.module_name }}s')}>
            {t('common.cancel')}
          </Button>
          <Button type="submit" form="create-form" disabled={submitting}>
            {submitting ? (
              <><Loader2 className="mr-2 h-4 w-4 animate-spin" /> {t('common.saving', 'Saving...')}</>
            ) : (
              <><Save className="mr-2 h-4 w-4" /> {t('common.save')}</>
            )}
          </Button>
        </div>
      </div>

      <form id="create-form" onSubmit={handleSubmit(onSubmit)} className="space-y-4" data-page-region="create-form">
            {% macro create_field(field) -%}
            hasFieldPerm('{{ field.name }}', 'c'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
            <div className="space-y-2">
              <Label htmlFor="{{ field.name }}">{t('{{ field.label_key }}')}{ {{ 'true' if field.required and not field.create_optional else 'false' }} && <span className="text-destructive"> *</span>}</Label>
              {% if field.ui_type == 'bool' %}
              <div className="flex items-center space-x-2">
                <Controller
                  control={control}
                  name="{{ field.name }}"
                  defaultValue={ {{ 'true' if field.default else 'false' }} }
                  render={({ field: { onChange, value } }) => (
                    <Switch checked={value} onCheckedChange={onChange} id="{{ field.name }}" />
                  )}
                />
                <Label htmlFor="{{ field.name }}" className="font-normal text-muted-foreground">
                  {t('{{ field.label_key }}')}
                </Label>
              </div>
              {% elif field.ui_type == 'image' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <ImageUpload value={value} onChange={onChange} />
                )}
              />
              {% elif field.ui_type == 'images' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <ImagesUpload id="{{ field.name }}" value={Array.isArray(value) ? value : []} onChange={onChange} />
                )}
              />
              {% elif field.ui_type == 'file' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <FileUpload
                    value={value}
                    onChange={onChange}
                    allowDownload={ {{ "true" if field.allow_download else "false" }} }
                  />
                )}
              />
              {% elif field.ui_type == 'video_stream' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <VideoStreamInput value={value} onChange={onChange} protocol="{{ field.stream_protocol }}" />
                )}
              />
              {% elif field.dict_key_reference %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <SearchableSelect
                    value={value}
                    onValueChange={onChange}
                    disabled={!rootValue?.{{ field.dict_key_reference.owner_fk }}}
                    optionsKey={rootValue?.{{ field.dict_key_reference.owner_fk }}}
                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                    searchPlaceholder={`${t('common.search')}...`}
                    loadOptions={async (query) => {
                      const ownerId = rootValue?.{{ field.dict_key_reference.owner_fk }};
                      if (ownerId === undefined || ownerId === null || ownerId === '') return [];
                      const options = await get{{ model.name }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}KeyOptions(ownerId);
                      const normalizedQuery = query.trim().toLocaleLowerCase();
                      return options.filter((option) => !normalizedQuery
                        || option.label.toLocaleLowerCase().includes(normalizedQuery)
                        || option.value.toLocaleLowerCase().includes(normalizedQuery));
                    }}
                  />
                )}
              />
              {% elif field.composite_selector %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <SearchableSelect
                    value={value}
                    onValueChange={onChange}
                    disabled={!watch('{{ field.composite_selector.parent_field }}')}
                    optionsKey={watch('{{ field.composite_selector.parent_field }}')}
                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                    searchPlaceholder={`${t('common.search')}...`}
                    loadOptions={async (query) => {
                      const parentValue = watch('{{ field.composite_selector.parent_field }}');
                      if (parentValue === undefined || parentValue === null || parentValue === '') return [];
                      const filters = { '{{ field.composite_selector.filter_field }}': parentValue, ...(query ? { '{{ field.composite_selector.label_field }}': query } : {}) };
                      const response = await {{ field.name|replace('_', ' ')|title|replace(' ', '') }}CompositeOptionService.get{{ field.composite_selector.target_model }}s(1, 20, filters);
                      return response.items.map((item: any) => ({
                        label: item.{{ field.composite_selector.label_field }} ?? item.{{ field.composite_selector.value_field }},
                        value: item.{{ field.composite_selector.value_field }},
                      }));
                    }}
                  />
                )}
              />
              {% elif field.is_enum and field.is_multi_select %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <SearchableSelect
                    value={value || []}
                    onValueChange={onChange}
                    multiple={true}
                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                    searchPlaceholder={`${t('common.search')}...`}
                    loadOptions={async () => {{ field.enum_values | tojson }}.map((v: string) => ({
                      label: t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v),
                      value: v,
                    }))}
                  />
                )}
              />
              {% elif field.is_enum %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => {
                  {% if model.module_name == "user" and model.name == "User" and field.name == "role" %}
                  const filteredValues = userRole === 'developer'
                    ? {{ field.enum_values | tojson }}
                    : ({{ field.enum_values | tojson }} as string[]).filter(v => v !== 'developer');
                  {% else %}
                  const filteredValues = {{ field.enum_values | tojson }};
                  {% endif %}
                  return (
                    <Select onValueChange={onChange} defaultValue={value}>
                      <SelectTrigger>
                        <SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
                      </SelectTrigger>
                      <SelectContent>
                        {filteredValues.map((enumVal: string) => (
                          <SelectItem key={enumVal} value={enumVal}>{t(`models.{{ model.module_name }}.enums.{{ field.name }}.${enumVal}`, enumVal)}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  );
                }}
              />
              {% elif field.fk_info %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <SearchableSelect
                    value={value}
                    onValueChange={(nextValue) => {
                      onChange(nextValue);
                      {% for cascade_fk in model.foreign_keys %}
                      {% if cascade_fk.cascade_parent_field == field.name %}
                      setValue('{{ cascade_fk.name }}', '');
                      {% endif %}
                      {% endfor %}
                      {% for dependent_field in model.fields %}
                      {% if dependent_field.composite_selector and dependent_field.composite_selector.parent_field == field.name %}
                      setValue('{{ dependent_field.name }}', '');
                      {% endif %}
                      {% endfor %}
                      {% for reference in model.dict_key_reference_meta %}
                      {% if reference.owner_fk == field.name %}
                      setValue('{{ reference.field }}', '');
                      {% endif %}
                      {% endfor %}
                    }}
                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                    searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
                    valueLabels={ {{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                    {% if field.fk_info.cascade_parent_field %}
                    disabled={!watch('{{ field.fk_info.cascade_parent_field }}')}
                    optionsKey={watch('{{ field.fk_info.cascade_parent_field }}')}
                    {% endif %}
                    loadOptions={async (query) => {
                      {% if field.fk_info.cascade_parent_field %}
                      const parentId = watch('{{ field.fk_info.cascade_parent_field }}');
                      if (parentId === undefined || parentId === null || parentId === '') return [];
                      const filters = { '{{ field.fk_info.cascade_filter_field }}': parentId, ...(query ? { {{ field.fk_info.label_field }}: query } : {}) };
                      {% else %}
                      const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                      {% endif %}
                      const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                      return response.items.map((item: any) => ({
                        label: item.{{ field.fk_info.label_field }} || item.id,
                        value: item.id,
                      }));
                    }}
                  />
                )}
              />
              {% elif field.ui_type == 'time' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                  <TimePicker
                    value={value}
                    onChange={onChange}
                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                  />
                )}
              />
              {% elif field.ui_type == 'location' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                defaultValue={null}
                render={({ field: { onChange, value } }) => (
                  <LocationInput value={value} onChange={onChange} />
                )}
              />
              {% elif field.ui_type == 'json' %}
              <Controller
                control={control}
                name="{{ field.name }}"
                defaultValue={ {% if field.json_kind == 'array' %}[]{% else %}{}{% endif %} }
                rules={ {
                  required: {{ 'true' if field.required and not field.create_optional else 'false' }},
                  {% if field.json_model_schema %}validate: (value) => validateJsonModelValue({{ field.json_model_schema | tojson }}, value, rootValue),{% elif field.json_item_schema %}validate: (value) => validateJsonModelCollectionValue({{ field.json_item_schema | tojson }}, value, rootValue),{% endif %}
                } }
                render={({ field: { onChange, value } }) => (
                  {% if field.json_model_schema %}
                  <JsonModelEditor
                    schema={ {{ field.json_model_schema | tojson }} }
                    value={value}
                    onChange={onChange}
                    rootValue={rootValue}
                  />
                  {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
                  <JsonModelTableEditor
                    collectionKind="dict"
                    itemSchema={ {{ field.json_item_schema | tojson }} }
                    value={value}
                    onChange={onChange}
                    rootValue={rootValue}
                    {% if field.json_fixed_keys %}
                    fixedKeys={ {{ field.json_fixed_keys | tojson }} }
                    {% endif %}
                    {% if field.json_lock_keys %}
                    lockKeys
                    {% endif %}
                  />
                  {% elif field.json_item_kind %}
                  <JsonScalarArrayEditor itemKind="{{ field.json_item_kind }}" value={value} onChange={onChange} />
                  {% elif field.json_item_schema %}
                  <JsonModelArrayEditor
                    itemSchema={ {{ field.json_item_schema | tojson }} }
                    value={value}
                    onChange={onChange}
                    rootValue={rootValue}
                    {% if model.definition_binding_meta and field.name == model.definition_binding_meta.config_field %}
                    canAdd={ {{ 'true' if model.definition_binding_meta.key_policy == 'free' else 'false' }} }
                    canRemove={ {{ 'false' if model.definition_binding_meta.key_policy == 'definition' else 'true' }} }
                    {% endif %}
                  />
                  {% else %}
                  <JsonInput
                    value={value}
                    onChange={onChange}
                    jsonKind="{{ field.json_kind or 'object' }}"
                    placeholder={ {% if field.json_kind == 'array' %}"[\\n  \\n]"{% else %}"{\\n  \\n}"{% endif %} }
                  />
                  {% endif %}
                )}
              />
              {% else %}
              <Input
                id="{{ field.name }}"
                {% if field.ui_type == 'int' or field.ui_type == 'float' %}
                type="number"
                {% if field.minimum is not none %}min={ {{ field.minimum }} }{% endif %}
                {% if field.maximum is not none %}max={ {{ field.maximum }} }{% endif %}
                {% elif field.ui_type == 'datetime' %}
                type="datetime-local"
                {% elif field.ui_type == 'date' %}
                type="date"
                {% if field.default_factory == 'date' %}
                defaultValue={new Date().toLocaleDateString('en-CA')}
                {% endif %}
                {% else %}
                type="text"
                {% endif %}
                {...register('{{ field.name }}', {
                  required: {{ 'true' if field.required and not field.create_optional else 'false' }},
                  {% if field.minimum is not none %}min: {{ field.minimum }},{% endif %}
                  {% if field.maximum is not none %}max: {{ field.maximum }},{% endif %}
                })}
              />
              {% endif %}
            </div>
            )
            {%- endmacro %}
            {(() => {
              const createLayout = {{ model.create_layout | default(model.form_layout) | default([]) | tojson }} as any[];
              const rowClasses: Record<number, string> = {
                1: 'grid grid-cols-1 gap-4',
                2: 'grid grid-cols-1 gap-4 md:grid-cols-2',
                3: 'grid grid-cols-1 gap-4 md:grid-cols-3',
                4: 'grid grid-cols-1 gap-4 md:grid-cols-4',
              };
              const spanClasses: Record<number, string> = {
                1: '',
                2: 'md:col-span-2',
                3: 'md:col-span-3',
                4: 'md:col-span-4',
              };
              const renderCreateField = (fieldName: string): React.ReactNode => {
                switch (fieldName) {
                  {% for field in model.fields %}
                  case '{{ field.name }}':
                    return ({{ create_field(field) }});
                  {% endfor %}
                  default:
                    return null;
                }
              };
              const renderFormLayoutNode = (node: any, key: string): React.ReactNode => {
                if (node.kind === 'field') {
                  const content = renderCreateField(node.field);
                  return content ? <div key={key} className={`min-w-0 ${spanClasses[node.span] || ''}`}>{content}</div> : null;
                }
                if (node.kind === 'row') {
                  const items = node.items
                    .map((item: any, index: number) => renderFormLayoutNode(item, `${key}-${index}`))
                    .filter(Boolean);
                  if (!items.length) return null;
                  return <div key={key} className={rowClasses[node.columns] || rowClasses[1]}>{items}</div>;
                }
                if (node.kind === 'section') {
                  const items = node.items
                    .map((item: any, index: number) => renderFormLayoutNode(item, `${key}-${index}`))
                    .filter(Boolean);
                  if (!items.length) return null;
                  return (
                    <Card key={key} className={spanClasses[node.span] || ''}>
                      <CardHeader><CardTitle>{node.title}</CardTitle></CardHeader>
                      <CardContent className="space-y-4">{items}</CardContent>
                    </Card>
                  );
                }
                return null;
              };
              return createLayout.map((node, index) => renderFormLayoutNode(node, `create-layout-${index}`));
            })()}

            {% if model.m2m_fields %}
            {% for m2m in model.m2m_fields %}
            <div className="space-y-2">
              <Label>{t('models.{{ m2m.target_service }}.plural')}</Label>
              <Controller
                control={control}
                name="{{ m2m.write_name }}"
                defaultValue={[]}
                render={({ field: { onChange, value } }) => (
                  {% if m2m.editor == 'inline' %}
                  <JsonModelArrayEditor
                    itemSchema={ {{ m2m.inline_schema | tojson }} }
                    value={value}
                    onChange={onChange}
                    foreignKeyLoaders={{ '{{' }}
                      {% for field in m2m.inline_schema.fields %}
                      {% if field.foreignKey %}
                      '{{ field.name }}': async (query) => {
                        const filters = query ? { {{ field.foreignKey.labelField }}: query } : undefined;
                        const response = await {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService.get{{ field.foreignKey.targetModel }}s(1, 20, filters);
                        return response.items.map((item: any) => ({ label: item.{{ field.foreignKey.labelField }} || item.id, value: item.id }));
                      },
                      {% endif %}
                      {% endfor %}
                    {{ '}}' }}
                  />
                  {% elif m2m.order_field %}
                  <LinkTableOrderedSelect
                    value={value}
                    onValueChange={onChange}
                    placeholder={`${t('common.select')} ${t('models.{{ m2m.target_service }}.name')}s`}
                    searchPlaceholder={`${t('common.search')} ${t('models.{{ m2m.target_service }}.name')}...`}
                    valueLabels={ {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                    loadOptions={async (query) => {
                      const filters = query ? { {{ m2m.label_field }}: query } : undefined;
                      const response = await get{{ m2m.target_model }}s(1, 20, filters);
                      return response.items.map((item: any) => ({
                        label: item.{{ m2m.label_field }} || item.id,
                        value: item.id,
                      }));
                    }}
                  />
                  {% else %}
                  <SearchableSelect
                    value={value}
                    onValueChange={onChange}
                    multiple={true}
                    placeholder={`${t('common.select')} ${t('models.{{ m2m.target_service }}.name')}s`}
                    searchPlaceholder={`${t('common.search')} ${t('models.{{ m2m.target_service }}.name')}...`}
                    valueLabels={ {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                    loadOptions={async (query) => {
                      const filters = query ? { {{ m2m.label_field }}: query } : undefined;
                      const response = await get{{ m2m.target_model }}s(1, 20, filters);
                      return response.items.map((item: any) => ({
                        label: item.{{ m2m.label_field }} || item.id,
                        value: item.id,
                      }));
                    }}
                  />
                  {% endif %}
                )}
              />
            </div>
            {% endfor %}
            {% endif %}
            {% for rfk in model.reverse_foreign_keys %}
            {% if rfk.editor == 'inline' %}
            <div className="space-y-2">
              <Label>{t('models.{{ rfk.source_service }}.plural')}</Label>
              <Controller
                control={control}
                name="{{ rfk.write_name }}"
                defaultValue={[]}
                render={({ field: { onChange, value } }) => (
                  <JsonModel{{ 'Table' if rfk.inline_layout == 'table' else 'Array' }}Editor
                    {% if rfk.inline_layout == 'table' %}collectionKind="array"{% endif %}
                    itemSchema={ {{ rfk.inline_schema | tojson }} }
                    value={value}
                    onChange={onChange}
                    foreignKeyLoaders={{ '{{' }}
                      {% for field in rfk.inline_schema.fields %}
                      {% if field.foreignKey %}
                      '{{ field.name }}': async (query) => {
                        const filters = query ? { {{ field.foreignKey.labelField }}: query } : undefined;
                        const response = await {{ rfk.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService.get{{ field.foreignKey.targetModel }}s(1, 20, filters);
                        return response.items.map((item: any) => ({ label: item.{{ field.foreignKey.labelField }} || item.id, value: item.id }));
                      },
                      {% endif %}
                      {% endfor %}
                    {{ '}}' }}
                  />
                )}
              />
            </div>
            {% endif %}
            {% endfor %}

      </form>
    </div>
  );
};

export default Create{{ model.name }}Page;
