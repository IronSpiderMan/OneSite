import React, { useEffect, useMemo, useState } from 'react';
import { AlertCircle, CheckCircle2, Clock3, Download, FileUp, Info, Loader2, Play, Search, ArrowRight, Wrench } from 'lucide-react';
import { Link } from 'react-router-dom';
import type { TFunction } from 'i18next';
import { useTranslation } from 'react-i18next';
import { toast } from 'sonner';

import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Textarea } from '../components/ui/textarea';
import { executeTool, getToolExecution, ToolExecution } from '../services/tools';
import { fieldDefaults, TypedToolFields, ToolResultView, type ToolFieldDefinition } from '../components/tools/ToolFields';

interface ToolInput {
  [key: string]: unknown;
  name: string;
  type: string;
  label: string;
  required?: boolean;
  default?: unknown;
  placeholder?: string;
  help?: string;
  min?: number;
  max?: number;
  step?: number;
  accept?: string[];
  options?: Array<string | number | boolean | { label: string; value: string | number | boolean }>;
}

interface ToolDefinition {
  [key: string]: unknown;
  name: string;
  title: string;
  description?: string;
  permissions: string[];
  inputs: ToolInput[];
  class_path?: string;
  result?: { type?: string; fields?: ToolFieldDefinition[] };
  result_ui?: { renderer?: string; field?: string | null };
}

const TOOL_DEFINITIONS: ToolDefinition[] = {{ tools | tojson }};
const TERMINAL = new Set(['succeeded', 'failed']);

const executionStyle = (status: string) => {
  if (status === 'succeeded') return { label: 'text-emerald-700 dark:text-emerald-400', surface: 'border-emerald-500/20 bg-emerald-500/5', Icon: CheckCircle2 };
  if (status === 'failed') return { label: 'text-destructive', surface: 'border-destructive/20 bg-destructive/5', Icon: AlertCircle };
  return { label: 'text-amber-700 dark:text-amber-400', surface: 'border-amber-500/20 bg-amber-500/5', Icon: Clock3 };
};

const optionValue = (option: NonNullable<ToolInput['options']>[number]): string =>
  typeof option === 'object' ? String(option.value) : String(option);
const optionLabel = (option: NonNullable<ToolInput['options']>[number]): string =>
  typeof option === 'object' ? option.label : String(option);

const initialValues = (tool: ToolDefinition): Record<string, unknown> =>
  tool.class_path ? fieldDefaults(tool.inputs) : Object.fromEntries(tool.inputs.map((input) => [
    input.name,
    input.default ?? (input.type === 'bool' ? false : input.type === 'multi_select' || input.type === 'files' ? [] : ''),
  ]));

const selectedFilesLabel = (value: unknown, multiple: boolean, t: TFunction) => {
  const files = multiple ? (value as File[] || []) : value ? [value as File] : [];
  if (files.length === 0) return t('tools.no_file_selected', 'No file selected');
  if (files.length === 1) return files[0].name;
  return t('tools.files_selected', '{% raw %}{{count}}{% endraw %} files selected', { count: files.length });
};

const ToolExecutionPanel: React.FC<{ execution: ToolExecution; tool: ToolDefinition; t: TFunction }> = ({ execution, tool, t }) => {
  const { label, surface, Icon } = executionStyle(execution.status);
  const progress = Number.isFinite(execution.progress) ? Math.min(100, Math.max(0, execution.progress)) : 0;
  return (
    <div aria-live="polite" className={`space-y-3 rounded-xl border p-4 ${surface}`}>
      <div className="flex items-center justify-between gap-3 text-sm">
        <span className={`flex items-center gap-2 font-medium ${label}`}><Icon className="h-4 w-4" />{t(`tools.status.${execution.status}`, execution.status)}</span>
        <span className="font-mono text-xs text-muted-foreground">{progress}%</span>
      </div>
      <div role="progressbar" aria-label={t('tools.progress', 'Execution progress')} aria-valuenow={progress} aria-valuemin={0} aria-valuemax={100} className="h-1.5 overflow-hidden rounded-full bg-background/80"><div className="h-full rounded-full bg-primary transition-all duration-500" style={ { width: `${progress}%` } } /></div>
      {execution.message && <p className="break-words text-sm text-muted-foreground">{execution.message}</p>}
      {execution.error && <p className="rounded-md bg-background/60 p-2.5 text-sm text-destructive">{execution.error}</p>}
      {execution.result != null && (tool.class_path
        ? <div className="max-h-96 overflow-auto rounded-lg border bg-background/75 p-3 text-sm"><ToolResultView value={execution.result} fields={tool.result?.fields || []} ui={tool.result_ui} prefix={`tool_definitions.${tool.name}.result`} t={t} /></div>
        : <pre className="max-h-64 overflow-auto rounded-lg border bg-background/75 p-3 whitespace-pre-wrap break-words text-xs leading-5 text-foreground">{typeof execution.result === 'string' ? execution.result : JSON.stringify(execution.result, null, 2)}</pre>)}
      {execution.download_url && <Button className="bg-background/70" type="button" variant="outline" onClick={() => window.open(execution.download_url!, '_blank')}><Download className="mr-2 h-4 w-4" />{t('tools.download', 'Download result')}</Button>}
    </div>
  );
};

const ToolCard: React.FC<{ tool: ToolDefinition }> = ({ tool }) => {
  const { t } = useTranslation();
  const [values, setValues] = useState<Record<string, unknown>>(() => initialValues(tool));
  const [execution, setExecution] = useState<ToolExecution | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const [validationErrors, setValidationErrors] = useState<string[]>([]);

  useEffect(() => {
    const listener = (event: Event) => {
      const next = (event as CustomEvent<ToolExecution>).detail;
      if (next?.task_id === execution?.task_id) setExecution(next);
    };
    window.addEventListener('onesite:tool-status', listener);
    return () => window.removeEventListener('onesite:tool-status', listener);
  }, [execution?.task_id]);

  useEffect(() => {
    if (!execution || TERMINAL.has(execution.status)) return;
    const timer = window.setInterval(async () => {
      try {
        const next = await getToolExecution(execution.task_id);
        setExecution(next);
        if (TERMINAL.has(next.status)) window.clearInterval(timer);
      } catch (error) {
        console.error('Failed to refresh tool execution', error);
      }
    }, 2000);
    return () => window.clearInterval(timer);
  }, [execution?.task_id, execution?.status]);

  const setValue = (name: string, value: unknown) =>
    setValues((previous) => ({ ...previous, [name]: value }));

  const submit = async (event: React.FormEvent) => {
    event.preventDefault();
    setValidationErrors([]);
    const form = new FormData();
    if (tool.class_path) {
      const payload: Record<string, unknown> = {};
      for (const input of tool.inputs) {
        const value = values[input.name];
        if (input.type === 'file' && value instanceof File) form.append(input.name, value);
        else if (input.type === 'files' && Array.isArray(value) && value.some((item) => item instanceof File)) {
          for (const file of value as File[]) form.append(input.name, file);
        } else if (value !== undefined) payload[input.name] = value;
      }
      form.append('__inputs__', JSON.stringify(payload));
    } else {
    for (const input of tool.inputs) {
      const value = values[input.name];
      if (input.type === 'files') {
        for (const file of (value as File[]) || []) form.append(input.name, file);
      } else if (input.type === 'file') {
        if (value instanceof File) form.append(input.name, value);
      } else if (input.type === 'multi_select') {
        for (const item of (value as string[]) || []) form.append(input.name, item);
      } else if (input.type === 'json') {
        if (value !== '' && value != null) form.append(input.name, typeof value === 'string' ? value : JSON.stringify(value));
      } else if (value !== '' && value != null) {
        form.append(input.name, String(value));
      }
    }
    }
    try {
      setSubmitting(true);
      const next = await executeTool(tool.name, form);
      setExecution(next);
      toast.success(t('tools.queued', 'Tool queued'));
    } catch (error: any) {
      const detail = error?.response?.data?.detail;
      const messages = Array.isArray(detail) ? detail.map((item) => `${(item.loc || []).join('.')}: ${item.msg || ''}`) : [];
      setValidationErrors(messages);
      toast.error(messages[0] || (typeof detail === 'string' ? detail : t('tools.submit_failed', 'Failed to start tool')));
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <form onSubmit={submit} className="flex min-w-0 flex-col overflow-hidden rounded-xl border bg-card text-card-foreground shadow-sm transition-colors focus-within:border-primary/40">
      <div className="flex flex-1 flex-col gap-6 p-5 sm:p-6">
      <div className="flex items-start gap-3.5">
        <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/15 bg-primary/10 text-primary shadow-sm"><Wrench className="h-5 w-5" /></div>
        <div className="min-w-0 flex-1 pt-0.5">
          <div className="flex items-start justify-between gap-3"><h2 className="break-words text-base font-semibold leading-6 tracking-tight">{tool.title}</h2><span className="shrink-0 rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">{tool.inputs.length} {t('tools.inputs', 'inputs')}</span></div>
          {tool.description && <p className="mt-1.5 text-sm leading-5 text-muted-foreground">{tool.description}</p>}
        </div>
      </div>

      {tool.class_path ? <TypedToolFields fields={tool.inputs} values={values} onChange={setValues} t={t} prefix={`tool_definitions.${tool.name}.inputs`} id={tool.name} /> : tool.inputs.length > 0 && <div className="grid gap-5 sm:grid-cols-2">
        {tool.inputs.map((input) => (
          <div key={input.name} className={input.type === 'text' || input.type === 'json' || input.type === 'files' || input.type === 'file' ? 'sm:col-span-2 space-y-2' : 'space-y-2'}>
            <Label className="text-sm font-medium" htmlFor={`${tool.name}-${input.name}`}>
              {input.label || input.name}{input.required && <span className="text-destructive"> *</span>}
            </Label>
            {input.type === 'text' || input.type === 'json' ? (
              <Textarea
                className={input.type === 'json' ? 'min-h-28 font-mono text-xs' : 'min-h-28'}
                id={`${tool.name}-${input.name}`}
                required={input.required}
                placeholder={input.placeholder}
                value={String(values[input.name] ?? '')}
                onChange={(event) => setValue(input.name, event.target.value)}
              />
            ) : input.type === 'select' ? (
              <select
                id={`${tool.name}-${input.name}`}
                required={input.required}
                className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                value={String(values[input.name] ?? '')}
                onChange={(event) => setValue(input.name, event.target.value)}
              >
                <option value="">{input.placeholder || t('common.select', 'Select')}</option>
                {(input.options || []).map((option) => <option key={optionValue(option)} value={optionValue(option)}>{optionLabel(option)}</option>)}
              </select>
            ) : input.type === 'multi_select' ? (
              <select
                id={`${tool.name}-${input.name}`}
                multiple
                required={input.required}
                className="min-h-24 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                value={(values[input.name] as string[]) || []}
                onChange={(event) => setValue(input.name, Array.from(event.target.selectedOptions, (option) => option.value))}
              >
                {(input.options || []).map((option) => <option key={optionValue(option)} value={optionValue(option)}>{optionLabel(option)}</option>)}
              </select>
            ) : input.type === 'bool' ? (
              <label className="flex h-10 items-center gap-2 rounded-md border border-input bg-muted/20 px-3 text-sm transition-colors hover:bg-muted/40">
                <input id={`${tool.name}-${input.name}`} className="h-4 w-4 accent-primary" type="checkbox" checked={Boolean(values[input.name])} onChange={(event) => setValue(input.name, event.target.checked)} />
                <span className="text-sm text-muted-foreground">{input.help || input.label}</span>
              </label>
            ) : input.type === 'file' || input.type === 'files' ? (
              <div className="rounded-lg border border-dashed border-input bg-muted/20 p-3 transition-colors hover:border-primary/50 hover:bg-primary/[0.03]">
                <div className="mb-2 flex items-center gap-2 text-xs text-muted-foreground"><FileUp className="h-4 w-4 text-primary" /><span>{input.accept?.join(', ') || t('tools.any_file', 'Any file type')}</span></div>
                <Input
                  id={`${tool.name}-${input.name}`}
                  className="border-0 bg-transparent px-0 shadow-none file:mr-3 file:rounded-md file:border-0 file:bg-primary/10 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-primary hover:file:bg-primary/15"
                  type="file"
                  required={input.required}
                  multiple={input.type === 'files'}
                  accept={(input.accept || []).join(',') || undefined}
                  onChange={(event) => setValue(input.name, input.type === 'files' ? Array.from(event.target.files || []) : event.target.files?.[0] || null)}
                />
                <p className="mt-2 break-all text-xs text-muted-foreground">{selectedFilesLabel(values[input.name], input.type === 'files', t)}</p>
              </div>
            ) : (
              <Input
                id={`${tool.name}-${input.name}`}
                type={input.type === 'number' ? 'number' : input.type === 'date' ? 'date' : input.type === 'datetime' ? 'datetime-local' : 'text'}
                required={input.required}
                placeholder={input.placeholder}
                min={input.min}
                max={input.max}
                step={input.step}
                value={String(values[input.name] ?? '')}
                onChange={(event) => setValue(input.name, event.target.value)}
              />
            )}
            {input.help && input.type !== 'bool' && <p className="flex items-center gap-1.5 text-xs leading-4 text-muted-foreground"><Info className="h-3.5 w-3.5 shrink-0" />{input.help}</p>}
          </div>
        ))}
      </div>}

      {validationErrors.length > 0 && <ul role="alert" className="space-y-1 text-sm text-destructive">{validationErrors.map((message, index) => <li key={index}>{message}</li>)}</ul>}
      {execution && <ToolExecutionPanel execution={execution} tool={tool} t={t} />}
      </div>
      <div className="flex flex-wrap items-center justify-between gap-3 border-t bg-muted/20 px-5 py-4 sm:px-6">
        <span className="flex min-w-0 items-center gap-1.5 text-xs text-muted-foreground">
          <Clock3 className="h-3.5 w-3.5 shrink-0" />{t('tools.background', 'Runs in the background')}
        </span>
        <Button className="min-w-28" type="submit" disabled={submitting || (!!execution && !TERMINAL.has(execution.status))}>
          {submitting || (!!execution && !TERMINAL.has(execution.status)) ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : <Play className="mr-2 h-4 w-4" />}
          {submitting || (!!execution && !TERMINAL.has(execution.status)) ? t('tools.status.running', 'Running') : t(`tool_definitions.${tool.name}.execute_label`, t('tools.execute', 'Execute'))}
        </Button>
      </div>
    </form>
  );
};

const ToolsPage: React.FC = () => {
  const { t } = useTranslation();
  const [search, setSearch] = useState('');
  const role = localStorage.getItem('user_role') || 'user';
  const tools = useMemo(() => TOOL_DEFINITIONS.filter((tool) => tool.permissions.includes(role)).map((tool) => ({
    ...tool,
    title: t(`tool_definitions.${tool.name}.title`, tool.title),
    description: t(`tool_definitions.${tool.name}.description`, tool.description || ''),
  })), [role, t]);
  const query = search.trim().toLocaleLowerCase();
  const matchingTools = tools.filter((tool) => `${tool.title} ${tool.description || ''} ${tool.name}`.toLocaleLowerCase().includes(query));
  return (
    <div className="mx-auto w-full max-w-[1600px] space-y-6">
      <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <div className="flex items-center gap-3">
            <h1 className="text-3xl font-bold tracking-tight">{t('tools.title', 'Tools')}</h1>
            <span className="rounded-full border bg-muted/50 px-2.5 py-0.5 text-xs font-medium tabular-nums text-muted-foreground">{tools.length} {t('tools.available', 'available')}</span>
          </div>
          <p className="mt-2 text-sm text-muted-foreground">{t('tools.subtitle', 'Run workspace utilities and track their progress')}</p>
        </div>
        <Link to="/task-center" className="inline-flex h-10 shrink-0 items-center justify-center self-start rounded-md border border-input bg-background px-4 py-2 text-sm font-medium transition-colors hover:bg-accent/50 hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
          {t('menu.task_center', 'Task Center')}<ArrowRight className="ml-2 h-4 w-4" />
        </Link>
      </div>

      {tools.length > 0 && <div className="flex flex-col gap-3 rounded-xl border bg-card p-4 sm:flex-row sm:items-center sm:justify-between">
        <div className="flex items-center gap-2 text-sm text-muted-foreground"><Wrench className="h-4 w-4 text-primary" />{t('tools.choose', 'Choose a tool to get started')}</div>
        <div className="relative w-full sm:max-w-xs">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <Input type="search" className="pl-9" aria-label={t('tools.search', 'Search tools')} placeholder={t('tools.search', 'Search tools')} value={search} onChange={(event) => setSearch(event.target.value)} />
        </div>
      </div>}

      <div className="grid items-start gap-5 xl:grid-cols-2">
        {tools.map((tool) => <div key={tool.name} className={matchingTools.includes(tool) ? 'min-w-0' : 'hidden'}><ToolCard tool={tool} /></div>)}
      </div>
      {matchingTools.length === 0 && <div role="status" className="flex flex-col items-center rounded-xl border border-dashed bg-card px-6 py-16 text-center">
        <div className="mb-4 rounded-full bg-muted p-4"><Wrench className="h-6 w-6 text-muted-foreground" /></div>
        <h2 className="font-semibold">{tools.length === 0 ? t('tools.empty', 'No tools available') : t('tools.no_matches', 'No matching tools')}</h2>
        <p className="mt-2 max-w-sm text-sm text-muted-foreground">{tools.length === 0 ? t('tools.empty_hint', 'Tools available to your role will appear here.') : t('tools.search_hint', 'Try a different name or keyword.')}</p>
        {search && <Button variant="outline" className="mt-5" onClick={() => setSearch('')}>{t('tools.clear_search', 'Clear search')}</Button>}
      </div>}
    </div>
  );
};

export default ToolsPage;
