    async def get_filter_options(
        self,
        session: AsyncSession,
        *,
        filter_name: str,
    ) -> list[dict]:
        """Get available filter options for visualize filters."""
        from sqlalchemy import text

        resolved_filters = {{ model.visualize.resolved_filters }}
        flt = next((f for f in resolved_filters if f["name"] == filter_name), None)
        if not flt:
            return []

        {% for rf in model.visualize.resolved_filters %}
        if filter_name == "{{ rf.name }}":
            {% if rf.filter_type == "enum" %}
            # Enum filter: return static values from field definition
            return [{"id": v, "label": v} for v in {{ rf.enum_values }}]
            {% else %}
            # FK-based filter: query target model through join path
            from app.models.{{ rf.filter_source_module }} import {{ rf.filter_model_class }} as FilterModel
            {% for join in rf.joins %}
            from app.models.{{ join.source_module }} import {{ join.model_name }}
            {% endfor %}

            stmt = select(
                FilterModel.id,
                getattr(FilterModel, "{{ rf.filter_label_field }}")
            )

            {% if rf.joins %}
            # Join through path tables to ensure only reachable options
            from app.models.{{ model.source_module }} import {{ model.name }}
            stmt = stmt.select_from({{ model.name }})
            {% for join in rf.joins %}
            stmt = stmt.join({{ join.model_name }}, text('{{ join.from_col }} = {{ join.to_col }}'))
            {% endfor %}
            # Final join to filter model
            stmt = stmt.join(FilterModel, text('{{ rf.fk_col }} = {{ rf.filter_id_col }}'))
            {% endif %}

            stmt = stmt.distinct().order_by(getattr(FilterModel, "{{ rf.filter_label_field }}"))
            result = await session.exec(stmt)
            return [{"id": row[0], "label": str(row[1])} for row in result.all()]
            {% endif %}
        {% endfor %}

        return []
    {% endif %}
    {% endif %}

