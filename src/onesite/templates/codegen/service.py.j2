    async def create(self, session: AsyncSession, obj_in: {{ model.name }}Create, *, current_user: Any = None) -> {{ model.name }}Read:
        obj = None
        hook_context = ModelHookContext(
            operation="create",
            input_data=obj_in.dict(exclude_none=True),
            changed_fields=frozenset(obj_in.dict(exclude_none=True)),
        )
        {% if model.fields | selectattr('is_unique') | list %}
        # Check unique field constraints
        {% for field in model.fields %}
        {% if field.is_unique and field.name != 'id' %}
        if getattr(obj_in, "{{ field.name }}", None) is not None:
            if not await crud.check_unique_field(session, "{{ field.name }}", obj_in.{{ field.name }}):
                raise ValueError("{{ field.name }} already exists")
        {% endif %}
        {% endfor %}
        {% endif %}
        {% if model.is_notification_table %}
        # If user_id is None, broadcast to all active users
        if getattr(obj_in, "user_id", None) is None:
            from sqlmodel import select
            from app.models.user import User
            
            result = await session.exec(select(User.id).where(User.is_active == True))
            user_ids = result.all()
            
            if not user_ids:
                # No active users, return placeholder
                return await self.to_read({{ model.name }}(
                    title=obj_in.title,
                    summary=obj_in.summary,
                    content=obj_in.content,
                    is_read=False,
                    user_id=0
                ), session, current_user=current_user, source="create")
            
            created_at = datetime.now(timezone.utc)
            created_objects = []

            try:
                for uid in user_ids:
                    obj_data = obj_in.dict()
                    obj_data["user_id"] = uid
                    obj_data["created_at"] = created_at
                    db_obj = {{ model.name }}(**obj_data)
                    await invoke_model_hook(
                        db_obj,
                        "on_before_create",
                        session=session,
                        context=hook_context,
                    )
                    session.add(db_obj)
                    created_objects.append(db_obj)

                await session.flush()

                # Refresh all objects to get their IDs, then run transactional hooks.
                for obj in created_objects:
                    await session.refresh(obj)
                    await invoke_model_hook(
                        obj,
                        "on_after_create",
                        session=session,
                        context=hook_context,
                    )
                await session.flush()
                await session.commit()
            except Exception:
                await session.rollback()
                raise

            for obj in created_objects:
                try:
                    await invoke_model_hook(
                        obj,
                        "on_after_commit_create",
                        context=hook_context,
                    )
                except Exception:
                    logger.exception(
                        "Post-commit create hook failed for {{ model.name }} id=%s",
                        getattr(obj, "id", None),
                    )
            
            # Push notifications to all users
            for obj in created_objects:
                try:
                    payload = {
                        "type": "notification",
                        "data": {
                            "id": obj.id,
                            "title": obj.title,
                            "summary": obj.summary,
                            "created_at": obj.created_at.isoformat() if obj.created_at else None,
                            "is_read": obj.is_read,
                        }
                    }
                    await manager.send_personal_message(payload, obj.user_id)
                except Exception as e:
                    logger.exception("Failed to push notification via WebSocket: %s", e)
            
            # Return the first created object as representative
            return await self.to_read(
                created_objects[0] if created_objects else {{ model.name }}(),
                session, current_user=current_user, source="create",
            )
        {% endif %}
        obj = await crud.create(session, obj_in)

        try:
            await invoke_model_hook(
                obj,
                "on_after_commit_create",
                context=hook_context,
            )
        except Exception:
            logger.exception("Post-commit create hook failed for {{ model.name }} id=%s", getattr(obj, "id", None))

        {% if model.is_notification_table %}
        # Auto-push for notification
        try:
            created_at = getattr(obj, "created_at", None)
            payload = {
                "type": "notification",
                "data": {
                    "id": getattr(obj, "id", None),
                    "title": getattr(obj, "title", ""),
                    "summary": getattr(obj, "summary", ""),
                    "created_at": created_at.isoformat() if created_at else None,
                    "is_read": bool(getattr(obj, "is_read", False)),
                }
            }
            await manager.send_personal_message(payload, obj.user_id)
        except Exception as e:
            logger.exception("Failed to send notification push via WebSocket: %s", e)
        {% endif %}
        return await self.to_read(obj, session, current_user=current_user, source="create")

    async def update(self, session: AsyncSession, id: {{ model.id_type }}, obj_in: {{ model.name }}Update, *, current_user: Any = None) -> {{ model.name }}Read:
        """
        Update {{ model.name }} by ID with validation.
        Raises ValueError if unique constraint is violated.
        Raises NotFoundError if object doesn't exist.
        """
        db_obj = None
        old = None
        changes = obj_in.dict(exclude_unset=True)
        hook_context = ModelHookContext(
            operation="update",
            input_data=dict(changes),
            changed_fields=frozenset(changes),
        )
        db_obj = await crud.get(session, id)
        if not db_obj:
            raise ValueError("{{ model.name }} not found")
        old = snapshot_model(db_obj)
        
        {% if model.fields | selectattr('is_unique') | list %}
        # Check unique field constraints (only for fields being updated)
        {% for field in model.fields %}
        {% if field.is_unique and field.name != 'id' %}
        if getattr(obj_in, "{{ field.name }}", None) is not None and getattr(obj_in, "{{ field.name }}") != getattr(db_obj, "{{ field.name }}"):
            if not await crud.check_unique_field(session, "{{ field.name }}", obj_in.{{ field.name }}, exclude_id=id):
                raise ValueError("{{ field.name }} already exists")
        {% endif %}
        {% endfor %}
        {% endif %}

        obj = await crud.update(session, db_obj, obj_in)

        try:
            await invoke_model_hook(
                obj,
                "on_after_commit_update",
                old=old,
                changes=changes,
                context=hook_context,
            )
        except Exception:
            logger.exception("Post-commit update hook failed for {{ model.name }} id=%s", id)

        {% if model.is_notification_table %}
        # Auto-push read status
        try:
            if getattr(obj, "is_read", False):
                await manager.send_personal_message({"type": "read", "id": obj.id}, obj.user_id)
        except Exception as e:
            logger.exception("Failed to send read status via WebSocket: %s", e)
        {% endif %}
        return await self.to_read(obj, session, current_user=current_user, source="update")

    async def delete(self, session: AsyncSession, id: {{ model.id_type }}) -> {{ model.id_type }}:
        db_obj = None
        old = None
        hook_context = ModelHookContext(operation="delete")
        db_obj = await crud.get(session, id)
        if not db_obj:
            raise ValueError("{{ model.name }} not found")
        old = snapshot_model(db_obj)
        deleted_id = await crud.delete(session, id)

        try:
            await invoke_model_hook(
                db_obj,
                "on_after_commit_delete",
                old=old,
                context=hook_context,
            )
        except Exception:
            logger.exception("Post-commit delete hook failed for {{ model.name }} id=%s", id)
        return deleted_id

    async def bulk_delete(
        self, session: AsyncSession, ids: List[{{ model.id_type }}]
    ) -> int:
        unique_ids = list(dict.fromkeys(ids))
        objects = []
        olds = []
        for id in unique_ids:
            obj = await crud.get(session, id)
            if obj is not None:
                objects.append(obj)
                olds.append(snapshot_model(obj))

        if not objects:
            return 0

        hook_context = ModelHookContext(
            operation="bulk_delete",
            input_data={"ids": unique_ids},
            changed_fields=frozenset(),
        )
        try:
            for obj, old in zip(objects, olds):
                await crud.delete(session, {% if model.uses_composite_identity %}crud.get_identity(obj){% else %}obj.id{% endif %}, auto_commit=False)
            await invoke_model_hook(
                {{ model.name }},
                "on_after_bulk_delete",
                session=session,
                olds=olds,
                context=hook_context,
            )
            await session.flush()
            await session.commit()
        except Exception:
            await session.rollback()
            raise

        for obj, old in zip(objects, olds):
            try:
                await invoke_model_hook(
                    obj,
                    "on_after_commit_delete",
                    old=old,
                    context=ModelHookContext(operation="delete"),
                )
            except Exception:
                logger.exception(
                    "Post-commit delete hook failed for {{ model.name }} id=%s",
                    getattr(obj, "id", None),
                )
        try:
            await invoke_model_hook(
                {{ model.name }},
                "on_after_commit_bulk_delete",
                olds=olds,
                context=hook_context,
            )
        except Exception:
            logger.exception(
                "Post-commit bulk delete hook failed for {{ model.name }} ids=%s",
                unique_ids,
            )
        return len(objects)

