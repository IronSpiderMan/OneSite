    {% if (model.importable and not model.custom_importable) or (model.exportable and not model.custom_exportable) %}
    # Import/Export methods
    {% if model.exportable and not model.custom_exportable %}
    async def export_to_csv(
        self,
        session: AsyncSession,
        *,
        task_id: str,
        user_id: int,
        filters: Optional[dict] = None,
        language: str = "en",
        current_role: str = "developer",
        ws_manager = None,
        progress_callback = None,
    ) -> str:
        """
        Export {{ model.name }} records to CSV.
        Returns the file path of the exported CSV.
        Configured foreign keys are exported through their lookup field and
        configured many-to-many and reverse one-to-many relations are joined
        with semicolons.
        """
        import csv
        import inspect
        from datetime import datetime, time
        from sqlmodel import select

        async def report_progress(progress: int, message: str) -> None:
            if progress_callback is None:
                return
            result = progress_callback(progress, message)
            if inspect.isawaitable(result):
                await result

        await report_progress(5, "preparing_export")
        
        upload_dir = settings.UPLOAD_DIR
        export_dir = os.path.join(upload_dir, "exports")
        os.makedirs(export_dir, exist_ok=True)
        
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"{{ model.module_name }}_export_{timestamp}_{task_id}.csv"
        filepath = os.path.join(export_dir, filename)
        language = "zh" if str(language).lower().startswith("zh") else "en"
        role = str(getattr(current_role, "value", current_role))
        export_column_permissions = {
            {% for column in model.export_fields %}
            "{{ column.column_name }}": {{ column.field.role_permissions | tojson }},
            {% endfor %}
        }
        readable_export_columns = {
            column_name
            for column_name, permissions in export_column_permissions.items()
            if "r" in permissions.get(role, "")
        }

        # Use the same supported filters as the list endpoint.  Exports run in
        # a background task, so date and time values arrive as JSON strings
        # rather than FastAPI-coerced query parameters.
        export_filters = {
            key: value
            for key, value in (filters or {}).items()
            if key in {
                {% for field in model.fields %}
                {% if field.is_search_field %}
                {% if field.ui_type == 'datetime' %}"{{ field.name }}_from", "{{ field.name }}_to",
                {% else %}"{{ field.name }}",
                {% endif %}
                {% endif %}
                {% endfor %}
                {% set search_field_names = model.fields | selectattr('is_search_field') | map(attribute='name') | list %}
                {% for fk in model.foreign_keys %}
                {% if fk.name != model.owner_field and fk.name not in search_field_names %}"{{ fk.name }}",
                {% endif %}
                {% endfor %}
                {% if model.owner_field %}"owner_id",
                {% endif %}
            }
        }
        {% for field in model.fields %}
        {% if field.is_search_field and field.ui_type == 'datetime' %}
        for filter_name in ("{{ field.name }}_from", "{{ field.name }}_to"):
            value = export_filters.get(filter_name)
            if isinstance(value, str) and value:
                export_filters[filter_name] = datetime.fromisoformat(value.replace("Z", "+00:00"))
        {% endif %}
        {% if field.is_search_field and field.ui_type == 'time' %}
        value = export_filters.get("{{ field.name }}")
        if isinstance(value, str) and value:
            export_filters["{{ field.name }}"] = time.fromisoformat(value)
        {% endif %}
        {% endfor %}

        total_items = await crud.count(session, **export_filters)
        processed_items = 0
        # Progress is persisted through an isolated session. End this read
        # transaction first so SQLite does not block the status write.
        await session.rollback()
        await report_progress(10, f"exporting_records:0:{total_items}")

        # Write CSV with UTF-8 BOM for Excel compatibility
        with open(filepath, 'w', newline='', encoding='utf-8-sig') as f:
            writer = csv.writer(f)

            headers = []
            {% for column in model.export_fields %}
            if "{{ column.column_name }}" in readable_export_columns:
                headers.append({{ column.header_labels | tojson }}.get(language, "{{ column.column_name }}"))
            {% endfor %}
            headers.extend([
                {% for m2m in model.export_m2m %}{{ m2m.header_labels | tojson }}.get(language, "{{ m2m.column_name }}"),
                {% endfor %}{% for rfk in model.export_reverse_fks %}{{ rfk.header_labels | tojson }}.get(language, "{{ rfk.column_name }}"),
                {% endfor %}
            ])
            writer.writerow(headers)
            
            {% set export_fks = model.export_fields | selectattr('kind', 'equalto', 'fk') | list %}
            {% if export_fks %}
            # Build FK label caches
            {% for column in export_fks %}
            {{ column.name }}_label_cache = {}
            {% endfor %}
            {% endif %}
            
            # Process in batches
            batch_size = 1000
            page = 1
            
            while True:
                items = await crud.get_multi(
                    session, page=page, size=batch_size, **export_filters
                )
                if not items:
                    await session.rollback()
                    break
                
                {% if export_fks %}
                # Collect unique FK IDs for batch label resolution
                {% for column in export_fks %}
                {{ column.name }}_ids = list(set(
                    getattr(item, "{{ column.name }}") for item in items
                    if getattr(item, "{{ column.name }}") is not None
                    and getattr(item, "{{ column.name }}") not in {{ column.name }}_label_cache
                ))
                {% endfor %}
                
                # Batch fetch FK labels
                {% for column in export_fks %}
                if {{ column.name }}_ids:
                    from app.models.{{ column.fk.target_source_module }} import {{ column.fk.target_model }} as {{ column.name }}_export_model
                    stmt = select({{ column.name }}_export_model).where({{ column.name }}_export_model.id.in_({{ column.name }}_ids))
                    result = await session.exec(stmt)
                    for obj in result.all():
                        {{ column.name }}_label_cache[obj.id] = getattr(obj, "{{ column.lookup_field }}", None)
                {% endfor %}
                {% endif %}

                {% for m2m in model.export_m2m %}
                # Resolve one configured M2M column for the whole batch.
                from app.models.{{ m2m.link_module }} import {{ m2m.link_model }} as {{ m2m.name }}_export_link
                from app.models.{{ m2m.target_source_module }} import {{ m2m.target_model }} as {{ m2m.name }}_export_target
                item_ids = [item.id for item in items]
                stmt = (
                    select(
                        {{ m2m.name }}_export_link.{{ m2m.source_fk_field }},
                        getattr({{ m2m.name }}_export_target, "{{ m2m.lookup_field }}"),
                    )
                    .join(
                        {{ m2m.name }}_export_target,
                        {{ m2m.name }}_export_target.id == {{ m2m.name }}_export_link.{{ m2m.target_fk_field }},
                    )
                    .where({{ m2m.name }}_export_link.{{ m2m.source_fk_field }}.in_(item_ids))
                    {% if m2m.order_field %}.order_by({{ m2m.name }}_export_link.{{ m2m.order_field }}){% endif %}
                )
                result = await session.exec(stmt)
                {{ m2m.name }}_values = {}
                for source_id, value in result.all():
                    {{ m2m.name }}_values.setdefault(source_id, []).append(str(value))
                {% endfor %}

                {% for rfk in model.export_reverse_fks %}
                # Resolve one configured reverse one-to-many column for the batch.
                from app.models.{{ rfk.source_module }} import {{ rfk.source_model }} as {{ rfk.value_cache_name }}_model
                item_ids = [item.id for item in items]
                stmt = (
                    select(
                        {{ rfk.value_cache_name }}_model.{{ rfk.source_fk_field }},
                        getattr({{ rfk.value_cache_name }}_model, "{{ rfk.lookup_field }}"),
                    )
                    .where({{ rfk.value_cache_name }}_model.{{ rfk.source_fk_field }}.in_(item_ids))
                    .order_by({{ rfk.value_cache_name }}_model.id)
                )
                result = await session.exec(stmt)
                {{ rfk.value_cache_name }} = {}
                for parent_id, value in result.all():
                    {{ rfk.value_cache_name }}.setdefault(parent_id, []).append(
                        "" if value is None else str(value)
                    )
                {% endfor %}
                
                for item in items:
                    row = []
                    {% for column in model.export_fields %}
                    {% set field = column.field %}
                    if "{{ column.column_name }}" in readable_export_columns:
                    {% if column.kind == 'fk' %}
                        # FK field - export label instead of ID
                        fk_id = getattr(item, "{{ column.name }}", None)
                        if fk_id is None:
                            row.append("")
                        elif fk_id in {{ column.name }}_label_cache:
                            row.append({{ column.name }}_label_cache[fk_id])
                        else:
                            row.append("")
                    {% else %}
                        val = getattr(item, "{{ column.name }}", None)
                        # Convert to string, handle Enum/datetime specially
                        if val is None:
                            row.append("")
                    {% if field.is_multi_select %}
                        elif isinstance(val, list):
                            # Multi-select enum - export as comma-separated
                            row.append(",".join(str(v) for v in val))
                    {% endif %}
                        elif hasattr(val, 'value'):
                            # Enum type - get the value
                            row.append(str(val.value))
                        elif hasattr(val, 'isoformat'):
                            # datetime type - use ISO format
                            row.append(val.isoformat())
                        else:
                            row.append(str(val))
                    {% endif %}
                    {% endfor %}
                    {% for m2m in model.export_m2m %}
                    row.append(";".join({{ m2m.name }}_values.get(item.id, [])))
                    {% endfor %}
                    {% for rfk in model.export_reverse_fks %}
                    row.append(";".join({{ rfk.value_cache_name }}.get(item.id, [])))
                    {% endfor %}
                    writer.writerow(row)

                processed_items += len(items)
                # All values needed from this batch are materialized above.
                # Release the read transaction before the separate progress write.
                await session.rollback()
                progress = 95 if total_items == 0 else 10 + int(
                    85 * min(processed_items, total_items) / total_items
                )
                await report_progress(
                    progress,
                    f"exporting_records:{processed_items}:{total_items}",
                )
                
                page += 1
                
                if len(items) < batch_size:
                    break
        
        await report_progress(98, "finalizing_export")
        return filepath
    {% endif %}

    {% if model.importable and not model.custom_importable %}
    async def import_from_csv(
        self,
        session: AsyncSession,
        *,
        task_id: str,
        user_id: int,
        file: Any,
        dry_run: bool = False,
        current_role: str = "developer",
        scoped_owner_id: Any = None,
        ws_manager = None,
        progress_callback = None,
    ) -> dict:
        """
        Import {{ model.name }} records from CSV.
        Uses upsert logic: if record with same {{ model.import_key }} exists, update it; otherwise create new.
        Configured FK and M2M values must match existing related objects.
        """
        import asyncio
        import csv
        import io
        import json
        import ast
        import inspect
        from pathlib import Path
        from datetime import datetime
        from sqlmodel import select

        async def report_progress(progress: int, message: str) -> None:
            if progress_callback is None:
                return
            result = progress_callback(progress, message)
            if inspect.isawaitable(result):
                await result

        await report_progress(5, "reading_import_file")
        if isinstance(file, (str, os.PathLike, Path)):
            contents = await asyncio.to_thread(Path(file).read_bytes)
        else:
            contents = await file.read()
        csv_file = io.StringIO(contents.decode('utf-8-sig'))
        reader = csv.DictReader(csv_file)

        rows = list(reader)
        total_rows = len(rows)
        await report_progress(10, f"validating_import:0:{total_rows}")

        stats = {
            "success": 0,
            "failed": 0,
            "created": 0,
            "updated": 0,
            "error_count": 0,
            "errors": [],
            "errors_truncated": False,
        }

        def record_row_error(message: str) -> None:
            stats["failed"] += 1
            stats["error_count"] += 1
            if len(stats["errors"]) < 200:
                stats["errors"].append(str(message)[:4000])
            else:
                stats["errors_truncated"] = True

        import_key = "{{ model.import_key }}"
        role = str(getattr(current_role, "value", current_role))
        import_column_permissions = {
            {% for column in model.import_fields %}
            "{{ column.column_name }}": {{ column.field.role_permissions | tojson }},
            {% endfor %}
        }

        {% set import_fks = model.import_fields | selectattr('kind', 'equalto', 'fk') | list %}
        {% for column in import_fks %}
        from app.models.{{ column.fk.target_source_module }} import {{ column.fk.target_model }} as {{ column.name }}_import_model
        {{ column.name }}_cache = {}
        {{ column.name }}_ambiguous = set()
        result = await session.exec(select({{ column.name }}_import_model))
        for obj in result.all():
            lookup_value = getattr(obj, "{{ column.lookup_field }}", None)
            if lookup_value is None:
                continue
            label = str(lookup_value)
            if label in {{ column.name }}_cache:
                {{ column.name }}_ambiguous.add(label)
            else:
                {{ column.name }}_cache[label] = obj.id
        {% endfor %}

        {% for m2m in model.import_m2m %}
        from app.models.{{ m2m.target_source_module }} import {{ m2m.target_model }} as {{ m2m.name }}_import_target
        {{ m2m.name }}_cache = {}
        {{ m2m.name }}_ambiguous = set()
        result = await session.exec(select({{ m2m.name }}_import_target))
        for obj in result.all():
            lookup_value = getattr(obj, "{{ m2m.lookup_field }}", None)
            if lookup_value is None:
                continue
            label = str(lookup_value)
            if label in {{ m2m.name }}_cache:
                {{ m2m.name }}_ambiguous.add(label)
            else:
                {{ m2m.name }}_cache[label] = obj.id
        {% endfor %}

        # FK/M2M caches are now plain dictionaries. Release their read
        # transaction before progress is written through another session.
        await session.rollback()

        def convert_import_value(column_name: str, value: str) -> Any:
            """Convert one authorized CSV value to its schema representation."""
            {% for column in model.import_fields %}
            {% set field = column.field %}
            {% if loop.first %}if{% else %}elif{% endif %} column_name == "{{ column.column_name }}":
                {% if column.kind == 'fk' %}
                if not value:
                    return None
                if value in {{ column.name }}_ambiguous:
                    raise ValueError(f"Foreign key '{value}' is ambiguous for field '{{ column.name }}'")
                if value in {{ column.name }}_cache:
                    return {{ column.name }}_cache[value]
                raise ValueError(f"Foreign key '{value}' not found for field '{{ column.name }}'")
                {% elif field.ui_type == 'int' %}
                return int(value) if value else None
                {% elif field.ui_type == 'float' %}
                return float(value) if value else None
                {% elif field.ui_type == 'bool' %}
                return value.lower() in ('true', '1', 'yes', 'on') if value else False
                {% elif field.ui_type == 'json' %}
                return ast.literal_eval(value) if value else []
                {% elif field.is_enum and field.is_multi_select %}
                return [v.strip() for v in value.split(",") if v.strip()] if value else []
                {% else %}
                return value
                {% endif %}
            {% endfor %}
            raise ValueError(f"Unknown import column '{column_name}'")

        import_key_column = import_key
        {% for column in model.import_fields %}
        {% if column.field.name == model.import_key %}
        import_key_column = "{{ column.column_name }}"
        {% endif %}
        {% endfor %}

        await report_progress(15, f"importing_records:0:{total_rows}")

        progress_step = max(1, (total_rows + 99) // 100)
        for idx, row in enumerate(rows, 1):
            try:
                # Get the unique field value
                raw_key_value = row.get(import_key_column)
                if not raw_key_value:
                    record_row_error(f"Row {idx}: Missing import key '{import_key}'")
                    continue

                # Convert only the selector before deciding whether this row is
                # a create or update; all other values are permission-gated first.
                key_value = convert_import_value(import_key_column, raw_key_value)
                existing = await crud.get_by_{{ model.import_key }}(session, key_value)
                {% if model.owner_field %}
                if (
                    existing is not None
                    and scoped_owner_id is not None
                    and getattr(existing, "{{ model.owner_field }}", None) != scoped_owner_id
                ):
                    raise ValueError("Record is not available for import")
                {% endif %}
                is_update = existing is not None
                required_permission = "u" if is_update else "c"

                # Import configuration is the union of fields used by all roles.
                # Enforce the requesting role again for the concrete row operation.
                obj_data = {}
                {% for column in model.import_fields %}
                if "{{ column.column_name }}" in row:
                    value = row["{{ column.column_name }}"]
                    permissions = import_column_permissions["{{ column.column_name }}"].get(role, "")
                    if (
                        scoped_owner_id is not None
                        and "{{ column.field.name }}" == "{{ model.owner_field or '' }}"
                    ):
                        # A scoped import always ignores an untrusted owner value.
                        pass
                    elif required_permission not in permissions:
                        if (
                            not (
                                is_update
                                and "{{ column.field.name }}" == import_key
                                and "r" in permissions
                            )
                            and value not in (None, "")
                        ):
                            raise ValueError(
                                "Field '{{ column.column_name }}' is not permitted for "
                                + ("update" if is_update else "create")
                            )
                    else:
                        obj_data["{{ column.field.name }}"] = convert_import_value(
                            "{{ column.column_name }}",
                            value,
                        )
                {% endfor %}

                {% if model.owner_field %}
                if scoped_owner_id is not None:
                    # Never trust an owner value supplied in an imported file.
                    obj_data["{{ model.owner_field }}"] = scoped_owner_id
                {% endif %}

                {% for m2m in model.import_m2m %}
                if "{{ m2m.column_name }}" in row:
                    labels = [value.strip() for value in row["{{ m2m.column_name }}"].split(";") if value.strip()]
                    missing = [value for value in labels if value not in {{ m2m.name }}_cache]
                    ambiguous = [value for value in labels if value in {{ m2m.name }}_ambiguous]
                    if ambiguous:
                        raise ValueError("M2M values are ambiguous for '{{ m2m.column_name }}': " + ";".join(ambiguous))
                    if missing:
                        raise ValueError("M2M values not found for '{{ m2m.column_name }}': " + ";".join(missing))
                    resolved_ids = [{{ m2m.name }}_cache[value] for value in labels]
                    {% if m2m.editor == 'inline' %}
                    obj_data["{{ m2m.write_name }}"] = [{"id": value} for value in resolved_ids]
                    {% else %}
                    obj_data["{{ m2m.write_name }}"] = resolved_ids
                    {% endif %}
                {% endfor %}

                if not dry_run:
                    if is_update:
                        # Update existing record (updated_at auto-set in update method)
                        obj_in = {{ model.name }}Update(**obj_data)
                        await self.update(session, existing.id, obj_in)
                        stats["updated"] += 1
                    else:
                        # Create new record (created_at and updated_at auto-set in create method)
                        obj_in = {{ model.name }}Create(**obj_data)
                        await self.create(session, obj_in)
                        stats["created"] += 1
                elif is_update:
                    {{ model.name }}Update(**obj_data)
                else:
                    {{ model.name }}Create(**obj_data)

                stats["success"] += 1

            except Exception as e:
                await session.rollback()
                record_row_error(f"Row {idx}: {str(e)}")
            finally:
                # Successful dry-runs leave a read transaction open; normal
                # writes already committed. This is harmless in both cases and
                # prevents SQLite from blocking the isolated progress session.
                await session.rollback()
                if idx == total_rows or idx == 1 or idx % progress_step == 0:
                    await report_progress(
                        15 + int(80 * idx / max(1, total_rows)),
                        f"importing_records:{idx}:{total_rows}",
                    )

        await report_progress(98, "finalizing_import")
        return stats
    {% endif %}
    {% endif %}
    {% endif %}

    {% if model.dashboard_metrics and not model.is_timescaledb %}
{% filter indent(4, true) %}{% include "dashboard_metrics_service.py.j2" %}{% endfilter %}
    {% endif %}

    {% if model.visualize %}
    async def get_stats(
        self,
        session: AsyncSession,
        *,
        label_field: str,
        value_field: str,
        aggregation: str = "count",
        {% if model.visualize.get('time_field') %}
        time_field: Optional[str] = None,
        period: Optional[str] = "day",
        start_time: Optional[str] = None,
        end_time: Optional[str] = None,
        {% endif %}
        filters: dict[str, Any] | None = None,
    ) -> dict:
        """
        Get statistics for {{ model.name }} visualization.
        """
        from sqlalchemy import func, extract, case, cast, String, text
        from datetime import datetime, timedelta, timezone

        model = {{ model.name }}

        def _typed_filter_expression(column, value):
            """Build a comparison while preserving the mapped database type."""
            try:
                python_type = column.type.python_type
                if not isinstance(value, python_type):
                    value = python_type(value)
            except (AttributeError, LookupError, NotImplementedError, TypeError, ValueError):
                pass
            return column == value

        {% if model.visualize.get('time_field') %}
        if time_field:
            # Time-based aggregation (line chart)
            from fastapi import HTTPException

            time_col = getattr(model, time_field)
            value_col = getattr(model, value_field)

            # Default to last 15 days if no time range specified
            now = datetime.now(timezone.utc)
            if not start_time and not end_time:
                start_time = (now - timedelta(days=15)).strftime("%Y-%m-%d")
                end_time = now.strftime("%Y-%m-%d")

            # Parse datetime strings; naive values use the configured system timezone.
            st = None
            et = None
            if start_time:
                try:
                    st = datetime.fromisoformat(start_time)
                    st = to_utc(st)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"Invalid start_time: {start_time}")
            if end_time:
                try:
                    et = datetime.fromisoformat(end_time)
                    et = to_utc(et)
                except ValueError:
                    raise HTTPException(status_code=400, detail=f"Invalid end_time: {end_time}")

            # Enforce max span per period
            if st and et:
                max_span_days = {"day": 30, "week": 210, "month": 900}.get(period, 30)
                if (et - st).days > max_span_days:
                    raise HTTPException(
                        status_code=400,
                        detail=f"Time span exceeds maximum of {max_span_days} days for {period} period",
                    )
                if et <= st:
                    raise HTTPException(status_code=400, detail="end_time must be after start_time")

            # Default end_time to now if only start_time is set
            if st and not et:
                et = now
                if (et - st).days > 30:
                    et = st + timedelta(days=30)
                end_time = et.strftime("%Y-%m-%d")

            # ── Database-agnostic date truncation ──
            # SQLite uses strftime/date, PostgreSQL uses date_trunc
            dialect = getattr(getattr(session, 'bind', None), 'dialect', None)
            dialect_name = dialect.name if dialect else "sqlite"

            if dialect_name == "postgresql":
                pg_period = period if period in ("day", "week", "month") else "day"
                date_trunc = func.date_trunc(pg_period, time_col)
            else:
                if period == "day":
                    date_trunc = func.date(time_col)
                elif period == "week":
                    date_trunc = func.strftime('%Y-%W', time_col)
                elif period == "month":
                    date_trunc = func.strftime('%Y-%m', time_col)
                else:
                    date_trunc = func.date(time_col)

            # Check if label_field is meaningful for multi-series grouping
            label_col = getattr(model, label_field, None) if label_field and label_field != value_field else None

            if aggregation == "count":
                agg_expr = func.count()
            elif aggregation == "sum":
                agg_expr = func.coalesce(func.sum(value_col), 0)
            elif aggregation == "avg":
                agg_expr = func.coalesce(func.avg(value_col), 0)
            elif aggregation == "min":
                agg_expr = func.min(value_col)
            elif aggregation == "max":
                agg_expr = func.max(value_col)
            else:
                agg_expr = func.count()

            if label_col:
                stmt = select(date_trunc, label_col, agg_expr)
            else:
                stmt = select(date_trunc, agg_expr)

            # Apply time range filter
            if st:
                stmt = stmt.where(time_col >= st)
            if et:
                stmt = stmt.where(time_col <= et)

            if label_col:
                stmt = stmt.group_by(date_trunc, label_col).order_by(date_trunc)
            else:
                stmt = stmt.group_by(date_trunc).order_by(date_trunc)

            {% if model.visualize.get('resolved_filters') %}
