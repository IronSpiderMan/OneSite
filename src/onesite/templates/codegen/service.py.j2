            def _fmt_date(val):
                if isinstance(val, datetime):
                    return val.strftime("%Y-%m-%d")
                if hasattr(val, 'value'):
                    return str(val.value)
                return str(val)

            def _fmt_label(val):
                if val is None:
                    return "None"
                if hasattr(val, 'value'):
                    return str(val.value)
                return str(val)

            if label_col:
                # Multi-series: pivot (time, label, value) into {labels, series}
                time_labels = []
                series_map: dict[str, dict[str, float]] = {}
                label_order: list[str] = []
                for row in rows:
                    t = _fmt_date(row[0])
                    l = _fmt_label(row[1])
                    v = float(row[2])
                    if t not in series_map:
                        series_map[t] = {}
                        time_labels.append(t)
                    series_map[t][l] = v
                    if l not in label_order:
                        label_order.append(l)
                series = []
                for l in label_order:
                    series.append({
                        "name": l,
                        "values": [series_map.get(t, {}).get(l, 0) for t in time_labels],
                    })
                return {
                    "labels": time_labels,
                    "series": series,
                    "title": "{{ model.visualize.get('title', model.name + ' Statistics') }}",
                }
            else:
