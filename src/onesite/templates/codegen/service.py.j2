    async def create(self, session: AsyncSession, obj_in: {{ model.name }}Create) -> dict:
        context = ModelHookContext(
            operation="create",
            input_data=obj_in.dict(exclude_none=True),
            changed_fields=frozenset(obj_in.dict(exclude_none=True)),
        )
        obj = await crud.create(session, obj_in)
        try:
            await invoke_model_hook(obj, "on_after_commit_create", context=context)
        except Exception:
            logger.exception(
                "Post-commit create hook failed for {{ model.name }} id=%s",
                getattr(obj, "id", None),
            )
        return obj.model_dump()

