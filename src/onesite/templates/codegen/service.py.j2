    {% if model.m2m_fields %}
    # M2M Relationship methods
    {% for m2m in model.m2m_fields %}
    async def get_{{ m2m.target_endpoint }}(
        self,
        session: AsyncSession,
        {{ model.lower_name }}_id: {{ model.id_type }},
        page: int = 1,
        size: int = 20,
        current_user: Any = None,
    ) -> PaginatedResponse[{{ m2m.target_model }}Read]:
        """
        Get {{ m2m.target_model }}s related to {{ model.name }}.
        """
        # Get total count
        total = await crud.count_{{ m2m.target_endpoint }}(session, {{ model.lower_name }}_id)

        if total == 0:
            return PaginatedResponse.create(data=[], total=0, page=page, size=size)

        # Get items (CRUD returns objects directly with pagination)
        items = await crud.get_{{ m2m.target_endpoint }}(session, {{ model.lower_name }}_id, page=page, size=size)

        # Convert to ReadSchema
        items_read = [
            {{ m2m.target_model }}Read.model_validate(await resolve_read_data(
                item, item.model_dump(),
                ReadContext(session=session, current_user=current_user, source="relation"),
            ))
            for item in items
        ]
        if size == -1:
            return PaginatedResponse.create(data=items_read, total=total, page=1, size=total)
        return PaginatedResponse.create(data=items_read, total=total, page=page, size=size)

    {% if m2m.order_field %}
    async def get_{{ m2m.target_endpoint }}_with_meta(
        self,
        session: AsyncSession,
        {{ model.lower_name }}_id: {{ model.id_type }},
        page: int = 1,
        size: int = 50,
    ) -> PaginatedResponse[{{ model.name }}{{ m2m.target_model }}Meta]:
        """
        Get {{ m2m.target_model }}s related to {{ model.name }} with link-table order.
        """
        # Count total first
        total = await crud.count_{{ m2m.target_endpoint }}(session, {{ model.lower_name }}_id)

        if total == 0:
            return PaginatedResponse.create(data=[], total=0, page=page, size=size)

        # Get all if size == -1
        if size == -1:
            rows, _ = await crud.get_{{ m2m.target_endpoint }}_with_order(session, {{ model.lower_name }}_id, page=1, size=total)
            items = [
                {{ model.name }}{{ m2m.target_model }}Meta(id=r[0], label=str(r[1]), order=int(r[2] or 0))
                for r in rows
            ]
            return PaginatedResponse.create(data=items, total=total, page=1, size=total)

        rows, _ = await crud.get_{{ m2m.target_endpoint }}_with_order(session, {{ model.lower_name }}_id, page, size)

        items = [
            {{ model.name }}{{ m2m.target_model }}Meta(id=r[0], label=str(r[1]), order=int(r[2] or 0))
            for r in rows
        ]

        return PaginatedResponse.create(data=items, total=total, page=page, size=size)
    {% endif %}
    {% endfor %}
    {% endif %}

