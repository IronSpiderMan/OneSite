{% set access_kind = "read" %}{% include "field_access.py.j2" %}
{% set ns = namespace(has_field=false) %}
{% set ns_json_fields = namespace(fields=[]) %}
{% for field in model.fields %}
    {% if 'r' in field.permissions and field.name != 'id' %}
    {% set override = (model.override_fields | default([]) | selectattr('field', 'equalto', field.name) | list | first) %}
    {{ field.name }}: {{ override.read_type if override and override.read_type is defined else field.type }}
    {% set ns.has_field = true %}
    {% if not override and ((field.ui_type in ['json', 'location'] and field.type not in ('Dict[str, Any]', 'Any', 'dict')) or field.ui_type == 'multi_select') %}
    {% set ns_json_fields.fields = ns_json_fields.fields + [field.name] %}
    {% endif %}
    {% endif %}
{% endfor %}
{% if not ns.has_field %}
    pass
{% endif %}
{% if ns_json_fields.fields %}
    @model_validator(mode='before')
    @classmethod
    def _parse_json_fields(cls, data: Any) -> Any:
        _fields = {{ ns_json_fields.fields }}
        if isinstance(data, dict):
            for f in _fields:
                val = data.get(f)
                if isinstance(val, str):
                    try:
                        data[f] = json.loads(val)
                    except (json.JSONDecodeError, TypeError):
                        pass
        elif hasattr(data, '__dict__'):
            for f in _fields:
                val = getattr(data, f, None)
                if isinstance(val, str):
                    try:
                        setattr(data, f, json.loads(val))
                    except (json.JSONDecodeError, TypeError):
                        pass
        return data
{% endif %}

