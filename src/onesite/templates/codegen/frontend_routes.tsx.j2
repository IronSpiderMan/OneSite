import React from 'react';
import {
  applyGeneratedRouteOverrides,
  GeneratedFeatureRoutes,
  GeneratedPublicFeatureRoutes,
  GeneratedRouteDefinition,
} from './GeneratedFeatureRoutes';
{% if agents_enabled %}
import AgentPage from './pages/Agent';
{% endif %}
import SettingsPage from './pages/Settings';
import DashboardPage from './pages/Dashboard';
{% if public_dashboard is defined and public_dashboard.enabled %}
{% if public_dashboard.component %}
import PublicDashboardPage from './custom/features/{{ public_dashboard.component.rsplit('.', 1)[0] }}';
{% else %}
import PublicDashboardPage from './pages/PublicDashboard';
{% endif %}
{% endif %}
{% if reports_enabled %}
import ReportsPage from './pages/Reports';
{% endif %}
{% if external_resources_enabled %}
import ExternalResourcesPage from './pages/ExternalResources';
{% endif %}
{% if import_export_enabled %}
import TaskCenterPage from './pages/TaskCenter';
{% endif %}
{% for model in models %}
{% if not model.is_singleton %}
import {{ model.name }}Page from './pages/{{ model.module_name }}';
import {{ model.name }}DetailPage from './pages/{{ model.module_name }}/detail';
{% if model.page_edit %}
import Create{{ model.name }}Page from './pages/{{ model.module_name }}/create';
{% endif %}
{% elif model.module_name != 'system_config' and model.module_name != 'custom_config' %}
import {{ model.name }}Page from './pages/{{ model.module_name }}';
{% endif %}
{% endfor %}

const GeneratedBaseRoutes: GeneratedRouteDefinition[] = [
{% if agents_enabled %}
  { id: 'builtin.agent', path: '/agent', element: <AgentPage /> },
{% endif %}
  {
    id: 'builtin.dashboard',
    path: '/dashboard',
    element: <DashboardPage />,
  },
  {
    id: 'builtin.settings',
    path: '/settings',
    element: <SettingsPage />,
  },
{% if reports_enabled %}
  {
    id: 'builtin.reports',
    path: '/reports',
    element: <ReportsPage />,
  },
{% endif %}
{% if external_resources_enabled %}
  {
    id: 'builtin.external-resources',
    path: '/external-resources',
    element: <ExternalResourcesPage />,
  },
{% endif %}
{% if import_export_enabled %}
  {
    id: 'builtin.task-center',
    path: '/task-center',
    element: <TaskCenterPage />,
  },
{% endif %}
{% for model in models %}
{% if not model.is_singleton %}
  {
    id: 'model.{{ model.module_name }}.list',
    path: '/{{ model.module_name }}s',
    element: <{{ model.name }}Page />,
  },
  {% if model.page_edit %}
  {
    id: 'model.{{ model.module_name }}.create',
    path: '/{{ model.module_name }}s/new',
    element: <Create{{ model.name }}Page />,
  },
  {% endif %}
  {
    id: 'model.{{ model.module_name }}.detail',
    path: '/{{ model.module_name }}s/:id',
    element: <{{ model.name }}DetailPage />,
  },
{% elif model.module_name != 'system_config' and model.module_name != 'custom_config' %}
  {
    id: 'model.{{ model.module_name }}.detail',
    path: '/{{ model.module_name }}',
    element: <{{ model.name }}Page />,
  },
{% endif %}
{% endfor %}
];

export const GeneratedRoutes: GeneratedRouteDefinition[] = [
  ...applyGeneratedRouteOverrides(GeneratedBaseRoutes),
  ...GeneratedFeatureRoutes,
];

export const PublicDashboardRoutes: GeneratedRouteDefinition[] = [
{% if public_dashboard is defined and public_dashboard.enabled %}
  {
    id: 'builtin.public-dashboard',
    path: {{ public_dashboard.path | tojson }},
    element: <PublicDashboardPage />,
  },
{% endif %}
];

export { GeneratedPublicFeatureRoutes };
