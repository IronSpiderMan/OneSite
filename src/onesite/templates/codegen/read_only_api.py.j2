from typing import Any, Optional
from datetime import datetime

from fastapi import APIRouter, Depends, HTTPException, Query
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core import db, deps
from app.models.user import User
from app.schemas.pagination import PaginatedResponse
from app.schemas.{{ model.module_name }} import {{ model.name }}Read
from app.services.{{ model.module_name }} import service


router = APIRouter(
    dependencies=[Depends(deps.require_role(deps.UserRole.{{ model.min_role_for_read }}))]
)


@router.get("/", response_model=PaginatedResponse[{{ model.name }}Read])
async def read_{{ model.lower_name }}s(
    page: int = 1,
    size: int = 20,
    user_id: Optional[int] = Query(None, description="Filter by user ID"),
    resource: Optional[str] = Query(None, description="Filter by resource"),
    operation: Optional[str] = Query(None, description="Filter by operation"),
    status: Optional[str] = Query(None, description="Filter by status"),
    operated_at_from: Optional[datetime] = Query(None, description="Filter from time"),
    operated_at_to: Optional[datetime] = Query(None, description="Filter to time"),
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
) -> Any:
    """List operation logs, scoped to the caller unless they are an administrator."""
    user_level = deps.ROLE_HIERARCHY.get(current_user.role, 0)
    owner_id = user_id
    if user_level < deps.ROLE_HIERARCHY.get(deps.UserRole.ADMIN, 1):
        owner_id = current_user.id
    return await service.get_multi(
        session,
        page=page,
        size=size,
        resource=resource,
        operation=operation,
        status=status,
        operated_at_from=operated_at_from,
        operated_at_to=operated_at_to,
        owner_id=owner_id,
    )


@router.get("/{id}", response_model={{ model.name }}Read)
async def read_{{ model.lower_name }}(
    *,
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
    id: {{ model.id_type }},
) -> Any:
    item = await service.get(session, id)
    if item is None:
        raise HTTPException(status_code=404, detail="{{ model.name }} not found")
    user_level = deps.ROLE_HIERARCHY.get(current_user.role, 0)
    if (
        user_level < deps.ROLE_HIERARCHY.get(deps.UserRole.ADMIN, 1)
        and item.user_id != current_user.id
    ):
        raise HTTPException(status_code=404, detail="{{ model.name }} not found")
    return item
