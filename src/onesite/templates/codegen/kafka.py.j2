"""Kafka integration runtime generated by OneSite."""

import asyncio
from collections import defaultdict
from typing import Awaitable, Callable, DefaultDict

from aiokafka import AIOKafkaConsumer

from app.core.config import settings
from app.core.logger import get_logger

logger = get_logger(__name__)

KafkaHandler = Callable[[str, bytes], Awaitable[None]]


class KafkaManager:
    def __init__(self) -> None:
        self._handlers: DefaultDict[tuple[str, str], list[KafkaHandler]] = defaultdict(list)
        self._tasks: list[asyncio.Task] = []
        self._started = False

    def register_handler(
        self,
        topic: str,
        callback: KafkaHandler,
        group_id: str,
    ) -> None:
        key = (topic, group_id)
        if callback not in self._handlers[key]:
            self._handlers[key].append(callback)

    async def start(self) -> None:
        """Start consumers in the background so Kafka cannot block API startup."""
        if self._started:
            return
        self._started = True
        self._tasks = [
            asyncio.create_task(
                self._consume_with_retry(topic, group_id, callbacks),
                name=f"kafka:{group_id}:{topic}",
            )
            for (topic, group_id), callbacks in self._handlers.items()
        ]
        logger.info("Started %s Kafka consumer(s)", len(self._tasks))

    async def _consume_with_retry(
        self,
        topic: str,
        group_id: str,
        callbacks: list[KafkaHandler],
    ) -> None:
        retry_delay = 1
        while self._started:
            consumer = AIOKafkaConsumer(
                topic,
                bootstrap_servers=settings.KAFKA_BROKERS,
                group_id=group_id,
                enable_auto_commit=False,
                auto_offset_reset="latest",
            )
            try:
                await consumer.start()
                retry_delay = 1
                logger.info(
                    "Kafka consumer connected: topic=%s group_id=%s",
                    topic,
                    group_id,
                )
                async for message in consumer:
                    for callback in callbacks:
                        await callback(message.topic, message.value)
                    await consumer.commit()
            except asyncio.CancelledError:
                raise
            except Exception:
                logger.exception(
                    "Kafka consumer failed: topic=%s group_id=%s; retrying in %ss",
                    topic,
                    group_id,
                    retry_delay,
                )
            finally:
                try:
                    await consumer.stop()
                except Exception:
                    logger.exception("Failed to stop Kafka consumer cleanly")

            if self._started:
                await asyncio.sleep(retry_delay)
                retry_delay = min(retry_delay * 2, 30)

    async def stop(self) -> None:
        self._started = False
        tasks, self._tasks = self._tasks, []
        for task in tasks:
            task.cancel()
        if tasks:
            await asyncio.gather(*tasks, return_exceptions=True)
        logger.info("Kafka consumers stopped")


kafka_manager = KafkaManager()
