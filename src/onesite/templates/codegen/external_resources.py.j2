"""Provider-level synchronization for model-owned external resources.

Model CUD calls the provider synchronously from the transactional ``on_after``
lifecycle. A periodic provider-wide reconciliation repairs uncertain outcomes
and external drift without retaining per-resource task or binding rows.
"""

from __future__ import annotations

import asyncio
import importlib
import logging
from datetime import datetime, timedelta, timezone
from enum import Enum
from typing import Any

from apscheduler.schedulers.asyncio import AsyncIOScheduler
from fastapi.encoders import jsonable_encoder
from sqlalchemy import Column, DateTime, String
from sqlalchemy.orm import sessionmaker
from sqlmodel import Field, SQLModel, select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.external_resource_config import (
    RESOURCE_CONFIGS,
    get_model_resource_config,
    get_resource_config,
)

logger = logging.getLogger(__name__)


class ProviderSyncStatus(str, Enum):
    unknown = "unknown"
    syncing = "syncing"
    synced = "synced"
    degraded = "degraded"


class ExternalProviderState(SQLModel, table=True):
    """Aggregate synchronization state for one provider."""

    __tablename__ = "onesite_external_provider_state"

    provider: str = Field(
        sa_column=Column(String(100), primary_key=True, nullable=False),
    )
    status: str = Field(
        default=ProviderSyncStatus.unknown.value,
        sa_column=Column(String(32), nullable=False, index=True),
    )
    desired_generation: int = 0
    synced_generation: int = 0
    checked_count: int = 0
    changed_count: int = 0
    failed_count: int = 0
    last_error: str | None = None
    last_started_at: datetime | None = Field(
        default=None, sa_column=Column(DateTime(timezone=True))
    )
    last_synced_at: datetime | None = Field(
        default=None, sa_column=Column(DateTime(timezone=True))
    )
    locked_until: datetime | None = Field(
        default=None, sa_column=Column(DateTime(timezone=True), index=True)
    )
    updated_at: datetime = Field(
        default_factory=lambda: datetime.now(timezone.utc),
        sa_column=Column(DateTime(timezone=True), nullable=False),
    )


async def init_external_resource_db() -> None:
    from app.core.db import engine

    async with engine.begin() as connection:
        await connection.run_sync(
            lambda sync_connection: SQLModel.metadata.create_all(
                sync_connection,
                tables=(ExternalProviderState.__table__,),
            )
        )
    factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
    async with factory() as session:
        for provider in sorted({item["provider"] for item in RESOURCE_CONFIGS}):
            await _provider_state(session, provider)
        await session.commit()


class ExternalResourceError(RuntimeError):
    pass


class ExternalResourcePermanentError(ExternalResourceError):
    pass


class ExternalResourceProvider:
    """Provider SPI for immediate CUD and provider-wide reconciliation."""

    async def create(self, resource: str, payload: dict[str, Any]) -> None:
        raise NotImplementedError

    async def update(
        self,
        resource: str,
        payload: dict[str, Any],
        previous: dict[str, Any],
    ) -> None:
        raise NotImplementedError

    async def delete(self, resource: str, payload: dict[str, Any]) -> None:
        raise NotImplementedError

    async def reconcile(
        self,
        desired: dict[str, list[dict[str, Any]]],
    ) -> dict[str, int] | None:
        """Converge every resource kind and return aggregate counters.

        Implementations own external enumeration and ownership filtering. A
        result may contain ``checked``, ``changed`` and ``failed`` counts.
        """
        raise NotImplementedError

    async def capabilities(self) -> dict[str, Any]:
        return {
            "reconcile": type(self).reconcile
            is not ExternalResourceProvider.reconcile
        }


_providers: dict[str, ExternalResourceProvider] = {}


def register_external_resource_provider(
    name: str, provider: ExternalResourceProvider
) -> None:
    if not name:
        raise ValueError("Provider name cannot be empty")
    _providers[name] = provider


def get_external_resource_provider(name: str) -> ExternalResourceProvider:
    try:
        return _providers[name]
    except KeyError as exc:
        raise ExternalResourcePermanentError(
            f"External resource provider '{name}' is not registered"
        ) from exc


def _utcnow() -> datetime:
    return datetime.now(timezone.utc)


async def _provider_state(
    session: AsyncSession,
    provider: str,
    *,
    for_update: bool = False,
) -> ExternalProviderState:
    statement = select(ExternalProviderState).where(
        ExternalProviderState.provider == provider
    )
    if for_update:
        statement = statement.with_for_update()
    state = (await session.exec(statement)).first()
    if state is None:
        state = ExternalProviderState(provider=provider)
        session.add(state)
        await session.flush()
    return state


async def sync_external_resource_change(
    session: AsyncSession,
    *,
    target: Any,
    operation: str,
    previous: dict[str, Any] | None = None,
) -> None:
    """Run the hidden transactional provider hook for one mapped model."""
    if operation not in {"create", "update", "delete"}:
        raise ValueError(f"Unsupported external-resource operation: {operation}")

    model_cls = target if isinstance(target, type) else type(target)
    source_module = model_cls.__module__.rsplit(".", 1)[-1]
    config = get_model_resource_config(source_module, model_cls.__name__)
    if config is None:
        return

    provider_name = config["provider"]
    resource = config["resource"]
    get_resource_config(provider_name, resource)
    provider = get_external_resource_provider(provider_name)
    from app.core.model_hooks import snapshot_model

    current = jsonable_encoder(snapshot_model(target))
    old = jsonable_encoder(previous or {})
    payload = old if operation == "delete" else current

    state = await _provider_state(session, provider_name, for_update=True)
    if operation == "create":
        await provider.create(resource, payload)
    elif operation == "update":
        await provider.update(resource, payload, old)
    else:
        await provider.delete(resource, payload)

    state.desired_generation += 1
    state.synced_generation = state.desired_generation
    state.status = ProviderSyncStatus.synced.value
    state.last_error = None
    state.last_synced_at = _utcnow()
    state.updated_at = _utcnow()


async def mark_external_provider_synced(
    session: AsyncSession,
    provider: str,
    *,
    changes: int = 1,
) -> None:
    """Record a custom bulk operation that already synchronized its provider."""
    state = await _provider_state(session, provider, for_update=True)
    state.desired_generation += max(1, int(changes))
    state.synced_generation = state.desired_generation
    state.status = ProviderSyncStatus.synced.value
    state.changed_count = max(0, int(changes))
    state.failed_count = 0
    state.last_error = None
    state.last_synced_at = _utcnow()
    state.updated_at = _utcnow()


class ExternalResourceManager:
    """Periodically reconciles all resources and exposes provider health."""

    def __init__(
        self,
        *,
        reconcile_seconds: float = 300.0,
        lease_seconds: float = 900.0,
        call_timeout_seconds: float = 600.0,
    ) -> None:
        self.reconcile_seconds = reconcile_seconds
        self.lease_seconds = lease_seconds
        self.call_timeout_seconds = call_timeout_seconds
        self._scheduler: AsyncIOScheduler | None = None
        self._initial_task: asyncio.Task[None] | None = None

    async def start(self) -> None:
        if self._scheduler is not None and self._scheduler.running:
            return
        self._scheduler = AsyncIOScheduler(timezone=timezone.utc)
        self._scheduler.add_job(
            self.reconcile_all,
            "interval",
            seconds=self.reconcile_seconds,
            id="onesite-external-provider-reconcile",
            replace_existing=True,
            coalesce=True,
            max_instances=1,
        )
        self._scheduler.start()
        self._initial_task = asyncio.create_task(
            self.reconcile_all(),
            name="onesite-external-provider-initial-reconcile",
        )

    async def stop(self) -> None:
        initial_task, self._initial_task = self._initial_task, None
        if initial_task is not None and not initial_task.done():
            initial_task.cancel()
            await asyncio.gather(initial_task, return_exceptions=True)
        if self._scheduler is not None:
            self._scheduler.shutdown(wait=False)
            self._scheduler = None

    async def reconcile_all(self) -> int:
        reconciled = 0
        for provider_name in sorted({item["provider"] for item in RESOURCE_CONFIGS}):
            if await self.reconcile_provider(provider_name):
                reconciled += 1
        return reconciled

    async def _claim_provider(self, provider_name: str) -> int | None:
        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            state = await _provider_state(session, provider_name, for_update=True)
            now = _utcnow()
            if state.locked_until is not None and state.locked_until > now:
                await session.rollback()
                return None
            state.status = ProviderSyncStatus.syncing.value
            state.last_started_at = now
            state.locked_until = now + timedelta(seconds=self.lease_seconds)
            state.updated_at = now
            generation = state.desired_generation
            await session.commit()
            return generation

    async def _desired_resources(
        self, provider_name: str
    ) -> dict[str, list[dict[str, Any]]]:
        from app.core.db import engine
        from app.core.model_hooks import snapshot_model

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        desired: dict[str, list[dict[str, Any]]] = {}
        async with factory() as session:
            for config in RESOURCE_CONFIGS:
                if config["provider"] != provider_name:
                    continue
                module = importlib.import_module(f"app.models.{config['module']}")
                model = getattr(module, config["model"])
                entities = (await session.exec(select(model))).all()
                desired[config["resource"]] = [
                    jsonable_encoder(snapshot_model(entity))
                    for entity in entities
                ]
        return desired

    async def reconcile_provider(self, provider_name: str) -> bool:
        generation = await self._claim_provider(provider_name)
        if generation is None:
            return False

        checked = changed = failed = 0
        error: str | None = None
        try:
            provider = get_external_resource_provider(provider_name)
            desired = await self._desired_resources(provider_name)
            result = await asyncio.wait_for(
                provider.reconcile(desired),
                timeout=self.call_timeout_seconds,
            ) or {}
            checked = int(result.get(
                "checked", sum(len(items) for items in desired.values())
            ))
            changed = int(result.get("changed", 0))
            failed = int(result.get("failed", 0))
            if failed:
                error = f"{failed} resource(s) failed reconciliation"
        except Exception as exc:
            logger.exception(
                "External provider reconciliation failed: %s", provider_name
            )
            failed = max(1, failed)
            error = str(exc)[:2000]

        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            state = await _provider_state(session, provider_name, for_update=True)
            state.checked_count = checked
            state.changed_count = changed
            state.failed_count = failed
            state.last_error = error
            state.locked_until = None
            state.updated_at = _utcnow()
            if error is None and state.desired_generation == generation:
                state.synced_generation = generation
                state.status = ProviderSyncStatus.synced.value
                state.last_synced_at = _utcnow()
            elif error is None:
                state.status = ProviderSyncStatus.unknown.value
            else:
                state.status = ProviderSyncStatus.degraded.value
            await session.commit()
        return True


external_resource_manager = ExternalResourceManager()
