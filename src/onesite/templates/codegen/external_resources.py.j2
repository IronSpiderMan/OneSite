"""Durable provider reconciliation runtime generated by OneSite.

Configured provider modules are loaded automatically during application and
worker startup. CRUD services only append outbox rows; this worker owns all
external I/O.
"""

from __future__ import annotations

import asyncio
import hashlib
import importlib
import json
import logging
from contextlib import suppress
from datetime import datetime, timedelta, timezone
from enum import Enum
from typing import Any

from fastapi.encoders import jsonable_encoder
from sqlalchemy import (
    Column, DateTime, JSON, String, UniqueConstraint, case, cast, exists,
    func, literal, or_, text, tuple_, update,
)
from sqlalchemy.dialects.postgresql import insert as postgresql_insert
from sqlalchemy.dialects.sqlite import insert as sqlite_insert
from sqlalchemy.orm import sessionmaker
from sqlmodel import Field, SQLModel, select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.external_resource_config import RESOURCE_CONFIGS, get_resource_config

logger = logging.getLogger(__name__)


class SyncStatus(str, Enum):
    pending = "pending"
    syncing = "syncing"
    synced = "synced"
    drifted = "drifted"
    retrying = "retrying"
    error = "error"
    deleting = "deleting"
    deleted = "deleted"


class ExternalResourceBinding(SQLModel, table=True):
    __tablename__ = "onesite_external_resource_binding"
    __table_args__ = (
        UniqueConstraint("provider", "resource_type", "entity_id", name="uq_external_resource_binding"),
    )

    id: int | None = Field(default=None, primary_key=True)
    provider: str = Field(sa_column=Column(String(100), nullable=False, index=True))
    resource_type: str = Field(sa_column=Column(String(100), nullable=False, index=True))
    entity_id: str = Field(sa_column=Column(String(255), nullable=False, index=True))
    external_id: str | None = Field(default=None, sa_column=Column(String(255)))
    status: str = Field(default=SyncStatus.pending.value, sa_column=Column(String(32), nullable=False, index=True))
    desired_revision: int = 0
    applied_revision: int = 0
    desired_hash: str | None = None
    observed_hash: str | None = None
    desired_state: dict[str, Any] = Field(default_factory=dict, sa_column=Column(JSON, nullable=False))
    observed_state: dict[str, Any] = Field(default_factory=dict, sa_column=Column(JSON, nullable=False))
    last_error: str | None = None
    retry_count: int = 0
    drift_count: int = 0
    last_drift_at: datetime | None = Field(default=None, sa_column=Column(DateTime(timezone=True)))
    last_observed_at: datetime | None = Field(default=None, sa_column=Column(DateTime(timezone=True)))
    last_synced_at: datetime | None = Field(default=None, sa_column=Column(DateTime(timezone=True)))
    last_checked_at: datetime | None = Field(default=None, sa_column=Column(DateTime(timezone=True)))
    next_check_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False, index=True))
    created_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False))
    updated_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False))


class ExternalResourceOutbox(SQLModel, table=True):
    __tablename__ = "onesite_external_resource_outbox"

    id: int | None = Field(default=None, primary_key=True)
    provider: str = Field(sa_column=Column(String(100), nullable=False, index=True))
    resource_type: str = Field(sa_column=Column(String(100), nullable=False, index=True))
    entity_id: str = Field(sa_column=Column(String(255), nullable=False, index=True))
    operation: str = Field(sa_column=Column(String(32), nullable=False))
    revision: int = 0
    snapshot: dict[str, Any] = Field(default_factory=dict, sa_column=Column(JSON, nullable=False))
    status: str = Field(default="pending", sa_column=Column(String(32), nullable=False, index=True))
    attempts: int = 0
    next_attempt_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False, index=True))
    last_error: str | None = None
    created_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False))
    updated_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False))


class ExternalResourceHealth(SQLModel, table=True):
    """Latest observation per external entity, independent of property count."""

    __tablename__ = "onesite_external_resource_health"

    provider: str = Field(sa_column=Column(String(100), primary_key=True))
    resource_type: str = Field(sa_column=Column(String(100), primary_key=True))
    entity_id: str = Field(sa_column=Column(String(255), primary_key=True))
    last_seen_at: datetime = Field(sa_column=Column(DateTime(timezone=True), nullable=False, index=True))
    updated_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc), sa_column=Column(DateTime(timezone=True), nullable=False))


async def init_external_resource_db() -> None:
    """Create and upgrade only the external-resource runtime schema.

    This function is deliberately independent from ``init_db``: the
    standalone reconciler must not create application models or run
    TimescaleDB DDL when it starts.
    """
    # Keep these imports local so this runtime can be imported by db.py
    # without creating an import cycle.
    from app.core.config import settings
    from app.core.db import engine

    tables = (
        ExternalResourceBinding.__table__,
        ExternalResourceOutbox.__table__,
        ExternalResourceHealth.__table__,
    )
    async with engine.begin() as conn:
        await conn.run_sync(
            lambda sync_conn: SQLModel.metadata.create_all(sync_conn, tables=tables)
        )

    if not settings.DATABASE_URI.startswith("postgresql"):
        return

    async with engine.begin() as conn:
        await conn.execute(text("""
            UPDATE onesite_external_resource_health
            SET last_seen_at = NOW(), updated_at = NOW()
            WHERE last_seen_at > NOW()
        """))
        await conn.execute(text("""
            CREATE INDEX IF NOT EXISTS ix_external_binding_health
            ON onesite_external_resource_binding
                (provider, resource_type, entity_id, status)
        """))
        await conn.execute(text("""
            ALTER TABLE onesite_external_resource_binding
            ADD COLUMN IF NOT EXISTS last_checked_at TIMESTAMPTZ
        """))
        await conn.execute(text("""
            ALTER TABLE onesite_external_resource_binding
            ADD COLUMN IF NOT EXISTS next_check_at TIMESTAMPTZ
        """))
        await conn.execute(text("""
            UPDATE onesite_external_resource_binding
            SET next_check_at = COALESCE(next_check_at, NOW())
        """))
        await conn.execute(text("""
            CREATE INDEX IF NOT EXISTS ix_external_binding_next_check
            ON onesite_external_resource_binding
                (next_check_at, id)
        """))
        await conn.execute(text("""
            CREATE INDEX IF NOT EXISTS ix_external_outbox_ready
            ON onesite_external_resource_outbox
                (status, next_attempt_at, id)
        """))
        await conn.execute(text("""
            CREATE INDEX IF NOT EXISTS ix_external_outbox_entity_status
            ON onesite_external_resource_outbox
                (provider, resource_type, entity_id, status)
        """))


class ExternalResourceError(RuntimeError):
    """Base provider error."""


class ExternalResourcePermanentError(ExternalResourceError):
    """Bad desired state or credentials; retry only after user action."""


class ExternalResourceProvider:
    """Small provider SPI; implementations contain no queue or retry policy."""

    async def build_desired(
        self, session: AsyncSession, resource_type: str, entity: Any, binding: ExternalResourceBinding
    ) -> dict[str, Any]:
        raise NotImplementedError

    async def observe(
        self, resource_type: str, desired: dict[str, Any], binding: ExternalResourceBinding
    ) -> dict[str, Any] | None:
        raise NotImplementedError

    async def apply(
        self, resource_type: str, desired: dict[str, Any], binding: ExternalResourceBinding
    ) -> str | None:
        raise NotImplementedError

    async def delete(
        self, resource_type: str, binding: ExternalResourceBinding, snapshot: dict[str, Any]
    ) -> None:
        raise NotImplementedError

    async def capabilities(self) -> dict[str, Any]:
        return {}

    def comparable_state(self, state: dict[str, Any] | None) -> dict[str, Any]:
        return state or {}

    def persisted_desired(self, desired: dict[str, Any]) -> dict[str, Any]:
        return desired


_providers: dict[str, ExternalResourceProvider] = {}


def register_external_resource_provider(name: str, provider: ExternalResourceProvider) -> None:
    if not name:
        raise ValueError("Provider name cannot be empty")
    _providers[name] = provider


def get_external_resource_provider(name: str) -> ExternalResourceProvider:
    try:
        return _providers[name]
    except KeyError as exc:
        raise ExternalResourcePermanentError(f"External resource provider '{name}' is not registered") from exc


def _utcnow() -> datetime:
    return datetime.now(timezone.utc)


def _liveness_timestamp(observed_at: datetime, now: datetime | None = None) -> datetime:
    """Normalize an observation and prevent a future producer clock pinning health."""
    normalized = (
        observed_at.replace(tzinfo=timezone.utc)
        if observed_at.tzinfo is None
        else observed_at.astimezone(timezone.utc)
    )
    return min(normalized, now or _utcnow())


def _hash(value: Any) -> str:
    encoded = json.dumps(jsonable_encoder(value), ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()


def _coerce_id(model: type[SQLModel], field_name: str, raw: str) -> Any:
    try:
        python_type = model.__table__.columns[field_name].type.python_type
        return python_type(raw)
    except (AttributeError, KeyError, NotImplementedError, TypeError, ValueError):
        return raw


def _load_model(config: dict[str, Any]) -> type[SQLModel]:
    module = importlib.import_module(f"app.models.{config['module']}")
    return getattr(module, config["model"])


async def _load_entity(session: AsyncSession, config: dict[str, Any], entity_id: str) -> Any | None:
    model = _load_model(config)
    return await session.get(model, _coerce_id(model, config.get("id_field", "id"), entity_id))


async def record_external_resource_health(
    session: AsyncSession,
    *,
    resource_type: str,
    provider: str | None = None,
    observations: dict[str, datetime],
) -> int:
    """Batch-advance last-seen timestamps inside the caller's transaction.

    Telemetry consumers should collapse a batch to one timestamp per entity
    before calling this function.  Timestamps never move backwards.
    """
    config = get_resource_config(resource_type, provider=provider)
    if not config.get("health"):
        raise ValueError(
            f"Resource type '{resource_type}' has no health projection"
        )
    if not observations:
        return 0
    now = _utcnow()
    rows = [
        {
            "provider": config["provider"],
            "resource_type": resource_type,
            "entity_id": str(entity_id),
            "last_seen_at": _liveness_timestamp(observed_at, now),
            "updated_at": now,
        }
        for entity_id, observed_at in observations.items()
    ]
    dialect = session.bind.dialect.name if session.bind is not None else ""
    insert_factory = postgresql_insert if dialect == "postgresql" else sqlite_insert
    statement = insert_factory(ExternalResourceHealth).values(rows)
    excluded = statement.excluded
    statement = statement.on_conflict_do_update(
        index_elements=["provider", "resource_type", "entity_id"],
        set_={
            "last_seen_at": case(
                (excluded.last_seen_at > ExternalResourceHealth.last_seen_at, excluded.last_seen_at),
                else_=ExternalResourceHealth.last_seen_at,
            ),
            "updated_at": excluded.updated_at,
        },
        where=excluded.last_seen_at > ExternalResourceHealth.last_seen_at,
    )
    await session.execute(statement)
    return len(rows)


async def enqueue_external_resource_change(
    session: AsyncSession,
    *,
    resource_type: str,
    provider: str | None = None,
    entity_id: str,
    operation: str = "reconcile",
    snapshot: dict[str, Any] | None = None,
    mark_pending: bool = True,
    bump_revision: bool = True,
) -> ExternalResourceBinding:
    """Append work inside the caller's transaction."""
    config = get_resource_config(resource_type, provider=provider)
    provider = config["provider"]
    statement = select(ExternalResourceBinding).where(
        ExternalResourceBinding.provider == provider,
        ExternalResourceBinding.resource_type == resource_type,
        ExternalResourceBinding.entity_id == str(entity_id),
    )
    binding = (await session.exec(statement)).first()
    if binding is None:
        binding = ExternalResourceBinding(
            provider=provider, resource_type=resource_type, entity_id=str(entity_id)
        )
        session.add(binding)
    if bump_revision:
        binding.desired_revision += 1
    if mark_pending:
        binding.status = SyncStatus.deleting.value if operation == "delete" else SyncStatus.pending.value
    binding.updated_at = _utcnow()
    session.add(
        ExternalResourceOutbox(
            provider=provider,
            resource_type=resource_type,
            entity_id=str(entity_id),
            operation=operation,
            revision=binding.desired_revision,
            snapshot=jsonable_encoder(snapshot or {}),
        )
    )
    return binding


async def enqueue_external_resource_dependents(
    session: AsyncSession, *, source_type: str, source_id: str
) -> int:
    """Fan a source-row change out to all external resources that reference it."""
    count = 0
    for config in RESOURCE_CONFIGS:
        for dependency in config.get("depends_on", []):
            if dependency.get("source") != source_type:
                continue
            model = _load_model(config)
            target_field = dependency["field"]
            value = _coerce_id(model, target_field, source_id)
            result = await session.exec(select(model).where(getattr(model, target_field) == value))
            for entity in result.all():
                await enqueue_external_resource_change(
                    session,
                    resource_type=config["resource_type"],
                    provider=config["provider"],
                    entity_id=str(getattr(entity, config.get("id_field", "id"))),
                )
                count += 1
    return count


class ExternalResourceManager:
    def __init__(
        self,
        poll_seconds: float = 1.0,
        drift_seconds: float = 1800.0,
        health_seconds: float = 5.0,
        worker_count: int = 4,
        scan_batch_size: int = 500,
    ) -> None:
        self.poll_seconds = poll_seconds
        self.drift_seconds = drift_seconds
        self.health_seconds = health_seconds
        self.worker_count = max(1, worker_count)
        self.scan_batch_size = max(1, scan_batch_size)
        self._tasks: list[asyncio.Task[None]] = []
        self._last_drift_scan = _utcnow()
        self._last_health_scan = _utcnow()

    async def start(self) -> None:
        if any(not task.done() for task in self._tasks):
            return
        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            processing = (await session.exec(select(ExternalResourceOutbox).where(ExternalResourceOutbox.status == "processing"))).all()
            for item in processing:
                item.status = "retry"
                item.next_attempt_at = _utcnow()
            await self._bootstrap(session)
            await session.commit()
        try:
            await self._project_health()
        except Exception:
            logger.exception("Initial external resource health projection failed")
        self._tasks = [
            asyncio.create_task(self._run(), name="onesite-external-resource-scheduler"),
            *[
                asyncio.create_task(
                    self._worker(), name=f"onesite-external-resource-worker-{index + 1}"
                )
                for index in range(self.worker_count)
            ],
        ]

    async def stop(self) -> None:
        if not self._tasks:
            return
        for task in self._tasks:
            task.cancel()
        for task in self._tasks:
            with suppress(asyncio.CancelledError):
                await task
        self._tasks = []

    async def _bootstrap(self, session: AsyncSession) -> None:
        for config in RESOURCE_CONFIGS:
            if config.get("reconcile_via"):
                continue
            model = _load_model(config)
            id_column = getattr(model, config.get("id_field", "id"))
            entity_ids = {str(value) for value in (await session.exec(select(id_column))).all()}
            existing_ids = {str(value) for value in (await session.exec(
                select(ExternalResourceBinding.entity_id).where(
                    ExternalResourceBinding.provider == config["provider"],
                    ExternalResourceBinding.resource_type == config["resource_type"],
                )
            )).all()}
            for entity_id in sorted(entity_ids - existing_ids):
                binding = ExternalResourceBinding(
                    provider=config["provider"],
                    resource_type=config["resource_type"],
                    entity_id=entity_id,
                    desired_revision=1,
                )
                session.add(binding)
                session.add(
                    ExternalResourceOutbox(
                        provider=config["provider"],
                        resource_type=config["resource_type"],
                        entity_id=entity_id,
                        operation="reconcile",
                        revision=1,
                    )
                )

    async def _run(self) -> None:
        while True:
            try:
                now = _utcnow()
                if (now - self._last_drift_scan).total_seconds() >= self.drift_seconds:
                    self._last_drift_scan = now
                    try:
                        await self._enqueue_drift_scan()
                    except Exception:
                        logger.exception("External resource drift scan failed")
                if (now - self._last_health_scan).total_seconds() >= self.health_seconds:
                    self._last_health_scan = now
                    try:
                        await self._project_health()
                    except Exception:
                        logger.exception("External resource health projection failed")
                await asyncio.sleep(self.poll_seconds)
            except asyncio.CancelledError:
                raise
            except Exception:
                logger.exception("External resource worker iteration failed")
                await asyncio.sleep(self.poll_seconds)

    async def _worker(self) -> None:
        while True:
            try:
                if not await self._process_one():
                    await asyncio.sleep(self.poll_seconds)
            except asyncio.CancelledError:
                raise
            except Exception:
                logger.exception("External resource reconciliation failed")
                await asyncio.sleep(self.poll_seconds)

    async def _process_one(self) -> bool:
        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            statement = select(ExternalResourceOutbox).where(
                ExternalResourceOutbox.status.in_(["pending", "retry"]),
                ExternalResourceOutbox.next_attempt_at <= _utcnow(),
            ).order_by(ExternalResourceOutbox.id).limit(1)
            if engine.dialect.name == "postgresql":
                statement = statement.with_for_update(skip_locked=True)
            task = (await session.exec(statement)).first()
            if task is None:
                return False
            task.status = "processing"
            task.attempts += 1
            task.updated_at = _utcnow()
            await session.commit()
            task_id = task.id

        async with factory() as session:
            task = await session.get(ExternalResourceOutbox, task_id)
            if task is None:
                return True
            try:
                await self._reconcile(session, task)
                task.status = "completed"
                task.last_error = None
                retained = (await session.exec(
                    select(ExternalResourceOutbox)
                    .where(
                        ExternalResourceOutbox.provider == task.provider,
                        ExternalResourceOutbox.resource_type == task.resource_type,
                        ExternalResourceOutbox.entity_id == task.entity_id,
                        ExternalResourceOutbox.status == "completed",
                    )
                    .order_by(ExternalResourceOutbox.id.desc())
                    .offset(100)
                )).all()
                for old_task in retained:
                    await session.delete(old_task)
            except Exception as exc:
                await session.rollback()
                task = await session.get(ExternalResourceOutbox, task_id)
                if task is None:
                    return True
                await self._record_failure(session, task, exc)
            task.updated_at = _utcnow()
            await session.commit()
        return True

    async def _binding_for(self, session: AsyncSession, task: ExternalResourceOutbox) -> ExternalResourceBinding:
        binding = (await session.exec(select(ExternalResourceBinding).where(
            ExternalResourceBinding.provider == task.provider,
            ExternalResourceBinding.resource_type == task.resource_type,
            ExternalResourceBinding.entity_id == task.entity_id,
        ))).first()
        if binding is None:
            raise ExternalResourcePermanentError("External resource binding is missing")
        return binding

    async def _reconcile(self, session: AsyncSession, task: ExternalResourceOutbox) -> None:
        binding = await self._binding_for(session, task)
        # A newer revision supersedes old reconcile work. Deletes are never skipped.
        if task.operation != "delete" and task.revision < binding.desired_revision:
            return
        provider = get_external_resource_provider(task.provider)
        config = get_resource_config(task.resource_type, provider=task.provider)
        entity = await _load_entity(session, config, task.entity_id)
        if task.operation == "delete" or entity is None:
            binding.status = SyncStatus.deleting.value
            await provider.delete(task.resource_type, binding, task.snapshot)
            empty_hash = _hash({})
            binding.status = SyncStatus.deleted.value
            # Successful deletion converges on absence. Retain the binding as
            # a tombstone, without comparing stale pre-delete desired state.
            binding.desired_state = {}
            binding.observed_state = {}
            binding.desired_hash = empty_hash
            binding.observed_hash = empty_hash
            binding.applied_revision = task.revision
            binding.last_error = None
            binding.last_observed_at = _utcnow()
            binding.last_checked_at = _utcnow()
            binding.last_synced_at = _utcnow()
            binding.updated_at = _utcnow()
            return

        binding.status = SyncStatus.syncing.value
        desired = await provider.build_desired(session, task.resource_type, entity, binding)
        observed = await provider.observe(task.resource_type, desired, binding)
        binding.last_checked_at = _utcnow()
        comparable_desired = provider.comparable_state(desired)
        comparable_observed = provider.comparable_state(observed)
        desired_hash = _hash(comparable_desired)
        observed_hash = _hash(comparable_observed)
        initial_provisioning = binding.applied_revision == 0 and not binding.desired_hash
        revision_advanced = binding.applied_revision < binding.desired_revision
        state_changed = desired_hash != observed_hash
        if state_changed:
            binding.status = SyncStatus.drifted.value
            if not initial_provisioning:
                binding.drift_count += 1
                binding.last_drift_at = _utcnow()
            external_id = await provider.apply(task.resource_type, desired, binding)
            if external_id:
                binding.external_id = external_id
            observed = await provider.observe(task.resource_type, desired, binding)
            binding.last_checked_at = _utcnow()
            comparable_observed = provider.comparable_state(observed)
            observed_hash = _hash(comparable_observed)
            if desired_hash != observed_hash:
                raise ExternalResourceError("Provider apply completed but observed state still differs")
        binding.desired_state = jsonable_encoder(provider.persisted_desired(desired))
        binding.observed_state = jsonable_encoder(observed or {})
        binding.desired_hash = desired_hash
        binding.observed_hash = observed_hash
        binding.applied_revision = binding.desired_revision
        binding.status = SyncStatus.synced.value
        binding.retry_count = 0
        binding.last_error = None
        binding.last_observed_at = _utcnow()
        if state_changed or revision_advanced:
            binding.last_synced_at = _utcnow()
        binding.updated_at = _utcnow()

    async def _record_failure(self, session: AsyncSession, task: ExternalResourceOutbox, exc: Exception) -> None:
        message = str(exc)[:2000]
        permanent = isinstance(exc, ExternalResourcePermanentError) or task.attempts >= 8
        task.last_error = message
        task.status = "failed" if permanent else "retry"
        task.next_attempt_at = _utcnow() + timedelta(seconds=min(300, 2 ** min(task.attempts, 8)))
        try:
            binding = await self._binding_for(session, task)
            binding.status = SyncStatus.error.value if permanent else SyncStatus.retrying.value
            binding.last_error = message
            binding.retry_count = task.attempts
            binding.last_checked_at = _utcnow()
            binding.updated_at = _utcnow()
        except Exception:
            logger.exception("Could not update failed external resource binding")

    async def _enqueue_drift_scan(self) -> None:
        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            active_job = exists().where(
                ExternalResourceOutbox.provider == ExternalResourceBinding.provider,
                ExternalResourceOutbox.resource_type == ExternalResourceBinding.resource_type,
                ExternalResourceOutbox.entity_id == ExternalResourceBinding.entity_id,
                ExternalResourceOutbox.status.in_(["pending", "processing", "retry"]),
            )
            statement = (
                select(
                    ExternalResourceBinding.id,
                    ExternalResourceBinding.provider,
                    ExternalResourceBinding.resource_type,
                    ExternalResourceBinding.entity_id,
                    ExternalResourceBinding.desired_revision,
                )
                .where(
                    ExternalResourceBinding.status.notin_([
                        SyncStatus.deleting.value, SyncStatus.deleted.value,
                    ]),
                    ExternalResourceBinding.next_check_at <= _utcnow(),
                    ~active_job,
                    tuple_(
                        ExternalResourceBinding.provider,
                        ExternalResourceBinding.resource_type,
                    ).notin_([
                        (item["provider"], item["resource_type"])
                        for item in RESOURCE_CONFIGS
                        if item.get("reconcile_via")
                    ]),
                )
                .order_by(ExternalResourceBinding.next_check_at, ExternalResourceBinding.id)
                .limit(self.scan_batch_size)
            )
            rows = (await session.exec(statement)).all()
            next_check_at = _utcnow() + timedelta(seconds=self.drift_seconds)
            for binding_id, provider, resource_type, entity_id, revision in rows:
                session.add(
                    ExternalResourceOutbox(
                        provider=provider,
                        resource_type=resource_type,
                        entity_id=entity_id,
                        operation="reconcile",
                        revision=revision,
                    )
                )
                await session.execute(
                    update(ExternalResourceBinding)
                    .where(ExternalResourceBinding.id == binding_id)
                    .values(next_check_at=next_check_at)
                )
            await session.commit()

    async def project_health(
        self,
        session: AsyncSession,
        *,
        resource_types: set[str] | None = None,
    ) -> None:
        """Project persisted observations in the caller's transaction.

        Ingestion callbacks can invoke this immediately after recording a
        successful observation.  The periodic scanner uses the same method to
        transition stale resources offline.
        """
        from app.core.db import engine

        now = _utcnow()
        await session.execute(
            update(ExternalResourceHealth)
            .where(ExternalResourceHealth.last_seen_at > now)
            .values(last_seen_at=now, updated_at=now)
        )
        for config in RESOURCE_CONFIGS:
            if resource_types is not None and config["resource_type"] not in resource_types:
                continue
            health = config.get("health")
            if not health:
                continue
            if engine.dialect.name == "postgresql":
                await self._project_health_postgresql(session, config, health)
            else:
                await self._project_health_portable(session, config, health)

    async def _project_health(self) -> None:
        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            await self.project_health(session)
            await session.commit()

    async def _project_health_postgresql(
        self, session: AsyncSession, config: dict[str, Any], health: dict[str, Any]
    ) -> None:
        """Project every entity of one resource type with one UPDATE statement."""
        model = _load_model(config)
        id_column = getattr(model, config.get("id_field", "id"))
        entity_key = cast(id_column, String)
        binding_key = cast(getattr(model, health["binding_entity_field"]), String)
        status_column = getattr(model, health["status_field"])
        interval_column = getattr(model, health["interval_field"])
        enabled_column = getattr(model, health["enabled_field"])
        last_seen_column = getattr(model, health["last_seen_field"])
        binding_status = (
            select(ExternalResourceBinding.status)
            .where(
                ExternalResourceBinding.provider == health["binding_provider"],
                ExternalResourceBinding.resource_type == health["binding_resource_type"],
                ExternalResourceBinding.entity_id == binding_key,
            )
            .scalar_subquery()
        )
        observed_at = (
            select(ExternalResourceHealth.last_seen_at)
            .where(
                ExternalResourceHealth.provider == config["provider"],
                ExternalResourceHealth.resource_type == config["resource_type"],
                ExternalResourceHealth.entity_id == entity_key,
            )
            .scalar_subquery()
        )
        last_seen_type = last_seen_column.property.columns[0].type
        stored_observed_at = (
            observed_at
            if getattr(last_seen_type, "timezone", False)
            else func.timezone("UTC", observed_at)
        )
        active_binding = exists().where(
            ExternalResourceBinding.provider == health["binding_provider"],
            ExternalResourceBinding.resource_type == health["binding_resource_type"],
            ExternalResourceBinding.entity_id == binding_key,
            ExternalResourceBinding.status.notin_([
                SyncStatus.deleting.value, SyncStatus.deleted.value,
            ]),
        )
        threshold = func.greatest(
            health["minimum_offline_seconds"],
            interval_column * health["interval_multiplier"] / 1000.0,
        )
        age_seconds = func.extract("epoch", _utcnow() - observed_at)
        status_type = status_column.property.columns[0].type
        typed_status = lambda value: literal(value, type_=status_type)
        projected = case(
            (~enabled_column, typed_status(health["disabled_status"])),
            (~active_binding, typed_status(health["inactive_status"])),
            (
                binding_status.in_([SyncStatus.error.value, SyncStatus.retrying.value]),
                typed_status(health["error_status"]),
            ),
            (binding_status != SyncStatus.synced.value, typed_status(health["inactive_status"])),
            (observed_at.is_(None), typed_status(health["offline_status"])),
            (age_seconds <= threshold, typed_status(health["online_status"])),
            else_=typed_status(health["offline_status"]),
        )
        statement = (
            update(model)
            .where(or_(
                status_column.is_distinct_from(projected),
                last_seen_column.is_distinct_from(stored_observed_at),
            ))
            .values({
                health["status_field"]: projected,
                health["last_seen_field"]: stored_observed_at,
            })
        )
        await session.execute(statement)

    async def _project_health_portable(
        self, session: AsyncSession, config: dict[str, Any], health: dict[str, Any]
    ) -> None:
        """Constant-query fallback for SQLite development and tests."""
        model = _load_model(config)
        entities = (await session.exec(select(model))).all()
        bindings = (await session.exec(select(ExternalResourceBinding).where(
            ExternalResourceBinding.provider == health["binding_provider"],
            ExternalResourceBinding.resource_type == health["binding_resource_type"],
            ExternalResourceBinding.status.notin_([
                SyncStatus.deleting.value, SyncStatus.deleted.value,
            ]),
        ))).all()
        observations = (await session.exec(select(ExternalResourceHealth).where(
            ExternalResourceHealth.provider == config["provider"],
            ExternalResourceHealth.resource_type == config["resource_type"],
        ))).all()
        binding_by_id = {item.entity_id: item for item in bindings}
        observed_by_id = {item.entity_id: item.last_seen_at for item in observations}
        now = _utcnow()
        for entity in entities:
            entity_id = str(getattr(entity, config.get("id_field", "id")))
            binding = binding_by_id.get(str(getattr(entity, health["binding_entity_field"])))
            observed_at = observed_by_id.get(entity_id)
            if not getattr(entity, health["enabled_field"]):
                status = health["disabled_status"]
            elif binding is None:
                status = health["inactive_status"]
            elif binding.status in {SyncStatus.error.value, SyncStatus.retrying.value}:
                status = health["error_status"]
            elif binding.status != SyncStatus.synced.value:
                status = health["inactive_status"]
            elif observed_at is None:
                status = health["offline_status"]
            else:
                comparable = observed_at if observed_at.tzinfo else observed_at.replace(tzinfo=timezone.utc)
                threshold = max(
                    health["minimum_offline_seconds"],
                    getattr(entity, health["interval_field"]) * health["interval_multiplier"] / 1000,
                )
                status = health["online_status"] if (now - comparable).total_seconds() <= threshold else health["offline_status"]
            current = getattr(entity, health["status_field"])
            if isinstance(current, Enum):
                status = type(current)(status)
            setattr(entity, health["status_field"], status)
            target_type = entity.__table__.columns[health["last_seen_field"]].type
            stored_observed_at = observed_at
            if (
                observed_at is not None
                and not getattr(target_type, "timezone", False)
                and observed_at.tzinfo is not None
            ):
                stored_observed_at = observed_at.astimezone(timezone.utc).replace(tzinfo=None)
            setattr(entity, health["last_seen_field"], stored_observed_at)


external_resource_manager = ExternalResourceManager()
