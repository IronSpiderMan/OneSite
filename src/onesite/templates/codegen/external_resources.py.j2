"""Lightweight, durable CUD delivery for provider-owned external resources.

Business services append one task in the same transaction as the local model
change. A small worker then invokes the configured provider after commit.
Successful tasks are removed; only pending and failed work remains persisted.
"""

from __future__ import annotations

import asyncio
import logging
from contextlib import suppress
from datetime import datetime, timedelta, timezone
from enum import Enum
from typing import Any

from fastapi.encoders import jsonable_encoder
from sqlalchemy import Column, DateTime, JSON, String, exists, or_
from sqlalchemy.orm import aliased, sessionmaker
from sqlmodel import Field, SQLModel, select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.external_resource_config import get_resource_config

logger = logging.getLogger(__name__)


class TaskStatus(str, Enum):
    pending = "pending"
    processing = "processing"
    retry = "retry"
    failed = "failed"


class ExternalResourceTask(SQLModel, table=True):
    __tablename__ = "onesite_external_resource_task"

    id: int | None = Field(default=None, primary_key=True)
    provider: str = Field(sa_column=Column(String(100), nullable=False, index=True))
    resource: str = Field(sa_column=Column(String(100), nullable=False, index=True))
    entity_id: str = Field(sa_column=Column(String(255), nullable=False, index=True))
    operation: str = Field(sa_column=Column(String(16), nullable=False))
    payload: dict[str, Any] = Field(default_factory=dict, sa_column=Column(JSON, nullable=False))
    previous: dict[str, Any] = Field(default_factory=dict, sa_column=Column(JSON, nullable=False))
    status: str = Field(
        default=TaskStatus.pending.value,
        sa_column=Column(String(16), nullable=False, index=True),
    )
    attempts: int = 0
    next_attempt_at: datetime = Field(
        default_factory=lambda: datetime.now(timezone.utc),
        sa_column=Column(DateTime(timezone=True), nullable=False, index=True),
    )
    locked_until: datetime | None = Field(
        default=None,
        sa_column=Column(DateTime(timezone=True), nullable=True, index=True),
    )
    last_error: str | None = None
    created_at: datetime = Field(
        default_factory=lambda: datetime.now(timezone.utc),
        sa_column=Column(DateTime(timezone=True), nullable=False),
    )
    updated_at: datetime = Field(
        default_factory=lambda: datetime.now(timezone.utc),
        sa_column=Column(DateTime(timezone=True), nullable=False),
    )


async def init_external_resource_db() -> None:
    """Create only the lightweight delivery table."""
    from app.core.db import engine

    async with engine.begin() as connection:
        await connection.run_sync(
            lambda sync_connection: SQLModel.metadata.create_all(
                sync_connection,
                tables=(ExternalResourceTask.__table__,),
            )
        )


class ExternalResourceError(RuntimeError):
    """Base class for provider delivery errors."""


class ExternalResourcePermanentError(ExternalResourceError):
    """A task that should wait for an explicit manual retry."""


class ExternalResourceProvider:
    """One external system capable of handling many resource kinds."""

    async def create(self, resource: str, payload: dict[str, Any]) -> None:
        raise NotImplementedError

    async def update(
        self,
        resource: str,
        payload: dict[str, Any],
        previous: dict[str, Any],
    ) -> None:
        raise NotImplementedError

    async def delete(self, resource: str, payload: dict[str, Any]) -> None:
        raise NotImplementedError

    async def capabilities(self) -> dict[str, Any]:
        return {}

    async def deliver(self, task: ExternalResourceTask) -> None:
        if task.operation == "create":
            await self.create(task.resource, task.payload)
        elif task.operation == "update":
            await self.update(task.resource, task.payload, task.previous)
        elif task.operation == "delete":
            await self.delete(task.resource, task.payload)
        else:
            raise ExternalResourcePermanentError(
                f"Unsupported external-resource operation: {task.operation}"
            )


_providers: dict[str, ExternalResourceProvider] = {}


def register_external_resource_provider(
    name: str,
    provider: ExternalResourceProvider,
) -> None:
    if not name:
        raise ValueError("Provider name cannot be empty")
    _providers[name] = provider


def get_external_resource_provider(name: str) -> ExternalResourceProvider:
    try:
        return _providers[name]
    except KeyError as exc:
        raise ExternalResourcePermanentError(
            f"External resource provider '{name}' is not registered"
        ) from exc


def _utcnow() -> datetime:
    return datetime.now(timezone.utc)


async def enqueue_external_resource_change(
    session: AsyncSession,
    *,
    provider: str,
    resource: str,
    entity_id: str,
    operation: str,
    payload: dict[str, Any],
    previous: dict[str, Any] | None = None,
) -> ExternalResourceTask:
    """Append a provider CUD task inside the caller's transaction."""
    if operation not in {"create", "update", "delete"}:
        raise ValueError(f"Unsupported external-resource operation: {operation}")
    get_resource_config(provider, resource)
    task = ExternalResourceTask(
        provider=provider,
        resource=resource,
        entity_id=str(entity_id),
        operation=operation,
        payload=jsonable_encoder(payload),
        previous=jsonable_encoder(previous or {}),
    )
    session.add(task)
    return task


class ExternalResourceManager:
    def __init__(
        self,
        *,
        poll_seconds: float = 1.0,
        lease_seconds: float = 120.0,
        call_timeout_seconds: float = 60.0,
        max_attempts: int = 8,
    ) -> None:
        self.poll_seconds = poll_seconds
        self.lease_seconds = lease_seconds
        self.call_timeout_seconds = call_timeout_seconds
        self.max_attempts = max_attempts
        self._task: asyncio.Task[None] | None = None

    async def start(self) -> None:
        if self._task is not None and not self._task.done():
            return
        self._task = asyncio.create_task(
            self._run(),
            name="onesite-external-resource-worker",
        )

    async def stop(self) -> None:
        if self._task is None:
            return
        self._task.cancel()
        with suppress(asyncio.CancelledError):
            await self._task
        self._task = None

    async def _run(self) -> None:
        while True:
            try:
                if not await self._process_one():
                    await asyncio.sleep(self.poll_seconds)
            except asyncio.CancelledError:
                raise
            except Exception:
                logger.exception("External resource delivery iteration failed")
                await asyncio.sleep(self.poll_seconds)

    async def _claim_one(self) -> int | None:
        from app.core.db import engine

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        now = _utcnow()
        earlier = aliased(ExternalResourceTask)
        blocked_by_earlier = exists().where(
            earlier.provider == ExternalResourceTask.provider,
            earlier.resource == ExternalResourceTask.resource,
            earlier.entity_id == ExternalResourceTask.entity_id,
            earlier.id < ExternalResourceTask.id,
            earlier.status.in_([
                TaskStatus.pending.value,
                TaskStatus.processing.value,
                TaskStatus.retry.value,
            ]),
        )
        ready = or_(
            (
                ExternalResourceTask.status.in_([
                    TaskStatus.pending.value,
                    TaskStatus.retry.value,
                ])
                & (ExternalResourceTask.next_attempt_at <= now)
            ),
            (
                (ExternalResourceTask.status == TaskStatus.processing.value)
                & (ExternalResourceTask.locked_until <= now)
            ),
        )
        async with factory() as session:
            statement = (
                select(ExternalResourceTask)
                .where(ready, ~blocked_by_earlier)
                .order_by(ExternalResourceTask.id)
                .limit(1)
            )
            if engine.dialect.name == "postgresql":
                statement = statement.with_for_update(skip_locked=True)
            task = (await session.exec(statement)).first()
            if task is None:
                return None
            task.status = TaskStatus.processing.value
            task.attempts += 1
            task.locked_until = now + timedelta(seconds=self.lease_seconds)
            task.updated_at = now
            await session.commit()
            return task.id

    async def _process_one(self) -> bool:
        from app.core.db import engine

        task_id = await self._claim_one()
        if task_id is None:
            return False

        factory = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)
        async with factory() as session:
            task = await session.get(ExternalResourceTask, task_id)
            if task is None:
                return True
            try:
                provider = get_external_resource_provider(task.provider)
                await asyncio.wait_for(
                    provider.deliver(task),
                    timeout=self.call_timeout_seconds,
                )
                await session.delete(task)
            except Exception as exc:
                permanent = (
                    isinstance(exc, ExternalResourcePermanentError)
                    or task.attempts >= self.max_attempts
                )
                task.status = (
                    TaskStatus.failed.value if permanent else TaskStatus.retry.value
                )
                task.next_attempt_at = _utcnow() + timedelta(
                    seconds=min(300, 2 ** min(task.attempts, 8))
                )
                task.locked_until = None
                task.last_error = str(exc)[:2000]
                task.updated_at = _utcnow()
            await session.commit()
        return True


external_resource_manager = ExternalResourceManager()
