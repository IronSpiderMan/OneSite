async def create(session: AsyncSession, obj_in: {{ model.name }}Create) -> {{ model.name }}:
    # Note: validation should happen before, here we assume obj_in is valid pydantic model
    
    # Handle M2M fields
    {% if model.m2m_fields %}
    m2m_data = {}
    {% for m2m in model.m2m_fields %}
    if hasattr(obj_in, "{{ m2m.name }}"):
        m2m_data["{{ m2m.name }}"] = getattr(obj_in, "{{ m2m.name }}")
        delattr(obj_in, "{{ m2m.name }}")
    {% endfor %}
    {% endif %}

    # Convert to dict to handle nested Pydantic models in JSON fields
    obj_dict = obj_in.dict()

    {% if model.property_config_meta %}
    # Initialize properties_config from blueprint model if not explicitly provided
    if not obj_dict.get("{{ model.property_config_meta.field_name }}"):
        blueprint_id = obj_dict.get("{{ model.property_config_meta.blueprint_fk }}")
        if blueprint_id is not None:
            blueprint = await session.get({{ model.property_config_meta.blueprint_model }}, blueprint_id)
            if blueprint and getattr(blueprint, "{{ model.property_config_meta.blueprint_properties_field }}", None):
                props = getattr(blueprint, "{{ model.property_config_meta.blueprint_properties_field }}")
                config_entries: dict[str, Any] = {}
                for key, p in props.items():
                    cfg = {{ model.property_config_meta.config_class }}(
                        {% for field_name, field_type in model.property_config_meta.config_fields.items() %}
                        {% set ft = field_type.lower() %}
                        {% if '= true' in ft %}
                        {{ field_name }}=True,
                        {% elif '= false' in ft %}
                        {{ field_name }}=False,
                        {% elif '= ' in ft %}
                        {{ field_name }}={{ field_type.split('=', 1)[1].strip() }},
                        {% elif 'optional' in ft %}
                        {{ field_name }}=None,
                        {% else %}
                        {% endif %}
                        {% endfor %}
                    )
                    config_entries[key] = cfg.model_dump()
                obj_dict["{{ model.property_config_meta.field_name }}"] = config_entries
    {% endif %}

    db_obj = {{ model.name }}(**obj_dict)
    session.add(db_obj)
    await session.commit()
    await session.refresh(db_obj)
    
    {% if model.m2m_fields %}
    # Insert M2M relations
    {% for m2m in model.m2m_fields %}
    if m2m_data.get("{{ m2m.name }}") is not None:
        for idx, target_id in enumerate(m2m_data["{{ m2m.name }}"], start=1):
            link = {{ m2m.link_model }}(
                {{ m2m.source_fk_field }}=db_obj.id,
                {{ m2m.target_fk_field }}=target_id
                {% if m2m.order_field %}
                , {{ m2m.order_field }}=idx
                {% endif %}
            )
            session.add(link)
    {% endfor %}
    await session.commit()
    await session.refresh(db_obj)
    {% endif %}

    return db_obj

async def update(session: AsyncSession, db_obj: {{ model.name }}, obj_in: {{ model.name }}Update) -> {{ model.name }}:
    obj_data = obj_in.dict(exclude_unset=True)
    
    {% if model.m2m_fields %}
    # Handle M2M updates
    {% for m2m in model.m2m_fields %}
    if "{{ m2m.name }}" in obj_data:
        new_ids = obj_data.pop("{{ m2m.name }}")
        if new_ids is not None:
            # 1. Clear existing relations
            # This is a naive implementation (delete all and re-insert). 
            # Better would be to calculate diff.
            statement = select({{ m2m.link_model }}).where({{ m2m.link_model }}.{{ m2m.source_fk_field }} == db_obj.id)
            result = await session.exec(statement)
            existing_links = result.all()
            for link in existing_links:
                await session.delete(link)
            
            # 2. Insert new relations
            for idx, target_id in enumerate(new_ids, start=1):
                link = {{ m2m.link_model }}(
                    {{ m2m.source_fk_field }}=db_obj.id,
                    {{ m2m.target_fk_field }}=target_id
                    {% if m2m.order_field %}
                    , {{ m2m.order_field }}=idx
                    {% endif %}
                )
                session.add(link)
    {% endfor %}
    {% endif %}
    
    {% if model.property_config_meta %}
    # Capture old blueprint FK before setattr overwrites it
    _old_blueprint_id = getattr(db_obj, "{{ model.property_config_meta.blueprint_fk }}", None)
    {% endif %}

    for key, value in obj_data.items():
        {% if model.property_config_meta %}
        if key == "{{ model.property_config_meta.field_name }}" and value is not None:
            # Validate add/delete permissions (dict keys)
            field_perms = "{{ model.property_config_meta.field_permissions }}"
            old_configs = getattr(db_obj, "{{ model.property_config_meta.field_name }}", None) or {}
            old_keys = set(old_configs.keys())
            new_keys = set(value.keys())
            added = new_keys - old_keys
            if added and "a" not in field_perms:
                raise ValueError("Adding items is not allowed: " + ", ".join(sorted(added)))
            removed = old_keys - new_keys
            if removed and "l" not in field_perms:
                raise ValueError("Deleting items is not allowed: " + ", ".join(sorted(removed)))
            # Convert Pydantic objects to dicts for JSON storage
            value = {k: (v if isinstance(v, dict) else v.model_dump()) for k, v in value.items()}
        {% endif %}
        setattr(db_obj, key, value)

    {% if model.property_config_meta %}
    # Re-initialize properties_config if blueprint FK changed
    new_bp = obj_data.get("{{ model.property_config_meta.blueprint_fk }}")
    if new_bp is not None and new_bp != _old_blueprint_id:
        blueprint = await session.get({{ model.property_config_meta.blueprint_model }}, new_bp)
        if blueprint and getattr(blueprint, "{{ model.property_config_meta.blueprint_properties_field }}", None):
            props = getattr(blueprint, "{{ model.property_config_meta.blueprint_properties_field }}")
            config_entries: dict[str, Any] = {}
            for key, p in props.items():
                cfg = {{ model.property_config_meta.config_class }}(
                    {% for field_name, field_type in model.property_config_meta.config_fields.items() %}
                    {% set ft = field_type.lower() %}
                    {% if '= true' in ft %}
                    {{ field_name }}=True,
                    {% elif '= false' in ft %}
                    {{ field_name }}=False,
                    {% elif '= ' in ft %}
                    {{ field_name }}={{ field_type.split('=', 1)[1].strip() }},
                    {% elif 'optional' in ft %}
                    {{ field_name }}=None,
                    {% else %}
                    {% endif %}
                    {% endfor %}
                )
                config_entries[key] = cfg.model_dump()
            setattr(db_obj, "{{ model.property_config_meta.field_name }}", config_entries)
    {% endif %}

    session.add(db_obj)
    await session.commit()
    await session.refresh(db_obj)
    return db_obj

async def delete(session: AsyncSession, id: {{ model.id_type }}) -> {{ model.id_type }}:
    db_obj = await session.get({{ model.name }}, id)
    await session.delete(db_obj)
    await session.commit()
    return db_obj.id

{% if model.is_notification_table %}
async def mark_all_read_by_user(session: AsyncSession, user_id: int) -> int:
    """
    Mark all unread notifications as read for a specific user.
    Returns the number of notifications updated.
    """
    from sqlmodel import update

    statement = (
        update({{ model.name }})
        .where({{ model.name }}.user_id == user_id)
        .where({{ model.name }}.is_read == False)
        .values(is_read=True)
    )
    result = await session.exec(statement)
    await session.commit()
    return result.rowcount
{% endif %}

{% if model.m2m_fields %}
# M2M Relationship CRUD functions
{% for m2m in model.m2m_fields %}
async def get_{{ m2m.target_endpoint }}(
    session: AsyncSession,
    {{ model.lower_name }}_id: {{ model.id_type }},
    page: int = 1,
    size: int = 20,
) -> List[Dict[str, Any]]:
    """Get list of {{ m2m.target_model }} objects related to {{ model.name }}, enriched with FK labels."""
    # Get target IDs first
    statement = select({{ m2m.link_model }}.{{ m2m.target_fk_field }}).where(
        {{ m2m.link_model }}.{{ m2m.source_fk_field }} == {{ model.lower_name }}_id
    )
    result = await session.exec(statement)
    target_ids = list(result.all())

    if not target_ids:
        return []

    # Pagination
    skip = (page - 1) * size
    paginated_ids = target_ids[skip:skip + size] if size != -1 else target_ids

    # Get objects by IDs
    statement = select({{ m2m.target_model }}).where(
        col({{ m2m.target_model }}.id).in_(paginated_ids)
    )
    result = await session.exec(statement)
    items = list(result.all())

    {% if m2m.target_fk_fields %}
    # Import FK target models for label resolution (avoid shadowing {{ m2m.target_model }})
    {% for fk_field in m2m.target_fk_fields %}
    {% if fk_field.target_model != m2m.target_model %}
    from app.models.{{ fk_field.target_source_module }} import {{ fk_field.target_model }}
    {% endif %}
    {% endfor %}

    # Enrich items with FK labels
    {% for fk_field in m2m.target_fk_fields %}
    {{ fk_field.name }}_ids = list(set(getattr(item, "{{ fk_field.name }}") for item in items if getattr(item, "{{ fk_field.name }}") is not None))
    {% endfor %}

    {% for fk_field in m2m.target_fk_fields %}
    {{ fk_field.name }}_map = {}
    if {{ fk_field.name }}_ids:
        stmt = select({{ fk_field.target_model }}).where({{ fk_field.target_model }}.id.in_({{ fk_field.name }}_ids))
        result = await session.exec(stmt)
        for obj in result.all():
            {{ fk_field.name }}_map[obj.id] = getattr(obj, "{{ fk_field.label_field }}", None) or str(obj.id)
    {% endfor %}

    enriched = []
    for item in items:
        item_dict = item.model_dump()
        {% for fk_field in m2m.target_fk_fields %}
        fk_id = getattr(item, "{{ fk_field.name }}", None)
        item_dict["{{ fk_field.name }}_label"] = {{ fk_field.name }}_map.get(fk_id) if fk_id else None
        {% endfor %}
        enriched.append(item_dict)

    return enriched
    {% else %}
    return [item.model_dump() for item in items]
    {% endif %}


async def count_{{ m2m.target_endpoint }}(session: AsyncSession, {{ model.lower_name }}_id: {{ model.id_type }}) -> int:
    """Count {{ m2m.target_model }}s related to {{ model.name }}."""
    statement = select(func.count()).select_from({{ m2m.link_model }}).where(
        {{ m2m.link_model }}.{{ m2m.source_fk_field }} == {{ model.lower_name }}_id
    )
    result = await session.exec(statement)
    return result.one()

{% if m2m.order_field %}
async def get_{{ m2m.target_endpoint }}_with_order(
    session: AsyncSession,
    {{ model.lower_name }}_id: {{ model.id_type }},
    page: int = 1,
    size: int = 50,
) -> tuple[List[tuple], int]:
    """Get {{ m2m.target_model }}s with order field. Returns (items, total)."""
    skip = (page - 1) * size
    
    # Count total
    total = await count_{{ m2m.target_endpoint }}(session, {{ model.lower_name }}_id)
    
    if total == 0:
        return [], 0
    
    # Query with join
    from app.models.{{ m2m.target_source_module }} import {{ m2m.target_model }}
    statement = (
        select({{ m2m.target_model }}.id, {{ m2m.target_model }}.{{ m2m.label_field }}, {{ m2m.link_model }}.{{ m2m.order_field }})
        .join({{ m2m.link_model }}, {{ m2m.link_model }}.{{ m2m.target_fk_field }} == {{ m2m.target_model }}.id)
        .where({{ m2m.link_model }}.{{ m2m.source_fk_field }} == {{ model.lower_name }}_id)
        .order_by({{ m2m.link_model }}.{{ m2m.order_field }})
        .offset(skip)
        .limit(size)
    )
    result = await session.exec(statement)
    rows = result.all()
    
    return rows, total
{% endif %}
{% endfor %}
{% endif %}

