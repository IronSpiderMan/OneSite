@transactional_write
async def create(session: AsyncSession, obj_in: {{ model.name }}Create, *, auto_commit: bool = True) -> {{ model.name }}:
    # Note: validation should happen before, here we assume obj_in is valid pydantic model
    
    # Separate relationship payloads from concrete {{ model.name }} columns.
    {% if model.m2m_fields %}
    m2m_data = {}
    {% for m2m in model.m2m_fields %}
    if hasattr(obj_in, "{{ m2m.write_name }}"):
        m2m_data["{{ m2m.write_name }}"] = getattr(obj_in, "{{ m2m.write_name }}")
        delattr(obj_in, "{{ m2m.write_name }}")
    {% endfor %}
    {% endif %}
    inline_reverse_data = {}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    if hasattr(obj_in, "{{ rfk.write_name }}"):
        inline_reverse_data["{{ rfk.write_name }}"] = getattr(obj_in, "{{ rfk.write_name }}")
        delattr(obj_in, "{{ rfk.write_name }}")
    {% endif %}
    {% endfor %}

    # Convert to dict to handle nested Pydantic models in JSON fields
    {% if scalar_json_arrays %}
    obj_dict = _serialize_json_scalar_arrays(obj_in.dict(exclude_none=True))
    {% else %}
    obj_dict = obj_in.dict(exclude_none=True)
    {% endif %}
    {% if datetime_fields %}
    obj_dict = _normalize_datetimes(obj_dict)
    {% endif %}

    {% if model.dict_key_reference_meta %}
    await _validate_dict_key_references(session, obj_dict)
    {% endif %}

    {% if model.definition_binding_meta and model.definition_binding_meta.config_field %}
    # Initialize instance configuration from the selected definition.
    if not obj_dict.get("{{ model.definition_binding_meta.config_field }}"):
        definition_id = obj_dict.get("{{ model.definition_binding_meta.definition_fk }}")
        if definition_id is not None:
            definition = await session.get({{ model.definition_binding_meta.definition_model }}, definition_id)
            definitions = getattr(definition, "{{ model.definition_binding_meta.definitions_field }}", None) if definition else None
            if definitions:
                obj_dict["{{ model.definition_binding_meta.config_field }}"] = {
                    key: {{ model.definition_binding_meta.config_class }}().model_dump()
                    for key in definitions
                }
    {% endif %}

    db_obj = {{ model.name }}(**obj_dict)
    {% if model.fields | selectattr('name', 'equalto', 'updated_at') | list %}
    db_obj.updated_at = datetime.now(timezone.utc)
    {% endif %}
    hook_context = ModelHookContext(
        operation="create",
        input_data=dict(obj_dict),
        changed_fields=frozenset(obj_dict),
    )
    await invoke_model_hook(
        db_obj,
        "on_before_create",
        session=session,
        context=hook_context,
    )
    {% if datetime_fields %}
    _normalize_model_datetimes(db_obj)
    {% endif %}
    session.add(db_obj)
    await session.flush()
    await session.refresh(db_obj)
    
    {% if model.m2m_fields %}
    # Insert M2M relations
    {% for m2m in model.m2m_fields %}
    {% if m2m.editor == 'inline' %}
    if m2m_data.get("{{ m2m.write_name }}") is not None:
        await _sync_inline_{{ m2m.write_name }}(session, db_obj.id, m2m_data["{{ m2m.write_name }}"])
    {% else %}
    if m2m_data.get("{{ m2m.write_name }}") is not None:
        for idx, target_id in enumerate(m2m_data["{{ m2m.write_name }}"], start=1):
            link = {{ m2m.link_model }}(
                {{ m2m.source_fk_field }}=db_obj.id,
                {{ m2m.target_fk_field }}=target_id
                {% if m2m.order_field %}
                , {{ m2m.order_field }}=idx
                {% endif %}
            )
            session.add(link)
    {% endif %}
    {% endfor %}
    await session.flush()
    await session.refresh(db_obj)
    {% endif %}

    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    if inline_reverse_data.get("{{ rfk.write_name }}") is not None:
        await _sync_inline_{{ rfk.name }}(
            session, db_obj.id, inline_reverse_data["{{ rfk.write_name }}"]
        )
    {% endif %}
    {% endfor %}

    await invoke_model_hook(
        db_obj,
        "on_after_create",
        session=session,
        context=hook_context,
    )
    await session.flush()
    return db_obj

@transactional_write
async def update(session: AsyncSession, db_obj: {{ model.name }}, obj_in: {{ model.name }}Update, *, auto_commit: bool = True) -> {{ model.name }}:
    {% if scalar_json_arrays %}
    obj_data = _serialize_json_scalar_arrays(obj_in.dict(exclude_unset=True))
    {% else %}
    obj_data = obj_in.dict(exclude_unset=True)
    {% endif %}
    {% if datetime_fields %}
    obj_data = _normalize_datetimes(obj_data)
    {% endif %}
    {% if model.dict_key_reference_meta %}
    await _validate_dict_key_references(session, obj_data, db_obj)
    {% endif %}
    {% for reference in model.reverse_dict_key_references %}
    if "{{ reference.source_field }}" in obj_data:
        old_keys = set((getattr(db_obj, "{{ reference.source_field }}", None) or {}).keys())
        new_value = obj_data.get("{{ reference.source_field }}") or {}
        new_keys = set(new_value.keys())
        removed_keys = old_keys - new_keys
        if removed_keys:
            statement = (
                select({{ reference.source_model }})
                .where(
                    {{ reference.source_model }}.{{ reference.owner_fk }} == db_obj.id,
                    col({{ reference.source_model }}.{{ reference.reference_field }}).in_(removed_keys),
                )
                .limit(1)
            )
            result = await session.exec(statement)
            referenced = result.first()
            if referenced is not None:
                removed = ", ".join(sorted(removed_keys))
                raise ValueError(
                    f"Cannot remove {{ reference.source_field }} key(s) {removed}: "
                    "they are referenced by {{ reference.source_model }} records"
                )
    {% endfor %}
    inline_reverse_data = {}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    if "{{ rfk.write_name }}" in obj_data:
        inline_reverse_data["{{ rfk.write_name }}"] = obj_data.pop("{{ rfk.write_name }}")
    {% endif %}
    {% endfor %}
    
    old = snapshot_model(db_obj)
    hook_context = ModelHookContext(
        operation="update",
        input_data=dict(obj_data),
        changed_fields=frozenset(obj_data),
    )
    await invoke_model_hook(
        db_obj,
        "on_before_update",
        session=session,
        old=old,
        changes=obj_data,
        context=hook_context,
    )

    {% if model.m2m_fields %}
    # Handle M2M updates
    {% for m2m in model.m2m_fields %}
    if "{{ m2m.write_name }}" in obj_data:
        new_ids = obj_data.pop("{{ m2m.write_name }}")
        if new_ids is not None:
            {% if m2m.editor == 'inline' %}
            await _sync_inline_{{ m2m.write_name }}(session, db_obj.id, new_ids)
            {% else %}
            # 1. Clear existing relations
            # This is a naive implementation (delete all and re-insert). 
            # Better would be to calculate diff.
            statement = select({{ m2m.link_model }}).where({{ m2m.link_model }}.{{ m2m.source_fk_field }} == db_obj.id)
            result = await session.exec(statement)
            existing_links = result.all()
            for link in existing_links:
                await session.delete(link)
            
            # 2. Insert new relations
            for idx, target_id in enumerate(new_ids, start=1):
                link = {{ m2m.link_model }}(
                    {{ m2m.source_fk_field }}=db_obj.id,
                    {{ m2m.target_fk_field }}=target_id
                    {% if m2m.order_field %}
                    , {{ m2m.order_field }}=idx
                    {% endif %}
                )
                session.add(link)
            {% endif %}
    {% endfor %}
    {% endif %}

    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    if inline_reverse_data.get("{{ rfk.write_name }}") is not None:
        await _sync_inline_{{ rfk.name }}(
            session, db_obj.id, inline_reverse_data["{{ rfk.write_name }}"]
        )
    {% endif %}
    {% endfor %}
    
    {% if model.definition_binding_meta %}
    # Capture the old definition FK before setattr overwrites it.
    _old_definition_id = getattr(db_obj, "{{ model.definition_binding_meta.definition_fk }}", None)
    {% endif %}

    for key, value in obj_data.items():
        {% if model.definition_binding_meta and model.definition_binding_meta.config_field %}
        if key == "{{ model.definition_binding_meta.config_field }}" and value is not None:
            value = {k: (v if isinstance(v, dict) else v.model_dump()) for k, v in value.items()}
            {% if model.definition_binding_meta.key_policy != "free" %}
            definition_id = obj_data.get(
                "{{ model.definition_binding_meta.definition_fk }}",
                _old_definition_id,
            )
            definition = await session.get({{ model.definition_binding_meta.definition_model }}, definition_id) if definition_id is not None else None
            definition_keys = set(
                (getattr(definition, "{{ model.definition_binding_meta.definitions_field }}", None) or {}).keys()
            )
            config_keys = set(value.keys())
            {% if model.definition_binding_meta.key_policy == "definition" %}
            if config_keys != definition_keys:
                raise ValueError("Configuration keys must exactly match definition keys")
            {% else %}
            unknown_keys = config_keys - definition_keys
            if unknown_keys:
                raise ValueError("Unknown configuration keys: " + ", ".join(sorted(unknown_keys)))
            {% endif %}
            {% endif %}
        {% endif %}
        setattr(db_obj, key, value)

    {% if model.definition_binding_meta and model.definition_binding_meta.config_field %}
    # Apply the configured policy when the selected definition changes.
    if "{{ model.definition_binding_meta.definition_fk }}" in obj_data:
        new_definition_id = obj_data.get("{{ model.definition_binding_meta.definition_fk }}")
        if new_definition_id != _old_definition_id:
            definition = await session.get({{ model.definition_binding_meta.definition_model }}, new_definition_id) if new_definition_id is not None else None
            definitions = getattr(definition, "{{ model.definition_binding_meta.definitions_field }}", None) or {}
            {% if model.definition_binding_meta.on_definition_change == "reset" %}
            new_configs = {
                key: {{ model.definition_binding_meta.config_class }}().model_dump()
                for key in definitions
            }
            setattr(db_obj, "{{ model.definition_binding_meta.config_field }}", new_configs)
            {% elif model.definition_binding_meta.on_definition_change == "merge" %}
            old_configs = getattr(db_obj, "{{ model.definition_binding_meta.config_field }}", None) or {}
            new_configs = {
                key: old_configs.get(key, {{ model.definition_binding_meta.config_class }}().model_dump())
                for key in definitions
            }
            setattr(db_obj, "{{ model.definition_binding_meta.config_field }}", new_configs)
            {% endif %}
    {% endif %}

    {% if model.fields | selectattr('name', 'equalto', 'updated_at') | list %}
    db_obj.updated_at = datetime.now(timezone.utc)
    {% endif %}
    {% if datetime_fields %}
    _normalize_model_datetimes(db_obj)
    {% endif %}
    session.add(db_obj)
    await session.flush()
    await session.refresh(db_obj)
    await invoke_model_hook(
        db_obj,
        "on_after_update",
        session=session,
        old=old,
        changes=obj_data,
        context=hook_context,
    )
    await session.flush()
    return db_obj

@transactional_write
async def delete(session: AsyncSession, id: {{ model.id_type }}, *, auto_commit: bool = True) -> {{ model.id_type }}:
    db_obj = await session.get({{ model.name }}, {% if model.uses_composite_identity %}_decode_identity(id){% else %}id{% endif %})
    old = snapshot_model(db_obj)
    hook_context = ModelHookContext(
        operation="delete",
        input_data={},
        changed_fields=frozenset(),
    )
    await invoke_model_hook(
        db_obj,
        "on_before_delete",
        session=session,
        old=old,
        context=hook_context,
    )
    deleted_id = {% if model.uses_composite_identity %}get_identity(db_obj){% else %}db_obj.id{% endif %}
    await session.delete(db_obj)
    await session.flush()
    await invoke_model_hook(
        db_obj,
        "on_after_delete",
        session=session,
        old=old,
        context=hook_context,
    )
    await session.flush()
    return deleted_id

{% if model.is_notification_table %}
@transactional_write
async def mark_all_read_by_user(
    session: AsyncSession,
    user_id: int,
    *,
    auto_commit: bool = True,
) -> int:
    """
    Mark all unread notifications as read for a specific user.
    Returns the number of notifications updated.
    """
    from sqlmodel import update

    statement = (
        update({{ model.name }})
        .where({{ model.name }}.user_id == user_id)
        .where({{ model.name }}.is_read == False)
        .values(is_read=True)
    )
    result = await session.exec(statement)
    return result.rowcount
