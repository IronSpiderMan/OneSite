async def _sync_inline_{{ m2m.write_name }}(
    session: AsyncSession,
    parent_id: {{ model.id_type }},
    items: list,
) -> None:
    statement = select({{ m2m.link_model }}).where(
        {{ m2m.link_model }}.{{ m2m.source_fk_field }} == parent_id
    )
    result = await session.exec(statement)
    existing_links = list(result.all())
    links_by_target = {
        getattr(link, "{{ m2m.target_fk_field }}"): link for link in existing_links
    }
    kept_ids = set()

    for index, item in enumerate(items, start=1):
        data = item.model_dump(exclude_unset=True) if hasattr(item, "model_dump") else dict(item)
        target_id = data.pop("id", None)
        if target_id is None:
            missing = [
                name for name in [
                    {% for field in m2m.inline_fields %}
                    {% if field.required and not field.create_optional %}"{{ field.name }}",{% endif %}
                    {% endfor %}
                ]
                if data.get(name) is None
            ]
            if missing:
                raise ValueError("Missing required {{ m2m.target_model }} fields: " + ", ".join(missing))
            target = {{ m2m.target_model }}(**data)
            session.add(target)
            await session.flush()
            target_id = target.id
        else:
            link = links_by_target.get(target_id)
            if link is None and not {{ 'True' if m2m.allow_existing else 'False' }}:
                raise ValueError("{{ m2m.target_model }} is not related to this {{ model.name }}")
            target = await session.get({{ m2m.target_model }}, target_id)
            if target is None:
                raise ValueError("{{ m2m.target_model }} not found")
            for key, value in data.items():
                setattr(target, key, value)
            session.add(target)

        link = links_by_target.get(target_id)
        if link is None:
            link = {{ m2m.link_model }}(
                {{ m2m.source_fk_field }}=parent_id,
                {{ m2m.target_fk_field }}=target_id,
            )
            session.add(link)
        {% if m2m.order_field %}
        setattr(link, "{{ m2m.order_field }}", index)
        {% endif %}
        kept_ids.add(target_id)

    for target_id, link in links_by_target.items():
        if target_id not in kept_ids:
            await session.delete(link)


{% endif %}
