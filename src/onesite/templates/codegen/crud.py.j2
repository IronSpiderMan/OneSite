def get_identity(obj: {{ model.name }}) -> str:
    """Encode the composite database key for generic REST/UI routes."""
    payload = json.dumps(
        [getattr(obj, field) for field in {{ model.primary_key_columns | tojson }}],
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    return base64.urlsafe_b64encode(payload).decode("ascii").rstrip("=")


def _decode_identity(value: str) -> tuple:
    try:
        padding = "=" * (-len(value) % 4)
        decoded = json.loads(base64.urlsafe_b64decode(value + padding))
    except Exception as exc:
        raise ValueError("Invalid {{ model.name }} identity") from exc
    if not isinstance(decoded, list) or len(decoded) != {{ model.primary_key_columns | length }}:
        raise ValueError("Invalid {{ model.name }} identity")
    return tuple(decoded)


