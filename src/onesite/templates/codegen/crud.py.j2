    {{ field.name }}_from: Optional[datetime] = None,
    {{ field.name }}_to: Optional[datetime] = None,
    {% elif field.ui_type == 'time' %}
    {{ field.name }}: Optional[time] = None,
    {% elif field.is_enum and field.is_multi_select %}
    {{ field.name }}: Optional[List[str]] = None,
    {% elif field.is_enum %}
    {{ field.name }}: Optional[str] = None,
    {% elif field.fk_info %}
    {{ field.name }}: Optional[{{ field.fk_info.target_id_type }}] = None,
    {% elif field.ui_type == 'str' %}
    {{ field.name }}: Optional[str] = None,
    {% endif %}
    {% endif %}
    {% endfor %}
    {% for fk in model.foreign_keys %}
    {% if fk.name != model.owner_field and fk.name not in search_field_names %}
    {{ fk.name }}: Optional[{{ fk.target_id_type }}] = None,
    {% endif %}
    {% endfor %}
    {% if model.owner_field %}
    owner_id: Optional[int] = None,
    {% endif %}
) -> List[{{ model.name }}]:
    """
    Get list of objects with optional search and filter support.
    When size=-1, returns all matching records without pagination.
    Returns only the list of objects; use count() for total.
    """
    statement = select({{ model.name }})
    statement = _apply_filters(
        statement,
        {% for field in model.fields %}
        {% if field.is_search_field %}
        {% if field.ui_type == 'bool' %}
        {{ field.name }}={{ field.name }},
        {% elif field.ui_type == 'datetime' %}
        {{ field.name }}_from={{ field.name }}_from,
        {{ field.name }}_to={{ field.name }}_to,
        {% elif field.is_enum %}
        {{ field.name }}={{ field.name }},
        {% elif field.fk_info %}
        {{ field.name }}={{ field.name }},
        {% elif field.ui_type == 'str' %}
        {{ field.name }}={{ field.name }},
        {% endif %}
        {% endif %}
        {% endfor %}
        {% for fk in model.foreign_keys %}
        {% if fk.name != model.owner_field and fk.name not in search_field_names %}
        {{ fk.name }}={{ fk.name }},
        {% endif %}
        {% endfor %}
        {% if model.owner_field %}
        owner_id=owner_id,
        {% endif %}
    )

    sortable_fields = [{% for field in model.fields if field.ui_type in ['datetime', 'date', 'time'] and 'r' in field.permissions %}"{{ field.name }}", {% endfor %}]
    if sort_by is not None:
        if sort_by not in sortable_fields or sort_order not in ("asc", "desc"):
            raise ValueError("Invalid time sort")
        sort_column = col(getattr({{ model.name }}, sort_by))
        statement = statement.order_by(
            sort_column.asc().nulls_last() if sort_order == "asc" else sort_column.desc().nulls_last(),
            col({{ model.name }}.id).asc(),
        )
    else:
        pass
        {% if model.default_order_field %}
        statement = statement.order_by(col({{ model.name }}.{{ model.default_order_field }}).desc())
        {% elif model.has_created_at %}
        statement = statement.order_by(col({{ model.name }}.created_at).desc())
        {% endif %}

    # Apply pagination (skip if size == -1, meaning get all)
    if size != -1:
        skip = (page - 1) * size
        statement = statement.offset(skip).limit(size)

    result = await session.exec(statement)
    return list(result.all())


async def _enrich_with_fk_labels(
    session: AsyncSession,
    items: List[{{ model.name }}],
) -> List[Dict[str, Any]]:
    """Return serialized items enriched with configured foreign-key labels."""
    if not items:
        return []

    {% if model.foreign_keys %}
    # Collect unique FK IDs for batch fetch
    {% for fk in model.foreign_keys %}
    {{ fk.name }}_ids = list(set(getattr(item, "{{ fk.name }}") for item in items if getattr(item, "{{ fk.name }}") is not None))
    {% endfor %}

    # Batch fetch FK targets
    {% for fk in model.foreign_keys %}
    {{ fk.name }}_map = {}
    if {{ fk.name }}_ids:
        from app.models.{{ fk.target_source_module }} import {{ fk.target_model }}
        stmt = select({{ fk.target_model }}).where({{ fk.target_model }}.id.in_({{ fk.name }}_ids))
        result = await session.exec(stmt)
        for obj in result.all():
            {{ fk.name }}_map[obj.id] = getattr(obj, "{{ fk.label_field }}", None) or str(obj.id)
    {% endfor %}

    enriched = []
    for item in items:
        item_dict = item.model_dump()
        {% if model.uses_composite_identity %}
        item_dict["id"] = get_identity(item)
        {% endif %}
        {% for fk in model.foreign_keys %}
        fk_id = getattr(item, "{{ fk.name }}", None)
        item_dict["{{ fk.name }}_label"] = {{ fk.name }}_map.get(fk_id) if fk_id is not None else None
        {% endfor %}
        enriched.append(item_dict)
    return enriched
    {% else %}
    return [
        {
            **item.model_dump(),
            {% if model.uses_composite_identity %}"id": get_identity(item),{% endif %}
        }
        for item in items
    ]
    {% endif %}


async def get_with_fk_labels(
    session: AsyncSession,
    id: {{ model.id_type }},
) -> Optional[Dict[str, Any]]:
    """Get one object with the same FK label enrichment as list responses."""
    item = await get(session, id)
    if item is None:
        return None
    return (await _enrich_with_fk_labels(session, [item]))[0]


