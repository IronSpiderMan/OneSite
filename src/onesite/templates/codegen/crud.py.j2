{% if model.definition_binding_meta and model.definition_binding_meta.config_field %}
@transactional_write
async def update_definition_config(
    session: AsyncSession,
    entity_id: {{ model.id_type }},
    configs: dict[str, Any],
    *,
    auto_commit: bool = True,
) -> dict:
    """Validate and update the entity's definition-backed configuration."""
    entity = await session.get({{ model.name }}, entity_id)
    if not entity:
        raise ValueError("{{ model.name }} not found")

    {% if model.definition_binding_meta.key_policy != "free" %}
    definition_id = getattr(entity, "{{ model.definition_binding_meta.definition_fk }}", None)
    definition = await session.get({{ model.definition_binding_meta.definition_model }}, definition_id) if definition_id is not None else None
    definition_keys = set(
        (getattr(definition, "{{ model.definition_binding_meta.definitions_field }}", None) or {}).keys()
    )
    config_keys = set(configs.keys())
    {% if model.definition_binding_meta.key_policy == "definition" %}
    if config_keys != definition_keys:
        raise ValueError("Configuration keys must exactly match definition keys")
    {% else %}
    unknown_keys = config_keys - definition_keys
    if unknown_keys:
        raise ValueError("Unknown configuration keys: " + ", ".join(sorted(unknown_keys)))
    {% endif %}
    {% endif %}

    # Validate config entries with model class
    validated: dict[str, Any] = {}
    for key, c in configs.items():
        if isinstance(c, dict):
            validated[key] = {{ model.definition_binding_meta.config_class }}(**c).model_dump()
        elif hasattr(c, "model_dump"):
            validated[key] = c.model_dump()
        else:
            validated[key] = c

    setattr(entity, "{{ model.definition_binding_meta.config_field }}", validated)
    session.add(entity)
    await session.flush()
    await session.refresh(entity)
    return entity.model_dump()
{% endif %}

{% if model.union_key %}
# Union Key (Composite Key) lookup
async def get_by_{{ model.union_key | join('_') }}(
    session: AsyncSession,
    {% for key_field in model.union_key %}
    {{ key_field }}: {% if key_field.endswith('_id') %}int{% else %}str{% endif %}{% if not loop.last %},
    {% endif %}
    {% endfor %}
) -> Optional[{{ model.name }}]:
    """Get {{ model.name }} by composite key: {{ model.union_key | join(', ') }}."""
    statement = select({{ model.name }}).where(
        {% for key_field in model.union_key %}
        {{ model.name }}.{{ key_field }} == {{ key_field }}{% if not loop.last %},
        {% endif %}
        {% endfor %}
    )
    result = await session.exec(statement)
    return result.first()
{% endif %}
{% endif %}
