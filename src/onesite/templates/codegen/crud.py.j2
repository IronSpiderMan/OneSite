{% if model.dict_key_reference_meta %}
async def _validate_dict_key_references(
    session: AsyncSession,
    values: dict[str, Any],
    current: {{ model.name }} | None = None,
) -> None:
    """Validate application-level references to keys in FK-owned JSON maps."""
    {% for reference in model.dict_key_reference_meta %}
    owner_id = values.get(
        "{{ reference.owner_fk }}",
        getattr(current, "{{ reference.owner_fk }}", None),
    )
    reference_key = values.get(
        "{{ reference.field }}",
        getattr(current, "{{ reference.field }}", None),
    )
    if reference_key is not None:
        if owner_id is None:
            raise ValueError(
                "{{ model.name }}.{{ reference.field }} requires {{ reference.owner_fk }}"
            )
        owner = await session.get({{ reference.owner_model }}, owner_id)
        if owner is None:
            raise ValueError("{{ reference.owner_model }} not found")
        source = getattr(owner, "{{ reference.source_field }}", None) or {}
        if reference_key not in source:
            raise ValueError(
                f"Unknown {{ reference.source_field }} key {reference_key!r} "
                f"for {{ reference.owner_model }}({owner_id})"
            )
    {% endfor %}


{% endif %}
{% if datetime_fields %}
def _datetime_column_uses_timezone(field_name: str) -> bool:
    column = {{ model.name }}.__table__.columns.get(field_name)
    return bool(column is not None and getattr(column.type, "timezone", False))


def _normalize_datetime_for_storage(field_name: str, value: datetime) -> datetime:
    """Store UTC using the awareness expected by the mapped SQL column."""
    normalized = to_utc(value)
    if not _datetime_column_uses_timezone(field_name):
        return normalized.replace(tzinfo=None)
    return normalized


def _normalize_datetimes(data: dict) -> dict:
    """Interpret naive form values in the system timezone and persist UTC."""
    {% for field in datetime_fields %}
    if isinstance(data.get("{{ field.name }}"), datetime):
        data["{{ field.name }}"] = _normalize_datetime_for_storage(
            "{{ field.name }}", data["{{ field.name }}"]
        )
    {% endfor %}
    return data


def _normalize_model_datetimes(obj: Any) -> None:
    """Normalize model defaults and hook-assigned datetime values as well."""
    {% for field in datetime_fields %}
    value = getattr(obj, "{{ field.name }}", None)
    if isinstance(value, datetime):
        # PostgreSQL returns TIMESTAMP WITHOUT TIME ZONE as a naive datetime.
        # It is already in the column's storage representation; interpreting it
        # as a fresh local form value would shift it and mark an untouched field
        # dirty during unrelated updates.
        if value.tzinfo is not None or _datetime_column_uses_timezone("{{ field.name }}"):
            setattr(
                obj,
                "{{ field.name }}",
                _normalize_datetime_for_storage("{{ field.name }}", value),
            )
    {% endfor %}

{% endif %}
{% if scalar_json_arrays %}
def _serialize_json_scalar_arrays(data: dict) -> dict:
    """Convert date/time objects to JSON-safe ISO strings before persistence."""
    {% for field in scalar_json_arrays %}
    if isinstance(data.get("{{ field.name }}"), list):
        data["{{ field.name }}"] = [
            {% if field.json_item_kind == "datetime" %}
            to_utc(value).isoformat() if isinstance(value, datetime) else value
            {% else %}
            value.isoformat() if hasattr(value, "isoformat") else value
            {% endif %}
            for value in data["{{ field.name }}"]
        ]
    {% endfor %}
    return data

{% endif %}

