{% if model.property_config_meta %}
async def update_properties_config(
    session: AsyncSession,
    entity_id: {{ model.id_type }},
    configs: list[dict],
) -> dict:
    """Update properties_config on entity, with add/delete permission checks."""
    entity = await session.get({{ model.name }}, entity_id)
    if not entity:
        raise ValueError("{{ model.name }} not found")

    field_perms = "{{ model.property_config_meta.field_permissions }}"
    old_keys = set(getattr(entity, "{{ model.property_config_meta.field_name }}", {}).keys())
    new_keys = set(configs.keys())

    # Check add permission
    added = new_keys - old_keys
    if added and "a" not in field_perms:
        raise ValueError(
            "Adding items is not allowed: " + ", ".join(sorted(added))
        )
    # Check delete permission
    removed = old_keys - new_keys
    if removed and "l" not in field_perms:
        raise ValueError(
            "Deleting items is not allowed: " + ", ".join(sorted(removed))
        )

    # Validate config entries with model class
    validated: dict[str, Any] = {}
    for key, c in configs.items():
        if isinstance(c, dict):
            validated[key] = {{ model.property_config_meta.config_class }}(**c).model_dump()
        elif hasattr(c, "model_dump"):
            validated[key] = c.model_dump()
        else:
            validated[key] = c

    setattr(entity, "{{ model.property_config_meta.field_name }}", validated)
    session.add(entity)
    await session.commit()
    await session.refresh(entity)
    return entity.model_dump()
{% endif %}

{% if model.union_key %}
# Union Key (Composite Key) lookup
async def get_by_{{ model.union_key | join('_') }}(
    session: AsyncSession,
    {% for key_field in model.union_key %}
    {{ key_field }}: {% if key_field.endswith('_id') %}int{% else %}str{% endif %}{% if not loop.last %},
    {% endif %}
    {% endfor %}
) -> Optional[{{ model.name }}]:
    """Get {{ model.name }} by composite key: {{ model.union_key | join(', ') }}."""
    statement = select({{ model.name }}).where(
        {% for key_field in model.union_key %}
        {{ model.name }}.{{ key_field }} == {{ key_field }}{% if not loop.last %},
        {% endif %}
        {% endfor %}
    )
    result = await session.exec(statement)
    return result.first()
{% endif %}
{% endif %}
