@transactional_write
async def create(session: AsyncSession, obj_in: {{ model.name }}Create, *, auto_commit: bool = True) -> {{ model.name }}:
    """Insert a timeseries record into hypertable and upsert latest table."""
    {% if scalar_json_arrays %}
    obj_dict = _serialize_json_scalar_arrays(obj_in.dict(exclude_none=True))
    {% else %}
    obj_dict = obj_in.dict(exclude_none=True)
    {% endif %}
    {% if datetime_fields %}
    obj_dict = _normalize_datetimes(obj_dict)
    {% endif %}
    {% if model.dict_key_reference_meta %}
    await _validate_dict_key_references(session, obj_dict)
    {% endif %}
    db_obj = {{ model.name }}(**obj_dict)
    hook_context = ModelHookContext(
        operation="create",
        input_data=dict(obj_dict),
        changed_fields=frozenset(obj_dict),
    )
    await invoke_model_hook(
        db_obj,
        "on_before_create",
        session=session,
        context=hook_context,
    )
    {% if datetime_fields %}
    _normalize_model_datetimes(db_obj)
    {% endif %}
    session.add(db_obj)
    await session.flush()
    await session.refresh(db_obj)

    {% if not is_postgresql %}
    # Upsert latest table (PostgreSQL uses a DB trigger for this)
    from sqlalchemy import text
    entity_val = getattr(db_obj, "{{ model.timescaledb_entity_field }}")
    time_val = getattr(db_obj, "{{ model.timescaledb_time_column }}")
    json_val = db_obj.model_dump_json()
    {% if model.timescaledb_metric_field %}
    metric_val = getattr(db_obj, "{{ model.timescaledb_metric_field }}")
    await session.execute(
        text("""
            INSERT INTO {{ model.timescaledb_latest_table_name }}
            ({{ model.timescaledb_entity_field }}, {{ model.timescaledb_metric_field }}, value, {{ model.timescaledb_time_column }})
            VALUES (:entity, :metric, :value::jsonb, :time)
            ON CONFLICT ({{ model.timescaledb_entity_field }}, {{ model.timescaledb_metric_field }})
            DO UPDATE SET value = :value::jsonb, {{ model.timescaledb_time_column }} = :time
            WHERE :time >= {{ model.timescaledb_latest_table_name }}.{{ model.timescaledb_time_column }}
        """),
        {"entity": entity_val, "metric": metric_val, "value": json_val, "time": time_val},
    )
    {% else %}
    await session.execute(
        text("""
            INSERT INTO {{ model.timescaledb_latest_table_name }}
            ({{ model.timescaledb_entity_field }}, value, {{ model.timescaledb_time_column }})
            VALUES (:entity, :value::jsonb, :time)
            ON CONFLICT ({{ model.timescaledb_entity_field }})
            DO UPDATE SET value = :value::jsonb, {{ model.timescaledb_time_column }} = :time
            WHERE :time >= {{ model.timescaledb_latest_table_name }}.{{ model.timescaledb_time_column }}
        """),
        {"entity": entity_val, "value": json_val, "time": time_val},
    )
    {% endif %}
    {% endif %}

    await invoke_model_hook(
        db_obj,
        "on_after_create",
        session=session,
        context=hook_context,
    )
    await session.flush()
    return db_obj


async def get_realtime_by_entity(
    session: AsyncSession,
    entity_id: str,
) -> list[dict]:
    """Get latest values for each metric of a given entity from the latest table."""
    from sqlalchemy import text
    {% if model.timescaledb_entity_sql_type == "INTEGER" %}
    entity_id = int(entity_id)  # entity_id comes as str from query param; convert for DB
    {% endif %}
    query = text("""
        SELECT latest_metric.*
        {% if model.timescaledb_metric_label_field %}, metric_meta.{{ model.timescaledb_metric_label_field }} AS metric_label{% endif %}
        {% if model.timescaledb_metric_data_type_field %}, metric_meta.{{ model.timescaledb_metric_data_type_field }} AS metric_data_type{% endif %}
        {% if model.timescaledb_metric_unit_field %}, metric_meta.{{ model.timescaledb_metric_unit_field }} AS metric_unit{% endif %}
        FROM {{ model.timescaledb_latest_table_name }} AS latest_metric
        {% if model.timescaledb_metric_label_field %}
        LEFT JOIN {{ model.timescaledb_metric_target_table }} AS metric_meta
          ON metric_meta.{{ model.timescaledb_metric_target_field }} = latest_metric.{{ model.timescaledb_metric_field }}
          {% if model.timescaledb_metric_target_field != 'id' %}
         AND metric_meta.{{ model.timescaledb_entity_field }} = latest_metric.{{ model.timescaledb_entity_field }}
          {% endif %}
        {% endif %}
        WHERE latest_metric.{{ model.timescaledb_entity_field }} = :entity
        ORDER BY latest_metric.{{ model.timescaledb_time_column }} DESC
    """)
    result = await session.execute(query, {"entity": entity_id})
    rows = result.fetchall()
    # Return as list of dicts
    columns = result.keys()
    return [dict(zip(columns, row)) for row in rows]


async def get_history_by_entity(
    session: AsyncSession,
    entity_id: str,
    metric: str | None = None,
    start_time: datetime | None = None,
    end_time: datetime | None = None,
    limit: int = 1000,
    per_metric: bool = False,
) -> list[dict]:
    """Get historical timeseries data for an entity from hypertable."""
    from sqlalchemy import text
    {% if model.timescaledb_entity_sql_type == "INTEGER" %}
    entity_id = int(entity_id)  # entity_id comes as str from query param; convert for DB
    {% endif %}

    conditions = ["{{ model.timescaledb_entity_field }} = :entity"]
    params: dict = {"entity": entity_id}

    {% if model.timescaledb_metric_field %}
    if metric is not None:
        conditions.append("{{ model.timescaledb_metric_field }} = :metric")
        params["metric"] = metric
    {% endif %}
    if start_time is not None:
        conditions.append("{{ model.timescaledb_time_column }} >= :start")
        params["start"] = start_time
    if end_time is not None:
        conditions.append("{{ model.timescaledb_time_column }} <= :end")
        params["end"] = end_time

    where_clause = " AND ".join(conditions)
    {% if model.timescaledb_metric_field %}
    if per_metric and metric is None and limit >= 0:
        per_metric_conditions = [
            "source_rows.{{ model.timescaledb_entity_field }} = :entity"
        ]
        if start_time is not None:
            per_metric_conditions.append(
                "source_rows.{{ model.timescaledb_time_column }} >= :start"
            )
        if end_time is not None:
            per_metric_conditions.append(
                "source_rows.{{ model.timescaledb_time_column }} <= :end"
            )
        per_metric_where = " AND ".join(per_metric_conditions)
        query = text(f"""
            SELECT history_rows.*
            FROM {{ model.timescaledb_latest_table_name }} AS latest_metric
            CROSS JOIN LATERAL (
                SELECT source_rows.*
                FROM {{ model.table_name }} AS source_rows
                WHERE {per_metric_where}
                  AND source_rows.{{ model.timescaledb_metric_field }} =
                      latest_metric.{{ model.timescaledb_metric_field }}
                ORDER BY source_rows.{{ model.timescaledb_time_column }} DESC
                LIMIT :limit
            ) AS history_rows
            WHERE latest_metric.{{ model.timescaledb_entity_field }} = :entity
            ORDER BY history_rows.{{ model.timescaledb_time_column }} DESC
        """)
    else:
    {% endif %}
        query = text(f"""
            SELECT *
            FROM {{ model.table_name }}
            WHERE {where_clause}
            ORDER BY {{ model.timescaledb_time_column }} DESC
            LIMIT NULLIF(:limit, -1)
        """)
    params["limit"] = limit
    result = await session.execute(query, params)
    rows = result.fetchall()
    return [dict(row._mapping) for row in rows]

