{% if rfk.editor == 'inline' %}
async def _sync_inline_{{ rfk.name }}(
    session: AsyncSession,
    parent_id: {{ model.id_type }},
    items: list,
) -> None:
    statement = select({{ rfk.source_model }}).where(
        {{ rfk.source_model }}.{{ rfk.source_fk_field }} == parent_id
    )
    result = await session.exec(statement)
    existing = {item.id: item for item in result.all()}
    kept_ids = set()

    for item in items:
        data = item.model_dump(exclude_unset=True) if hasattr(item, "model_dump") else dict(item)
        item_id = data.pop("id", None)
        data.pop("{{ rfk.source_fk_field }}", None)
        if item_id is None:
            missing = [
                name for name in [
                    {% for field in rfk.inline_fields %}
                    {% if field.required and not field.create_optional %}"{{ field.name }}",{% endif %}
                    {% endfor %}
                ]
                if data.get(name) is None
            ]
            if missing:
                raise ValueError("Missing required {{ rfk.source_model }} fields: " + ", ".join(missing))
            child = {{ rfk.source_model }}(**data)
            setattr(child, "{{ rfk.source_fk_field }}", parent_id)
            session.add(child)
            await session.flush()
            kept_ids.add(child.id)
        else:
            child = existing.get(item_id)
            if child is None:
                raise ValueError("{{ rfk.source_model }} is not related to this {{ model.name }}")
            for key, value in data.items():
                setattr(child, key, value)
            session.add(child)
            kept_ids.add(item_id)

    for item_id, child in existing.items():
        if item_id in kept_ids:
            continue
        {% if rfk.on_remove == 'nullify' %}
        setattr(child, "{{ rfk.source_fk_field }}", None)
        session.add(child)
        {% else %}
        await session.delete(child)
        {% endif %}


{% endif %}
{% endfor %}
