async def get_{{ m2m.target_endpoint }}(
    session: AsyncSession,
    {{ model.lower_name }}_id: {{ model.id_type }},
    page: int = 1,
    size: int = 20,
) -> List[Dict[str, Any]]:
    """Get list of {{ m2m.target_model }} objects related to {{ model.name }}, enriched with FK labels."""
