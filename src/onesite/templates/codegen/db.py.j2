from functools import wraps
from typing import AsyncGenerator, Awaitable, Callable, ParamSpec, TypeVar
from pathlib import Path
from sqlalchemy.ext.asyncio import create_async_engine
from sqlalchemy.engine import make_url
from sqlmodel import SQLModel
from sqlmodel.ext.asyncio.session import AsyncSession
from sqlalchemy.orm import sessionmaker
from sqlalchemy import text
from app.core.config import settings

P = ParamSpec("P")
R = TypeVar("R")


def transactional_write(
    function: Callable[P, Awaitable[R]],
) -> Callable[P, Awaitable[R]]:
    """Commit a CRUD write by default while allowing caller-owned transactions."""
    @wraps(function)
    async def wrapper(*args: P.args, **kwargs: P.kwargs) -> R:
        auto_commit = kwargs.get("auto_commit", True)
        session = kwargs["session"] if "session" in kwargs else args[0]
        try:
            result = await function(*args, **kwargs)
            if auto_commit:
                await session.commit()
            return result
        except Exception:
            if auto_commit:
                await session.rollback()
            raise

    return wrapper

# Parse DATABASE_URI to determine async driver
database_url = settings.DATABASE_URI
if database_url.startswith(("sqlite://", "sqlite+aiosqlite://")):
    # Ensure aiosqlite driver
    if not database_url.startswith("sqlite+aiosqlite://"):
        database_url = database_url.replace("sqlite://", "sqlite+aiosqlite://")

    # SQLite cannot create a missing parent directory. Container deployments
    # commonly mount /app/data, while local development uses a relative path.
    sqlite_database = make_url(database_url).database
    if sqlite_database and sqlite_database != ":memory:":
        sqlite_path = Path(sqlite_database)
        if not sqlite_path.is_absolute():
            sqlite_path = Path.cwd() / sqlite_path
        if sqlite_path.exists() and sqlite_path.is_dir():
            raise RuntimeError(
                f"SQLite database path points to a directory: {sqlite_path}. "
                "Mount a directory at /app/data and use "
                "sqlite+aiosqlite:////app/data/app.db."
            )
        sqlite_path.parent.mkdir(parents=True, exist_ok=True)
elif database_url.startswith("postgresql://"):
    # Ensure asyncpg driver
    if not "postgresql+asyncpg://" in database_url:
        database_url = database_url.replace("postgresql://", "postgresql+asyncpg://")

# Create Async Engine
engine = create_async_engine(database_url, future=True)

async def init_db():
    # Register every database model before create_all. Link/association tables
    # may not have API endpoints, so endpoint imports alone are insufficient.
    {% for module in model_imports %}
    import {{ module }}  # noqa: F401
    {% endfor %}
    # Runtime-owned models are not part of the user's regular model set.
    {% if background_execution_enabled %}
    import app.core.background_execution  # noqa: F401
    {% endif %}
    # Ensure _latest table models are imported so SQLModel.metadata knows about them
    {% for module in latest_table_imports %}
    import {{ module }}  # noqa: F401
    {% endfor %}
    async with engine.begin() as conn:
        await conn.run_sync(SQLModel.metadata.create_all)
        {% for index in generated_indexes %}
        await conn.execute(text({{ index.sql_literal }}))
        {% endfor %}
    {% if external_resources_enabled %}
    # Keep external-resource schema ownership in its runtime module. This is
    # also the only schema initialization the standalone reconciler performs.
    from app.core.external_resources import init_external_resource_db
    await init_external_resource_db()
    {% endif %}
    {% if background_execution_enabled %}
    if settings.DATABASE_URI.startswith("postgresql"):
        # Older generated projects created these columns as timestamp without
        # time zone even though the runtime writes timezone-aware UTC values.
        # create_all does not alter existing columns, so upgrade them once.
        async with engine.begin() as conn:
            await conn.execute(text("""
                DO $$
                DECLARE
                    target_column TEXT;
                BEGIN
                    FOREACH target_column IN ARRAY ARRAY[
                        'created_at', 'started_at', 'completed_at'
                    ]
                    LOOP
                        IF EXISTS (
                            SELECT 1
                            FROM information_schema.columns
                            WHERE table_schema = current_schema()
                              AND table_name = 'onesite_background_execution'
                              AND information_schema.columns.column_name = target_column
                              AND data_type = 'timestamp without time zone'
                        ) THEN
                            EXECUTE format(
                                'ALTER TABLE onesite_background_execution '
                                'ALTER COLUMN %I TYPE TIMESTAMPTZ '
                                'USING %I AT TIME ZONE ''UTC''',
                                target_column,
                                target_column
                            );
                        END IF;
                    END LOOP;
                END $$;
            """))
    {% endif %}
    {% if has_timescaledb %}
    if settings.DATABASE_URI.startswith("postgresql"):
        # ── TimescaleDB: create hypertables ──
        {% for ts_model in timescaledb_models %}
        async with engine.begin() as conn:
            await conn.execute(
                text("SELECT create_hypertable('{{ ts_model.table_name }}', '{{ ts_model.timescaledb_time_column }}', "
                     "if_not_exists => TRUE{% if ts_model.timescaledb_lifecycle.chunk_interval %}, chunk_time_interval => INTERVAL '{{ ts_model.timescaledb_lifecycle.chunk_interval }}'{% endif %})")
            )
            {% if ts_model.timescaledb_lifecycle.chunk_interval %}
            await conn.execute(text(
                "SELECT set_chunk_time_interval('{{ ts_model.table_name }}', "
                "INTERVAL '{{ ts_model.timescaledb_lifecycle.chunk_interval }}')"
            ))
            {% endif %}
        {% endfor %}

        # ── TimescaleDB lifecycle policies ──
        {% for ts_model in timescaledb_models %}
        {% set lifecycle = ts_model.timescaledb_lifecycle %}
        {% if lifecycle.compress_after %}
        async with engine.begin() as conn:
            await conn.execute(text("""
                ALTER TABLE {{ ts_model.table_name }} SET (
                    timescaledb.compress,
                    timescaledb.compress_segmentby = '{{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %},{{ ts_model.timescaledb_metric_field }}{% endif %}',
                    timescaledb.compress_orderby = '{{ ts_model.timescaledb_time_column }} DESC'
                )
            """))
            await conn.execute(text(
                "SELECT add_compression_policy('{{ ts_model.table_name }}', "
                "INTERVAL '{{ lifecycle.compress_after }}', if_not_exists => TRUE)"
            ))
        {% endif %}
        {% if lifecycle.retention_after %}
        async with engine.begin() as conn:
            await conn.execute(text(
                "SELECT add_retention_policy('{{ ts_model.table_name }}', "
                "INTERVAL '{{ lifecycle.retention_after }}', if_not_exists => TRUE)"
            ))
        {% endif %}
        {% if lifecycle.bucket_interval %}
        async with engine.begin() as conn:
            await conn.execute(text("""
                CREATE MATERIALIZED VIEW IF NOT EXISTS {{ ts_model.timescaledb_continuous_aggregate_name }}
                WITH (timescaledb.continuous) AS
                SELECT
                    time_bucket(INTERVAL '{{ lifecycle.bucket_interval }}', {{ ts_model.timescaledb_time_column }}) AS bucket,
                    {{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %},
                    {{ ts_model.timescaledb_metric_field }}{% endif %},
                    COUNT(*)::BIGINT AS sample_count,
                    first(value, {{ ts_model.timescaledb_time_column }}) AS first_value,
                    last(value, {{ ts_model.timescaledb_time_column }}) AS last_value
                FROM {{ ts_model.table_name }}
                GROUP BY bucket, {{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %}, {{ ts_model.timescaledb_metric_field }}{% endif %}
                WITH NO DATA
            """))
            await conn.execute(text(
                "SELECT add_continuous_aggregate_policy('{{ ts_model.timescaledb_continuous_aggregate_name }}', "
                "start_offset => {% if lifecycle.refresh_start_offset %}INTERVAL '{{ lifecycle.refresh_start_offset }}'{% else %}NULL{% endif %}, "
                "end_offset => INTERVAL '{{ lifecycle.refresh_end_offset }}', "
                "schedule_interval => INTERVAL '{{ lifecycle.refresh_schedule_interval }}', "
                "if_not_exists => TRUE)"
            ))
        {% endif %}
        {% endfor %}

        # ── TimescaleDB: create latest-data tables ──
        {% for ts_model in timescaledb_models %}
        async with engine.begin() as conn:
            await conn.execute(
                text("""
                    CREATE TABLE IF NOT EXISTS {{ ts_model.timescaledb_latest_table_name }} (
                        {{ ts_model.timescaledb_entity_field }} {{ ts_model.get('timescaledb_entity_sql_type', 'INTEGER') }} NOT NULL{% if ts_model.get('timescaledb_entity_target_table') %} REFERENCES {{ ts_model.timescaledb_entity_target_table }}(id){% endif %}
                        {% if ts_model.timescaledb_metric_field %},
                        {{ ts_model.timescaledb_metric_field }} TEXT NOT NULL
                        {% endif %},
                        value JSONB NOT NULL,
                        {{ ts_model.timescaledb_time_column }} TIMESTAMPTZ NOT NULL,
                        PRIMARY KEY ({{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %}, {{ ts_model.timescaledb_metric_field }}{% endif %})
                    )
                """)
            )
        {% endfor %}

        # ── TimescaleDB: create triggers to auto-sync _latest on insert ──
        {% for ts_model in timescaledb_models %}
        async with engine.begin() as conn:
            await conn.execute(text("DROP TRIGGER IF EXISTS trg_sync_{{ ts_model.table_name }}_latest ON {{ ts_model.table_name }}"))
            await conn.execute(text("""
                CREATE OR REPLACE FUNCTION fn_sync_{{ ts_model.table_name }}_latest()
                RETURNS TRIGGER AS $$
                BEGIN
                    INSERT INTO {{ ts_model.timescaledb_latest_table_name }} (
                        {{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %},
                        {{ ts_model.timescaledb_metric_field }}{% endif %},
                        value,
                        {{ ts_model.timescaledb_time_column }}
                    )
                    VALUES (
                        NEW.{{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %},
                        NEW.{{ ts_model.timescaledb_metric_field }}{% endif %},
                        NEW.value,
                        NEW.{{ ts_model.timescaledb_time_column }}
                    )
                    ON CONFLICT ({{ ts_model.timescaledb_entity_field }}{% if ts_model.timescaledb_metric_field %}, {{ ts_model.timescaledb_metric_field }}{% endif %})
                    DO UPDATE SET
                        value = EXCLUDED.value,
                        {{ ts_model.timescaledb_time_column }} = EXCLUDED.{{ ts_model.timescaledb_time_column }}
                    WHERE EXCLUDED.{{ ts_model.timescaledb_time_column }} >=
                          {{ ts_model.timescaledb_latest_table_name }}.{{ ts_model.timescaledb_time_column }};
                    {% for projection in ts_model.get('health_projections', []) %}
                    INSERT INTO onesite_external_resource_health (
                        provider, resource_type, entity_id, last_seen_at, updated_at
                    ) VALUES (
                        '{{ projection.provider }}',
                        '{{ projection.resource_type }}',
                        NEW.{{ projection.entity_field }}::TEXT,
                        LEAST(NEW.{{ projection.time_field }}, NOW()),
                        NOW()
                    )
                    ON CONFLICT (provider, resource_type, entity_id)
                    DO UPDATE SET
                        last_seen_at = GREATEST(
                            onesite_external_resource_health.last_seen_at,
                            EXCLUDED.last_seen_at
                        ),
                        updated_at = NOW()
                    WHERE EXCLUDED.last_seen_at >
                          onesite_external_resource_health.last_seen_at;
                    {% endfor %}
                    RETURN NEW;
                END;
                $$ LANGUAGE plpgsql
            """))
            await conn.execute(text("""
                CREATE TRIGGER trg_sync_{{ ts_model.table_name }}_latest
                AFTER INSERT ON {{ ts_model.table_name }}
                FOR EACH ROW
                EXECUTE FUNCTION fn_sync_{{ ts_model.table_name }}_latest()
            """))
        {% endfor %}

        # Backfill health rows when upgrading projects that already contain
        # latest telemetry. This is idempotent and timestamps never regress.
        {% for ts_model in timescaledb_models %}
        {% for projection in ts_model.get('health_projections', []) %}
        async with engine.begin() as conn:
            await conn.execute(text("""
                INSERT INTO onesite_external_resource_health (
                    provider, resource_type, entity_id, last_seen_at, updated_at
                )
                SELECT
                    '{{ projection.provider }}',
                    '{{ projection.resource_type }}',
                    {{ projection.entity_field }}::TEXT,
                    LEAST(MAX({{ projection.time_field }}), NOW()),
                    NOW()
                FROM {{ ts_model.timescaledb_latest_table_name }}
                GROUP BY {{ projection.entity_field }}
                ON CONFLICT (provider, resource_type, entity_id)
                DO UPDATE SET
                    last_seen_at = GREATEST(
                        onesite_external_resource_health.last_seen_at,
                        EXCLUDED.last_seen_at
                    ),
                    updated_at = NOW()
                WHERE EXCLUDED.last_seen_at >
                      onesite_external_resource_health.last_seen_at
            """))
        {% endfor %}
        {% endfor %}
    {% endif %}

async def get_session() -> AsyncGenerator[AsyncSession, None]:
    async_session = sessionmaker(
        engine, class_=AsyncSession, expire_on_commit=False
    )
    async with async_session() as session:
        yield session
