import React, { useCallback, useEffect, useState } from 'react';
import { RefreshCw, RotateCcw, ShieldCheck } from 'lucide-react';
import { toast } from 'sonner';
import {
  ExternalProviderState,
  getExternalProviders,
  reconcileExternalProvider,
  reconcileExternalProviders,
} from '../services/external-resources';

const statusColor: Record<string, string> = {
  unknown: 'bg-slate-100 text-slate-700',
  syncing: 'bg-violet-100 text-violet-700',
  synced: 'bg-emerald-100 text-emerald-700',
  degraded: 'bg-red-100 text-red-700',
};

export default function ExternalResourcesPage() {
  const [rows, setRows] = useState<ExternalProviderState[]>([]);
  const [loading, setLoading] = useState(true);
  const load = useCallback(async () => {
    setLoading(true);
    try { setRows(await getExternalProviders()); }
    finally { setLoading(false); }
  }, []);

  useEffect(() => {
    void load();
    const id = window.setInterval(load, 5000);
    return () => window.clearInterval(id);
  }, [load]);

  const reconcileAll = async () => {
    await reconcileExternalProviders();
    toast.success('Provider 全局同步完成');
    await load();
  };

  const reconcileOne = async (provider: string) => {
    await reconcileExternalProvider(provider);
    toast.success(`${provider} 同步完成`);
    await load();
  };

  return <div className="flex h-full min-h-0 flex-col gap-5 p-6">
    <div className="flex shrink-0 items-center justify-between">
      <div>
        <h1 className="text-2xl font-semibold">外部 Provider 同步</h1>
        <p className="text-sm text-muted-foreground">查看外部系统的整体同步与健康状态</p>
      </div>
      <div className="flex items-center gap-3">
        <button className="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm" onClick={() => void reconcileAll()}>
          <ShieldCheck className="h-4 w-4" />全局同步
        </button>
        <button className="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm" onClick={() => void load()}>
          <RefreshCw className="h-4 w-4" />刷新
        </button>
      </div>
    </div>
    <div className="min-h-0 flex-1 overflow-auto rounded-lg border bg-card">
      <table className="w-full text-sm">
        <thead className="sticky top-0 z-20 border-b bg-muted text-left shadow-sm"><tr>
          <th className="p-3">Provider</th><th className="p-3">状态</th>
          <th className="p-3">同步代次</th><th className="p-3">检查</th>
          <th className="p-3">修复</th><th className="p-3">失败</th>
          <th className="p-3">最近同步</th><th className="p-3">操作</th>
        </tr></thead>
        <tbody>
          {rows.map(row => <tr className="border-b last:border-0" key={row.provider}>
            <td className="p-3 font-medium">{row.provider}</td>
            <td className="p-3">
              <span className={`rounded-full px-2 py-1 text-xs ${statusColor[row.status]}`}>{row.status}</span>
              {row.last_error && <div className="mt-1 max-w-md truncate text-xs text-red-600" title={row.last_error}>{row.last_error}</div>}
            </td>
            <td className="p-3" title="已同步 / 目标">{row.synced_generation}/{row.desired_generation}</td>
            <td className="p-3">{row.checked_count}</td><td className="p-3">{row.changed_count}</td>
            <td className="p-3">{row.failed_count}</td>
            <td className="p-3">{row.last_synced_at ? new Date(row.last_synced_at).toLocaleString() : '—'}</td>
            <td className="p-3"><button className="inline-flex items-center gap-1 rounded border px-2 py-1" disabled={row.status === 'syncing'} onClick={() => void reconcileOne(row.provider)}><RotateCcw className="h-3 w-3" />同步</button></td>
          </tr>)}
          {!loading && rows.length === 0 && <tr><td className="p-8 text-center text-muted-foreground" colSpan={8}>暂无 External Resource Provider</td></tr>}
          {loading && rows.length === 0 && <tr><td className="p-8 text-center text-muted-foreground" colSpan={8}>加载中…</td></tr>}
        </tbody>
      </table>
    </div>
  </div>;
}
