import React, { useCallback, useEffect, useState } from 'react';
import { RefreshCw, RotateCcw } from 'lucide-react';
import { toast } from 'sonner';
import {
  ExternalResourceTask,
  getExternalResourceTasks,
  retryExternalResourceTask,
} from '../services/external-resources';

const statusColor: Record<string, string> = {
  pending: 'bg-blue-100 text-blue-700',
  processing: 'bg-violet-100 text-violet-700',
  retry: 'bg-amber-100 text-amber-700',
  failed: 'bg-red-100 text-red-700',
};

export default function ExternalResourcesPage() {
  const [rows, setRows] = useState<ExternalResourceTask[]>([]);
  const [loading, setLoading] = useState(true);
  const load = useCallback(async () => {
    setLoading(true);
    try { setRows((await getExternalResourceTasks()).items); }
    finally { setLoading(false); }
  }, []);

  useEffect(() => {
    void load();
    const id = window.setInterval(load, 5000);
    return () => window.clearInterval(id);
  }, [load]);

  const retry = async (row: ExternalResourceTask) => {
    await retryExternalResourceTask(row.id);
    toast.success('同步任务已重新入队');
    await load();
  };

  return <div className="space-y-5 p-6">
    <div className="flex items-center justify-between">
      <div>
        <h1 className="text-2xl font-semibold">外部资源同步</h1>
        <p className="text-sm text-muted-foreground">待处理与失败的 Provider CUD 任务</p>
      </div>
      <button className="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm" onClick={() => void load()}>
        <RefreshCw className="h-4 w-4" />刷新
      </button>
    </div>
    <div className="overflow-hidden rounded-lg border bg-card">
      <table className="w-full text-sm"><thead className="border-b bg-muted/40 text-left"><tr>
        <th className="p-3">Provider</th><th className="p-3">资源</th><th className="p-3">业务 ID</th><th className="p-3">操作</th><th className="p-3">状态</th><th className="p-3">尝试</th><th className="p-3">错误</th><th className="p-3">操作</th>
      </tr></thead><tbody>
        {rows.map(row => <tr className="border-b last:border-0" key={row.id}>
          <td className="p-3 font-medium">{row.provider}</td><td className="p-3">{row.resource}</td><td className="p-3 font-mono text-xs">{row.entity_id}</td><td className="p-3">{row.operation}</td>
          <td className="p-3"><span className={`rounded-full px-2 py-1 text-xs ${statusColor[row.status]}`}>{row.status}</span></td><td className="p-3">{row.attempts}</td>
          <td className="p-3"><div className="max-w-xs truncate text-xs text-red-600" title={row.last_error}>{row.last_error || '—'}</div></td>
          <td className="p-3">{row.status === 'failed' && <button className="inline-flex items-center gap-1 rounded border px-2 py-1" onClick={() => void retry(row)}><RotateCcw className="h-3 w-3" />重试</button>}</td>
        </tr>)}
        {!loading && rows.length === 0 && <tr><td className="p-8 text-center text-muted-foreground" colSpan={8}>没有待处理或失败任务</td></tr>}
        {loading && rows.length === 0 && <tr><td className="p-8 text-center text-muted-foreground" colSpan={8}>加载中…</td></tr>}
      </tbody></table>
    </div>
  </div>;
}
