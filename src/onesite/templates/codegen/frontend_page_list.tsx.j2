                                }}
                            />
                        )} />
                        {% elif field.ui_type == 'time' %}
                        <Controller control={control} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
                            <TimePicker value={value} onChange={onChange} />
                        )} />
                        {% elif field.ui_type == 'location' %}
                        <Controller control={control} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
                            <LocationInput value={value} onChange={onChange} />
                        )} />
                        {% elif field.ui_type == 'json' %}
                        <Controller control={control} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
                            <JsonInput value={value} onChange={onChange} jsonKind="{{ field.json_kind or 'object' }}" />
                        )} />
                        {% else %}
                        <Input
                            aria-label={t('{{ field.label_key }}')}
                            {% if field.ui_type == 'int' or field.ui_type == 'float' %}type="number"{% elif field.ui_type == 'datetime' %}type="datetime-local"{% elif field.ui_type == 'date' %}type="date"{% else %}type="text"{% endif %}
                            {% if field.minimum is not none %}min={ {{ field.minimum }} }{% endif %}
                            {% if field.maximum is not none %}max={ {{ field.maximum }} }{% endif %}
                            {...register('{{ field.name }}', {
                                required: {{ 'true' if field.required and not field.update_optional else 'false' }},
                                {% if field.minimum is not none %}min: {{ field.minimum }},{% endif %}
                                {% if field.maximum is not none %}max: {{ field.maximum }},{% endif %}
                            })}
                        />
                        {% endif %}
                        </div>
                        ) : (
                        <>
                        {% endif %}
                        {% include 'frontend_list_cell.tsx.j2' %}
                        {% if model.edit_mode == 'inplace_edit' and 'u' in field.permissions %}
                        </>
                        )}
                        {% endif %}
                    </TableCell>
                    )}{% endif %}
                    {% endfor %}
                    {% for field in list_extra_fields %}
                    <TableCell>
                        {% include 'frontend_list_extra_cell.tsx.j2' %}
                    </TableCell>
                    {% endfor %}
                    <TableCell className="sticky right-0 bg-card z-10">
                        <div className="flex items-center gap-2">
                        {% if model.edit_mode == 'inplace_edit' %}
                        {editingId === item.id ? (
                        <>
                        <Button
                            type="button"
                            variant="ghost"
                            size="icon"
                            disabled={isSaving}
                            title={t('common.save')}
                            onClick={() => void handleSubmit(onSubmit)()}
                        >
                            {isSaving ? <Loader2 className="h-4 w-4 animate-spin" /> : <Save className="h-4 w-4" />}
                        </Button>
                        <Button
                            type="button"
                            variant="ghost"
                            size="icon"
                            disabled={isSaving}
                            title={t('common.cancel')}
                            onClick={handleCancelInplaceEdit}
                        >
                            <X className="h-4 w-4" />
                        </Button>
                        </>
                        ) : (
                        <>
                        {% endif %}
                        <>
                        {% if model.actions %}
                        {% for action_name, action_config in model.actions.items() %}
                        {(() => {
                            const actionPerms = {{ action_config.get("permissions", "da") | tojson }};
                            const roleChar = userRole[0];
                            if (!actionPerms.includes(roleChar)) return false;
                            {% if action_config.get("dynamic_availability") %}
                            const state = actionStates[String(item.id)]?.[{{ action_name | tojson }}];
                            return Boolean(state?.visible);
                            {% else %}
                            const cond = {{ action_config.get("condition", None) | tojson }} as any;
                            let enabled = true;
                            if (cond) {
                                const field = cond.field;
                                const op = cond.op;
                                const expected = cond.value;
                                const actual = (item as any)[field];
                                if (op === 'eq') enabled = actual === expected;
                                else if (op === 'ne') enabled = actual !== expected;
                                else if (op === 'in') enabled = Array.isArray(expected) ? expected.includes(actual) : false;
                                else if (op === 'not_in') enabled = Array.isArray(expected) ? !expected.includes(actual) : true;
                                else if (op === 'gt') enabled = actual > expected;
                                else if (op === 'gte') enabled = actual >= expected;
                                else if (op === 'lt') enabled = actual < expected;
                                else if (op === 'lte') enabled = actual <= expected;
                                else if (op === 'contains') enabled = actual?.includes(expected);
                                else if (op === 'startswith') enabled = String(actual).startsWith(String(expected));
                                else if (op === 'endswith') enabled = String(actual).endsWith(String(expected));
                                else if (op === 'is_null') enabled = actual === null || actual === undefined;
                                else if (op === 'is_not_null') enabled = actual !== null && actual !== undefined;
                            }
                            return enabled;
                            {% endif %}
                        })() && (
                        <Button
                            variant={% if action_config.get("toggle") %}{(item as any)[{{ action_config.get("toggle") | tojson }}] ? "destructive" : "default"}{% else %}"outline"{% endif %}
                            size="sm"
                            {% if action_config.get("dynamic_availability") %}
                            disabled={!actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.enabled}
                            title={actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.reason}
                            {% endif %}
                            onClick={async (e) => {
                                e.stopPropagation();
                                try {
                                    await perform{{ model.name }}{{ action_name.capitalize() }}(item.id);
                                    toast.success(t('common.success', 'Success'));
                                    fetchData(use{{ model.name }}Store.getState().page, use{{ model.name }}Store.getState().size);
                                } catch (e) {
                                    toast.error(t('common.error', 'Error'));
                                }
                            }}
                        >
                            {% if action_config.get("toggle") %}
                            {(item as any)[{{ action_config.get("toggle") | tojson }}] ? t('common.disable', 'Disable') : t('common.enable', 'Enable')}
                            {% else %}
                            {% if action_config.get("dynamic_availability") %}
                            {actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.label || {{ (action_config.get("label") or action_name) | tojson }}}
                            {% else %}
                            { {{ (action_config.get("label") or action_name) | tojson }} }
                            {% endif %}
                            {% endif %}
                        </Button>
                        )}
                        {% endfor %}
                        {% endif %}
                        </>
                        {!embedded && hasPermission('r') && (
                        <Button variant="ghost" size="icon" onClick={() => navigate(`/{{ model.module_name }}s/${item.id}`)}>
                            <Eye className="h-4 w-4" />
                        </Button>
                        )}
                        {hasPermission('u') && (
                        <Button variant="ghost" size="icon" onClick={() => handleEdit(item)}>
                            <Pencil className="h-4 w-4" />
                        </Button>
                        )}
                        {hasPermission('d') && (
                        <Button variant="ghost" size="icon" className="text-destructive" onClick={() => requestDelete(item.id)}>
                            <Trash2 className="h-4 w-4" />
                        </Button>
                        )}
                        {% if model.edit_mode == 'inplace_edit' %}
                        </>
                        )}
                        {% endif %}
                        </div>
                    </TableCell>
                </TableRow>
                ))
            )}
          </TableBody>
        </Table>
      </div>
      {% endif %}
      {% if model.multi_display %}
      </>
      )}
      {% endif %}

      {/* Pagination Controls */}
      <div className={`shrink-0 flex flex-wrap items-center justify-between gap-4 ${embedded ? '' : 'bg-background'}`}>
        <div className="flex items-center gap-4">
          <div className="text-sm text-muted-foreground whitespace-nowrap">
            {t('common.page_info')} {use{{ model.name }}Store(state => state.page)} {t('common.of_page')} {Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || 1}
          </div>
          <div className="flex items-center gap-2">
            <span className="text-sm text-muted-foreground whitespace-nowrap">{t('common.page_size', 'Page size')}:</span>
            <Select
              value={String(use{{ model.name }}Store.getState().size)}
              onValueChange={(v) => {
                const newSize = Number(v);
                fetchData(1, newSize);
              }}
            >
              <SelectTrigger className="w-[80px] h-8">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="10">10</SelectItem>
                <SelectItem value="20">20</SelectItem>
                <SelectItem value="50">50</SelectItem>
                <SelectItem value="100">100</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchData(1, use{{ model.name }}Store.getState().size)}
            disabled={use{{ model.name }}Store(state => state.page) <= 1 || loading}
          >
            {t('common.first')}
          </Button>
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchData(use{{ model.name }}Store.getState().page - 1, use{{ model.name }}Store.getState().size)}
            disabled={use{{ model.name }}Store(state => state.page) <= 1 || loading}
          >
            {t('common.previous')}
          </Button>
          <div className="flex items-center gap-1">
            <Input
              type="number"
              min={1}
              max={Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || 1}
              className="w-16 h-8 text-center"
              value={gotoPageInput}
              onChange={(e) => setGotoPageInput(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter') {
                  const page = Number(gotoPageInput);
                  const totalPages = Math.ceil(use{{ model.name }}Store.getState().total / use{{ model.name }}Store.getState().size) || 1;
                  if (page >= 1 && page <= totalPages) {
                    fetchData(page, use{{ model.name }}Store.getState().size);
                  }
                }
              }}
            />
          </div>
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchData(use{{ model.name }}Store.getState().page + 1, use{{ model.name }}Store.getState().size)}
            disabled={use{{ model.name }}Store(state => state.page) >= Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || loading}
          >
            {t('common.next')}
          </Button>
          <Button
            variant="outline"
            size="sm"
            onClick={() => {
              const totalPages = Math.ceil(use{{ model.name }}Store.getState().total / use{{ model.name }}Store.getState().size) || 1;
              fetchData(totalPages, use{{ model.name }}Store.getState().size);
            }}
            disabled={use{{ model.name }}Store(state => state.page) >= Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || loading}
          >
            {t('common.last')}
          </Button>
        </div>
      </div>
{% else %}
      {/* Tree View — Lazy Loading */}
      <div className="flex-1 min-h-0 overflow-auto rounded-md border border-t-2 border-t-accent/30 bg-card shadow-sm">
        <div className="sticky top-0 z-10 flex items-center justify-between border-b bg-card/95 px-4 py-2.5 backdrop-blur supports-[backdrop-filter]:bg-card/80">
          <div className="flex min-w-0 items-center gap-2">
            <FolderOpen className="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
            <span className="truncate text-sm font-medium">{t('models.{{ model.module_name }}.name')}</span>
            {!rootLoading && <Badge variant="secondary" className="shrink-0 font-normal">{rootTotal}</Badge>}
          </div>
          <span className="text-xs text-muted-foreground">{t('common.page_info')} {rootPage} {t('common.of_page')} {Math.ceil(rootTotal / rootSize) || 1}</span>
        </div>
        {rootLoading && rootItems.length === 0 ? (
          <div className="flex h-32 items-center justify-center">
            <Loader2 className="h-6 w-6 animate-spin mx-auto" />
          </div>
        ) : !rootLoading && rootItems.length === 0 ? (
          <div className="flex h-32 flex-col items-center justify-center gap-2 text-center text-sm text-muted-foreground">
            <Folder className="h-7 w-7 opacity-50" aria-hidden="true" />
            <span>{t('common.no_result')}</span>
          </div>
        ) : (
          <div className="min-w-max py-2">
            {(() => {
              const renderNodes = (nodes: any[], depth: number): React.ReactNode[] => {
                const elements: React.ReactNode[] = [];
                for (const node of nodes) {
                  const isExpanded = expandedIds.has(node.id);
                  const children = childrenMap[node.id] || [];
                  const childTotal = childrenTotal[node.id] || 0;
                  const childPageNum = childrenPage[node.id] || 1;
                  const isLoading = loadingChildren[node.id];
                  const hasMore = children.length > 0 && children.length < childTotal;
                  {% if model.tree_leaf %}
                  const leaves = leafMap[node.id] || [];
                  const leafCount = leafTotal[node.id] || 0;
                  const leavesLoading = loadingLeaves[node.id];
                  const hasMoreLeaves = leaves.length > 0 && leaves.length < leafCount;
                  {% endif %}
                  // An absent entry means this node has not been expanded yet.
                  // Only disable the expander after a completed child request confirms
                  // that the node has no children.
                  const hasLoadedChildren = Object.prototype.hasOwnProperty.call(childrenMap, node.id);
                  {% if model.tree_leaf %}
                  const hasLoadedLeaves = Object.prototype.hasOwnProperty.call(leafMap, node.id);
                  const isLeaf = hasLoadedChildren && hasLoadedLeaves && !isLoading && !leavesLoading && !hasMore && !hasMoreLeaves && children.length === 0 && childTotal === 0 && leaves.length === 0 && leafCount === 0;
                  {% else %}
                  const isLeaf = hasLoadedChildren && !isLoading && !hasMore && children.length === 0 && childTotal === 0;
                  {% endif %}
                  const label = node.{{ model.search_field }} || `#${node.id}`;

                  elements.push(
                    <div
                      key={node.id}
                      className="group relative mx-2 flex min-h-10 items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-accent/60 focus-within:bg-accent/60"
                      style={% raw %}{{ paddingLeft: `${depth * 28 + 8}px` }}{% endraw %}
                    >
                      {depth > 0 && (
                        <>
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-0 bottom-0 w-px bg-border"
                            style={% raw %}{{ left: `${(depth - 1) * 28 + 21}px` }}{% endraw %}
                          />
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-1/2 h-px w-3.5 bg-border"
                            style={% raw %}{{ left: `${(depth - 1) * 28 + 21}px` }}{% endraw %}
                          />
                        </>
                      )}
                      <button
                        type="button"
                        className="relative z-[1] flex h-6 w-6 shrink-0 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:bg-background hover:text-foreground focus:outline-none focus:ring-2 focus:ring-ring disabled:cursor-default disabled:hover:bg-transparent"
                        onClick={() => handleToggleExpand(node.id)}
                        disabled={isLeaf}
                        aria-label={isExpanded ? 'Collapse node' : 'Expand node'}
                      >
                        {isLoading ? (
                          <Loader2 className="h-4 w-4 animate-spin text-muted-foreground" />
                        ) : isExpanded ? (
                          children.length > 0 ? (
                            <ChevronDown className="h-4 w-4 text-muted-foreground" />
                          ) : (
                            <span className="h-4 w-4" aria-hidden="true" />
                          )
                        ) : !isLeaf ? (
                          <ChevronRight className="h-4 w-4 text-muted-foreground" />
                        ) : null}
                      </button>
                      {isExpanded ? (
                        <FolderOpen className="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                      ) : (
                        <Folder className="h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                      )}
                      <div className="flex min-w-0 flex-1 items-center gap-2">
                        <span className="truncate text-sm font-medium" title={String(label)}>{label}</span>
                        {childTotal{% if model.tree_leaf %} + leafCount{% endif %} > 0 && (
                          <Badge variant="secondary" className="h-5 shrink-0 px-1.5 text-[10px] font-medium">
                            {childTotal{% if model.tree_leaf %} + leafCount{% endif %}}
                          </Badge>
                        )}
                      </div>
                      <div className="flex shrink-0 items-center gap-1 rounded-md bg-background/80 p-0.5 opacity-80 shadow-sm transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
                        {hasPermission('c') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => handleCreateChild(node)} aria-label="Add child">
                            <Plus className="h-3.5 w-3.5" />
                          </Button>
                        )}
                        {hasPermission('r') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => navigate(`/{{ model.module_name }}s/${node.id}`)} aria-label="View node">
                            <Eye className="h-3.5 w-3.5" />
                          </Button>
                        )}
                        {hasPermission('u') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => handleEdit(node)} aria-label="Edit node">
                            <Pencil className="h-3.5 w-3.5" />
                          </Button>
                        )}
                        {hasPermission('d') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7 text-destructive hover:text-destructive" onClick={() => requestDelete(node.id)} aria-label="Delete node">
                            <Trash2 className="h-3.5 w-3.5" />
                          </Button>
                        )}
                      </div>
                    </div>
                  );

                  if (isExpanded && !isLoading) {
                    if (children.length > 0) {
                      elements.push(...renderNodes(children, depth + 1));
                    }
                    {% if model.tree_leaf %}
                    for (const leaf of leaves) {
                      const leafLabel = leaf.{{ model.tree_leaf.label_field }} || `#${leaf.id}`;
                      elements.push(
                        <div
                          key={`leaf-${leaf.id}`}
                          className="group relative mx-2 flex min-h-10 items-center gap-2 rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-primary/[0.04] hover:text-foreground"
                          style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 8}px` }}{% endraw %}
                          data-tree-node-kind="leaf"
                        >
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-0 bottom-0 w-px bg-border"
                            style={% raw %}{{ left: `${depth * 28 + 21}px` }}{% endraw %}
                          />
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-1/2 h-px w-3.5 bg-border"
                            style={% raw %}{{ left: `${depth * 28 + 21}px` }}{% endraw %}
                          />
                          <span className="relative z-[1] h-6 w-6 shrink-0" aria-hidden="true" />
                          <FileText className="h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
                          <div className="flex min-w-0 flex-1 items-center gap-2">
                            <span className="truncate text-sm" title={String(leafLabel)}>{leafLabel}</span>
                            <Badge variant="outline" className="h-5 shrink-0 px-1.5 text-[10px] font-normal">
                              {t('models.{{ model.tree_leaf.service }}.name')}
                            </Badge>
                          </div>
                          {% if model.tree_leaf.standalone %}
                          <div className="flex shrink-0 items-center rounded-md bg-background/80 p-0.5 opacity-70 transition-opacity group-hover:opacity-100">
                            <Button
                              variant="ghost"
                              size="icon"
                              className="h-7 w-7"
                              onClick={() => navigate(`/{{ model.tree_leaf.service }}s/${leaf.id}`)}
                              aria-label="View leaf record"
                            >
                              <Eye className="h-3.5 w-3.5" />
                            </Button>
                          </div>
                          {% endif %}
                        </div>
                      );
                    }
                    if (leavesLoading) {
                      elements.push(
                        <div key={`${node.id}-leaves-loading`} className="flex items-center gap-2 py-2 text-xs text-muted-foreground" style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 40}px` }}{% endraw %}>
                          <Loader2 className="h-3.5 w-3.5 animate-spin" />
                          {t('common.loading', 'Loading...')}
                        </div>
                      );
                    }
                    {% endif %}
                    if (children.length === 0 && childTotal === 0) {
                      // No children yet, show load more to fetch empty state? Actually just show nothing
                    }
                    if (hasMore) {
                      elements.push(
                        <div
                          key={`${node.id}-more`}
                          className="flex items-center gap-2 py-1.5 text-muted-foreground"
                          style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 8}px` }}{% endraw %}
                        >
                          <CornerDownRight className="h-3.5 w-3.5" aria-hidden="true" />
                          <Button
                            variant="ghost"
                            size="sm"
                            className="h-7 px-2 text-xs"
                            onClick={() => loadChildren(node.id, childPageNum + 1)}
                          >
                            {t('common.load_more', 'Load more')}...
                          </Button>
                        </div>
                      );
                    }
                    {% if model.tree_leaf %}
                    if (hasMoreLeaves) {
                      elements.push(
                        <div
                          key={`${node.id}-more-leaves`}
                          className="flex items-center gap-2 py-1.5 text-muted-foreground"
                          style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 8}px` }}{% endraw %}
                        >
                          <FileText className="h-3.5 w-3.5" aria-hidden="true" />
                          <Button variant="ghost" size="sm" className="h-7 px-2 text-xs" onClick={() => loadMoreLeaves(node.id)}>
                            {t('common.load_more', 'Load more')} {t('models.{{ model.tree_leaf.service }}.plural')}...
                          </Button>
                        </div>
                      );
                    }
                    {% endif %}
                  }
                }
                return elements;
              };
              return renderNodes(rootItems, 0);
            })()}
          </div>
        )}
      </div>
      {/* Root-level pagination */}
      {!rootLoading && rootItems.length > 0 && (
        <div className="shrink-0 flex flex-wrap items-center justify-between gap-4 pt-4 border-t bg-background">
          <div className="flex items-center gap-4">
            <div className="text-sm text-muted-foreground whitespace-nowrap">
              {t('common.page_info')} {rootPage} {t('common.of_page')} {Math.ceil(rootTotal / rootSize) || 1}
            </div>
            <div className="flex items-center gap-2">
              <span className="text-sm text-muted-foreground whitespace-nowrap">{t('common.page_size', 'Page size')}:</span>
              <Select
                value={String(rootSize)}
                onValueChange={(v) => {
                  const newSize = Number(v);
                  setRootSize(newSize);
                  loadRoots(1, newSize);
                }}
              >
                <SelectTrigger className="w-[80px] h-8">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="10">10</SelectItem>
                  <SelectItem value="20">20</SelectItem>
                  <SelectItem value="50">50</SelectItem>
                  <SelectItem value="100">100</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Button
              variant="outline"
              size="sm"
              onClick={() => loadRoots(1)}
              disabled={rootPage <= 1 || rootLoading}
            >
              {t('common.first')}
            </Button>
            <Button
              variant="outline"
              size="sm"
              onClick={() => loadRoots(rootPage - 1)}
              disabled={rootPage <= 1 || rootLoading}
            >
              {t('common.previous')}
            </Button>
            <div className="flex items-center gap-1">
              <Input
                type="number"
                min={1}
                max={Math.ceil(rootTotal / rootSize) || 1}
                className="w-16 h-8 text-center"
                value={gotoPageInput}
                onChange={(e) => setGotoPageInput(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') {
                    const page = Number(gotoPageInput);
                    const totalPages = Math.ceil(rootTotal / rootSize) || 1;
                    if (page >= 1 && page <= totalPages) {
                      loadRoots(page);
                    }
                  }
                }}
              />
            </div>
            <Button
              variant="outline"
              size="sm"
              onClick={() => loadRoots(rootPage + 1)}
              disabled={rootPage >= Math.ceil(rootTotal / rootSize) || rootLoading}
            >
              {t('common.next')}
            </Button>
            <Button
              variant="outline"
              size="sm"
              onClick={() => {
                const totalPages = Math.ceil(rootTotal / rootSize) || 1;
                loadRoots(totalPages);
              }}
              disabled={rootPage >= Math.ceil(rootTotal / rootSize) || rootLoading}
            >
              {t('common.last')}
            </Button>
          </div>
        </div>
      )}
{% endif %}

{% if not model.page_edit %}
      <EditContainer
        title={editingId ? `${t('common.edit')} ${t('models.{{ model.module_name }}.name')}` : `${t('common.create')} ${t('models.{{ model.module_name }}.name')}`}
        isOpen={isModalOpen}
        onClose={() => { if (!isSaving) setIsModalOpen(false); }}
      >
            <div className="max-h-[80vh] overflow-y-auto pr-2">
                <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
          {% macro modal_form_field(field, as_expression=false) -%}
          {% if not as_expression %}{{ '{' }}{% endif %}(!editingId ? hasFieldPerm('{{ field.name }}', 'c') : hasFieldPerm('{{ field.name }}', 'u')){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
          <div className="space-y-2">
            <Label htmlFor="{{ field.name }}">{t('{{ field.label_key }}')}{((!editingId && {{ 'true' if field.required and not field.create_optional else 'false' }}) || (Boolean(editingId) && {{ 'true' if field.required and not field.update_optional else 'false' }})) && <span className="text-destructive"> *</span>}</Label>
            {% set override = (model.override_fields | default([]) | selectattr('field', 'equalto', field.name) | list | first) %}
            {% if field.name in writable_override_field_names %}
            {% if override.read_type == 'bool' %}
            <Controller control={control} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
                <Switch checked={Boolean(value)} onCheckedChange={onChange} id="{{ field.name }}" />
            )} />
            {% elif override.read_type in ['int', 'float'] %}
            <Input id="{{ field.name }}" type="number" {...register('{{ field.name }}', { valueAsNumber: true })} />
            {% elif override.read_type.startswith('List[') or override.read_type.startswith('Dict[') or override.read_type in ['list', 'dict', 'Any'] %}
            <Controller control={control} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
                <JsonInput value={value} onChange={onChange} jsonKind="{{ 'array' if override.read_type.startswith('List[') or override.read_type == 'list' else 'object' }}" />
            )} />
            {% else %}
            <Input id="{{ field.name }}" type="text" {...register('{{ field.name }}')} />
            {% endif %}
            {% elif field.ui_type == 'bool' %}
            <div className="flex items-center space-x-2">
                <Controller
                    control={control}
                    name="{{ field.name }}"
                    defaultValue={ {{ 'true' if field.default else 'false' }} }
                    render={({ field: { onChange, value } }) => (
                        <Switch checked={value} onCheckedChange={onChange} id="{{ field.name }}" />
                    )}
                />
                <Label htmlFor="{{ field.name }}" className="font-normal text-muted-foreground">
                    {t('{{ field.label_key }}')}
                </Label>
            </div>
            {% elif field.ui_type == 'image' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <ImageUpload
                        value={value}
                        onChange={onChange}
                    />
                )}
            />
            {% elif field.ui_type == 'images' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <ImagesUpload id="{{ field.name }}" value={Array.isArray(value) ? value : []} onChange={onChange} />
                )}
            />
            {% elif field.ui_type == 'file' %}
                        <Controller
                            control={control}
                            name="{{ field.name }}"
                            render={({ field: { onChange, value } }) => (
                                <FileUpload
                                    value={value}
                                    onChange={onChange}
                                    allowDownload={ {{ "true" if field.allow_download else "false" }} }
                                />
                            )}
                        />
                        {% elif field.ui_type == 'video_stream' %}
                        <Controller
                            control={control}
                            name="{{ field.name }}"
                            render={({ field: { onChange, value } }) => (
                                <VideoStreamInput value={value} onChange={onChange} protocol="{{ field.stream_protocol }}" />
                            )}
                        />
                        {% elif field.dict_key_reference %}
                        <Controller
                            control={control}
                            name="{{ field.name }}"
                            render={({ field: { onChange, value } }) => (
                                <SearchableSelect
                                    value={value}
                                    onValueChange={onChange}
                                    disabled={!rootValue?.{{ field.dict_key_reference.owner_fk }}}
                                    optionsKey={rootValue?.{{ field.dict_key_reference.owner_fk }}}
                                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                    searchPlaceholder={`${t('common.search')}...`}
                                    loadOptions={async (query) => {
                                        const ownerId = rootValue?.{{ field.dict_key_reference.owner_fk }};
                                        if (ownerId === undefined || ownerId === null || ownerId === '') return [];
                                        const options = await get{{ model.name }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}KeyOptions(ownerId);
                                        const normalizedQuery = query.trim().toLocaleLowerCase();
                                        return options.filter((option) => !normalizedQuery
                                            || option.label.toLocaleLowerCase().includes(normalizedQuery)
                                            || option.value.toLocaleLowerCase().includes(normalizedQuery));
                                    }}
                                />
                            )}
                        />
                        {% elif field.composite_selector %}
                        <Controller
                            control={control}
                            name="{{ field.name }}"
                            render={({ field: { onChange, value } }) => (
                                <SearchableSelect
                                    value={value}
                                    onValueChange={onChange}
                                    disabled={!watch('{{ field.composite_selector.parent_field }}')}
                                    optionsKey={watch('{{ field.composite_selector.parent_field }}')}
                                    placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                    searchPlaceholder={`${t('common.search')}...`}
                                    loadOptions={async (query) => {
                                        const parentValue = watch('{{ field.composite_selector.parent_field }}');
                                        if (parentValue === undefined || parentValue === null || parentValue === '') return [];
                                        const filters = { '{{ field.composite_selector.filter_field }}': parentValue, ...(query ? { '{{ field.composite_selector.label_field }}': query } : {}) };
                                        const response = await {{ field.name|replace('_', ' ')|title|replace(' ', '') }}CompositeOptionService.get{{ field.composite_selector.target_model }}s(1, 20, filters);
                                        return response.items.map((item: any) => ({
                                            label: item.{{ field.composite_selector.label_field }} ?? item.{{ field.composite_selector.value_field }},
                                            value: item.{{ field.composite_selector.value_field }},
                                        }));
                                    }}
                                />
                            )}
                        />
                        {% elif field.is_enum and field.is_multi_select %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <SearchableSelect
                        value={value || []}
                        onValueChange={onChange}
                        multiple={true}
                        placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                        searchPlaceholder={`${t('common.search')}...`}
                        loadOptions={async () => {{ field.enum_values | tojson }}.map((v: string) => ({
                            label: t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v),
                            value: v,
                        }))}
                    />
                )}
            />
                        {% elif field.is_enum %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => {
                    // Filter enum values based on role for User.role field
                    {% if model.module_name == "user" and model.name == "User" and field.name == "role" %}
                    const filteredValues = userRole === 'developer'
                        ? {{ field.enum_values | tojson }}
                        : ({{ field.enum_values | tojson }} as string[]).filter(v => v !== 'developer');
                    {% else %}
                    const filteredValues = {{ field.enum_values | tojson }};
                    {% endif %}
                    return (
                    <Select onValueChange={onChange} defaultValue={value}>
                        <SelectTrigger>
                            <SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
                        </SelectTrigger>
                        <SelectContent>
                            {filteredValues.map((enumVal: string) => (
                                <SelectItem key={enumVal} value={enumVal}>{t(`models.{{ model.module_name }}.enums.{{ field.name }}.${enumVal}`, enumVal)}</SelectItem>
                            ))}
                        </SelectContent>
                    </Select>
                    )
                }}
            />
            {% elif field.fk_info %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <SearchableSelect
                        value={value}
                        onValueChange={(nextValue) => {
                            onChange(nextValue);
                            {% for cascade_fk in model.foreign_keys %}
                            {% if cascade_fk.cascade_parent_field == field.name %}
                            setValue('{{ cascade_fk.name }}', '');
                            {% endif %}
                            {% endfor %}
                            {% for dependent_field in model.fields %}
                            {% if dependent_field.composite_selector and dependent_field.composite_selector.parent_field == field.name %}
                            setValue('{{ dependent_field.name }}', '');
                            {% endif %}
                            {% endfor %}
                            {% for reference in model.dict_key_reference_meta %}
                            {% if reference.owner_fk == field.name %}
                            setValue('{{ reference.field }}', '');
                            {% endif %}
                            {% endfor %}
                        }}
                        placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                        searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
                        valueLabels={ {{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                        {% if field.fk_info.cascade_parent_field %}
                        disabled={!watch('{{ field.fk_info.cascade_parent_field }}')}
                        optionsKey={watch('{{ field.fk_info.cascade_parent_field }}')}
                        {% endif %}
                        loadOptions={async (query) => {
                            {% if field.fk_info.cascade_parent_field %}
                            const parentId = watch('{{ field.fk_info.cascade_parent_field }}');
                            if (parentId === undefined || parentId === null || parentId === '') return [];
                            const filters = { '{{ field.fk_info.cascade_filter_field }}': parentId, ...(query ? { {{ field.fk_info.label_field }}: query } : {}) };
                            {% else %}
                            const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                            {% endif %}
                            const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                            return response.items.map((item: any) => ({
                                label: item.{{ field.fk_info.label_field }} || item.id,
                                value: item.id
                            }));
                        }}
                    />
                )}
            />
            {% elif field.ui_type == 'time' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <TimePicker
                        value={value}
                        onChange={onChange}
                        placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                    />
                )}
            />
            {% elif field.ui_type == 'location' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                defaultValue={null}
                render={({ field: { onChange, value } }) => (
                    <LocationInput value={value} onChange={onChange} />
                )}
            />
            {% elif field.ui_type == 'json' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                defaultValue={ {% if field.json_kind == 'array' %}[]{% else %}{}{% endif %} }
                rules={ {
                    required: !editingId ? {{ 'true' if field.required and not field.create_optional else 'false' }} : {{ 'true' if field.required and not field.update_optional else 'false' }},
                    {% if field.json_model_schema %}validate: (value) => validateJsonModelValue({{ field.json_model_schema | tojson }}, value, rootValue),{% elif field.json_item_schema %}validate: (value) => validateJsonModelCollectionValue({{ field.json_item_schema | tojson }}, value, rootValue),{% endif %}
                } }
                render={({ field: { onChange, value } }) => (
                    {% if field.json_model_schema %}
                    <JsonModelEditor
                        schema={ {{ field.json_model_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        rootValue={rootValue}
                    />
                    {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
                    <JsonModelTableEditor
                        collectionKind="dict"
                        itemSchema={ {{ field.json_item_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        rootValue={rootValue}
                        {% if field.json_fixed_keys %}
                        fixedKeys={ {{ field.json_fixed_keys | tojson }} }
                        {% endif %}
                        {% if field.json_lock_keys %}
                        lockKeys
                        {% endif %}
                    />
                    {% elif field.json_item_kind %}
                    <JsonScalarArrayEditor itemKind="{{ field.json_item_kind }}" value={value} onChange={onChange} />
                    {% elif field.json_item_schema %}
                    <JsonModelArrayEditor
                        itemSchema={ {{ field.json_item_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        rootValue={rootValue}
                        {% if model.definition_binding_meta and field.name == model.definition_binding_meta.config_field %}
                        canAdd={ {{ 'true' if model.definition_binding_meta.key_policy == 'free' else 'false' }} }
                        canRemove={ {{ 'false' if model.definition_binding_meta.key_policy == 'definition' else 'true' }} }
                        {% endif %}
                    />
                    {% else %}
                    <JsonInput
                        value={value}
                        onChange={onChange}
                        jsonKind="{{ field.json_kind or 'object' }}"
                        placeholder={ {% if field.json_kind == 'array' %}"[\\n  \\n]"{% else %}"{\\n  \\n}"{% endif %} }
                    />
                    {% endif %}
                )}
            />
            {% else %}
            <Input
                id="{{ field.name }}"
                {% if field.ui_type == 'int' or field.ui_type == 'float' %}
                type="number"
                {% if field.minimum is not none %}min={ {{ field.minimum }} }{% endif %}
                {% if field.maximum is not none %}max={ {{ field.maximum }} }{% endif %}
                {% elif field.ui_type == 'datetime' %}
                type="datetime-local"
                {% elif field.ui_type == 'date' %}
                type="date"
                {% if field.default_factory == 'date' %}
                defaultValue={new Date().toLocaleDateString('en-CA')}
                {% endif %}
                {% else %}
                type="text"
                {% endif %}
                {...register('{{ field.name }}', {
                    required: !editingId ? {{ 'true' if field.required and not field.create_optional else 'false' }} : {{ 'true' if field.required and not field.update_optional else 'false' }},
                    {% if field.minimum is not none %}min: {{ field.minimum }},{% endif %}
                    {% if field.maximum is not none %}max: {{ field.maximum }},{% endif %}
                })}
            />
            {% endif %}
          </div>
          ){% if not as_expression %}{{ '}' }}{% endif %}
          {%- endmacro %}
          {(() => {
            const formLayout = {{ model.form_layout | default([]) | tojson }} as any[];
            const formFields: Record<string, React.ReactNode> = {
              {% for field in model.fields %}
              '{{ field.name }}': ({{ modal_form_field(field, true) }}),
              {% endfor %}
            };
            const rowClasses: Record<number, string> = {
              1: 'grid grid-cols-1 gap-4',
              2: 'grid grid-cols-1 gap-4 md:grid-cols-2',
              3: 'grid grid-cols-1 gap-4 md:grid-cols-3',
              4: 'grid grid-cols-1 gap-4 md:grid-cols-4',
            };
            const spanClasses: Record<number, string> = {
              1: '', 2: 'md:col-span-2', 3: 'md:col-span-3', 4: 'md:col-span-4',
            };
            const renderModalFormLayoutNode = (node: any, key: string): React.ReactNode => {
              if (node.kind === 'field') {
                const content = formFields[node.field];
                return content ? <div key={key} className={`min-w-0 ${spanClasses[node.span] || ''}`}>{content}</div> : null;
              }
              if (node.kind === 'row') {
                const items = node.items.map((item: any, index: number) => renderModalFormLayoutNode(item, `${key}-${index}`)).filter(Boolean);
                return items.length ? <div key={key} className={rowClasses[node.columns] || rowClasses[1]}>{items}</div> : null;
              }
              if (node.kind === 'section') {
                const items = node.items.map((item: any, index: number) => renderModalFormLayoutNode(item, `${key}-${index}`)).filter(Boolean);
                return items.length ? <fieldset key={key} className={`min-w-0 rounded-md border p-4 ${spanClasses[node.span] || ''}`}><legend className="px-1 text-sm font-semibold">{node.title}</legend><div className="space-y-4">{items}</div></fieldset> : null;
              }
              return null;
            };
            return formLayout.length
              ? formLayout.map((node, index) => renderModalFormLayoutNode(node, `form-layout-${index}`))
              : Object.values(formFields);
          })()}

          {% if model.m2m_fields %}
          {% for m2m in model.m2m_fields %}
          <div className="space-y-2">
            <Label>{t('models.{{ m2m.target_service }}.plural')}</Label>
            <Controller
                control={control}
                name="{{ m2m.write_name }}"
                render={({ field: { onChange, value } }) => (
                    {% if m2m.editor == 'inline' %}
                    <JsonModelArrayEditor
                        itemSchema={ {{ m2m.inline_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        foreignKeyLoaders={{ '{{' }}
                            {% for field in m2m.inline_schema.fields %}
                            {% if field.foreignKey %}
                            '{{ field.name }}': async (query) => {
                                const filters = query ? { {{ field.foreignKey.labelField }}: query } : undefined;
                                const response = await {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService.get{{ field.foreignKey.targetModel }}s(1, 20, filters);
                                return response.items.map((item: any) => ({ label: item.{{ field.foreignKey.labelField }} || item.id, value: item.id }));
                            },
                            {% endif %}
                            {% endfor %}
                        {{ '}}' }}
                    />
                    {% elif m2m.order_field %}
                    <LinkTableOrderedSelect
                        value={value}
                        onValueChange={onChange}
                        placeholder={`${t('common.select')} ${t('models.{{ m2m.target_service }}.name')}s`}
                        searchPlaceholder={`${t('common.search')} ${t('models.{{ m2m.target_service }}.name')}...`}
                        valueLabels={ {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                        loadOptions={async (query) => {
                            const filters = query ? { {{ m2m.label_field }}: query } : undefined;
                            const response = await get{{ m2m.target_model }}s(1, 20, filters);
                            return response.items.map((item: any) => ({
                                label: item.{{ m2m.label_field }} || item.id,
                                value: item.id
                            }));
                        }}
                    />
                    {% else %}
                    <SearchableSelect
                        value={value}
                        onValueChange={onChange}
                        multiple={true}
                        placeholder={`${t('common.select')} ${t('models.{{ m2m.target_service }}.name')}s`}
                        searchPlaceholder={`${t('common.search')} ${t('models.{{ m2m.target_service }}.name')}...`}
                        valueLabels={ {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                        loadOptions={async (query) => {
                            const filters = query ? { {{ m2m.label_field }}: query } : undefined;
                            const response = await get{{ m2m.target_model }}s(1, 20, filters);
                            return response.items.map((item: any) => ({
                                label: item.{{ m2m.label_field }} || item.id,
                                value: item.id
                            }));
                        }}
                    />
                    {% endif %}
                )}
            />
          </div>
          {% endfor %}
          {% endif %}
          {% for rfk in model.reverse_foreign_keys %}
          {% if rfk.editor == 'inline' %}
          <div className="space-y-2">
            <Label>{t('models.{{ rfk.source_service }}.plural')}</Label>
            <Controller
                control={control}
                name="{{ rfk.write_name }}"
                defaultValue={[]}
                render={({ field: { onChange, value } }) => (
                    <JsonModel{{ 'Table' if rfk.inline_layout == 'table' else 'Array' }}Editor
                        {% if rfk.inline_layout == 'table' %}collectionKind="array"{% endif %}
                        itemSchema={ {{ rfk.inline_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        foreignKeyLoaders={{ '{{' }}
                            {% for field in rfk.inline_schema.fields %}
                            {% if field.foreignKey %}
                            '{{ field.name }}': async (query) => {
                                const filters = query ? { {{ field.foreignKey.labelField }}: query } : undefined;
                                const response = await {{ rfk.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService.get{{ field.foreignKey.targetModel }}s(1, 20, filters);
                                return response.items.map((item: any) => ({ label: item.{{ field.foreignKey.labelField }} || item.id, value: item.id }));
                            },
                            {% endif %}
                            {% endfor %}
                        {{ '}}' }}
                    />
                )}
            />
          </div>
          {% endif %}
          {% endfor %}
          <div className="flex justify-end space-x-2 pt-4">
            <Button variant="outline" type="button" disabled={isSaving} onClick={() => setIsModalOpen(false)}>{t('common.cancel')}</Button>
            <Button type="submit" disabled={isSaving}>
              {isSaving ? (
                <><Loader2 className="mr-2 h-4 w-4 animate-spin" /> {t('common.saving', 'Saving...')}</>
              ) : t('common.save')}
            </Button>
          </div>
        </form>
            </div>
      </EditContainer>
      {% endif %}

      {% if model.has_embedded_page %}
      <Modal
        title={t('common.add_existing', 'Add existing')}
        isOpen={attachExistingOpen}
        onClose={() => { if (!isAttachingExisting) setAttachExistingOpen(false); }}
      >
        <div className="space-y-4">
          <SearchableSelect
            multiple
            value={attachExistingIds}
            onValueChange={(value) => setAttachExistingIds(Array.isArray(value) ? value as {{ 'string[]' if 'str' in model.id_type else 'number[]' }} : [])}
            placeholder={t('common.select_existing', 'Select existing records')}
            searchPlaceholder={t('common.search', 'Search')}
            emptyText={t('common.no_result', 'No result')}
            loadOptions={loadAttachExistingOptions}
          />
          <div className="flex justify-end gap-2">
            <Button type="button" variant="outline" disabled={isAttachingExisting} onClick={() => setAttachExistingOpen(false)}>
              {t('common.cancel')}
            </Button>
            <Button type="button" disabled={isAttachingExisting || attachExistingIds.length === 0} onClick={handleAttachExisting}>
              {isAttachingExisting && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
              {isAttachingExisting ? t('common.adding', 'Adding...') : t('common.add', 'Add')}
            </Button>
          </div>
        </div>
      </Modal>
      {% endif %}

      {% if model.importable %}
      {/* Import Modal */}
      <Modal
        isOpen={importModalOpen}
        onClose={() => setImportModalOpen(false)}
        title={t('common.import', 'Import')}
      >
        <div className="space-y-4">
          <div className="flex flex-col gap-2">
            <Label>{t('{{ 'import.custom_file' if model.custom_importable else 'import.file' }}', '{{ 'Import file' if model.custom_importable else 'CSV File' }}')}</Label>
            <FileInput
              {% if not model.custom_importable %}
              accept=".csv"
              {% endif %}
              value={importingFile}
              onChange={setImportingFile}
            />
          </div>
          {% raw %}<div className="flex justify-end space-x-2 pt-4">{% endraw %}
            <Button variant="outline" onClick={() => setImportModalOpen(false)}>
              {t('common.cancel', 'Cancel')}
            </Button>
            <Button onClick={handleImportSubmit} disabled={!importingFile || isImporting}>
              {isImporting ? (
                <>
                  <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                  {t('common.importing', 'Importing...')}
                </>
              ) : (
                <>
                  <Upload className="mr-2 h-4 w-4" />
                  {t('common.import', 'Import')}
                </>
              )}
            </Button>
          </div>
        </div>
      </Modal>
      {% endif %}
    </div>
  );
};

export default {{ model.name }}Page;
