                    {% if action_config.get("dynamic_availability") %}
                    return Boolean(actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.visible);
                    {% else %}
                    const condition = {{ action_config.get("condition", None) | tojson }} as any;
                    if (!condition) return true;
                    const actual = (item as any)[condition.field];
                    if (condition.op === 'eq') return actual === condition.value;
                    if (condition.op === 'ne') return actual !== condition.value;
                    if (condition.op === 'in') return Array.isArray(condition.value) && condition.value.includes(actual);
                    if (condition.op === 'not_in') return !Array.isArray(condition.value) || !condition.value.includes(actual);
                    if (condition.op === 'gt') return actual > condition.value;
                    if (condition.op === 'gte') return actual >= condition.value;
                    if (condition.op === 'lt') return actual < condition.value;
                    if (condition.op === 'lte') return actual <= condition.value;
                    if (condition.op === 'contains') return actual?.includes(condition.value);
                    if (condition.op === 'startswith') return String(actual).startsWith(String(condition.value));
                    if (condition.op === 'endswith') return String(actual).endsWith(String(condition.value));
                    if (condition.op === 'is_null') return actual == null;
                    if (condition.op === 'is_not_null') return actual != null;
                    return true;
