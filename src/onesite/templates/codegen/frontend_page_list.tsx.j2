{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

const JsonPreview: React.FC<{ value: unknown }> = ({ value }) => {
  if (value === undefined || value === null) {
    return <span className="text-muted-foreground">-</span>;
  }

  let parsedValue = value;
  if (typeof value === 'string') {
    try {
      parsedValue = JSON.parse(value);
    } catch {
      return <span className="block max-w-[250px] truncate" title={value}>{value}</span>;
    }
  }

  if (parsedValue === undefined || parsedValue === null) {
    return <span className="text-muted-foreground">-</span>;
  }

  if (typeof parsedValue !== 'object') {
    return <span>{String(parsedValue)}</span>;
  }

  const summary = Array.isArray(parsedValue)
    ? `[ ] ${parsedValue.length}`
    : `{ } ${Object.keys(parsedValue as Record<string, unknown>).length}`;

  return (
    <Popover>
      <PopoverTrigger asChild>
        <button
          type="button"
          className="inline-flex max-w-[180px] items-center gap-1.5 rounded-md border border-border bg-muted/40 px-2 py-1 font-mono text-xs text-foreground transition-colors hover:bg-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          title="View JSON"
        >
          <Braces className="h-3.5 w-3.5 text-muted-foreground" aria-hidden="true" />
          <span className="truncate">{summary}</span>
        </button>
      </PopoverTrigger>
      <PopoverContent align="start" className="w-[min(32rem,calc(100vw-2rem))] p-0">
        <pre className="max-h-80 overflow-auto whitespace-pre-wrap break-words p-3 font-mono text-xs leading-relaxed">
          {JSON.stringify(parsedValue, null, 2)}
        </pre>
      </PopoverContent>
    </Popover>
  );
};

export type {{ model.name }}ListProps = {
  /** Fixed server/parent filters supplied by an embedded relationship tab. */
  scopeFilters?: Record<string, any>;
  /** Values enforced when records are created or updated from that tab. */
  fixedFields?: Record<string, any>;
  embedded?: boolean;
  /** Enables reassignment of existing records to the embedded parent. */
  allowAttachExisting?: boolean;
  relationField?: string;
  relationValue?: string | number;
};

const {{ model.name }}Page: React.FC<{{ model.name }}ListProps> = ({
  scopeFilters = {},
  fixedFields = {},
  embedded = false,
  allowAttachExisting = false,
  relationField,
  relationValue,
}) => {
  const { t, i18n } = useTranslation();
  const navigate = useNavigate();
  {% if not model.page_edit %}
  const [searchParams, setSearchParams] = useSearchParams();
  {% endif %}
  const { data, loading, fetchData, refreshData, fetchItem, createItem, updateItem, deleteItem, bulkDeleteItem } = use{{ model.name }}Store();
  const timeZone = getUserTimeZone();
  {% if not model.page_edit %}
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingId, setEditingId] = useState<{{ 'string' if 'str' in model.id_type else 'number' }} | null>(null);
  const [isSaving, setIsSaving] = useState(false);
  {% endif %}
  const [deleteOpen, setDeleteOpen] = useState(false);
  const [deleteId, setDeleteId] = useState<{{ 'string' if 'str' in model.id_type else 'number' }} | null>(null);
  const [isDeleting, setIsDeleting] = useState(false);
  const [selectedIds, setSelectedIds] = useState<{{ 'string[]' if 'str' in model.id_type else 'number[]' }}>([]);
  const [bulkDeleteOpen, setBulkDeleteOpen] = useState(false);
  const [isBulkDeleting, setIsBulkDeleting] = useState(false);
  const [searchValues, setSearchValues] = useState<Record<string, any>>({});
  const [gotoPageInput, setGotoPageInput] = useState('');
  {% if model.has_embedded_page %}
  const [attachExistingOpen, setAttachExistingOpen] = useState(false);
  const [attachExistingIds, setAttachExistingIds] = useState<{{ 'string[]' if 'str' in model.id_type else 'number[]' }}>([]);
  const [isAttachingExisting, setIsAttachingExisting] = useState(false);
  {% endif %}
  {% if model.has_dynamic_action_states %}
  const [actionStates, setActionStates] = useState<Record<string, Record<string, { visible: boolean; enabled: boolean; reason?: string; label?: string }>>>({});
  {% endif %}
  {% if model.is_tree %}
  // Lazy-loading tree state
  const [rootItems, setRootItems] = useState<any[]>([]);
  const [rootLoading, setRootLoading] = useState(false);
  const [rootTotal, setRootTotal] = useState(0);
  const [rootPage, setRootPage] = useState(1);
  const [expandedIds, setExpandedIds] = useState<Set<number>>(new Set());
  const [childrenMap, setChildrenMap] = useState<Record<number, any[]>>({});
  const [childrenTotal, setChildrenTotal] = useState<Record<number, number>>({});
  const [childrenPage, setChildrenPage] = useState<Record<number, number>>({});
  const [loadingChildren, setLoadingChildren] = useState<Record<number, boolean>>({});
  {% if model.tree_leaf %}
  const [leafMap, setLeafMap] = useState<Record<number, any[]>>({});
  const [leafTotal, setLeafTotal] = useState<Record<number, number>>({});
  const [leafPage, setLeafPage] = useState<Record<number, number>>({});
  const [loadingLeaves, setLoadingLeaves] = useState<Record<number, boolean>>({});
  {% endif %}
  const treeSearchFiltersRef = useRef<Record<string, any>>({});
  {% endif %}
  {% if model.importable %}
  const [importModalOpen, setImportModalOpen] = useState(false);
  const [importingFile, setImportingFile] = useState<File | null>(null);
  const [isImporting, setIsImporting] = useState(false);
  {% endif %}
  {% if model.exportable %}
  const [isExporting, setIsExporting] = useState(false);
  {% endif %}

  // Role-based permissions
  const userRole = (localStorage.getItem('user_role') || 'user') as 'user' | 'admin' | 'developer';
  const rolePermissions: Record<string, string> = {{ model.role_permissions | tojson }};
  const userPerms = rolePermissions[userRole] || '';

  const hasPermission = (perm: 'r' | 'c' | 'u' | 'd') => userPerms.includes(perm);

  // Field-level role-based permissions (Layer 2)
  const fieldRolePerms: Record<string, Record<string, string>> = {
  {% for field in model.fields %}
  {% if field.role_permissions %}
    "{{ field.name }}": {{ field.role_permissions | tojson }},
  {% endif %}
  {% endfor %}
  };
  const hasFieldPerm = (fieldName: string, perm: 'c' | 'r' | 'u') => {
    const fp = fieldRolePerms[fieldName];
    if (!fp) return true; // no restrictions = allowed
    return (fp[userRole] || '').includes(perm);
  };

  {% if model.is_tree %}
  // ── Tree lazy-loading functions ──
  const CHILD_PAGE_SIZE = 20;
  const [rootSize, setRootSize] = useState(20);

  const loadRoots = async (page: number = 1, pageSize?: number) => {
    setRootLoading(true);
    try {
      const size = pageSize ?? rootSize;
      const filters = { {{ model.tree_parent_field }}: 0, ...treeSearchFiltersRef.current };
      const result = await {{ model.module_name }}Service.get{{ model.name }}s(page, size, filters);
      if (page === 1) {
        setRootItems(result.items);
      } else {
        setRootItems(prev => [...prev, ...result.items]);
      }
      setRootTotal(result.total);
      setRootPage(page);
    } catch (error) {
      console.error('Failed to load root nodes:', error);
    } finally {
      setRootLoading(false);
    }
  };

  const loadChildren = async (parentId: number, page: number = 1) => {
    setLoadingChildren(prev => ({ ...prev, [parentId]: true }));
    {% if model.tree_leaf %}
    if (page === 1) setLoadingLeaves(prev => ({ ...prev, [parentId]: true }));
    {% endif %}
    try {
      const filters = { {{ model.tree_parent_field }}: parentId, ...treeSearchFiltersRef.current };
      {% if model.tree_leaf %}
      const leafRolePermissions: Record<string, string> = {{ model.tree_leaf.role_permissions | tojson }};
      const canReadLeaves = (leafRolePermissions[userRole] || '').includes('r');
      const [result, leafResult] = await Promise.all([
        {{ model.module_name }}Service.get{{ model.name }}s(page, CHILD_PAGE_SIZE, filters),
        page === 1 && canReadLeaves
          ? TreeLeafService.get{{ model.tree_leaf.model }}s(
              1,
              {{ model.tree_leaf.page_size }},
              { {{ model.tree_leaf.parent_field }}: parentId },
            )
          : Promise.resolve(null),
      ]);
      {% else %}
      const result = await {{ model.module_name }}Service.get{{ model.name }}s(page, CHILD_PAGE_SIZE, filters);
      {% endif %}
      setChildrenMap(prev => {
        const existing = prev[parentId] || [];
        const merged = page === 1 ? result.items : [...existing, ...result.items];
        return { ...prev, [parentId]: merged };
      });
      setChildrenTotal(prev => ({ ...prev, [parentId]: result.total }));
      setChildrenPage(prev => ({ ...prev, [parentId]: page }));
      {% if model.tree_leaf %}
      if (page === 1) {
        setLeafMap(prev => ({ ...prev, [parentId]: leafResult?.items || [] }));
        setLeafTotal(prev => ({ ...prev, [parentId]: leafResult?.total || 0 }));
        setLeafPage(prev => ({ ...prev, [parentId]: 1 }));
      }
      {% endif %}
    } catch (error) {
      console.error('Failed to load children:', error);
    } finally {
      setLoadingChildren(prev => ({ ...prev, [parentId]: false }));
      {% if model.tree_leaf %}
      if (page === 1) setLoadingLeaves(prev => ({ ...prev, [parentId]: false }));
      {% endif %}
    }
  };

  {% if model.tree_leaf %}
  const loadMoreLeaves = async (parentId: number) => {
    const nextPage = (leafPage[parentId] || 1) + 1;
    setLoadingLeaves(prev => ({ ...prev, [parentId]: true }));
    try {
      const result = await TreeLeafService.get{{ model.tree_leaf.model }}s(
        nextPage,
        {{ model.tree_leaf.page_size }},
        { {{ model.tree_leaf.parent_field }}: parentId },
      );
      setLeafMap(prev => ({ ...prev, [parentId]: [...(prev[parentId] || []), ...result.items] }));
      setLeafTotal(prev => ({ ...prev, [parentId]: result.total }));
      setLeafPage(prev => ({ ...prev, [parentId]: nextPage }));
    } catch (error) {
      console.error('Failed to load tree leaf records:', error);
    } finally {
      setLoadingLeaves(prev => ({ ...prev, [parentId]: false }));
    }
  };
  {% endif %}

  const handleToggleExpand = async (nodeId: number) => {
    if (expandedIds.has(nodeId)) {
      const next = new Set(expandedIds);
      next.delete(nodeId);
      setExpandedIds(next);
    } else {
      const next = new Set(expandedIds);
      next.add(nodeId);
      setExpandedIds(next);
      if (!Object.prototype.hasOwnProperty.call(childrenMap, nodeId){% if model.tree_leaf %} || !Object.prototype.hasOwnProperty.call(leafMap, nodeId){% endif %}) {
        await loadChildren(nodeId, 1);
      }
    }
  };

  const refreshTree = async () => {
    setChildrenMap({});
    setChildrenPage({});
    setChildrenTotal({});
    {% if model.tree_leaf %}
    setLeafMap({});
    setLeafPage({});
    setLeafTotal({});
    {% endif %}
    setExpandedIds(new Set());
    await loadRoots(1);
  };
  {% endif %}

  // User model special handling: user role can only access /me
  {% if model.module_name == "user" and model.name == "User" %}
  useEffect(() => {
    if (userRole === 'user') {
      // Redirect to /users/me for user role
      navigate('/users/me');
    }
  }, [userRole, navigate]);
  {% endif %}

  {% for field in model.fields %}
  {% if field.fk_info %}
  const [{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels, set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels] = useState<Record<string, string>>({});
  const [search{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels, setSearch{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels] = useState<Record<string, string>>({});
  {% endif %}
  {% endfor %}
  {% if model.m2m_fields %}
  {% for m2m in model.m2m_fields %}
  const [{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels, set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels] = useState<Record<string, string>>({});
  {% endfor %}
  {% endif %}

  const { register, handleSubmit, reset, setValue, control, watch } = useForm();
  const rootValue = watch();

  {% if model.refresh_interval %}
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [refreshInterval, setRefreshInterval] = useState({{ model.refresh_interval }});

  useEffect(() => {
    let interval: ReturnType<typeof setInterval>;
    if (autoRefresh) {
      interval = setInterval(() => {
        refreshData(use{{ model.name }}Store.getState().page, use{{ model.name }}Store.getState().size);
      }, refreshInterval);
    }
    return () => clearInterval(interval);
  }, [autoRefresh, refreshInterval, refreshData]);
  {% endif %}

  useEffect(() => {
    {% if model.is_tree %}
    loadRoots(1);
    {% else %}
    fetchData(1, 20, scopeFilters);
    {% endif %}
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  {% if model.has_dynamic_action_states %}
  useEffect(() => {
    let cancelled = false;
    const ids = data.map((item) => item.id);
    if (ids.length === 0) {
      setActionStates({});
      return () => { cancelled = true; };
    }
    get{{ model.name }}ActionStates(ids)
      .then((states) => {
        if (!cancelled) setActionStates(states);
      })
      .catch(() => {
        if (!cancelled) setActionStates({});
      });
    return () => { cancelled = true; };
  }, [data]);
  {% endif %}

  {% if model.importable %}
  useEffect(() => {
    const handleImportComplete = (event: Event) => {
      const payload = (event as CustomEvent).detail;
      if (payload?.module !== '{{ model.module_name }}' || payload?.error) return;
      {% if model.is_tree %}
      refreshTree();
      {% else %}
      refreshData();
      {% endif %}
    };
    window.addEventListener('onesite:import-complete', handleImportComplete);
    return () => window.removeEventListener('onesite:import-complete', handleImportComplete);
  }, [{% if model.is_tree %}refreshTree{% else %}refreshData{% endif %}]);
  {% endif %}

  // Sync page input with current page from store
  const storePage = use{{ model.name }}Store(state => state.page);
  useEffect(() => {
    setGotoPageInput(String(storePage));
  }, [storePage]);

  const handleCreate = () => {
    {% if model.page_edit %}
    navigate('/{{ model.module_name }}s/new');
    {% else %}
    setEditingId(null);
    reset();
    {% for field in model.fields %}
    {% if field.fk_info %}
    set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
    {% endif %}
    {% endfor %}
    {% if model.m2m_fields %}
    {% for m2m in model.m2m_fields %}
    setValue('{{ m2m.write_name }}', []);
    {% if m2m.editor != 'inline' %}
    set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
    {% endif %}
    {% endfor %}
    {% endif %}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    setValue('{{ rfk.write_name }}', []);
    {% endif %}
    {% endfor %}
    setIsModalOpen(true);
    Object.entries(fixedFields).forEach(([field, value]) => setValue(field, value));
    {% endif %}
  };

  {% if model.has_embedded_page %}
  const loadAttachExistingOptions = async (query: string) => {
    const filters = query ? { {{ model.search_field }}: query } : undefined;
    const response = await get{{ model.name }}s(1, 20, filters);
    return response.items
      .filter((item: any) => !relationField || String(item[relationField]) !== String(relationValue))
      .map((item: any) => ({
        label: String(item.{{ model.search_field }} ?? item.id),
        value: item.id,
      }));
  };

  const handleAttachExisting = async () => {
    if (!relationField || relationValue === undefined || relationValue === null || attachExistingIds.length === 0) return;
    setIsAttachingExisting(true);
    try {
      await Promise.all(
        attachExistingIds.map((recordId) => update{{ model.name }}(recordId, { [relationField]: relationValue }))
      );
      toast.success(t('common.attach_existing_success', 'Existing records added'));
      setAttachExistingOpen(false);
      setAttachExistingIds([]);
      await fetchData(1, use{{ model.name }}Store.getState().size, scopeFilters);
    } catch (error: any) {
      const detail = error?.response?.data?.detail || t('common.attach_existing_failed', 'Failed to add existing records');
      toast.error(detail);
      console.error(error);
    } finally {
      setIsAttachingExisting(false);
    }
  };
  {% endif %}

  {% if model.is_tree %}
  const handleCreateChild = (parentNode: any) => {
    {% if model.page_edit %}
    navigate(`/{{ model.module_name }}s/new?parent_id=${parentNode.id}`);
    {% else %}
    setEditingId(null);
    reset();
    {% for field in model.fields %}
    {% if field.fk_info %}
    set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
    {% endif %}
    {% endfor %}
    {% if model.m2m_fields %}
    {% for m2m in model.m2m_fields %}
    setValue('{{ m2m.write_name }}', []);
    {% if m2m.editor != 'inline' %}
    set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
    {% endif %}
    {% endfor %}
    {% endif %}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    setValue('{{ rfk.write_name }}', []);
    {% endif %}
    {% endfor %}
    setValue('{{ model.tree_parent_field }}', parentNode.id);
    set{{ model.tree_parent_field|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({ [parentNode.id]: parentNode.{{ model.search_field }} || `#${parentNode.id}` });
    setIsModalOpen(true);
    {% endif %}
  };
  {% endif %}

  {% if model.exportable %}
  const handleExport = async () => {
    try {
      setIsExporting(true);
      const task = await export{{ model.name }}s(
        i18n.resolvedLanguage || i18n.language,
        {% if model.is_tree %}treeSearchFiltersRef.current{% else %}use{{ model.name }}Store.getState().filters{% endif %},
      );
      toast.success(t('common.export_started', 'Export started, you will be notified when complete'){% if model.export_task_center_visible is not false %}, {
        action: {
          label: t('task_center.view_progress', 'View progress'),
          onClick: () => navigate(`/task-center?task_id=${task.task_id}`),
        },
      }{% endif %});
    } catch (error) {
      toast.error(t('common.export_failed', 'Export failed'));
    } finally {
      setIsExporting(false);
    }
  };
  {% endif %}

  {% if model.importable %}
  const handleImportClick = () => {
    setImportingFile(null);
    setImportModalOpen(true);
  };

  const handleImportSubmit = async () => {
    if (!importingFile) {
      toast.error(t('import.no_file', 'Please select a file'));
      return;
    }

    try {
      setIsImporting(true);
      const task = await queueImport{{ model.name }}s(importingFile);
      toast.success(t('common.import_started', 'Import started, you will be notified when complete'){% if model.import_task_center_visible is not false %}, {
        action: {
          label: t('task_center.view_progress', 'View progress'),
          onClick: () => navigate(`/task-center?task_id=${task.task_id}`),
        },
      }{% endif %});
      setImportModalOpen(false);
      setImportingFile(null);
    } catch (error) {
      toast.error(t('import.failed', 'Import failed'));
    } finally {
      setIsImporting(false);
    }
  };
  {% endif %}

  {% if model.importable and not model.exportable and not model.custom_importable %}
  const handleDownloadTemplate = async () => {
    try {
      await download{{ model.name }}Template();
      toast.success(t('template.downloaded', 'Template downloaded'));
    } catch (error) {
      toast.error(t('template.download_failed', 'Download failed'));
    }
  };
  {% endif %}

  const handleEdit = async (record: {{ model.name }}) => {
    {% if model.page_edit %}
    navigate(`/{{ model.module_name }}s/${record.id}?edit=true`);
    {% else %}
    setEditingId(record.id);
    const full = await fetchItem(record.id);
    const item = full || record;
    // Set form values
    {% for field in model.fields %}
    {% if 'r' in field.permissions %}
    setValue('{{ field.name }}', item.{{ field.name }});
    {% endif %}
    {% endfor %}
    {% for field in model.fields %}
    {% if field.fk_info %}
    try {
      if (item.{{ field.name }}) {
        const fkItem = await get{{ field.fk_info.target_model }}(item.{{ field.name }});
        if (fkItem) {
          set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({ [String(fkItem.id)]: fkItem.{{ field.fk_info.label_field }} || String(fkItem.id) });
        } else {
          set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
        }
      } else {
        set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
      }
    } catch (error) {
      console.error(error);
      set{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
    }
    {% endif %}
    {% endfor %}
    {% if model.m2m_fields %}
    {% for m2m in model.m2m_fields %}
    try {
      {% if m2m.editor == 'inline' %}
      const rel = await get{{ model.name }}{{ m2m.target_model }}s(record.id, 1, -1);
      setValue('{{ m2m.write_name }}', rel.items);
      {% elif m2m.order_field %}
      const rel = await get{{ model.name }}{{ m2m.target_model }}sWithMeta(record.id, 1, 200);
      const ordered = [...rel.items].sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0));
      setValue('{{ m2m.name }}', ordered.map((x: any) => x.id));
      set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels(Object.fromEntries(ordered.map((x: any) => [String(x.id), x.label || String(x.id)])));
      {% else %}
      const rel = await get{{ model.name }}{{ m2m.target_model }}s(record.id, 1, 200);
      setValue('{{ m2m.name }}', rel.items.map((x: any) => x.id));
      set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels(Object.fromEntries(rel.items.map((x: any) => [String(x.id), x.{{ m2m.label_field }} || String(x.id)])));
      {% endif %}
    } catch (error) {
      console.error(error);
      set{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
    }
    {% endfor %}
    {% endif %}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.editor == 'inline' %}
    try {
      const rel = await get{{ rfk.source_model }}s(1, -1, { {{ rfk.source_fk_field }}: record.id });
      setValue('{{ rfk.write_name }}', rel.items);
    } catch (error) {
      console.error(error);
      setValue('{{ rfk.write_name }}', []);
    }
    {% endif %}
    {% endfor %}
    setIsModalOpen(true);
    {% endif %}
  };

  {% if not model.page_edit %}
  // Relation tables can deep-link into the same edit modal used by this list page.
  const editRecordId = searchParams.get('edit');
  useEffect(() => {
    if (!editRecordId) return;
    const recordId = {% if 'str' in model.id_type %}editRecordId{% else %}Number(editRecordId){% endif %};
    if ({% if 'str' in model.id_type %}!recordId{% else %}!Number.isFinite(recordId){% endif %}) return;
    void handleEdit({ id: recordId } as {{ model.name }}).finally(() => {
      setSearchParams((current) => {
        const next = new URLSearchParams(current);
        next.delete('edit');
        return next;
      }, { replace: true });
    });
  // The query parameter is consumed once; handleEdit intentionally uses the latest generated form helpers.
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [editRecordId]);
  {% endif %}

  const requestDelete = (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
    setDeleteId(id);
    setDeleteOpen(true);
  };

  const confirmDelete = async () => {
    if (!deleteId) return;
    setIsDeleting(true);
    try {
      await deleteItem(deleteId);
      toast.success(t('toast.delete_success', 'Deleted'));
      {% if model.is_tree %}
      await refreshTree();
      {% endif %}
    } catch (error: any) {
      const detail = error?.response?.data?.detail || t('toast.delete_failed', 'Delete failed');
      toast.error(detail);
      console.error(error);
    } finally {
      setIsDeleting(false);
      setDeleteOpen(false);
      setDeleteId(null);
    }
  };

  const toggleSelectAll = () => {
    if (selectedIds.length === data.length) {
      setSelectedIds([]);
    } else {
      setSelectedIds(data.map((item) => item.id));
    }
  };

  const toggleSelect = (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
    setSelectedIds((prev) =>
      prev.includes(id) ? prev.filter((i) => i !== id) : [...prev, id]
    );
  };

  const confirmBulkDelete = async () => {
    if (selectedIds.length === 0) return;
    setIsBulkDeleting(true);
    try {
      await bulkDeleteItem(selectedIds);
      toast.success(t('toast.delete_success', 'Deleted'));
      setSelectedIds([]);
      {% if model.is_tree %}
      await refreshTree();
      {% endif %}
    } catch (error: any) {
      const detail = error?.response?.data?.detail || t('toast.delete_failed', 'Delete failed');
      toast.error(detail);
      console.error(error);
    } finally {
      setIsBulkDeleting(false);
      setBulkDeleteOpen(false);
    }
  };

  {% if not model.page_edit %}
  const onSubmit = async (values: any) => {
    if (isSaving) return;
    setIsSaving(true);
    const payload = { ...values, ...fixedFields };
    try {
      {% if model.is_tree %}
      if (editingId) {
        await updateItem(editingId, payload);
        toast.success(t('toast.update_success', 'Updated'));
        setIsModalOpen(false);
        await refreshTree();
      } else {
        const parentId = values.{{ model.tree_parent_field }};
        await createItem(payload);
        toast.success(t('toast.create_success', 'Created'));
        setIsModalOpen(false);
        if (parentId) {
          await loadChildren(parentId, 1);
        } else {
          await loadRoots(1);
        }
      }
      {% else %}
      if (editingId) {
        await updateItem(editingId, payload);
        toast.success(t('toast.update_success', 'Updated'));
      } else {
        await createItem(payload);
        toast.success(t('toast.create_success', 'Created'));
      }
      setIsModalOpen(false);
      {% endif %}
    } catch (error) {
      toast.error(t('toast.save_failed', 'Save failed'));
      console.error(error);
    } finally {
      setIsSaving(false);
    }
  };
  {% endif %}

  const applySearch = () => {
    const next: Record<string, any> = { ...scopeFilters };
    {% for field in model.fields %}
    {% if field.is_search_field %}
    {% if field.ui_type == 'bool' %}
    if (searchValues['{{ field.name }}'] === 'true') next['{{ field.name }}'] = true;
    if (searchValues['{{ field.name }}'] === 'false') next['{{ field.name }}'] = false;
    {% elif field.ui_type == 'datetime' %}
    if (searchValues['{{ field.name }}_from']) next['{{ field.name }}_from'] = `${searchValues['{{ field.name }}_from']}T00:00:00`;
    if (searchValues['{{ field.name }}_to']) next['{{ field.name }}_to'] = `${searchValues['{{ field.name }}_to']}T23:59:59`;
    {% elif field.ui_type == 'time' %}
    if (searchValues['{{ field.name }}']) next['{{ field.name }}'] = searchValues['{{ field.name }}'];
    {% elif field.is_enum and field.is_multi_select %}
    if (Array.isArray(searchValues['{{ field.name }}']) && searchValues['{{ field.name }}'].length > 0) next['{{ field.name }}'] = searchValues['{{ field.name }}'];
    {% elif field.is_enum %}
    if (searchValues['{{ field.name }}'] && searchValues['{{ field.name }}'] !== '__all__') next['{{ field.name }}'] = searchValues['{{ field.name }}'];
    {% elif field.ui_type == 'str' %}
    if (searchValues['{{ field.name }}']) next['{{ field.name }}'] = searchValues['{{ field.name }}'];
    {% endif %}
    {% endif %}
    {% endfor %}
    {% for field in model.fields %}
    {% if field.fk_info and field.is_search_field %}
    if (searchValues['{{ field.name }}']) next['{{ field.name }}'] = Number(searchValues['{{ field.name }}']);
    {% endif %}
    {% endfor %}
    {% if model.is_tree %}
    treeSearchFiltersRef.current = next;
    loadRoots(1);
    {% else %}
    fetchData(1, use{{ model.name }}Store.getState().size, next);
    {% endif %}
  };

  const resetSearch = () => {
    setSearchValues({});
    {% for field in model.fields %}
    {% if field.fk_info and field.is_search_field %}
    setSearch{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels({});
    {% endif %}
    {% endfor %}
  };

  // Apply filter changes automatically while avoiding a request on every keystroke.
  const searchListenerReady = useRef(false);
  useEffect(() => {
    if (!searchListenerReady.current) {
      searchListenerReady.current = true;
      return;
    }
    const timer = setTimeout(applySearch, 300);
    return () => clearTimeout(timer);
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [searchValues]);

  return (
    <div
      className="{{ page_shell_class | default('flex h-full min-h-0 flex-col gap-6') }}"
      data-codegen-theme="{{ codegen_theme | default('normal') }}"
      data-page-kind="list"
    >
      <AlertDialog open={deleteOpen} onOpenChange={(open) => { if (!isDeleting) setDeleteOpen(open); }}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>{t('alert.delete_title', 'Confirm deletion')}</AlertDialogTitle>
            <AlertDialogDescription>
              {t('common.confirm_delete')}
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel disabled={isDeleting}>{t('common.cancel')}</AlertDialogCancel>
            <AlertDialogAction
              disabled={isDeleting}
              onClick={(event) => {
                // Radix Action closes immediately by default. Keep the dialog
                // mounted so the pending state remains visible until deletion finishes.
                event.preventDefault();
                void confirmDelete();
              }}
            >
              {isDeleting ? (
                <><Loader2 className="mr-2 h-4 w-4 animate-spin" /> {t('common.deleting', 'Deleting...')}</>
              ) : t('common.delete')}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      <AlertDialog open={bulkDeleteOpen} onOpenChange={(open) => { if (!isBulkDeleting) setBulkDeleteOpen(open); }}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>{t('alert.delete_title', 'Confirm deletion')}</AlertDialogTitle>
            <AlertDialogDescription>
              {t('alert.bulk_delete_confirm', `Are you sure you want to delete ${selectedIds.length} items?`)}
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel disabled={isBulkDeleting}>{t('common.cancel')}</AlertDialogCancel>
            <AlertDialogAction
              disabled={isBulkDeleting}
              onClick={(event) => {
                // Radix Action closes immediately by default. Keep the dialog
                // mounted so the pending state remains visible until deletion finishes.
                event.preventDefault();
                void confirmBulkDelete();
              }}
            >
              {isBulkDeleting ? (
                <><Loader2 className="mr-2 h-4 w-4 animate-spin" /> {t('common.deleting', 'Deleting...')}</>
              ) : t('common.delete')}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      <div className="flex items-center justify-between">
        <h1 className="text-3xl font-bold tracking-tight">{% if model.owner_field %}{userRole === 'user' ? t('models.{{ model.module_name }}.my_name') : t('models.{{ model.module_name }}.plural')}{% else %}{t('models.{{ model.module_name }}.plural')}{% endif %}</h1>
        <div className="flex items-center gap-4">
          {% if model.refresh_interval %}
          <div className="flex items-center gap-2">
             <span className="text-sm text-muted-foreground">{t('common.auto_refresh')}</span>
             <Switch checked={autoRefresh} onCheckedChange={setAutoRefresh} />
             {autoRefresh && (
                <Select value={String(refreshInterval)} onValueChange={(v) => setRefreshInterval(Number(v))}>
                    <SelectTrigger className="w-[100px] h-8">
                        <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem value="1000">1s</SelectItem>
                        <SelectItem value="5000">5s</SelectItem>
                        <SelectItem value="10000">10s</SelectItem>
                        <SelectItem value="30000">30s</SelectItem>
                    </SelectContent>
                </Select>
             )}
          </div>
          {% endif %}
          {% if model.importable or model.exportable %}
          <div className="flex items-center gap-2">
            {% if model.importable %}
            {hasPermission('c') && hasPermission('u') && (
              <Button variant="outline" onClick={handleImportClick}>
                <Upload className="mr-2 h-4 w-4" /> {t('common.import', 'Import')}
              </Button>
            )}
            {% endif %}
            {% if model.exportable %}
            {hasPermission('r') && (
              <Button variant="outline" onClick={handleExport} disabled={isExporting}>
                {isExporting ? (
                  <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                ) : (
                  <Download className="mr-2 h-4 w-4" />
                )}
                {isExporting ? t('common.loading', 'Loading...') : t('common.export', 'Export')}
              </Button>
            )}
            {% endif %}
            {% if model.importable and not model.exportable and not model.custom_importable %}
            <Button variant="outline" onClick={handleDownloadTemplate}>
              <Download className="mr-2 h-4 w-4" /> {t('common.template', 'Template')}
            </Button>
            {% endif %}
          </div>
          {% endif %}
          {selectedIds.length > 0 && hasPermission('d') && (
            <Button variant="destructive" onClick={() => setBulkDeleteOpen(true)}>
              <Trash className="mr-2 h-4 w-4" /> {t('common.bulk_delete', 'Delete')} ({selectedIds.length})
            </Button>
          )}
          {hasPermission('c') && (
            <Button onClick={handleCreate}>
              <Plus className="mr-2 h-4 w-4" /> {t('common.create')} {t('models.{{ model.module_name }}.name')}
            </Button>
          )}
          {% if model.has_embedded_page %}
          {embedded && allowAttachExisting && relationField && hasPermission('r') && hasPermission('u') && hasFieldPerm(relationField, 'u') && (
            <Button
              variant="outline"
              onClick={() => {
                setAttachExistingIds([]);
                setAttachExistingOpen(true);
              }}
            >
              <Plus className="mr-2 h-4 w-4" /> {t('common.add_existing', 'Add existing')}
            </Button>
          )}
          {% endif %}
        </div>
      </div>

      {% set ns = namespace(has_search_fields=false) %}
      {% for field in model.fields %}
          {% if field.is_search_field and (field.ui_type in ['bool','str','datetime','time'] or field.is_enum) %}
      {% set ns.has_search_fields = true %}
      {% elif field.fk_info and field.is_search_field %}
      {% set ns.has_search_fields = true %}
      {% endif %}
      {% endfor %}
      {% if ns.has_search_fields %}
      <div className="rounded-md border bg-card p-4 border-l-[3px] border-l-accent/40">
        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div className="text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">{t('common.filters', 'Filters')}</div>
          <div className="flex items-center gap-2">
            <Button variant="outline" size="sm" type="button" onClick={resetSearch}>{t('common.reset', 'Reset')}</Button>
          </div>
        </div>
        <div className="mt-4 max-h-[40vh] overflow-y-auto overflow-x-hidden pr-2">
          <div className="grid min-w-0 grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
          {% for field in model.fields %}
              {% if field.is_search_field and (field.ui_type in ['bool','str','datetime','time'] or field.is_enum) %}
          <div className="min-w-0 space-y-2">
            <Label className="block truncate" title={String(t('{{ field.label_key }}'))}>{t('{{ field.label_key }}')}</Label>
            {% if field.ui_type == 'bool' %}
            <Select
              value={searchValues['{{ field.name }}'] || '__all__'}
              onValueChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
            >
              <SelectTrigger className="h-9 min-w-0 w-full">
                <SelectValue placeholder={t('common.all', 'All')} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__all__">{t('common.all', 'All')}</SelectItem>
                <SelectItem value="true">{t('common.yes', 'Yes')}</SelectItem>
                <SelectItem value="false">{t('common.no', 'No')}</SelectItem>
              </SelectContent>
            </Select>
            {% elif field.ui_type == 'datetime' %}
            <div className="grid min-w-0 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2">
              <Input
                type="date"
                className="h-9 min-w-0 w-full"
                value={searchValues['{{ field.name }}_from'] || ''}
                onChange={(e) => setSearchValues((s) => ({ ...s, ['{{ field.name }}_from']: e.target.value }))}
              />
              <span className="text-muted-foreground text-sm">-</span>
              <Input
                type="date"
                className="h-9 min-w-0 w-full"
                value={searchValues['{{ field.name }}_to'] || ''}
                onChange={(e) => setSearchValues((s) => ({ ...s, ['{{ field.name }}_to']: e.target.value }))}
              />
            </div>
            {% elif field.ui_type == 'time' %}
            <TimePicker
              value={searchValues['{{ field.name }}'] || ''}
              onChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
              placeholder={t('common.select_time', 'Select time')}
            />
            {% elif field.is_enum and field.is_multi_select %}
            <SearchableSelect
              value={searchValues['{{ field.name }}'] || []}
              onValueChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
              multiple={true}
              placeholder={t('common.all', 'All')}
              searchPlaceholder={`${t('common.search')}...`}
              loadOptions={async () => [
                {% for enum_val in field.enum_values %}
                { label: t('models.{{ model.module_name }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}'), value: '{{ enum_val }}' },
                {% endfor %}
              ]}
            />
            {% elif field.is_enum %}
            <Select
              value={searchValues['{{ field.name }}'] || '__all__'}
              onValueChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
            >
              <SelectTrigger className="h-9 min-w-0 w-full">
                <SelectValue placeholder={t('common.all', 'All')} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__all__">{t('common.all', 'All')}</SelectItem>
                {% for enum_val in field.enum_values %}
                <SelectItem value="{{ enum_val }}">{
                    t('models.{{ model.module_name }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}')
                }</SelectItem>
                {% endfor %}
              </SelectContent>
            </Select>
            {% elif field.ui_type == 'str' %}
            <Input
              className="h-9 min-w-0 w-full"
              value={searchValues['{{ field.name }}'] || ''}
              onChange={(e) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: e.target.value }))}
              placeholder={t('common.search')}
            />
            {% endif %}
          </div>
          {% elif field.fk_info and field.is_search_field %}
          <div className="min-w-0 space-y-2">
            <Label className="block truncate" title={String(t('{{ field.label_key }}'))}>{t('{{ field.label_key }}')}</Label>
            <SearchableSelect
              value={searchValues['{{ field.name }}'] || ''}
              onValueChange={(v) => {
                setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }));
                if (v) {
                  const key = String(v);
                  const label = {{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels[key] || '';
                  if (label) {
                    setSearch{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels((s) => ({ ...s, [key]: label }));
                  }
                }
              }}
              placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
              searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
              valueLabels={search{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels}
              loadOptions={async (query) => {
                const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                return response.items.map((item: any) => ({
                  label: item.{{ field.fk_info.label_field }} || item.id,
                  value: item.id
                }));
              }}
            />
          </div>
          {% endif %}
          {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}

{% if not model.is_tree %}
      <div className="flex-1 min-h-0 overflow-hidden border rounded-md border-t-2 border-t-accent/30 [&>[data-ui=table-container]]:h-full">
        <Table>
          <TableHeader className="sticky top-0 z-20 bg-card shadow-sm">
            {% set list_extra_fields = model.extra_fields | default([]) | selectattr('show_in_list') | list %}
            <TableRow>
              <TableHead className="w-[40px]">
                <input
                  type="checkbox"
                  checked={selectedIds.length === data.length && data.length > 0}
                  onChange={toggleSelectAll}
                  className="h-4 w-4 rounded border-gray-300"
                />
              </TableHead>
              {% for field in model.fields %}
              {% if 'r' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'r'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
              <TableHead>{t('{{ field.label_key }}')}</TableHead>
              )}{% endif %}
              {% endfor %}
              {% for field in list_extra_fields %}
              <TableHead>{{ field.label if field.label is string else field.name }}</TableHead>
              {% endfor %}
              <TableHead className="w-[100px] sticky right-0 bg-card z-10 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.08)]">{t('common.actions')}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {loading ? (
                <TableRow>
                    <TableCell colSpan={ {{ model.fields|length + list_extra_fields|length + 2 }} } className="h-24 text-center">
                        <Loader2 className="h-6 w-6 animate-spin mx-auto" />
                    </TableCell>
                </TableRow>
            ) : data.length === 0 ? (
                <TableRow>
                    <TableCell colSpan={ {{ model.fields|length + list_extra_fields|length + 2 }} } className="h-24 text-center">
                        {t('common.no_result')}
                    </TableCell>
                </TableRow>
            ) : (
                data.map((item) => (
                <TableRow key={item.id}>
                    <TableCell>
                      <input
                        type="checkbox"
                        checked={selectedIds.includes(item.id)}
                        onChange={() => toggleSelect(item.id)}
                        className="h-4 w-4 rounded border-gray-300"
                      />
                    </TableCell>
                    {% for field in model.fields %}
                    {% if 'r' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'r'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
                    <TableCell>
                        {% if field.fk_info %}
                        <span className="block max-w-[250px] truncate" title={item.{{ field.name }}_label || (item.{{ field.name }} ? `ID: ${item.{{ field.name }}}` : '-')}>
                        {item.{{ field.name }}_label || (item.{{ field.name }} ? `ID: ${item.{{ field.name }}}` : '-')}
                        </span>
                        {% elif field.ui_type == 'bool' %}
                        <Badge variant={item.{{ field.name }} ? "default" : "secondary"}>
                            {item.{{ field.name }} ? 'Yes' : 'No'}
                        </Badge>
                        {% elif field.ui_type == 'image' %}
                        <div className="h-10 w-10 overflow-hidden rounded-md border bg-muted">
                            <img
                                src={item.{{ field.name }} || 'https://placehold.co/100?text=No+Image'}
                                alt="{{ field.name }}"
                                className="h-full w-full object-cover"
                                onError={(e) => {
                                    (e.target as HTMLImageElement).src = 'https://placehold.co/100?text=Error';
                                }}
                            />
                        </div>
                        {% elif field.ui_type == 'images' %}
                        {Array.isArray(item.{{ field.name }}) && item.{{ field.name }}.length ? (
                            <div className="flex items-center gap-2">
                                <div className="h-10 w-10 overflow-hidden rounded-md border bg-muted">
                                    <img src={item.{{ field.name }}[0]} alt="{{ field.name }}" className="h-full w-full object-cover" />
                                </div>
                                {item.{{ field.name }}.length > 1 && <span className="text-sm text-muted-foreground">+{item.{{ field.name }}.length - 1}</span>}
                            </div>
                        ) : '-'}
                        {% elif field.ui_type == 'file' %}
                        {item.{{ field.name }} ? (
                            <div className="flex items-center gap-2">
                                <span
                                    className="flex items-center text-primary cursor-pointer hover:underline"
                                    title={item.{{ field.name }}}
                                    onClick={() => {
                                        // TODO: Open preview
                                    }}
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="mr-1"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    File
                                </span>
                                {% if field.allow_download %}
                                <a
                                    href={item.{{ field.name }}}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    className="text-muted-foreground hover:text-primary"
                                    title="Download"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                </a>
                                {% endif %}
                            </div>
                        ) : (
                            <span className="text-muted-foreground">-</span>
                        )}
                        {% elif field.ui_type == 'video_stream' %}
                        {item.{{ field.name }} ? (
                            <Badge variant="secondary" title={item.{{ field.name }}} className="max-w-[180px] truncate">
                                {t('video_stream.stream')}
                            </Badge>
                        ) : '-'}
                        {% elif field.is_enum and field.is_multi_select %}
                        <div className="flex flex-wrap gap-1">
                        {Array.isArray(item.{{ field.name }}) && item.{{ field.name }}.map((v: string) => (
                            <Badge key={v} variant="default" className="px-2.5 py-0.5 text-xs font-medium shadow-sm whitespace-nowrap">{String(t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v))}</Badge>
                        ))}
                        </div>
                        {% elif field.is_enum %}
                        {item.{{ field.name }} != null ? (
                            <Badge variant="default" className="px-2.5 py-0.5 text-xs font-medium shadow-sm whitespace-nowrap">{String(t(`models.{{ model.module_name }}.enums.{{ field.name }}.${item.{{ field.name }}}`, item.{{ field.name }}))}</Badge>
                        ) : '-'}
                        {% elif field.ui_type == 'datetime' %}
                        <span className="text-muted-foreground">{formatDateTime(item.{{ field.name }}, timeZone)}</span>
                        {% elif field.ui_type == 'time' %}
                        <span className="text-muted-foreground">{formatTime(item.{{ field.name }})}</span>
                        {% elif field.ui_type == 'location' %}
                        <span className="whitespace-nowrap text-muted-foreground">
                        {item.{{ field.name }}?.latitude != null && item.{{ field.name }}?.longitude != null
                          ? `${item.{{ field.name }}.latitude}, ${item.{{ field.name }}.longitude}`
                          : '-'}
                        </span>
                        {% elif field.ui_type == 'json' %}
                        <JsonPreview value={item.{{ field.name }}} />
                        {% else %}
                        <span className="block max-w-[250px] truncate" title={String(item.{{ field.name }})}>
                        {String(item.{{ field.name }})}
                        </span>
                        {% endif %}
                    </TableCell>
                    )}{% endif %}
                    {% endfor %}
                    {% for field in list_extra_fields %}
                    <TableCell>
                        <span className="block max-w-[250px] truncate" title={String(item.{{ field.name }} ?? '')}>
                            {item.{{ field.name }} == null ? '-' : String(item.{{ field.name }})}
                        </span>
                    </TableCell>
                    {% endfor %}
                    <TableCell className="sticky right-0 bg-card z-10">
                        <div className="flex items-center gap-2">
                        <>
                        {% if model.actions %}
                        {% for action_name, action_config in model.actions.items() %}
                        {(() => {
                            const actionPerms = {{ action_config.get("permissions", "da") | tojson }};
                            const roleChar = userRole[0];
                            if (!actionPerms.includes(roleChar)) return false;
                            {% if action_config.get("dynamic_availability") %}
                            const state = actionStates[String(item.id)]?.[{{ action_name | tojson }}];
                            return Boolean(state?.visible);
                            {% else %}
                            const cond = {{ action_config.get("condition", None) | tojson }} as any;
                            let enabled = true;
                            if (cond) {
                                const field = cond.field;
                                const op = cond.op;
                                const expected = cond.value;
                                const actual = (item as any)[field];
                                if (op === 'eq') enabled = actual === expected;
                                else if (op === 'ne') enabled = actual !== expected;
                                else if (op === 'in') enabled = Array.isArray(expected) ? expected.includes(actual) : false;
                                else if (op === 'not_in') enabled = Array.isArray(expected) ? !expected.includes(actual) : true;
                                else if (op === 'gt') enabled = actual > expected;
                                else if (op === 'gte') enabled = actual >= expected;
                                else if (op === 'lt') enabled = actual < expected;
                                else if (op === 'lte') enabled = actual <= expected;
                                else if (op === 'contains') enabled = actual?.includes(expected);
                                else if (op === 'startswith') enabled = String(actual).startsWith(String(expected));
                                else if (op === 'endswith') enabled = String(actual).endsWith(String(expected));
                                else if (op === 'is_null') enabled = actual === null || actual === undefined;
                                else if (op === 'is_not_null') enabled = actual !== null && actual !== undefined;
                            }
                            return enabled;
                            {% endif %}
                        })() && (
                        <Button
                            variant={% if action_config.get("toggle") %}{(item as any)[{{ action_config.get("toggle") | tojson }}] ? "destructive" : "default"}{% else %}"outline"{% endif %}
                            size="sm"
                            {% if action_config.get("dynamic_availability") %}
                            disabled={!actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.enabled}
                            title={actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.reason}
                            {% endif %}
                            onClick={async (e) => {
                                e.stopPropagation();
                                try {
                                    await perform{{ model.name }}{{ action_name.capitalize() }}(item.id);
                                    toast.success(t('common.success', 'Success'));
                                    fetchData(use{{ model.name }}Store.getState().page, use{{ model.name }}Store.getState().size);
                                } catch (e) {
                                    toast.error(t('common.error', 'Error'));
                                }
                            }}
                        >
                            {% if action_config.get("toggle") %}
                            {(item as any)[{{ action_config.get("toggle") | tojson }}] ? t('common.disable', 'Disable') : t('common.enable', 'Enable')}
                            {% else %}
                            {% if action_config.get("dynamic_availability") %}
                            {actionStates[String(item.id)]?.[{{ action_name | tojson }}]?.label || {{ (action_config.get("label") or action_name) | tojson }}}
                            {% else %}
                            { {{ (action_config.get("label") or action_name) | tojson }} }
                            {% endif %}
                            {% endif %}
                        </Button>
                        )}
                        {% endfor %}
                        {% endif %}
                        </>
                        {!embedded && hasPermission('r') && (
                        <Button variant="ghost" size="icon" onClick={() => navigate(`/{{ model.module_name }}s/${item.id}`)}>
                            <Eye className="h-4 w-4" />
                        </Button>
                        )}
                        {hasPermission('u') && (
                        <Button variant="ghost" size="icon" onClick={() => handleEdit(item)}>
                            <Pencil className="h-4 w-4" />
                        </Button>
                        )}
                        {hasPermission('d') && (
                        <Button variant="ghost" size="icon" className="text-destructive" onClick={() => requestDelete(item.id)}>
                            <Trash2 className="h-4 w-4" />
                        </Button>
                        )}
                        </div>
                    </TableCell>
                </TableRow>
                ))
            )}
          </TableBody>
        </Table>
      </div>

      {/* Pagination Controls */}
      <div className={`shrink-0 flex flex-wrap items-center justify-between gap-4 ${embedded ? '' : 'bg-background'}`}>
        <div className="flex items-center gap-4">
          <div className="text-sm text-muted-foreground whitespace-nowrap">
            {t('common.page_info')} {use{{ model.name }}Store(state => state.page)} {t('common.of_page')} {Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || 1}
          </div>
          <div className="flex items-center gap-2">
            <span className="text-sm text-muted-foreground whitespace-nowrap">{t('common.page_size', 'Page size')}:</span>
            <Select
              value={String(use{{ model.name }}Store.getState().size)}
              onValueChange={(v) => {
                const newSize = Number(v);
                fetchData(1, newSize);
              }}
            >
              <SelectTrigger className="w-[80px] h-8">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="10">10</SelectItem>
                <SelectItem value="20">20</SelectItem>
                <SelectItem value="50">50</SelectItem>
                <SelectItem value="100">100</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchData(1, use{{ model.name }}Store.getState().size)}
            disabled={use{{ model.name }}Store(state => state.page) <= 1 || loading}
          >
            {t('common.first')}
          </Button>
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchData(use{{ model.name }}Store.getState().page - 1, use{{ model.name }}Store.getState().size)}
            disabled={use{{ model.name }}Store(state => state.page) <= 1 || loading}
          >
            {t('common.previous')}
          </Button>
          <div className="flex items-center gap-1">
            <Input
              type="number"
              min={1}
              max={Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || 1}
              className="w-16 h-8 text-center"
              value={gotoPageInput}
              onChange={(e) => setGotoPageInput(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter') {
                  const page = Number(gotoPageInput);
                  const totalPages = Math.ceil(use{{ model.name }}Store.getState().total / use{{ model.name }}Store.getState().size) || 1;
                  if (page >= 1 && page <= totalPages) {
                    fetchData(page, use{{ model.name }}Store.getState().size);
                  }
                }
              }}
            />
          </div>
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchData(use{{ model.name }}Store.getState().page + 1, use{{ model.name }}Store.getState().size)}
            disabled={use{{ model.name }}Store(state => state.page) >= Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || loading}
          >
            {t('common.next')}
          </Button>
          <Button
            variant="outline"
            size="sm"
            onClick={() => {
              const totalPages = Math.ceil(use{{ model.name }}Store.getState().total / use{{ model.name }}Store.getState().size) || 1;
              fetchData(totalPages, use{{ model.name }}Store.getState().size);
            }}
            disabled={use{{ model.name }}Store(state => state.page) >= Math.ceil(use{{ model.name }}Store(state => state.total) / use{{ model.name }}Store(state => state.size)) || loading}
          >
            {t('common.last')}
          </Button>
        </div>
      </div>
{% else %}
      {/* Tree View — Lazy Loading */}
      <div className="flex-1 min-h-0 overflow-auto rounded-md border border-t-2 border-t-accent/30 bg-card shadow-sm">
        <div className="sticky top-0 z-10 flex items-center justify-between border-b bg-card/95 px-4 py-2.5 backdrop-blur supports-[backdrop-filter]:bg-card/80">
          <div className="flex min-w-0 items-center gap-2">
            <FolderOpen className="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
            <span className="truncate text-sm font-medium">{t('models.{{ model.module_name }}.name')}</span>
            {!rootLoading && <Badge variant="secondary" className="shrink-0 font-normal">{rootTotal}</Badge>}
          </div>
          <span className="text-xs text-muted-foreground">{t('common.page_info')} {rootPage} {t('common.of_page')} {Math.ceil(rootTotal / rootSize) || 1}</span>
        </div>
        {rootLoading && rootItems.length === 0 ? (
          <div className="flex h-32 items-center justify-center">
            <Loader2 className="h-6 w-6 animate-spin mx-auto" />
          </div>
        ) : !rootLoading && rootItems.length === 0 ? (
          <div className="flex h-32 flex-col items-center justify-center gap-2 text-center text-sm text-muted-foreground">
            <Folder className="h-7 w-7 opacity-50" aria-hidden="true" />
            <span>{t('common.no_result')}</span>
          </div>
        ) : (
          <div className="min-w-max py-2">
            {(() => {
              const renderNodes = (nodes: any[], depth: number): React.ReactNode[] => {
                const elements: React.ReactNode[] = [];
                for (const node of nodes) {
                  const isExpanded = expandedIds.has(node.id);
                  const children = childrenMap[node.id] || [];
                  const childTotal = childrenTotal[node.id] || 0;
                  const childPageNum = childrenPage[node.id] || 1;
                  const isLoading = loadingChildren[node.id];
                  const hasMore = children.length > 0 && children.length < childTotal;
                  {% if model.tree_leaf %}
                  const leaves = leafMap[node.id] || [];
                  const leafCount = leafTotal[node.id] || 0;
                  const leavesLoading = loadingLeaves[node.id];
                  const hasMoreLeaves = leaves.length > 0 && leaves.length < leafCount;
                  {% endif %}
                  // An absent entry means this node has not been expanded yet.
                  // Only disable the expander after a completed child request confirms
                  // that the node has no children.
                  const hasLoadedChildren = Object.prototype.hasOwnProperty.call(childrenMap, node.id);
                  {% if model.tree_leaf %}
                  const hasLoadedLeaves = Object.prototype.hasOwnProperty.call(leafMap, node.id);
                  const isLeaf = hasLoadedChildren && hasLoadedLeaves && !isLoading && !leavesLoading && !hasMore && !hasMoreLeaves && children.length === 0 && childTotal === 0 && leaves.length === 0 && leafCount === 0;
                  {% else %}
                  const isLeaf = hasLoadedChildren && !isLoading && !hasMore && children.length === 0 && childTotal === 0;
                  {% endif %}
                  const label = node.{{ model.search_field }} || `#${node.id}`;

                  elements.push(
                    <div
                      key={node.id}
                      className="group relative mx-2 flex min-h-10 items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-accent/60 focus-within:bg-accent/60"
                      style={% raw %}{{ paddingLeft: `${depth * 28 + 8}px` }}{% endraw %}
                    >
                      {depth > 0 && (
                        <>
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-0 bottom-0 w-px bg-border"
                            style={% raw %}{{ left: `${(depth - 1) * 28 + 21}px` }}{% endraw %}
                          />
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-1/2 h-px w-3.5 bg-border"
                            style={% raw %}{{ left: `${(depth - 1) * 28 + 21}px` }}{% endraw %}
                          />
                        </>
                      )}
                      <button
                        type="button"
                        className="relative z-[1] flex h-6 w-6 shrink-0 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:bg-background hover:text-foreground focus:outline-none focus:ring-2 focus:ring-ring disabled:cursor-default disabled:hover:bg-transparent"
                        onClick={() => handleToggleExpand(node.id)}
                        disabled={isLeaf}
                        aria-label={isExpanded ? 'Collapse node' : 'Expand node'}
                      >
                        {isLoading ? (
                          <Loader2 className="h-4 w-4 animate-spin text-muted-foreground" />
                        ) : isExpanded ? (
                          children.length > 0 ? (
                            <ChevronDown className="h-4 w-4 text-muted-foreground" />
                          ) : (
                            <span className="h-4 w-4" aria-hidden="true" />
                          )
                        ) : !isLeaf ? (
                          <ChevronRight className="h-4 w-4 text-muted-foreground" />
                        ) : null}
                      </button>
                      {isExpanded ? (
                        <FolderOpen className="h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                      ) : (
                        <Folder className="h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                      )}
                      <div className="flex min-w-0 flex-1 items-center gap-2">
                        <span className="truncate text-sm font-medium" title={String(label)}>{label}</span>
                        {childTotal{% if model.tree_leaf %} + leafCount{% endif %} > 0 && (
                          <Badge variant="secondary" className="h-5 shrink-0 px-1.5 text-[10px] font-medium">
                            {childTotal{% if model.tree_leaf %} + leafCount{% endif %}}
                          </Badge>
                        )}
                      </div>
                      <div className="flex shrink-0 items-center gap-1 rounded-md bg-background/80 p-0.5 opacity-80 shadow-sm transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
                        {hasPermission('c') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => handleCreateChild(node)} aria-label="Add child">
                            <Plus className="h-3.5 w-3.5" />
                          </Button>
                        )}
                        {hasPermission('r') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => navigate(`/{{ model.module_name }}s/${node.id}`)} aria-label="View node">
                            <Eye className="h-3.5 w-3.5" />
                          </Button>
                        )}
                        {hasPermission('u') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => handleEdit(node)} aria-label="Edit node">
                            <Pencil className="h-3.5 w-3.5" />
                          </Button>
                        )}
                        {hasPermission('d') && (
                          <Button variant="ghost" size="icon" className="h-7 w-7 text-destructive hover:text-destructive" onClick={() => requestDelete(node.id)} aria-label="Delete node">
                            <Trash2 className="h-3.5 w-3.5" />
                          </Button>
                        )}
                      </div>
                    </div>
                  );

                  if (isExpanded && !isLoading) {
                    if (children.length > 0) {
                      elements.push(...renderNodes(children, depth + 1));
                    }
                    {% if model.tree_leaf %}
                    for (const leaf of leaves) {
                      const leafLabel = leaf.{{ model.tree_leaf.label_field }} || `#${leaf.id}`;
                      elements.push(
                        <div
                          key={`leaf-${leaf.id}`}
                          className="group relative mx-2 flex min-h-10 items-center gap-2 rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-primary/[0.04] hover:text-foreground"
                          style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 8}px` }}{% endraw %}
                          data-tree-node-kind="leaf"
                        >
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-0 bottom-0 w-px bg-border"
                            style={% raw %}{{ left: `${depth * 28 + 21}px` }}{% endraw %}
                          />
                          <span
                            aria-hidden="true"
                            className="pointer-events-none absolute top-1/2 h-px w-3.5 bg-border"
                            style={% raw %}{{ left: `${depth * 28 + 21}px` }}{% endraw %}
                          />
                          <span className="relative z-[1] h-6 w-6 shrink-0" aria-hidden="true" />
                          <FileText className="h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
                          <div className="flex min-w-0 flex-1 items-center gap-2">
                            <span className="truncate text-sm" title={String(leafLabel)}>{leafLabel}</span>
                            <Badge variant="outline" className="h-5 shrink-0 px-1.5 text-[10px] font-normal">
                              {t('models.{{ model.tree_leaf.service }}.name')}
                            </Badge>
                          </div>
                          {% if model.tree_leaf.standalone %}
                          <div className="flex shrink-0 items-center rounded-md bg-background/80 p-0.5 opacity-70 transition-opacity group-hover:opacity-100">
                            <Button
                              variant="ghost"
                              size="icon"
                              className="h-7 w-7"
                              onClick={() => navigate(`/{{ model.tree_leaf.service }}s/${leaf.id}`)}
                              aria-label="View leaf record"
                            >
                              <Eye className="h-3.5 w-3.5" />
                            </Button>
                          </div>
                          {% endif %}
                        </div>
                      );
                    }
                    if (leavesLoading) {
                      elements.push(
                        <div key={`${node.id}-leaves-loading`} className="flex items-center gap-2 py-2 text-xs text-muted-foreground" style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 40}px` }}{% endraw %}>
                          <Loader2 className="h-3.5 w-3.5 animate-spin" />
                          {t('common.loading', 'Loading...')}
                        </div>
                      );
                    }
                    {% endif %}
                    if (children.length === 0 && childTotal === 0) {
                      // No children yet, show load more to fetch empty state? Actually just show nothing
                    }
                    if (hasMore) {
                      elements.push(
                        <div
                          key={`${node.id}-more`}
                          className="flex items-center gap-2 py-1.5 text-muted-foreground"
                          style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 8}px` }}{% endraw %}
                        >
                          <CornerDownRight className="h-3.5 w-3.5" aria-hidden="true" />
                          <Button
                            variant="ghost"
                            size="sm"
                            className="h-7 px-2 text-xs"
                            onClick={() => loadChildren(node.id, childPageNum + 1)}
                          >
                            {t('common.load_more', 'Load more')}...
                          </Button>
                        </div>
                      );
                    }
                    {% if model.tree_leaf %}
                    if (hasMoreLeaves) {
                      elements.push(
                        <div
                          key={`${node.id}-more-leaves`}
                          className="flex items-center gap-2 py-1.5 text-muted-foreground"
                          style={% raw %}{{ paddingLeft: `${(depth + 1) * 28 + 8}px` }}{% endraw %}
                        >
                          <FileText className="h-3.5 w-3.5" aria-hidden="true" />
                          <Button variant="ghost" size="sm" className="h-7 px-2 text-xs" onClick={() => loadMoreLeaves(node.id)}>
                            {t('common.load_more', 'Load more')} {t('models.{{ model.tree_leaf.service }}.plural')}...
                          </Button>
                        </div>
                      );
                    }
                    {% endif %}
                  }
                }
                return elements;
              };
              return renderNodes(rootItems, 0);
            })()}
          </div>
        )}
      </div>
      {/* Root-level pagination */}
      {!rootLoading && rootItems.length > 0 && (
        <div className="shrink-0 flex flex-wrap items-center justify-between gap-4 pt-4 border-t bg-background">
          <div className="flex items-center gap-4">
            <div className="text-sm text-muted-foreground whitespace-nowrap">
              {t('common.page_info')} {rootPage} {t('common.of_page')} {Math.ceil(rootTotal / rootSize) || 1}
            </div>
            <div className="flex items-center gap-2">
              <span className="text-sm text-muted-foreground whitespace-nowrap">{t('common.page_size', 'Page size')}:</span>
              <Select
                value={String(rootSize)}
                onValueChange={(v) => {
                  const newSize = Number(v);
                  setRootSize(newSize);
                  loadRoots(1, newSize);
                }}
              >
                <SelectTrigger className="w-[80px] h-8">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="10">10</SelectItem>
                  <SelectItem value="20">20</SelectItem>
                  <SelectItem value="50">50</SelectItem>
                  <SelectItem value="100">100</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Button
              variant="outline"
              size="sm"
              onClick={() => loadRoots(1)}
              disabled={rootPage <= 1 || rootLoading}
            >
              {t('common.first')}
            </Button>
            <Button
              variant="outline"
              size="sm"
              onClick={() => loadRoots(rootPage - 1)}
              disabled={rootPage <= 1 || rootLoading}
            >
              {t('common.previous')}
            </Button>
            <div className="flex items-center gap-1">
              <Input
                type="number"
                min={1}
                max={Math.ceil(rootTotal / rootSize) || 1}
                className="w-16 h-8 text-center"
                value={gotoPageInput}
                onChange={(e) => setGotoPageInput(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') {
                    const page = Number(gotoPageInput);
                    const totalPages = Math.ceil(rootTotal / rootSize) || 1;
                    if (page >= 1 && page <= totalPages) {
                      loadRoots(page);
                    }
                  }
                }}
              />
            </div>
            <Button
              variant="outline"
              size="sm"
              onClick={() => loadRoots(rootPage + 1)}
              disabled={rootPage >= Math.ceil(rootTotal / rootSize) || rootLoading}
            >
              {t('common.next')}
            </Button>
            <Button
              variant="outline"
              size="sm"
              onClick={() => {
                const totalPages = Math.ceil(rootTotal / rootSize) || 1;
                loadRoots(totalPages);
              }}
              disabled={rootPage >= Math.ceil(rootTotal / rootSize) || rootLoading}
            >
              {t('common.last')}
            </Button>
          </div>
        </div>
      )}
{% endif %}

{% if not model.page_edit %}
      <EditContainer
        title={editingId ? `${t('common.edit')} ${t('models.{{ model.module_name }}.name')}` : `${t('common.create')} ${t('models.{{ model.module_name }}.name')}`}
        isOpen={isModalOpen}
        onClose={() => { if (!isSaving) setIsModalOpen(false); }}
      >
            <div className="max-h-[80vh] overflow-y-auto pr-2">
                <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
          {% macro modal_form_field(field, as_expression=false) -%}
          {% if not as_expression %}{{ '{' }}{% endif %}(!editingId ? hasFieldPerm('{{ field.name }}', 'c') : hasFieldPerm('{{ field.name }}', 'u')){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
          <div className="space-y-2">
            <Label htmlFor="{{ field.name }}">{t('{{ field.label_key }}')}</Label>
            {% if field.ui_type == 'bool' %}
            <div className="flex items-center space-x-2">
                <Controller
                    control={control}
                    name="{{ field.name }}"
                    defaultValue={ {{ 'true' if field.default else 'false' }} }
                    render={({ field: { onChange, value } }) => (
                        <Switch checked={value} onCheckedChange={onChange} id="{{ field.name }}" />
                    )}
                />
                <Label htmlFor="{{ field.name }}" className="font-normal text-muted-foreground">
                    {t('{{ field.label_key }}')}
                </Label>
            </div>
            {% elif field.ui_type == 'image' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <ImageUpload
                        value={value}
                        onChange={onChange}
                    />
                )}
            />
            {% elif field.ui_type == 'images' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <ImagesUpload id="{{ field.name }}" value={Array.isArray(value) ? value : []} onChange={onChange} />
                )}
            />
            {% elif field.ui_type == 'file' %}
                        <Controller
                            control={control}
                            name="{{ field.name }}"
                            render={({ field: { onChange, value } }) => (
                                <FileUpload
                                    value={value}
                                    onChange={onChange}
                                    allowDownload={ {{ "true" if field.allow_download else "false" }} }
                                />
                            )}
                        />
                        {% elif field.ui_type == 'video_stream' %}
                        <Controller
                            control={control}
                            name="{{ field.name }}"
                            render={({ field: { onChange, value } }) => (
                                <VideoStreamInput value={value} onChange={onChange} protocol="{{ field.stream_protocol }}" />
                            )}
                        />
                        {% elif field.is_enum and field.is_multi_select %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <SearchableSelect
                        value={value || []}
                        onValueChange={onChange}
                        multiple={true}
                        placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                        searchPlaceholder={`${t('common.search')}...`}
                        loadOptions={async () => {{ field.enum_values | tojson }}.map((v: string) => ({
                            label: t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v),
                            value: v,
                        }))}
                    />
                )}
            />
                        {% elif field.is_enum %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => {
                    // Filter enum values based on role for User.role field
                    {% if model.module_name == "user" and model.name == "User" and field.name == "role" %}
                    const filteredValues = userRole === 'developer'
                        ? {{ field.enum_values | tojson }}
                        : ({{ field.enum_values | tojson }} as string[]).filter(v => v !== 'developer');
                    {% else %}
                    const filteredValues = {{ field.enum_values | tojson }};
                    {% endif %}
                    return (
                    <Select onValueChange={onChange} defaultValue={value}>
                        <SelectTrigger>
                            <SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
                        </SelectTrigger>
                        <SelectContent>
                            {filteredValues.map((enumVal: string) => (
                                <SelectItem key={enumVal} value={enumVal}>{t(`models.{{ model.module_name }}.enums.{{ field.name }}.${enumVal}`, enumVal)}</SelectItem>
                            ))}
                        </SelectContent>
                    </Select>
                    )
                }}
            />
            {% elif field.fk_info %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <SearchableSelect
                        value={value}
                        onValueChange={onChange}
                        placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                        searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
                        valueLabels={ {{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                        loadOptions={async (query) => {
                            const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                            const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                            return response.items.map((item: any) => ({
                                label: item.{{ field.fk_info.label_field }} || item.id,
                                value: item.id
                            }));
                        }}
                    />
                )}
            />
            {% elif field.ui_type == 'time' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                render={({ field: { onChange, value } }) => (
                    <TimePicker
                        value={value}
                        onChange={onChange}
                        placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                    />
                )}
            />
            {% elif field.ui_type == 'location' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                defaultValue={null}
                render={({ field: { onChange, value } }) => (
                    <LocationInput value={value} onChange={onChange} />
                )}
            />
            {% elif field.ui_type == 'json' %}
            <Controller
                control={control}
                name="{{ field.name }}"
                defaultValue={ {% if field.json_kind == 'array' %}[]{% else %}{}{% endif %} }
                render={({ field: { onChange, value } }) => (
                    {% if field.json_model_schema %}
                    <JsonModelEditor
                        schema={ {{ field.json_model_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        rootValue={rootValue}
                    />
                    {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
                    <JsonModelDictEditor
                        itemSchema={ {{ field.json_item_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        rootValue={rootValue}
                        {% if field.json_fixed_keys %}
                        fixedKeys={ {{ field.json_fixed_keys | tojson }} }
                        {% endif %}
                        {% if field.json_lock_keys %}
                        lockKeys
                        {% endif %}
                    />
                    {% elif field.json_item_kind %}
                    <JsonScalarArrayEditor itemKind="{{ field.json_item_kind }}" value={value} onChange={onChange} />
                    {% elif field.json_item_schema %}
                    <JsonModelArrayEditor
                        itemSchema={ {{ field.json_item_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        rootValue={rootValue}
                        {% if model.property_config_meta and field.name == model.property_config_meta.field_name %}
                        canAdd={'{{ model.property_config_meta.field_permissions }}'.includes('a')}
                        canRemove={'{{ model.property_config_meta.field_permissions }}'.includes('l')}
                        {% endif %}
                    />
                    {% else %}
                    <JsonInput
                        value={value}
                        onChange={onChange}
                        jsonKind="{{ field.json_kind or 'object' }}"
                        placeholder={ {% if field.json_kind == 'array' %}"[\\n  \\n]"{% else %}"{\\n  \\n}"{% endif %} }
                    />
                    {% endif %}
                )}
            />
            {% else %}
            <Input
                id="{{ field.name }}"
                {% if field.ui_type == 'int' or field.ui_type == 'float' %}
                type="number"
                {% elif field.ui_type == 'datetime' %}
                type="datetime-local"
                {% elif field.ui_type == 'date' %}
                type="date"
                {% if field.default_factory == 'date' %}
                defaultValue={new Date().toLocaleDateString('en-CA')}
                {% endif %}
                {% else %}
                type="text"
                {% endif %}
                {...register('{{ field.name }}', { required: !editingId ? {{ 'true' if field.required and not field.create_optional else 'false' }} : {{ 'true' if field.required and not field.update_optional else 'false' }} })}
            />
            {% endif %}
          </div>
          ){% if not as_expression %}{{ '}' }}{% endif %}
          {%- endmacro %}
          {(() => {
            const formLayout = {{ model.form_layout | default([]) | tojson }} as any[];
            const formFields: Record<string, React.ReactNode> = {
              {% for field in model.fields %}
              '{{ field.name }}': ({{ modal_form_field(field, true) }}),
              {% endfor %}
            };
            const rowClasses: Record<number, string> = {
              1: 'grid grid-cols-1 gap-4',
              2: 'grid grid-cols-1 gap-4 md:grid-cols-2',
              3: 'grid grid-cols-1 gap-4 md:grid-cols-3',
              4: 'grid grid-cols-1 gap-4 md:grid-cols-4',
            };
            const spanClasses: Record<number, string> = {
              1: '', 2: 'md:col-span-2', 3: 'md:col-span-3', 4: 'md:col-span-4',
            };
            const renderModalFormLayoutNode = (node: any, key: string): React.ReactNode => {
              if (node.kind === 'field') {
                const content = formFields[node.field];
                return content ? <div key={key} className={`min-w-0 ${spanClasses[node.span] || ''}`}>{content}</div> : null;
              }
              if (node.kind === 'row') {
                const items = node.items.map((item: any, index: number) => renderModalFormLayoutNode(item, `${key}-${index}`)).filter(Boolean);
                return items.length ? <div key={key} className={rowClasses[node.columns] || rowClasses[1]}>{items}</div> : null;
              }
              if (node.kind === 'section') {
                const items = node.items.map((item: any, index: number) => renderModalFormLayoutNode(item, `${key}-${index}`)).filter(Boolean);
                return items.length ? <fieldset key={key} className={`min-w-0 rounded-md border p-4 ${spanClasses[node.span] || ''}`}><legend className="px-1 text-sm font-semibold">{node.title}</legend><div className="space-y-4">{items}</div></fieldset> : null;
              }
              return null;
            };
            return formLayout.length
              ? formLayout.map((node, index) => renderModalFormLayoutNode(node, `form-layout-${index}`))
              : Object.values(formFields);
          })()}

          {% if model.m2m_fields %}
          {% for m2m in model.m2m_fields %}
          <div className="space-y-2">
            <Label>{t('models.{{ m2m.target_service }}.plural')}</Label>
            <Controller
                control={control}
                name="{{ m2m.write_name }}"
                render={({ field: { onChange, value } }) => (
                    {% if m2m.editor == 'inline' %}
                    <JsonModelArrayEditor
                        itemSchema={ {{ m2m.inline_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        foreignKeyLoaders={{ '{{' }}
                            {% for field in m2m.inline_schema.fields %}
                            {% if field.foreignKey %}
                            '{{ field.name }}': async (query) => {
                                const filters = query ? { {{ field.foreignKey.labelField }}: query } : undefined;
                                const response = await {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService.get{{ field.foreignKey.targetModel }}s(1, 20, filters);
                                return response.items.map((item: any) => ({ label: item.{{ field.foreignKey.labelField }} || item.id, value: item.id }));
                            },
                            {% endif %}
                            {% endfor %}
                        {{ '}}' }}
                    />
                    {% elif m2m.order_field %}
                    <LinkTableOrderedSelect
                        value={value}
                        onValueChange={onChange}
                        placeholder={`${t('common.select')} ${t('models.{{ m2m.target_service }}.name')}s`}
                        searchPlaceholder={`${t('common.search')} ${t('models.{{ m2m.target_service }}.name')}...`}
                        valueLabels={ {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                        loadOptions={async (query) => {
                            const filters = query ? { {{ m2m.label_field }}: query } : undefined;
                            const response = await get{{ m2m.target_model }}s(1, 20, filters);
                            return response.items.map((item: any) => ({
                                label: item.{{ m2m.label_field }} || item.id,
                                value: item.id
                            }));
                        }}
                    />
                    {% else %}
                    <SearchableSelect
                        value={value}
                        onValueChange={onChange}
                        multiple={true}
                        placeholder={`${t('common.select')} ${t('models.{{ m2m.target_service }}.name')}s`}
                        searchPlaceholder={`${t('common.search')} ${t('models.{{ m2m.target_service }}.name')}...`}
                        valueLabels={ {{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                        loadOptions={async (query) => {
                            const filters = query ? { {{ m2m.label_field }}: query } : undefined;
                            const response = await get{{ m2m.target_model }}s(1, 20, filters);
                            return response.items.map((item: any) => ({
                                label: item.{{ m2m.label_field }} || item.id,
                                value: item.id
                            }));
                        }}
                    />
                    {% endif %}
                )}
            />
          </div>
          {% endfor %}
          {% endif %}
          {% for rfk in model.reverse_foreign_keys %}
          {% if rfk.editor == 'inline' %}
          <div className="space-y-2">
            <Label>{t('models.{{ rfk.source_service }}.plural')}</Label>
            <Controller
                control={control}
                name="{{ rfk.write_name }}"
                defaultValue={[]}
                render={({ field: { onChange, value } }) => (
                    <JsonModelArrayEditor
                        itemSchema={ {{ rfk.inline_schema | tojson }} }
                        value={value}
                        onChange={onChange}
                        foreignKeyLoaders={{ '{{' }}
                            {% for field in rfk.inline_schema.fields %}
                            {% if field.foreignKey %}
                            '{{ field.name }}': async (query) => {
                                const filters = query ? { {{ field.foreignKey.labelField }}: query } : undefined;
                                const response = await {{ rfk.name|replace('_', ' ')|title|replace(' ', '') }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}InlineFieldService.get{{ field.foreignKey.targetModel }}s(1, 20, filters);
                                return response.items.map((item: any) => ({ label: item.{{ field.foreignKey.labelField }} || item.id, value: item.id }));
                            },
                            {% endif %}
                            {% endfor %}
                        {{ '}}' }}
                    />
                )}
            />
          </div>
          {% endif %}
          {% endfor %}
          <div className="flex justify-end space-x-2 pt-4">
            <Button variant="outline" type="button" disabled={isSaving} onClick={() => setIsModalOpen(false)}>{t('common.cancel')}</Button>
            <Button type="submit" disabled={isSaving}>
              {isSaving ? (
                <><Loader2 className="mr-2 h-4 w-4 animate-spin" /> {t('common.saving', 'Saving...')}</>
              ) : t('common.save')}
            </Button>
          </div>
        </form>
            </div>
      </EditContainer>
      {% endif %}

      {% if model.has_embedded_page %}
      <Modal
        title={t('common.add_existing', 'Add existing')}
        isOpen={attachExistingOpen}
        onClose={() => { if (!isAttachingExisting) setAttachExistingOpen(false); }}
      >
        <div className="space-y-4">
          <SearchableSelect
            multiple
            value={attachExistingIds}
            onValueChange={(value) => setAttachExistingIds(Array.isArray(value) ? value as {{ 'string[]' if 'str' in model.id_type else 'number[]' }} : [])}
            placeholder={t('common.select_existing', 'Select existing records')}
            searchPlaceholder={t('common.search', 'Search')}
            emptyText={t('common.no_result', 'No result')}
            loadOptions={loadAttachExistingOptions}
          />
          <div className="flex justify-end gap-2">
            <Button type="button" variant="outline" disabled={isAttachingExisting} onClick={() => setAttachExistingOpen(false)}>
              {t('common.cancel')}
            </Button>
            <Button type="button" disabled={isAttachingExisting || attachExistingIds.length === 0} onClick={handleAttachExisting}>
              {isAttachingExisting && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
              {isAttachingExisting ? t('common.adding', 'Adding...') : t('common.add', 'Add')}
            </Button>
          </div>
        </div>
      </Modal>
      {% endif %}

      {% if model.importable %}
      {/* Import Modal */}
      <Modal
        isOpen={importModalOpen}
        onClose={() => setImportModalOpen(false)}
        title={t('common.import', 'Import')}
      >
        <div className="space-y-4">
          <div className="flex flex-col gap-2">
            <Label>{t('{{ 'import.custom_file' if model.custom_importable else 'import.file' }}', '{{ 'Import file' if model.custom_importable else 'CSV File' }}')}</Label>
            <FileInput
              {% if not model.custom_importable %}
              accept=".csv"
              {% endif %}
              value={importingFile}
              onChange={setImportingFile}
            />
          </div>
          {% raw %}<div className="flex justify-end space-x-2 pt-4">{% endraw %}
            <Button variant="outline" onClick={() => setImportModalOpen(false)}>
              {t('common.cancel', 'Cancel')}
            </Button>
            <Button onClick={handleImportSubmit} disabled={!importingFile || isImporting}>
              {isImporting ? (
                <>
                  <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                  {t('common.importing', 'Importing...')}
                </>
              ) : (
                <>
                  <Upload className="mr-2 h-4 w-4" />
                  {t('common.import', 'Import')}
                </>
              )}
            </Button>
          </div>
        </div>
      </Modal>
      {% endif %}
    </div>
  );
};

export default {{ model.name }}Page;
