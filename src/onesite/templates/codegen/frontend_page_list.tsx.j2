    {{ model.name }}{% if model.has_embedded_page %}, get{{ model.name }}s, update{{ model.name }}{% endif %}{% if model.m2m_fields %}{% for m2m in model.m2m_fields %}, get{{ model.name }}{{ m2m.target_model }}s{% if m2m.order_field %}, get{{ model.name }}{{ m2m.target_model }}sWithMeta{% endif %}{% endfor %}{% endif %}{% for reference in model.dict_key_reference_meta %}, get{{ model.name }}{{ reference.field|replace('_', ' ')|title|replace(' ', '') }}KeyOptions{% endfor %}
