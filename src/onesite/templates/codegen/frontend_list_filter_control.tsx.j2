              {% if field.is_search_field and (field.ui_type in ['bool','str','datetime','time'] or field.is_enum) %}
          <div className="min-w-0 space-y-2">
            {% if ns.search_field_count > 1 %}
            <Label className="block truncate" title={String(t('{{ field.label_key }}'))}>{t('{{ field.label_key }}')}</Label>
            {% endif %}
            {% if field.ui_type == 'bool' %}
            <Select
              value={searchValues['{{ field.name }}'] || '__all__'}
              onValueChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
            >
              <SelectTrigger className="h-9 min-w-0 w-full">
                <SelectValue placeholder={t('common.all', 'All')} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__all__">{t('common.all', 'All')}</SelectItem>
                <SelectItem value="true">{t('common.yes', 'Yes')}</SelectItem>
                <SelectItem value="false">{t('common.no', 'No')}</SelectItem>
              </SelectContent>
            </Select>
            {% elif field.ui_type == 'datetime' %}
            <div className="grid min-w-0 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2">
              <Input
                type="date"
                className="h-9 min-w-0 w-full"
                value={searchValues['{{ field.name }}_from'] || ''}
                onChange={(e) => setSearchValues((s) => ({ ...s, ['{{ field.name }}_from']: e.target.value }))}
              />
              <span className="text-muted-foreground text-sm">-</span>
              <Input
                type="date"
                className="h-9 min-w-0 w-full"
                value={searchValues['{{ field.name }}_to'] || ''}
                onChange={(e) => setSearchValues((s) => ({ ...s, ['{{ field.name }}_to']: e.target.value }))}
              />
            </div>
            {% elif field.ui_type == 'time' %}
            <TimePicker
              value={searchValues['{{ field.name }}'] || ''}
              onChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
              placeholder={t('common.select_time', 'Select time')}
            />
            {% elif field.is_enum and field.is_multi_select %}
            <SearchableSelect
              value={searchValues['{{ field.name }}'] || []}
              onValueChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
              multiple={true}
              placeholder={t('common.all', 'All')}
              searchPlaceholder={`${t('common.search')}...`}
              loadOptions={async () => [
                {% for enum_val in field.enum_values %}
                { label: t('models.{{ model.module_name }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}'), value: '{{ enum_val }}' },
                {% endfor %}
              ]}
            />
            {% elif field.is_enum %}
            <Select
              value={searchValues['{{ field.name }}'] || '__all__'}
              onValueChange={(v) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }))}
            >
              <SelectTrigger className="h-9 min-w-0 w-full">
                <SelectValue placeholder={t('common.all', 'All')} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__all__">{t('common.all', 'All')}</SelectItem>
                {% for enum_val in field.enum_values %}
                <SelectItem value="{{ enum_val }}">{
                    t('models.{{ model.module_name }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}')
                }</SelectItem>
                {% endfor %}
              </SelectContent>
            </Select>
            {% elif field.ui_type == 'str' %}
            <Input
              className="h-9 min-w-0 w-full"
              value={searchValues['{{ field.name }}'] || ''}
              onChange={(e) => setSearchValues((s) => ({ ...s, ['{{ field.name }}']: e.target.value }))}
              placeholder={t('common.search')}
            />
            {% endif %}
          </div>
          {% elif field.fk_info and field.is_search_field %}
          <div className="min-w-0 space-y-2">
            {% if ns.search_field_count > 1 %}
            <Label className="block truncate" title={String(t('{{ field.label_key }}'))}>{t('{{ field.label_key }}')}</Label>
            {% endif %}
            <SearchableSelect
              value={searchValues['{{ field.name }}'] || ''}
              onValueChange={(v) => {
                setSearchValues((s) => ({ ...s, ['{{ field.name }}']: v }));
                if (v) {
                  const key = String(v);
                  const label = {{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels[key] || '';
                  if (label) {
                    setSearch{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels((s) => ({ ...s, [key]: label }));
                  }
                }
              }}
              placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
              searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
              valueLabels={search{{ field.name|replace('_', ' ')|title|replace(' ', '') }}Labels}
              loadOptions={async (query) => {
                const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                return response.items.map((item: any) => ({
                  label: item.{{ field.fk_info.label_field }} || item.id,
                  value: item.id
                }));
              }}
            />
          </div>
          {% endif %}
