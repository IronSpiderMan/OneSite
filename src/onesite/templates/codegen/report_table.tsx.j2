const validReportTableSize = (size: number): boolean => Number.isSafeInteger(size) && size > 0;
const ReportDataTable: React.FC<{ config: NonNullable<ReportBlock['table']>; refreshKey: number; editing: boolean; disabled: boolean; onChange: (config: NonNullable<ReportBlock['table']>) => void }> = ({ config, refreshKey, editing, disabled, onChange }) => {
  const { t } = useTranslation();
  const label = (key: string, fallback: string) => String(t(`reports.editor.${key}`, fallback));
  const timeZone = getUserTimeZone();
  const role = localStorage.getItem('user_role') || 'user';
  const sources = tableSources.filter((source) => source.visible[role] && (source.permissions[role] || '').includes('r'));
  const source = sources.find((item) => item.key === config.model);
  const page = Number.isInteger(config.page) && config.page > 0 ? config.page : 1;
  const size = validReportTableSize(config.size) ? config.size : 20;
  const [sizeDraft, setSizeDraft] = useState(String(size));
  useEffect(() => { setSizeDraft(String(size)); }, [size, config.model]);
  const requestKey = `${role}:${config.model}:${page}:${size}:${refreshKey}`;
  const [result, setResult] = useState<{ key: string; items: Record<string, any>[]; total: number; pages: number } | null>(null);
  const [error, setError] = useState('');
  useEffect(() => {
    let cancelled = false;
    setResult(null); setError('');
    if (source) source.load(page, size).then((data) => {
      if (!cancelled) setResult({ key: requestKey, items: data.items, total: data.total, pages: data.total_pages });
    }).catch(() => { if (!cancelled) setError(label('table_error', 'Table could not be loaded. Check access and retry.')); });
    return () => { cancelled = true; };
  }, [source, requestKey]);
  const data = result?.key === requestKey && source ? result : null;
  const columns = source?.fields.filter((field) => !(field.hiddenForUser && role === 'user') && (!Object.keys(field.permissions).length || (field.permissions[role] || '').includes('r')) && (!data?.items.length || data.items.some((item) => Object.prototype.hasOwnProperty.call(item, field.key)))) || [];
  return <div className="report-rich-text" data-table-ready={!!data}>
    {editing && <div data-editor-control className="space-y-2" onClick={(event) => event.stopPropagation()}>
      <Select disabled={disabled} value={source?.key || ''} onValueChange={(model) => onChange({ model, page: 1, size })}><SelectTrigger aria-label={label('table_source', 'Table data source')}><SelectValue placeholder={label('table_source', 'Table data source')} /></SelectTrigger><SelectContent>{sources.map((item) => <SelectItem key={item.key} value={item.key}>{String(t(`models.${item.key}.name`, item.key))}</SelectItem>)}</SelectContent></Select>
      {!sources.length && <p>{label('table_no_sources', 'No readable frontend data sources.')}</p>}
      <form className="flex items-center gap-2" onSubmit={(event) => { event.preventDefault(); const nextSize = Number(sizeDraft); if (validReportTableSize(nextSize)) onChange({ ...config, size: nextSize, page: 1 }); }}>
        <label className="flex items-center gap-2 text-sm">{label('table_size', 'Rows per page')}<input className="w-24 rounded border bg-background px-2 py-1" type="number" min="1" step="1" required disabled={disabled} value={sizeDraft} onChange={(event) => setSizeDraft(event.target.value)} /></label>
        <Button type="submit" size="sm" variant="outline" disabled={disabled || !validReportTableSize(Number(sizeDraft))}>{label('apply_content', 'Save content')}</Button>
      </form>
      <div className="flex items-center gap-2"><Button size="sm" variant="outline" disabled={disabled || page <= 1} onClick={() => onChange({ ...config, page: page - 1 })}>←</Button><span>{page} / {data?.pages || 1}</span><Button size="sm" variant="outline" disabled={disabled || !data || page >= data.pages} onClick={() => onChange({ ...config, page: page + 1 })}>→</Button></div>
    </div>}
    {!source ? <p className="report-note">{label('table_select', 'Select an available table data source.')}</p> : error ? <p role="alert" className="report-note">{error}</p> : !data ? <p>{label('loading', 'Loading…')}</p> : <>
      <table><caption>{String(t(`models.${source.key}.name`, source.key))} · {label('table_page', 'Page')} {page} / {data.pages || 1} · {label('table_total', 'Total')} {data.total}</caption><thead><tr>{columns.map((field) => <th key={field.key}>{String(t(field.labelKey, field.key))}</th>)}</tr></thead><tbody>{data.items.map((item, index) => <tr key={index}>{columns.map((field) => <td key={field.key}>{field.render(item, t, timeZone)}</td>)}</tr>)}</tbody></table>
      {!data.items.length && <p className="report-note">{label('no_data', 'No data for these filters.')}</p>}
    </>}
  </div>;
};
