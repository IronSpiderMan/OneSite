"""Retention cleanup for persisted background task executions and artifacts."""

import asyncio
import logging
import shutil
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import unquote, urlsplit

from sqlalchemy import and_, or_
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.background_execution import BackgroundExecution
from app.core.config import settings
from app.core.db import engine


logger = logging.getLogger(__name__)
RETENTION_PERIOD = timedelta(days=1)
CLEANUP_INTERVAL_SECONDS = 300
TERMINAL_STATUSES = ("succeeded", "failed")


def _task_directory(execution: BackgroundExecution) -> Path | None:
    directory_by_kind = {
        "tool": "tools",
        "scheduled_task": "scheduled_tasks",
    }
    directory = directory_by_kind.get(execution.kind)
    if directory is None:
        return None
    upload_root = Path(settings.UPLOAD_DIR).resolve()
    candidate = (upload_root / directory / execution.id).resolve()
    expected_parent = (upload_root / directory).resolve()
    try:
        candidate.relative_to(expected_parent)
    except ValueError:
        logger.warning("Refusing to clean unsafe task directory: %s", candidate)
        return None
    if candidate == expected_parent or candidate.parent != expected_parent:
        logger.warning("Refusing to clean invalid task directory: %s", candidate)
        return None
    return candidate


def _download_path(download_url: str | None) -> Path | None:
    if not download_url:
        return None
    path = unquote(urlsplit(download_url).path)
    prefix = "/uploads/"
    if not path.startswith(prefix):
        return None
    upload_root = Path(settings.UPLOAD_DIR).resolve()
    candidate = (upload_root / path[len(prefix):]).resolve()
    try:
        candidate.relative_to(upload_root)
    except ValueError:
        logger.warning("Refusing to clean unsafe task download: %s", candidate)
        return None
    return candidate


def _remove_artifacts(execution: BackgroundExecution) -> None:
    task_directory = _task_directory(execution)
    if task_directory is not None and task_directory.exists():
        shutil.rmtree(task_directory)

    download_path = _download_path(execution.download_url)
    if download_path is not None and download_path.is_file():
        download_path.unlink()


async def cleanup_expired_background_executions(
    *,
    now: datetime | None = None,
) -> int:
    """Delete terminal executions and their artifacts after 24 hours."""
    cutoff = (now or datetime.now(timezone.utc)) - RETENTION_PERIOD
    async with AsyncSession(engine, expire_on_commit=False) as session:
        statement = select(BackgroundExecution).where(
            BackgroundExecution.status.in_(TERMINAL_STATUSES),
            or_(
                BackgroundExecution.completed_at < cutoff,
                and_(
                    BackgroundExecution.completed_at.is_(None),
                    BackgroundExecution.created_at < cutoff,
                ),
            ),
        )
        executions = (await session.exec(statement)).all()
        deleted = 0
        for execution in executions:
            try:
                _remove_artifacts(execution)
            except OSError:
                logger.exception(
                    "Failed to remove artifacts for expired background task %s",
                    execution.id,
                )
                continue
            await session.delete(execution)
            deleted += 1
        if deleted:
            await session.commit()
            logger.info("Deleted %s expired background task executions", deleted)
        return deleted


async def run_background_execution_cleanup() -> None:
    """Continuously enforce the background-task retention period."""
    while True:
        try:
            await asyncio.sleep(CLEANUP_INTERVAL_SECONDS)
            await cleanup_expired_background_executions()
        except asyncio.CancelledError:
            raise
        except Exception:
            logger.exception("Background task retention cleanup failed")
