"""Project-specific external-resource declarations generated by OneSite."""

from __future__ import annotations

import json
from typing import Any


RESOURCE_CONFIGS: list[dict[str, Any]] = json.loads(r'''{{ resources_json }}''')
RESOURCE_BY_KEY = {
    (item["provider"], item["resource_type"]): item
    for item in RESOURCE_CONFIGS
}


def get_resource_config(
    resource_type: str, *, provider: str | None = None
) -> dict[str, Any]:
    """Resolve a resource declaration, requiring a provider when ambiguous."""
    if provider is not None:
        config = RESOURCE_BY_KEY.get((provider, resource_type))
        if config is None:
            raise ValueError(
                f"Unknown external resource: provider='{provider}', "
                f"resource_type='{resource_type}'"
            )
        return config

    matches = [item for item in RESOURCE_CONFIGS if item["resource_type"] == resource_type]
    if not matches:
        raise ValueError(f"Unknown external resource type: '{resource_type}'")
    if len(matches) > 1:
        raise ValueError(
            f"External resource type '{resource_type}' is configured for multiple "
            "providers; specify provider explicitly"
        )
    return matches[0]
