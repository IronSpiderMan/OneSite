"""Project-specific provider/resource mappings generated by OneSite."""

from __future__ import annotations

import json
from typing import Any


RESOURCE_CONFIGS: list[dict[str, Any]] = json.loads(r'''{{ resources_json }}''')
RESOURCE_BY_KEY = {
    (item["provider"], item["resource"]): item
    for item in RESOURCE_CONFIGS
}


def get_resource_config(provider: str, resource: str) -> dict[str, Any]:
    """Resolve the model mapped to one provider resource kind."""
    try:
        return RESOURCE_BY_KEY[(provider, resource)]
    except KeyError as exc:
        raise ValueError(
            f"Unknown external resource: provider='{provider}', resource='{resource}'"
        ) from exc
