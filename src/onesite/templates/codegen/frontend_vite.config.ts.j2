import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'

// https://vitejs.dev/config/
export default defineConfig({
  plugins: [react()],
  clearScreen: false,
  server: {
    port: 5173,
    strictPort: true,
    watch: {
      ignored: ['**/src-tauri/**'],
    },
    proxy: {
      '/api': {
        target: 'http://127.0.0.1:8000',
        changeOrigin: true,
        ws: true,
      },
      '/static': {
        target: 'http://127.0.0.1:8000',
        changeOrigin: true,
      },
      // Proxy uploads to backend
      // Assuming URL prefix is /uploads. If config changes, this might need update.
      '/uploads': {
        target: 'http://127.0.0.1:8000',
        changeOrigin: true,
      }{% if config.get('video_stream', {}).get('rtsp', {}).get('enabled', False) %},
      '/media-hls': {
        target: 'http://127.0.0.1:8888',
        changeOrigin: true,
        rewrite: (path) => path.replace(/^\/media-hls/, ''),
        configure: (proxy) => {
          proxy.on('proxyRes', (proxyRes) => {
            const location = proxyRes.headers.location
            if (location?.startsWith('/')) {
              proxyRes.headers.location = `/media-hls${location}`
            }
          })
        },
      }
      {% endif %}
    }
  }
})
