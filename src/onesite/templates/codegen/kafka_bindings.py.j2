"""Generated Kafka callback bindings. Do not edit this file directly."""

from app.core.kafka import kafka_manager
{% for handler in handlers %}
from app.integrations.kafka.{{ handler }} import {{ handler }}
{% endfor %}

_registered = False


def register_kafka_handlers() -> None:
    """Register configured topic-to-handler bindings exactly once."""
    global _registered
    if _registered:
        return

{% for callback in callbacks %}
    kafka_manager.register_handler(
        "{{ callback.topic }}",
        {{ callback.handler }},
        group_id="{{ callback.group_id }}",
    )
{% endfor %}
    _registered = True
