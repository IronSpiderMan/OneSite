@tailwind base;
@tailwind components;
@tailwind utilities;

{# ── Generate CSS variables for ALL themes ── #}
@layer base {
{% for tid, t in themes.items() %}
  {# Light mode variables #}
  :root[data-theme="{{ tid }}"] {
    --background: {{ t.background }};
    --foreground: {{ t.foreground }};
    --card: {{ t.card }};
    --card-foreground: {{ t.card_foreground }};
    --popover: {{ t.popover }};
    --popover-foreground: {{ t.popover_foreground }};
    --primary: {{ t.primary }};
    --primary-foreground: {{ t.primary_foreground }};
    --secondary: {{ t.secondary }};
    --secondary-foreground: {{ t.secondary_foreground }};
    --muted: {{ t.muted }};
    --muted-foreground: {{ t.muted_foreground }};
    --accent: {{ t.accent }};
    --accent-foreground: {{ t.accent_foreground }};
    --destructive: {{ t.destructive }};
    --destructive-foreground: {{ t.destructive_foreground }};
    --border: {{ t.border }};
    --input: {{ t.input }};
    --ring: {{ t.ring }};
    --shadow-sm-style: {{ t.shadow_sm }};
    --shadow-md-style: {{ t.shadow_md }};
  }
  {# Dark mode variables #}
  :root[data-theme="{{ tid }}"].dark {
    --background: {{ t.dark_background }};
    --foreground: {{ t.dark_foreground }};
    --card: {{ t.dark_card }};
    --card-foreground: {{ t.dark_card_foreground }};
    --popover: {{ t.dark_popover }};
    --popover-foreground: {{ t.dark_popover_foreground }};
    --primary: {{ t.dark_primary }};
    --primary-foreground: {{ t.dark_primary_foreground }};
    --secondary: {{ t.dark_secondary }};
    --secondary-foreground: {{ t.dark_secondary_foreground }};
    --muted: {{ t.dark_muted }};
    --muted-foreground: {{ t.dark_muted_foreground }};
    --accent: {{ t.dark_accent }};
    --accent-foreground: {{ t.dark_accent_foreground }};
    --destructive: {{ t.dark_destructive }};
    --destructive-foreground: {{ t.dark_destructive_foreground }};
    --border: {{ t.dark_border }};
    --input: {{ t.dark_input }};
    --ring: {{ t.dark_ring }};
  }

{% endfor %}
  {# Backward-compatible :root fallback (uses build-time default) #}
  :root {
    --background: {{ theme.background }};
    --foreground: {{ theme.foreground }};
    --card: {{ theme.card }};
    --card-foreground: {{ theme.card_foreground }};
    --popover: {{ theme.popover }};
    --popover-foreground: {{ theme.popover_foreground }};
    --primary: {{ theme.primary }};
    --primary-foreground: {{ theme.primary_foreground }};
    --secondary: {{ theme.secondary }};
    --secondary-foreground: {{ theme.secondary_foreground }};
    --muted: {{ theme.muted }};
    --muted-foreground: {{ theme.muted_foreground }};
    --accent: {{ theme.accent }};
    --accent-foreground: {{ theme.accent_foreground }};
    --destructive: {{ theme.destructive }};
    --destructive-foreground: {{ theme.destructive_foreground }};
    --border: {{ theme.border }};
    --input: {{ theme.input }};
    --ring: {{ theme.ring }};
    --radius: {{ radius }}rem;
    --shadow-sm-style: {{ theme.shadow_sm }};
    --shadow-md-style: {{ theme.shadow_md }};
  }
  .dark {
    --background: {{ theme.dark_background }};
    --foreground: {{ theme.dark_foreground }};
    --card: {{ theme.dark_card }};
    --card-foreground: {{ theme.dark_card_foreground }};
    --popover: {{ theme.dark_popover }};
    --popover-foreground: {{ theme.dark_popover_foreground }};
    --primary: {{ theme.dark_primary }};
    --primary-foreground: {{ theme.dark_primary_foreground }};
    --secondary: {{ theme.dark_secondary }};
    --secondary-foreground: {{ theme.dark_secondary_foreground }};
    --muted: {{ theme.dark_muted }};
    --muted-foreground: {{ theme.dark_muted_foreground }};
    --accent: {{ theme.dark_accent }};
    --accent-foreground: {{ theme.dark_accent_foreground }};
    --destructive: {{ theme.dark_destructive }};
    --destructive-foreground: {{ theme.dark_destructive_foreground }};
    --border: {{ theme.dark_border }};
    --input: {{ theme.dark_input }};
    --ring: {{ theme.dark_ring }};
  }
}

@layer base {
  html,
  body,
  #root {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
  h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
  }
}

@layer utilities {
  .shadow-sm {
    box-shadow: var(--shadow-sm-style);
  }
  .shadow, .shadow-md {
    box-shadow: var(--shadow-md-style);
  }
  button {
    transition: transform 0.15s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }
  button:hover {
    filter: saturate(1.06);
  }
}

{# ── Industrial theme-specific rules ── #}
[data-theme="industrial"] body {
  font-family: "IBM Plex Sans", Inter, "Segoe UI", system-ui, sans-serif;
  background-image: linear-gradient(0deg, rgb(148 163 184 / 0.07) 1px, transparent 1px), linear-gradient(90deg, rgb(148 163 184 / 0.07) 1px, transparent 1px);
  background-size: 32px 32px;
}
[data-theme="industrial"] h1, [data-theme="industrial"] h2, [data-theme="industrial"] h3,
[data-theme="industrial"] h4, [data-theme="industrial"] h5, [data-theme="industrial"] h6 {
  font-weight: 800;
}
{# Industrial uses hard, technical edges so its corner brackets align with their containers. #}
[data-theme="industrial"] main [class*="rounded"],
[data-theme="industrial"] main button,
[data-theme="industrial"] main input,
[data-theme="industrial"] main textarea,
[data-theme="industrial"] main select {
  border-radius: 0;
}
[data-theme="industrial"] thead tr {
  border-bottom: 2px solid hsl(var(--accent) / 0.35);
}
[data-theme="industrial"] thead th {
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  font-weight: 700;
  color: hsl(var(--muted-foreground));
}
[data-theme="industrial"] button.bg-primary:hover,
[data-theme="industrial"] button[class*="bg-primary"]:hover {
  box-shadow: 0 0 0 1px hsl(var(--accent) / 0.4), 0 2px 8px -2px hsl(var(--accent) / 0.3);
}
[data-theme="industrial"] button[class*="border"][class*="bg-background"]:hover {
  border-color: hsl(var(--accent));
  color: hsl(var(--accent));
}
[data-theme="industrial"] code, [data-theme="industrial"] pre, [data-theme="industrial"] .font-mono {
  font-family: "IBM Plex Mono", "JetBrains Mono", "Fira Code", monospace;
}
[data-theme="industrial"] ::-webkit-scrollbar {
  width: 8px; height: 8px;
}
[data-theme="industrial"] ::-webkit-scrollbar-track {
  background: hsl(var(--muted));
}
[data-theme="industrial"] ::-webkit-scrollbar-thumb {
  background: hsl(var(--border));
  border: 1px solid hsl(var(--muted));
}
{# Industrial: corner brackets on bg-card elements (only in main content, not sidebar) #}
[data-theme="industrial"] main .bg-card {
  position: relative;
}
[data-theme="industrial"] main .bg-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  border-top: 2px solid hsl(var(--accent) / 0.5);
  border-left: 2px solid hsl(var(--accent) / 0.5);
  width: 14px; height: 14px;
  pointer-events: none;
  z-index: 1;
}
[data-theme="industrial"] main .bg-card::after {
  content: '';
  position: absolute;
  bottom: 0; right: 0;
  border-bottom: 2px solid hsl(var(--accent) / 0.5);
  border-right: 2px solid hsl(var(--accent) / 0.5);
  width: 14px; height: 14px;
  pointer-events: none;
  z-index: 1;
}
[data-theme="industrial"] header {
  border-bottom-style: dashed !important;
}

{# ── Arco theme-specific rules ── #}
{# A compact enterprise console, inspired by the supplied Arco Design Pro reference. #}
[data-theme="arco"] { color-scheme: light; }
[data-theme="arco"].dark { color-scheme: dark; }
[data-theme="arco"] body {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  background: hsl(var(--background));
}
[data-theme="arco"] h1, [data-theme="arco"] h2, [data-theme="arco"] h3,
[data-theme="arco"] h4, [data-theme="arco"] h5, [data-theme="arco"] h6 { letter-spacing: -0.015em; }
[data-theme="arco"] main [class*="rounded"], [data-theme="arco"] button,
[data-theme="arco"] input, [data-theme="arco"] textarea, [data-theme="arco"] select { border-radius: 6px; }
[data-theme="arco"] main .bg-card, [data-theme="arco"] [role="dialog"],
[data-theme="arco"] [role="listbox"] { box-shadow: 0 4px 16px rgb(31 56 88 / 0.06); }
[data-theme="arco"] thead th { background: hsl(var(--muted) / 0.75); color: hsl(var(--muted-foreground)); font-size: 0.75rem; font-weight: 600; }
[data-theme="arco"] tbody tr { border-bottom-color: hsl(var(--border) / 0.75); }
[data-theme="arco"] tbody tr:hover { background: hsl(var(--accent) / 0.55); }
[data-theme="arco"] .arco-sider { background: #fff !important; color: hsl(var(--foreground)); border-right: 1px solid hsl(var(--border)); }
[data-theme="arco"].dark .arco-sider { background: hsl(var(--card)) !important; }
[data-theme="arco"] .arco-brand { color: hsl(var(--foreground)); background: #fff; }
[data-theme="arco"].dark .arco-brand { background: hsl(var(--card)); }
[data-theme="arco"] .arco-logo-mark { background: #1677ff !important; color: white !important; box-shadow: 0 4px 12px rgb(22 119 255 / 0.35); }
[data-theme="arco"] .arco-nav { padding-top: 18px; }
[data-theme="arco"] .arco-nav-item { border: 0; margin-bottom: 2px; }
[data-theme="arco"] .arco-nav-item.text-primary { background: rgb(22 119 255 / 0.11); color: #1677ff; }
[data-theme="arco"] .arco-nav-item svg { color: currentColor; }
[data-theme="arco"] .arco-sider .text-muted-foreground { color: hsl(var(--muted-foreground)) !important; }
[data-theme="arco"] .arco-sider .border-t { border-color: hsl(var(--border)); }
[data-theme="arco"] .arco-header { background: hsl(var(--card) / 0.95) !important; backdrop-filter: blur(12px); }
[data-theme="arco"] .arco-workspace { background: hsl(var(--background)); }
[data-theme="arco"] button[class*="bg-primary"] { box-shadow: 0 2px 6px rgb(22 119 255 / 0.18); }
[data-theme="arco"] button[class*="bg-primary"]:hover { box-shadow: 0 5px 13px rgb(22 119 255 / 0.28); transform: translateY(-1px); }
[data-theme="arco"] [data-page-region="grid-list"] > .grid {
  gap: 20px;
}
[data-theme="arco"] [data-grid-create-card] {
  min-height: 250px;
  border-color: hsl(var(--border) / 0.9);
  background: hsl(var(--card));
  color: hsl(var(--muted-foreground));
  box-shadow: none;
}
[data-theme="arco"] [data-grid-create-card]:hover {
  border-color: rgb(22 119 255 / 0.55);
  background: rgb(22 119 255 / 0.025);
  box-shadow: 0 8px 24px rgb(31 56 88 / 0.08);
  transform: translateY(-1px);
}
[data-theme="arco"] [data-grid-create-card] svg {
  height: 42px;
  width: 42px;
  stroke-width: 1.5;
}
[data-theme="arco"] [data-grid-create-card] span {
  font-size: 0.875rem;
}
[data-theme="arco"] [data-grid-card] {
  min-height: 250px;
  overflow: hidden;
  border-color: hsl(var(--border) / 0.9);
  box-shadow: none;
}
[data-theme="arco"] [data-grid-card]:hover {
  border-color: rgb(22 119 255 / 0.45);
  box-shadow: 0 8px 24px rgb(31 56 88 / 0.1);
}
[data-theme="arco"] [data-grid-card] > div:first-child {
  border-bottom: 0;
  padding: 28px 32px 0;
}
[data-theme="arco"] [data-grid-card] h2 {
  color: hsl(var(--foreground));
  font-size: 1.25rem;
  font-weight: 650;
  line-height: 1.5;
}
[data-theme="arco"] [data-grid-card] .grid-card-id {
  display: none;
}
[data-theme="arco"] [data-grid-card] .grid-card-select {
  position: absolute;
  right: 20px;
  top: 20px;
  margin: 0;
  opacity: 0;
  transition: opacity 150ms ease;
}
[data-theme="arco"] [data-grid-card]:hover .grid-card-select,
[data-theme="arco"] [data-grid-card] .grid-card-select:focus-visible,
[data-theme="arco"] [data-grid-card] .grid-card-select:checked {
  opacity: 1;
}
[data-theme="arco"] [data-grid-card] dl {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 24px;
  row-gap: 20px;
  padding: 18px 32px 28px;
}
[data-theme="arco"] [data-grid-card] .grid-card-field {
  display: flex;
  align-items: baseline;
  gap: 12px;
  min-width: 0;
  font-size: 1rem;
}
[data-theme="arco"] [data-grid-card] .grid-card-field dt {
  flex: 0 0 auto;
  color: hsl(var(--muted-foreground));
  font-weight: 600;
}
[data-theme="arco"] [data-grid-card] .grid-card-field dd {
  min-width: 0;
  text-align: left;
  color: hsl(var(--foreground));
  font-weight: 500;
}
[data-theme="arco"] [data-grid-card] .grid-card-field[data-grid-field-type="datetime"],
[data-theme="arco"] [data-grid-card] .grid-card-field[data-grid-field-type="date"] {
  grid-column: 1 / -1;
}
[data-theme="arco"] [data-grid-card] .grid-card-field[data-grid-field="created_at"] dt {
  display: none;
}
[data-theme="arco"] [data-grid-card] .grid-card-field[data-grid-field="created_at"] dd {
  color: hsl(var(--muted-foreground));
  font-size: 1rem;
  font-weight: 400;
}
[data-theme="arco"] [data-grid-card] > div:last-child {
  margin-top: auto;
  justify-content: flex-end;
  gap: 16px;
  border-top: 0;
  padding: 0 32px 28px;
}
[data-theme="arco"] [data-grid-card] .grid-card-action {
  height: 42px;
  min-width: 88px;
  padding: 0 20px;
  font-size: 1rem;
}
[data-theme="arco"] [data-grid-card] .grid-card-action svg {
  display: none;
}
[data-theme="arco"] [data-grid-card] .grid-card-action .sr-only {
  position: static;
  width: auto;
  height: auto;
  margin: 0;
  padding: 0;
  overflow: visible;
  clip: auto;
  clip-path: none;
  white-space: normal;
}
[data-theme="arco"] [data-grid-card] .grid-card-action-edit {
  background: #1677ff;
  color: #fff;
  box-shadow: 0 2px 6px rgb(22 119 255 / 0.18);
}
[data-theme="arco"] [data-grid-card] .grid-card-action-edit:hover {
  background: #0f6ae6;
}
[data-theme="arco"] [data-grid-card] .grid-card-action-delete {
  background: hsl(var(--muted) / 0.65);
  color: hsl(var(--foreground));
}
[data-theme="arco"] [data-grid-card] .grid-card-action-delete:hover {
  background: hsl(var(--destructive) / 0.12);
  color: hsl(var(--destructive));
}
@media (max-width: 640px) {
  [data-theme="arco"] [data-grid-card] dl { grid-template-columns: 1fr; }
  [data-theme="arco"] [data-grid-card] .grid-card-field[data-grid-field-type="datetime"],
  [data-theme="arco"] [data-grid-card] .grid-card-field[data-grid-field-type="date"] { grid-column: auto; }
}
[data-theme="arco"] ::-webkit-scrollbar { width: 7px; height: 7px; }
[data-theme="arco"] ::-webkit-scrollbar-thumb { background: hsl(var(--border)); border-radius: 999px; }

{# ── Neuron theme-specific rules ── #}
{# A telemetry-console treatment with light and dark color modes. #}
[data-theme="neuron"] {
  color-scheme: light;
}
[data-theme="neuron"].dark { color-scheme: dark; }
[data-theme="neuron"] body {
  font-family: Inter, "SF Pro Text", "PingFang SC", "Microsoft YaHei", sans-serif;
  background-image: linear-gradient(hsl(var(--foreground) / 0.045) 1px, transparent 1px), linear-gradient(90deg, hsl(var(--foreground) / 0.045) 1px, transparent 1px);
  background-size: 32px 32px;
}
[data-theme="neuron"] h1, [data-theme="neuron"] h2, [data-theme="neuron"] h3,
[data-theme="neuron"] h4, [data-theme="neuron"] h5, [data-theme="neuron"] h6 {
  font-weight: 600;
  letter-spacing: -0.025em;
}
[data-theme="neuron"] code, [data-theme="neuron"] pre, [data-theme="neuron"] .font-mono,
[data-theme="neuron"] thead th {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}
[data-theme="neuron"] aside {
  background-color: hsl(var(--neuron-sidebar)) !important;
  border-right-color: hsl(var(--border)) !important;
}
[data-theme="neuron"] header {
  background-color: hsl(var(--background) / 0.88) !important;
  border-bottom-color: hsl(var(--border)) !important;
  backdrop-filter: blur(18px);
}
[data-theme="neuron"] aside > div:first-child {
  border-bottom-color: hsl(var(--border)) !important;
}
[data-theme="neuron"] main [class*="rounded-"],
[data-theme="neuron"] button,
[data-theme="neuron"] input,
[data-theme="neuron"] textarea,
[data-theme="neuron"] select {
  border-radius: 2px;
}
[data-theme="neuron"] main .bg-card {
  box-shadow: none;
}
[data-theme="neuron"] button {
  transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
[data-theme="neuron"] button:hover {
  filter: none;
}
[data-theme="neuron"] button[class*="bg-primary"]:hover {
  box-shadow: 0 0 22px hsl(var(--primary) / 0.16);
}
[data-theme="neuron"] button[class*="border"][class*="bg-background"]:hover {
  border-color: hsl(var(--primary));
  color: hsl(var(--primary));
  background-color: hsl(var(--primary) / 0.06);
}
[data-theme="neuron"] thead th {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: hsl(var(--muted-foreground));
}
[data-theme="neuron"] tbody tr {
  transition: background-color 0.12s ease;
}
[data-theme="neuron"] tbody tr:hover {
  background-color: hsl(var(--secondary));
}
[data-theme="neuron"] ::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}
[data-theme="neuron"] ::-webkit-scrollbar-track {
  background: transparent;
}
[data-theme="neuron"] ::-webkit-scrollbar-thumb {
  background: hsl(var(--border));
  border: 1px solid hsl(var(--muted));
}

{# Neuron layout and component system: deliberately distinct from the standard admin shell. #}
[data-theme="neuron"] {
  --neuron-sidebar: 210 23% 95%;
  --neuron-panel-soft: 210 22% 97%;
  --neuron-panel-raised: 210 18% 93%;
  --neuron-line-strong: 205 14% 72%;
  --neuron-ink-soft: 207 12% 37%;
  --neuron-ink-faint: 207 10% 50%;
}
[data-theme="neuron"].dark {
  --neuron-sidebar: 210 13% 6%;
  --neuron-panel-soft: 210 12% 9%;
  --neuron-panel-raised: 210 11% 14%;
  --neuron-line-strong: 206 10% 25%;
  --neuron-ink-soft: 200 9% 64%;
  --neuron-ink-faint: 205 8% 38%;
}
[data-theme="neuron"] aside {
  background-color: hsl(var(--neuron-sidebar)) !important;
}
[data-theme="neuron"] .neuron-brand-area {
  border-bottom-color: hsl(var(--border)) !important;
}
[data-theme="neuron"] .neuron-brand {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 12px;
  color: hsl(var(--foreground));
}
[data-theme="neuron"] .neuron-mark {
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  display: flex;
  align-items: end;
  gap: 3px;
  padding: 8px;
  border: 1px solid hsl(var(--primary) / 0.35);
  background: hsl(var(--primary) / 0.06);
}
[data-theme="neuron"] .neuron-mark i {
  width: 4px;
  border-radius: 1px 1px 0 0;
  background: hsl(var(--primary));
  box-shadow: 0 0 12px hsl(var(--primary) / 0.3);
}
[data-theme="neuron"] .neuron-mark i:nth-child(1) { height: 8px; opacity: 0.45; }
[data-theme="neuron"] .neuron-mark i:nth-child(2) { height: 18px; }
[data-theme="neuron"] .neuron-mark i:nth-child(3) { height: 13px; opacity: 0.7; }
[data-theme="neuron"] .neuron-project-logo {
  width: auto;
  max-width: 118px;
  height: 38px;
  flex: 0 1 auto;
  object-fit: contain;
  object-position: left center;
}
[data-theme="neuron"] .neuron-project-logo--collapsed {
  width: 34px;
  max-width: 34px;
  object-position: center;
}
[data-theme="neuron"] .neuron-brand-copy {
  min-width: 0;
  display: grid;
  gap: 4px;
}
[data-theme="neuron"] .neuron-brand-copy strong {
  overflow: hidden;
  color: hsl(var(--foreground));
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  text-overflow: ellipsis;
  white-space: nowrap;
}
[data-theme="neuron"] .neuron-brand-copy small {
  color: hsl(var(--neuron-ink-faint));
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.45rem;
  font-weight: 700;
  letter-spacing: 0.14em;
}
[data-theme="neuron"] .neuron-nav {
  padding-top: 15px;
}
[data-theme="neuron"] .neuron-nav-heading {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0 3px 8px;
  padding: 0 7px;
  color: hsl(var(--neuron-ink-faint));
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.13em;
}
[data-theme="neuron"] .neuron-nav-heading span {
  color: hsl(var(--primary) / 0.72);
  font-size: 0.55rem;
}
[data-theme="neuron"] .neuron-nav-item {
  min-height: 40px;
  color: hsl(var(--muted-foreground));
  font-size: 0.78rem;
}
[data-theme="neuron"] .neuron-nav-item svg {
  width: 15px;
  height: 15px;
  color: hsl(var(--neuron-ink-faint));
}
[data-theme="neuron"] .neuron-nav-item:hover svg,
[data-theme="neuron"] .neuron-nav-item.text-primary svg {
  color: hsl(var(--primary));
}
[data-theme="neuron"] .neuron-nav > div:last-of-type {
  margin-top: 22px;
  padding-top: 16px;
  border-top-color: hsl(var(--border));
}
[data-theme="neuron"] .neuron-header {
  box-shadow: 0 10px 30px -24px rgb(0 0 0 / 0.9);
}
[data-theme="neuron"] .neuron-breadcrumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: 8px;
  color: hsl(var(--neuron-ink-faint));
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.6rem;
  letter-spacing: 0.08em;
}
[data-theme="neuron"] .neuron-breadcrumbs i {
  color: hsl(var(--border));
  font-style: normal;
}
[data-theme="neuron"] .neuron-breadcrumbs b {
  color: hsl(var(--neuron-ink-soft));
  font-weight: 500;
}
[data-theme="neuron"] .neuron-user-control {
  border-left: 1px solid hsl(var(--border));
  border-radius: 0;
}
[data-theme="neuron"] .neuron-workspace {
  width: 100%;
  max-width: 1540px;
  margin: 0 auto;
}
[data-theme="neuron"] [data-ui="card"] {
  position: relative;
  overflow: hidden;
  border-color: hsl(var(--border));
  border-radius: 2px;
  background: hsl(var(--card));
  box-shadow: inset 2px 0 hsl(var(--primary) / 0.36), 0 18px 35px -30px rgb(0 0 0 / 0.95);
}
[data-theme="neuron"] [data-ui="card"]:hover {
  border-color: hsl(var(--neuron-line-strong));
}
[data-theme="neuron"] [data-ui="card"] > div:first-child {
  padding: 16px 18px;
  border-bottom: 1px solid hsl(var(--border) / 0.8);
}
[data-theme="neuron"] [data-ui="card"] h3 {
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.01em;
}
[data-theme="neuron"] [data-ui="card"] p {
  font-size: 0.72rem;
}
[data-theme="neuron"] [data-ui="button"] {
  min-height: 34px;
  border-radius: 2px;
  font-size: 0.72rem;
  font-weight: 650;
}
[data-theme="neuron"] [data-ui="button"].bg-primary {
  box-shadow: 0 0 20px hsl(var(--primary) / 0.1);
}
[data-theme="neuron"] [data-ui="input"],
[data-theme="neuron"] [data-ui="select-trigger"],
[data-theme="neuron"] textarea {
  min-height: 34px;
  border-color: hsl(var(--border));
  border-radius: 2px;
  background: hsl(var(--neuron-panel-soft));
  font-size: 0.78rem;
}
[data-theme="neuron"] [data-ui="input"]:focus,
[data-theme="neuron"] [data-ui="select-trigger"]:focus,
[data-theme="neuron"] textarea:focus {
  border-color: hsl(var(--primary) / 0.7);
  box-shadow: 0 0 0 2px hsl(var(--primary) / 0.12);
}
[data-theme="neuron"] [data-ui="table-container"] {
  border: 0;
}
[data-theme="neuron"] [data-ui="table-container"] table {
  font-size: 0.78rem;
}
[data-theme="neuron"] thead th {
  height: 40px;
  padding: 0 16px;
  border-bottom-color: hsl(var(--border));
  background: hsl(var(--neuron-panel-raised));
  font-size: 0.6rem;
}
[data-theme="neuron"] tbody td {
  padding: 13px 16px;
  border-bottom-color: hsl(var(--border) / 0.78);
}
[data-theme="neuron"] tbody tr:hover {
  background-color: hsl(var(--neuron-panel-raised));
}
[data-theme="neuron"] [data-ui="badge"] {
  border-radius: 1px;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}
[data-theme="neuron"] [role="dialog"],
[data-theme="neuron"] [role="listbox"] {
  border: 1px solid hsl(var(--neuron-line-strong));
  border-radius: 2px;
  background: hsl(var(--card));
  box-shadow: 0 22px 60px rgb(0 0 0 / 0.42);
}
[data-theme="neuron"] .settings-page {
  max-width: 980px;
}
[data-theme="neuron"] .settings-page-title {
  color: hsl(var(--foreground)) !important;
  font-size: 1.15rem;
  font-weight: 600;
  letter-spacing: -0.02em;
}
[data-theme="neuron"] .settings-panel {
  padding: 20px;
  border: 1px solid hsl(var(--border));
  border-radius: 2px;
  background: hsl(var(--card)) !important;
  box-shadow: inset 2px 0 hsl(var(--primary) / 0.36), 0 18px 35px -30px rgb(0 0 0 / 0.95);
}
[data-theme="neuron"] .settings-panel > form > .space-y-6 {
  padding: 18px;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--neuron-panel-soft));
}
[data-theme="neuron"] .settings-panel > form > .space-y-6 h2 {
  color: hsl(var(--foreground));
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.01em;
}
[data-theme="neuron"] .settings-group {
  border-color: hsl(var(--border));
  border-radius: 2px;
  background: hsl(var(--card));
}
[data-theme="neuron"] .settings-group-trigger {
  min-height: 48px;
  padding: 0 14px;
  border-radius: 0;
  background: hsl(var(--neuron-panel-raised)) !important;
  color: hsl(var(--neuron-ink-soft));
  font-size: 0.76rem;
}
[data-theme="neuron"] .settings-group-trigger:hover {
  background: hsl(var(--secondary)) !important;
}
[data-theme="neuron"] .settings-group-trigger svg {
  width: 15px;
  height: 15px;
  color: hsl(var(--primary));
}
[data-theme="neuron"] .settings-group-content {
  background: hsl(var(--card));
}
[data-theme="neuron"] .settings-panel label {
  color: hsl(var(--neuron-ink-soft));
  font-size: 0.72rem;
}
[data-theme="neuron"] .settings-panel label span {
  color: hsl(var(--neuron-ink-faint)) !important;
}
[data-theme="neuron"] .login-shell {
  position: relative;
  isolation: isolate;
  background: hsl(var(--background));
}
[data-theme="neuron"] .login-shell::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background-image: radial-gradient(circle at 72% 32%, hsl(var(--primary) / 0.07), transparent 22%), linear-gradient(hsl(var(--foreground) / 0.045) 1px, transparent 1px), linear-gradient(90deg, hsl(var(--foreground) / 0.045) 1px, transparent 1px);
  background-size: auto, 32px 32px, 32px 32px;
}
[data-theme="neuron"] .login-brand-panel {
  border-right: 1px solid hsl(var(--border));
  background: hsl(var(--neuron-sidebar)) !important;
}
[data-theme="neuron"] .login-brand-panel > div:first-child {
  background: linear-gradient(155deg, hsl(var(--neuron-sidebar)), hsl(var(--neuron-panel-soft))) !important;
}
[data-theme="neuron"] .login-form-panel > div {
  padding: 28px;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card) / 0.94);
  box-shadow: 0 24px 60px -36px rgb(0 0 0 / 0.9);
}
[data-theme="neuron"] .login-form-panel h1::before {
  content: 'SECURE ACCESS / 01';
  display: block;
  margin-bottom: 10px;
  color: hsl(var(--primary));
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.13em;
}
{# ── Normal theme-specific rules ── #}
[data-theme="normal"] body {
  font-family: Inter, "Segoe UI", system-ui, sans-serif;
}
[data-theme="normal"] header {
  border-bottom: 1px solid hsl(var(--border));
}
