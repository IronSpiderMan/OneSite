"""Minimal async tool loop. Hooks operate on copies, never on persisted history."""
import asyncio
import copy
import json
import logging
from dataclasses import dataclass, field
from types import SimpleNamespace
from typing import Any

logger = logging.getLogger(__name__)


class AgentBlocked(Exception):
    """A deliberate, user-visible denial from a hook or tool."""


@dataclass
class ModelRequestOverride:
    messages: list[dict] | None = None
    parameters: dict = field(default_factory=dict)


@dataclass
class ToolArgumentsOverride:
    arguments: dict


@dataclass
class ToolResultOverride:
    result: Any


@dataclass
class RunContextOverride:
    instructions: str


@dataclass
class AgentContext:
    user: Any
    session_id: str
    run_id: str
    api: Any = None
    state: dict = field(default_factory=dict)


async def stream_completion(client, request, partial, check):
    """Assemble indexed tool deltas; incomplete calls must never reach execution."""
    stream = await client.chat.completions.create(**request, stream=True, stream_options={"include_usage": True})
    payload = {"role": "assistant", "content": None}
    tool_calls = {}
    finish_reason = None
    usage = None
    try:
        async for chunk in stream:
            await check()
            if chunk.usage:
                usage = chunk.usage.model_dump()
            if not chunk.choices:
                continue
            choice = chunk.choices[0]
            delta = choice.delta
            if delta.content:
                payload["content"] = (payload["content"] or "") + delta.content
            reasoning = getattr(delta, "reasoning_content", None)
            if reasoning:
                payload["reasoning_content"] = payload.get("reasoning_content", "") + reasoning
            for fragment in delta.tool_calls or []:
                call = tool_calls.setdefault(fragment.index, {
                    "id": "", "type": "function", "function": {"name": "", "arguments": ""},
                })
                if fragment.id:
                    call["id"] += fragment.id
                if fragment.type and fragment.type != "function":
                    raise ValueError("Only function tool calls are supported")
                if fragment.function:
                    call["function"]["name"] += fragment.function.name or ""
                    call["function"]["arguments"] += fragment.function.arguments or ""
            if delta.content or reasoning:
                await partial(copy.deepcopy(payload))
            if choice.finish_reason:
                finish_reason = choice.finish_reason
    finally:
        await stream.close()
    if finish_reason not in {"stop", "tool_calls"}:
        raise RuntimeError(f"Model did not finish: {finish_reason}")
    calls = [tool_calls[index] for index in sorted(tool_calls)]
    if calls and (finish_reason != "tool_calls" or any(
            not call["id"] or not call["function"]["name"] for call in calls)):
        raise ValueError("Incomplete tool call stream")
    if len({call["id"] for call in calls}) != len(calls):
        raise ValueError("Duplicate tool call IDs")
    if finish_reason == "tool_calls" and not calls:
        raise ValueError("Missing streamed tool calls")
    if calls:
        payload["tool_calls"] = calls
    return payload, calls, usage


async def run_agent(*, client, config, messages, registry, context, emit, check, hooks=None, emit_partial=None):
    """emit(payload, metadata) must persist before returning; check enforces cancellation."""
    hooks = hooks or {}
    history = copy.deepcopy(messages)
    usage = []
    reported = set()

    async def notify_error(stage, exc):
        if id(exc) in reported:
            return
        reported.add(id(exc))
        logger.error("Agent failure at %s", stage, exc_info=(type(exc), exc, exc.__traceback__))
        if "on_error" in hooks:
            try:
                await hooks["on_error"](SimpleNamespace(stage=stage, error=exc), context)
            except Exception:
                logger.exception("Agent on_error hook failed")

    async def hook(point, **values):
        fn = hooks.get(point)
        if fn is None:
            return None
        try:
            return await fn(SimpleNamespace(**copy.deepcopy(values)), context)
        except AgentBlocked:
            raise
        except Exception as exc:
            await notify_error(point, exc)
            raise

    async def append(payload, metadata=None):
        await emit(payload, metadata or {})
        history.append(payload)

    try:
        before = await hook("before_run", messages=history)
        instructions = config["instructions"]
        if before is not None:
            if not isinstance(before, RunContextOverride):
                raise TypeError("before_run must return RunContextOverride or None")
            instructions += "\n" + before.instructions
        for step in range(config["max_steps"]):
            await check()
            definitions = await registry.definitions()
            request_messages = [{"role": "system", "content": instructions}, *copy.deepcopy(history)]
            override = await hook("before_model", messages=request_messages, step=step)
            parameters = {}
            if override is not None:
                if not isinstance(override, ModelRequestOverride):
                    raise TypeError("before_model must return ModelRequestOverride or None")
                if override.messages is not None:
                    request_messages = override.messages
                # Hooks cannot replace tools, credentials, streaming mode or the client.
                allowed = {"model", "temperature", "top_p", "max_tokens"}
                if set(override.parameters) - allowed:
                    raise ValueError("Unsupported model parameter override")
                parameters = override.parameters
            await check()
            async def partial(payload):
                if emit_partial:
                    await emit_partial(payload)

            payload, raw_calls, model_usage = await stream_completion(client, {
                "messages": request_messages,
                **{"model": config["model"], **parameters},
                **({"tools": definitions} if definitions else {}),
            }, partial, check)
            calls = [SimpleNamespace(id=call["id"], function=SimpleNamespace(**call["function"]))
                     for call in raw_calls]
            await append(payload)
            if model_usage:
                usage.append(model_usage)
            if not calls:
                await hook("after_run", messages=history, usage=usage)
                return
            for call in calls:
                await check()
                actual = None
                success = False
                metadata = {"name": call.function.name}
                try:
                    actual = json.loads(call.function.arguments)
                    if not isinstance(actual, dict):
                        raise AgentBlocked("Tool arguments must be a JSON object")
                    await registry.validate(call.function.name, actual)
                    changed = await hook("before_tool", name=call.function.name, arguments=actual,
                                         call_id=call.id)
                    if changed is not None:
                        if not isinstance(changed, ToolArgumentsOverride):
                            raise TypeError("before_tool must return ToolArgumentsOverride or None")
                        actual = changed.arguments
                    await check()
                    await registry.validate(call.function.name, actual)
                    # Persist actual arguments BEFORE side effects; recovery never repeats this call.
                    await emit(None, {"call_id": call.id, "name": call.function.name,
                                      "arguments": actual, "status": "started"})
                    try:
                        result = await registry.execute(call.function.name, actual)
                        success = True
                    except AgentBlocked:
                        raise
                    except Exception as exc:
                        await notify_error("tool", exc)
                        result = {"error": "Tool execution failed; verify results before retrying"}
                except AgentBlocked as exc:
                    result = {"error": str(exc)}
                    metadata["blocked"] = str(exc)
                except json.JSONDecodeError as exc:
                    await notify_error("tool", exc)
                    result = {"error": "Invalid tool arguments"}
                except Exception as exc:
                    await notify_error("tool", exc)
                    # A broken hook must never be silently skipped.
                    raise
                changed = await hook("after_tool", name=call.function.name, arguments=actual,
                                     result=result, success=success, call_id=call.id)
                if changed is not None:
                    if not isinstance(changed, ToolResultOverride):
                        raise TypeError("after_tool must return ToolResultOverride or None")
                    result = changed.result
                metadata.update({"arguments": actual, "success": success})
                await append({"role": "tool", "tool_call_id": call.id,
                              "content": json.dumps(result, ensure_ascii=False, default=str)}, metadata)
        raise AgentBlocked("Maximum agent steps reached")
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        await notify_error("run", exc)
        raise
