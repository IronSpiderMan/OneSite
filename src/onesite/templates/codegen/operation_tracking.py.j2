"""Generated operation tracking runtime."""

import logging
from collections.abc import Callable
from typing import Any

from sqlmodel.ext.asyncio.session import AsyncSession
from starlette.middleware.base import BaseHTTPMiddleware
from starlette.requests import Request

from app.core.db import engine
from app.models.operation_log import OperationLog


logger = logging.getLogger(__name__)
VALID_OPERATIONS = {
    "create", "read", "update", "delete", "bulk_delete", "import", "export"
}
VALID_STATUSES = {"success", "failed"}


def tracked_operation(
    *,
    resource: str,
    operation: str,
    failures_only: bool = False,
    ignore_dry_run: bool = False,
) -> Callable:
    """Attach tracking metadata without wrapping the generated endpoint."""
    if operation not in VALID_OPERATIONS:
        raise ValueError(f"Unsupported tracked operation: {operation}")

    def decorate(endpoint: Callable) -> Callable:
        endpoint.__onesite_tracking__ = {
            "resource": resource,
            "operation": operation,
            "failures_only": failures_only,
            "ignore_dry_run": ignore_dry_run,
        }
        return endpoint

    return decorate


async def record_operation(
    *, user_id: int | None, resource: str, operation: str, status: str
) -> None:
    """Persist one outcome without changing the result of the user operation."""
    if user_id is None:
        return
    if operation not in VALID_OPERATIONS or status not in VALID_STATUSES:
        logger.error(
            "Rejected invalid operation log resource=%s operation=%s status=%s",
            resource, operation, status,
        )
        return
    try:
        async with AsyncSession(engine, expire_on_commit=False) as session:
            session.add(OperationLog(
                user_id=user_id,
                resource=resource,
                operation=operation,
                status=status,
            ))
            await session.commit()
    except Exception:
        # The business operation may already have committed. Never turn it
        # into an apparent failure merely because its tracking write failed.
        logger.exception(
            "Failed to record operation resource=%s operation=%s status=%s",
            resource, operation, status,
        )


async def _record_request(request: Request, status: str) -> None:
    endpoint: Any = request.scope.get("endpoint")
    metadata = getattr(endpoint, "__onesite_tracking__", None)
    if not metadata:
        return
    if metadata.get("failures_only") and status == "success":
        return
    if metadata.get("ignore_dry_run") and request.query_params.get("dry_run", "").lower() in {
        "1", "true", "yes", "on"
    }:
        return
    await record_operation(
        user_id=getattr(request.state, "current_user_id", None),
        resource=metadata["resource"],
        operation=metadata["operation"],
        status=status,
    )


class OperationTrackingMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        try:
            response = await call_next(request)
        except Exception:
            await _record_request(request, "failed")
            raise
        await _record_request(
            request,
            "success" if response.status_code < 400 else "failed",
        )
        return response
