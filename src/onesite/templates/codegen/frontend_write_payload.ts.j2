  // Submit only fields writable by this role, including embedded child rows.
  const writablePayload = (values: Record<string, any>, operation: 'c' | 'u'{% if universal_capabilities %}, saved?: Record<string, unknown>{% endif %}) => {
    const payload = Object.fromEntries(Object.entries(values).filter(([key]) => hasFieldPerm(key, operation)));
    {% if universal_capabilities %}
    const selector = payload[capabilitySelectorField] ?? saved?.[capabilitySelectorField] ?? capabilityFormDefaults[capabilitySelectorField];
    for (const field of conditionalCapabilityFields) {
      if (!capabilityFieldVisible(field, selector)) delete payload[field];
    }
    {% endif %}
    {% for field in model.fields if field.capability_secret %}
    {% if universal_capabilities %}delete payload.__clear_{{ field.name }};{% endif %}
    if (operation === 'u') {
      {% if field.capability_secret_clearable %}
      if (values.__clear_{{ field.name }} && hasFieldPerm('{{ field.name }}', 'u'){% if universal_capabilities %} && canClearCapabilityPassword('{{ field.name }}', selector){% endif %}) payload.{{ field.name }} = '';
      else {% endif %}if (payload.{{ field.name }} === '') delete payload.{{ field.name }};
    }
    {% endfor %}
    {% if universal_capabilities %}
    validateCapabilityFields(payload, operation, saved);
    {% endif %}
    {% for rel in model.inline_relations | default([]) %}
    if (Array.isArray(payload.{{ rel.write_name }})) {
      const grants: Record<string, Record<string, string>> = {{ rel.field_permissions | default({}) | tojson }};
      payload.{{ rel.write_name }} = payload.{{ rel.write_name }}.map((item: Record<string, any>) =>
        Object.fromEntries(Object.entries(item).filter(([key]) => key === 'id' || (grants[key]?.[userRole] || '').includes(item.id != null ? 'u' : 'c')))
      );
    }
    {% endfor %}
    return payload;
  };
