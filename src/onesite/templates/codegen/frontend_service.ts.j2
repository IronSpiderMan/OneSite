import request from '../utils/request';

const API_URL = '/{{ model.module_name }}s';

{% if not model.is_timescaledb %}

export interface {{ model.name }} {
    id: {{ 'string' if 'str' in model.id_type else 'number' }};
{% for field in model.fields %}
    {% if field.name != 'id' and 'r' in field.permissions %}
    {{ field.name }}: {{ 'Record<string, any>' if 'Dict[' in field.type else 'string[]' if field.is_multi_select else 'any[]' if 'List[' in field.type else 'string' if 'str' in field.type else 'number' if 'int' in field.type or 'float' in field.type else 'boolean' if 'bool' in field.type else 'any' }};
    {% if field.fk_info %}
    {{ field.name }}_label?: string;
    {% endif %}
    {% endif %}
{% endfor %}
}

export interface PaginatedResponse<T> {
    items: T[];
    total: number;
    page: number;
    size: number;
    total_pages: number;
}

export const get{{ model.name }}s = async (page = 1, size = 20, filters?: Record<string, any>) => {
    let url = `${API_URL}/?page=${page}&size=${size}`;
    if (filters) {
        Object.entries(filters).forEach(([key, value]) => {
            if (value !== undefined && value !== null) {
                if (Array.isArray(value)) {
                    value.forEach((v) => {
                        url += `&${key}=${encodeURIComponent(String(v))}`;
                    });
                } else {
                    url += `&${key}=${encodeURIComponent(String(value))}`;
                }
            }
        });
    }
    const response = await request.get<PaginatedResponse<{{ model.name }}>>(url);
    return response.data;
};

export const get{{ model.name }} = async (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
    const response = await request.get<{{ model.name }}>(`${API_URL}/${id}`);
    return response.data;
};

export const create{{ model.name }} = async (data: any) => {
    const response = await request.post<{{ model.name }}>(`${API_URL}/`, data);
    return response.data;
};

export const update{{ model.name }} = async (id: {{ 'string' if 'str' in model.id_type else 'number' }}, data: any) => {
    const response = await request.put<{{ model.name }}>(`${API_URL}/${id}`, data);
    return response.data;
};

export const delete{{ model.name }} = async (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
    const response = await request.delete<{{ model.name }}>(`${API_URL}/${id}`);
    return response.data;
};

export const bulkDelete{{ model.name }} = async (ids: {{ 'string[]' if 'str' in model.id_type else 'number[]' }}) => {
    const response = await request.post<{ deleted: number }>(`${API_URL}/bulk_delete`, { ids });
    return response.data;
};

{% if model.property_config_meta %}
export const update{{ model.name }}PropertiesConfig = async (id: {{ 'string' if 'str' in model.id_type else 'number' }}, configs: Record<string, any>[]) => {
    const response = await request.put(`${API_URL}/${id}/properties-config`, configs);
