"""OPC UA profile helpers and on-demand address-space browsing."""

import asyncio
import base64
import math
import re
from collections import deque
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import urlsplit
from uuid import UUID

from app.core.config import settings

_NODE_ID = re.compile(r"(?:(?:ns=(\d+)|nsu=(.+));)?([isgb])=(.*)")
MAX_CONDITION_SCAN_NODES = 10000


class ConditionScanLimitError(RuntimeError):
    """The address space cannot be completely scanned within the node budget."""


@dataclass(frozen=True)
class OpcuaConnection:
    endpoint: str
    username: str | None = None
    password: str | None = field(default=None, repr=False)
    auth_type: str = "anonymous"
    request_timeout_seconds: float = 10
    security_policy: str = "None"
    security_mode: str = "None"
    app_uri: str | None = None
    cert_path: str | None = None
    key_path: str | None = field(default=None, repr=False)
    server_cert_path: str | None = None

    @classmethod
    def from_fields(cls, values):
        endpoint = values["endpoint"]
        if not isinstance(endpoint, str) or any(c.isspace() or ord(c) < 32 for c in endpoint):
            raise ValueError("Invalid OPC UA endpoint")
        url = urlsplit(endpoint)
        port = url.port
        if (
            url.scheme != "opc.tcp"
            or not url.hostname
            or url.username is not None
            or url.password is not None
            or url.netloc.endswith(":")
            or port == 0
            or url.query
            or url.fragment
        ):
            raise ValueError("Invalid OPC UA endpoint")
        if port is None:
            endpoint = url._replace(netloc=f"{url.netloc}:4840").geturl()

        username = values.get("username")
        password = values.get("password")
        auth_type = values.get("auth_type") or ("username" if username else "anonymous")
        if (
            auth_type not in ("anonymous", "username")
            or (auth_type == "username" and not (username or "").strip())
            or (auth_type == "anonymous" and (username or password))
        ):
            raise ValueError("Invalid OPC UA authentication settings")

        timeout = values.get("request_timeout_seconds")
        if timeout is None:
            timeout = 10
        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not 0 < timeout <= 30:
            raise ValueError("Invalid OPC UA request timeout")

        policy = values.get("security_policy") or "None"
        mode = values.get("security_mode") or "None"
        certificate = values.get("cert_path")
        key = values.get("key_path")
        server_certificate = values.get("server_cert_path")
        if (policy, mode) != ("None", "None"):
            if policy != "Basic256Sha256" or mode not in ("Sign", "SignAndEncrypt"):
                raise ValueError("Invalid OPC UA security settings")
            for path, prefixes in (
                (certificate, ("/uploads/", "/private-uploads/")),
                (key, ("/private-uploads/",)),
                (server_certificate, ("/uploads/", "/private-uploads/")),
            ):
                if not isinstance(path, str) or not path.startswith(prefixes):
                    raise ValueError("Invalid OPC UA certificate reference")
                certificate_path(path)

        return cls(
            endpoint=endpoint,
            username=username,
            password=password,
            auth_type=auth_type,
            request_timeout_seconds=timeout,
            security_policy=policy,
            security_mode=mode,
            app_uri=values.get("app_uri"),
            cert_path=certificate,
            key_path=key,
            server_cert_path=server_certificate,
        )


def validate_nodeid(value):
    """Validate both indexed NodeIds and namespace-URI addresses."""
    match = _NODE_ID.fullmatch(value) if isinstance(value, str) else None
    if not match or (match[1] and int(match[1]) > 65535) or not match[4]:
        raise ValueError("无效的 OPC UA NodeId")
    namespace, uri, kind, identifier = match.groups()
    if kind == "i":
        if not identifier.isascii() or not identifier.isdigit() or int(identifier) > 4294967295:
            raise ValueError("无效的数字 NodeId")
        if int(identifier) == 0 and not uri and int(namespace or 0) == 0:
            raise ValueError("不能使用空 NodeId")
    elif kind == "g":
        UUID(identifier)
    elif kind == "b":
        base64.b64decode(identifier, validate=True)
    return match


def certificate_path(value):
    """Resolve uploaded files without permitting traversal out of their storage."""
    if not isinstance(value, str) or not value:
        raise ValueError("缺少证书路径")
    for prefix, root in (
        ("/uploads/", settings.UPLOAD_DIR),
        ("/private-uploads/", settings.PRIVATE_UPLOAD_DIR),
    ):
        if value.startswith(prefix):
            name = value[len(prefix) :]
            if not name or Path(name).name != name or name in (".", "..") or "\\" in name:
                raise ValueError("无效的证书路径")
            path = (Path(root) / name).resolve()
            if path.parent != Path(root).resolve():
                raise ValueError("无效的证书路径")
            return str(path)
    if "://" in value or ".." in Path(value).parts:
        raise ValueError("证书必须是本地文件")
    return value


async def create_client(server):
    from asyncua import Client, ua
    from asyncua.crypto.security_policies import SecurityPolicyBasic256Sha256

    timeout = server.request_timeout_seconds
    if not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or timeout <= 0:
        raise ValueError("请求超时无效")
    client = Client(server.endpoint, timeout=timeout)
    if server.auth_type == "username":
        client.set_user(server.username)
        client.set_password(server.password or "")
    elif server.auth_type != "anonymous":
        raise ValueError("不支持的用户认证方式")
    if server.app_uri:
        client.application_uri = server.app_uri
    if server.security_policy == "None":
        if server.security_mode != "None":
            raise ValueError("安全策略和模式不匹配")
    else:
        if server.security_policy != "Basic256Sha256" or server.security_mode not in (
            "Sign",
            "SignAndEncrypt",
        ):
            raise ValueError("不支持的安全策略和模式")
        if not server.app_uri:
            from cryptography import x509

            data = Path(certificate_path(server.cert_path)).read_bytes()
            cert = (
                x509.load_pem_x509_certificate(data)
                if b"-----BEGIN" in data
                else x509.load_der_x509_certificate(data)
            )
            try:
                uris = cert.extensions.get_extension_for_class(
                    x509.SubjectAlternativeName
                ).value.get_values_for_type(x509.UniformResourceIdentifier)
                if uris:
                    client.application_uri = uris[0]
            except x509.ExtensionNotFound:
                pass
        await client.set_security(
            SecurityPolicyBasic256Sha256,
            certificate=certificate_path(server.cert_path),
            private_key=certificate_path(server.key_path),
            server_certificate=certificate_path(server.server_cert_path),
            mode=getattr(ua.MessageSecurityMode, server.security_mode),
        )
    return client


async def is_condition(client, type_id, cache):
    from asyncua import ua

    visited = set()
    while type_id and type_id not in visited:
        if type_id in cache:
            result = cache[type_id]
            break
        visited.add(type_id)
        if type_id == "i=2782":
            result = True
            break
        parents = await client.get_node(type_id).get_references(
            refs=ua.ObjectIds.HasSubtype,
            direction=ua.BrowseDirection.Inverse,
        )
        type_id = parents[0].NodeId.to_string() if parents else None
    else:
        result = False
    for item in visited:
        cache[item] = result
    return result


def _local_nodeid(nodeid, namespaces):
    from asyncua import ua

    if getattr(nodeid, "ServerIndex", 0):
        return None
    namespace_index = nodeid.NamespaceIndex
    if getattr(nodeid, "NamespaceUri", None):
        namespace_index = namespaces.index(nodeid.NamespaceUri)
    return ua.NodeId(nodeid.Identifier, namespace_index, nodeid.NodeIdType)


async def _reference_entry(client, ref, namespaces, cache):
    from asyncua import ua

    nid = _local_nodeid(ref.NodeId, namespaces)
    if nid is None:
        return None
    raw = nid.to_string()
    stable = (
        f"nsu={namespaces[nid.NamespaceIndex]};{raw.split(';', 1)[-1]}"
        if nid.NamespaceIndex
        else raw
    )
    condition = False
    if ref.NodeClass == ua.NodeClass.Object:
        type_id = _local_nodeid(ref.TypeDefinition, namespaces)
        # Some servers omit TypeDefinition on alias/HasCondition references.
        # Resolve it before classifying the node so traversal order cannot
        # cause an otherwise discoverable condition to be missed.
        if type_id is not None and type_id.is_null():
            definition = await client.get_node(nid).read_type_definition()
            type_id = _local_nodeid(definition, namespaces) if definition is not None else None
        if type_id is not None and not type_id.is_null():
            condition = await is_condition(client, type_id.to_string(), cache)
    return dict(
        nodeid=raw,
        stable_nodeid=stable,
        title=ref.DisplayName.Text or ref.BrowseName.Name or raw,
        node_class=ref.NodeClass.name,
        is_condition=condition,
    )


async def _bounded_children(node, limit):
    from asyncua import ua

    description = ua.BrowseDescription()
    description.NodeId = node.nodeid
    description.BrowseDirection = ua.BrowseDirection.Forward
    description.ReferenceTypeId = ua.NodeId(ua.ObjectIds.HierarchicalReferences)
    description.IncludeSubtypes = True
    description.ResultMask = ua.BrowseResultMask.All
    parameters = ua.BrowseParameters()
    parameters.NodesToBrowse = [description]
    parameters.RequestedMaxReferencesPerNode = min(limit, 250)

    references = []
    continuation = None
    try:
        results = await node.session.browse(parameters)
        while results:
            result = results[0]
            continuation = result.ContinuationPoint
            result.StatusCode.check()
            remaining = limit - len(references)
            references.extend(result.References[:remaining])
            if len(result.References) > remaining or (continuation and len(references) == limit):
                return references, True
            if not continuation:
                return references, False
            next_page = ua.BrowseNextParameters()
            next_page.ContinuationPoints = [continuation]
            results = await node.session.browse_next(next_page)
        return references, False
    finally:
        if continuation:
            release = ua.BrowseNextParameters()
            release.ContinuationPoints = [continuation]
            release.ReleaseContinuationPoints = True
            await node.session.browse_next(release)


async def browse(server, nodeid, *, max_references=None):
    match = validate_nodeid(nodeid)
    client = await create_client(server)
    try:
        async with client:
            namespaces = await client.get_namespace_array()
            if match[2]:
                nodeid = f"ns={namespaces.index(match[2])};{match[3]}={match[4]}"
            node = client.get_node(nodeid)
            if max_references is None:
                refs = await node.get_children_descriptions()
                truncated = False
            else:
                refs, truncated = await _bounded_children(node, max_references)
            cache, items = {}, {}
            for ref in refs:
                entry = await _reference_entry(client, ref, namespaces, cache)
                if entry is not None:
                    items[entry["nodeid"]] = entry
            response = {"items": list(items.values())}
            if max_references is not None:
                response["truncated"] = truncated
            return response
    except asyncio.CancelledError:
        client.disconnect_socket()
        raise


async def browse_conditions(server):
    """Find all exposed conditions below Objects, or fail without partial results."""
    from asyncua import ua

    client = await create_client(server)
    async with client:
        namespaces = await client.get_namespace_array()
        pending = deque(["i=85"])
        visited = {"i=85"}
        cache, items = {}, {}
        while pending:
            node = client.get_node(pending.popleft())
            refs = await node.get_children_descriptions()
            # HasCondition is non-hierarchical and may be the only reference to
            # an exposed condition. HasNotifier/HasEventSource are hierarchical.
            refs += await node.get_children_descriptions(refs=ua.NodeId(ua.ObjectIds.HasCondition))
            for ref in refs:
                if ref.NodeClass not in (ua.NodeClass.Object, ua.NodeClass.Variable):
                    continue
                nid = _local_nodeid(ref.NodeId, namespaces)
                if nid is None:
                    continue
                raw = nid.to_string()
                if raw in visited:
                    continue
                if len(visited) >= MAX_CONDITION_SCAN_NODES:
                    raise ConditionScanLimitError("OPC UA condition scan node limit exceeded")
                visited.add(raw)
                pending.append(raw)
                entry = await _reference_entry(client, ref, namespaces, cache)
                if entry["is_condition"]:
                    items[raw] = entry
        return {"items": list(items.values())}
