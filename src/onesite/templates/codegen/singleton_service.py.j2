import logging
from sqlmodel.ext.asyncio.session import AsyncSession
from app.cruds import {{ model.module_name }} as crud
from app.schemas.{{ model.module_name }} import {{ model.name }}Update
from app.models.{{ model.source_module }} import {{ model.name }}
from app.core.model_hooks import ModelHookContext, invoke_model_hook, publish_model_background_hook, snapshot_model
{% if model.external_resource %}
from app.core.external_resources import enqueue_external_resource_change
{% endif %}

logger = logging.getLogger(__name__)

class {{ model.name }}Service:
    async def get(self, session: AsyncSession) -> {{ model.name }}:
        return await crud.get(session)

    async def update(self, session: AsyncSession, obj_in: {{ model.name }}Update) -> {{ model.name }}:
        db_obj = await crud.get(session)
        old = snapshot_model(db_obj)
        changes = obj_in.dict(exclude_unset=True)
        context = ModelHookContext(
            operation="update",
            input_data=dict(changes),
            changed_fields=frozenset(changes),
        )
        {% if model.external_resource %}
        try:
            obj = await crud.update(session, obj_in, auto_commit=False)
            await enqueue_external_resource_change(
                session,
                provider="{{ model.external_resource.provider }}",
                resource="{{ model.external_resource.resource }}",
                entity_id=str(getattr(obj, "{{ model.external_resource.get('identity_field', 'id') }}")),
                operation="update",
                payload=snapshot_model(obj),
                previous=old,
            )
            await session.commit()
            await session.refresh(obj)
        except Exception:
            await session.rollback()
            raise
        {% else %}
        obj = await crud.update(session, obj_in)
        {% endif %}
        try:
            await invoke_model_hook(
                obj,
                "on_after_commit_update",
                old=old,
                changes=changes,
                context=context,
            )
        except Exception:
            logger.exception("Post-commit update hook failed for {{ model.name }}")
        publish_model_background_hook(
            obj,
            "update",
            old=old,
            changes=changes,
            context=context,
        )
        return obj

service = {{ model.name }}Service()
