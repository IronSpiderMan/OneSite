import logging
from typing import Any
from sqlmodel.ext.asyncio.session import AsyncSession
from app.cruds import {{ model.module_name }} as crud
from app.schemas.{{ model.module_name }} import {{ model.name }}Update
from app.models.{{ model.source_module }} import {{ model.name }}
from app.core.model_hooks import ModelHookContext, invoke_model_hook, snapshot_model
from app.core.action_runtime import ReadContext, WriteContext, resolve_read_data, resolve_write_data{% if model.network_device %}, NetworkDeviceMetadata{% endif %}
from app.schemas.{{ model.module_name }} import {{ model.name }}Read

logger = logging.getLogger(__name__)

class {{ model.name }}Service:
    async def to_read(self, obj: {{ model.name }}, session: AsyncSession, *, current_user: Any = None, source: str = "singleton") -> {{ model.name }}Read:
        data = await resolve_read_data(
            obj, obj.model_dump(),
            ReadContext(session=session, current_user=current_user, source=source),
            {% if model.network_device %}
            network_device=NetworkDeviceMetadata(
                url_field={{ model.network_device.url_field | tojson }},
                status_field={{ model.network_device.status_field | tojson }},
                checker={% if model.network_device.checker %}{{ model.network_device.checker | tojson }}{% else %}None{% endif %},
                timeout={{ model.network_device.timeout }},
                udp_payload={{ model.network_device.udp_payload | tojson }},
            ),
            {% endif %}
        )
        return {{ model.name }}Read.model_validate(data)

    async def get(self, session: AsyncSession, *, current_user: Any = None) -> {{ model.name }}Read:
        return await self.to_read(await crud.get(session), session, current_user=current_user)

    async def update(self, session: AsyncSession, obj_in: {{ model.name }}Update, *, current_user: Any = None) -> {{ model.name }}Read:
        db_obj = await crud.get(session)
        old = snapshot_model(db_obj)
        changes = obj_in.dict(exclude_unset=True)
        {% set write_overrides = model.override_fields | default([]) | selectattr('write_handler', 'defined') | list %}
        {% if write_overrides %}
        changes = await resolve_write_data(
            db_obj, changes,
            WriteContext(session=session, current_user=current_user, operation="update"),
        )
        for key, value in changes.items():
            setattr(obj_in, key, value)
        {% endif %}
        context = ModelHookContext(
            operation="update",
            input_data=dict(changes),
            changed_fields=frozenset(changes),
        )
        obj = await crud.update(session, obj_in)
        try:
            await invoke_model_hook(
                obj,
                "on_after_commit_update",
                old=old,
                changes=changes,
                context=context,
            )
        except Exception:
            logger.exception("Post-commit update hook failed for {{ model.name }}")
        return await self.to_read(obj, session, current_user=current_user, source="update")

service = {{ model.name }}Service()
