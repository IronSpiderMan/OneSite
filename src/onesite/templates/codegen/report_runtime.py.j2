def get_model_report_catalog(*, report: dict[str, Any], role: str, model: str, title: str) -> dict[str, Any]:
    """Return only report fields readable by the current role."""
    if role not in report.get("permitted_roles", []):
        raise HTTPException(status_code=403, detail="Reports are not available for this role")

    def visible(items: list[dict[str, Any]]) -> list[dict[str, Any]]:
        return [
            {key: value for key, value in item.items() if key != "readable_roles"}
            for item in items
            if role in item.get("readable_roles", [])
        ]

    categories = report["categories"]
    inputs = {slot: visible(items) for slot, items in report["inputs"].items()}
    charts = []
    for key, spec in REPORT_CHARTS.items():
        if spec["category"] not in categories:
            continue
        if spec.get("requires_cls") and not inputs["cls"]:
            continue
        if spec["category"] == "composition" and (not inputs["cls"] or not inputs["count"]):
            continue
        if spec["category"] != "composition" and len(inputs["y"]) < spec.get("y_count", [1, 1])[0]:
            continue
        if spec["category"] != "composition" and not inputs["x"]:
            continue
        charts.append({"key": key, **spec})
    available_categories = [
        category for category in categories
        if any(chart["category"] == category for chart in charts)
    ]
    return {
        "model": model,
        "title": title,
        "categories": available_categories,
        "charts": charts,
        "inputs": inputs,
        "filters": visible(report.get("filters", [])),
        "limits": report["limits"],
    }


def _report_binding(value: Any, *, slot: str) -> dict[str, Any]:
    if not isinstance(value, dict) or not isinstance(value.get("field"), str):
        raise HTTPException(status_code=400, detail=f"Report input '{slot}' must select a field")
    return value


def _report_allowed(report: dict[str, Any], role: str, slot: str, field: str) -> dict[str, Any]:
    declaration = next(
        (
            item for item in report["inputs"].get(slot, [])
            if item["field"] == field and role in item.get("readable_roles", [])
        ),
        None,
    )
    if declaration is None:
        raise HTTPException(status_code=400, detail=f"Field '{field}' is not allowed for report input '{slot}'")
    return declaration


def _report_bin(column: Any, bin_name: str, dialect_name: str) -> Any:
    if bin_name == "none":
        return column
    if bin_name == "auto":
        bin_name = "day"
    if dialect_name == "postgresql":
        if bin_name in {"1m", "5m", "15m"}:
            seconds = {"1m": 60, "5m": 300, "15m": 900}[bin_name]
            epoch = func.extract("epoch", column)
            return func.to_timestamp(func.floor(epoch / seconds) * seconds)
        unit = {"hour": "hour", "day": "day", "week": "week", "month": "month"}[bin_name]
        return func.date_trunc(unit, column)
    if bin_name in {"1m", "5m", "15m"}:
        seconds = {"1m": 60, "5m": 300, "15m": 900}[bin_name]
        epoch = cast(func.strftime("%s", column), Integer)
        return func.datetime(func.floor(epoch / seconds) * seconds, "unixepoch")
    formats = {"hour": "%Y-%m-%d %H:00:00", "day": "%Y-%m-%d", "week": "%Y-%W", "month": "%Y-%m"}
    return func.strftime(formats[bin_name], column)


def _report_aggregate(column: Any, aggregation: str, dialect_name: str) -> Any:
    if aggregation == "sum":
        return func.sum(column)
    if aggregation == "avg":
        return func.avg(column)
    if aggregation == "min":
        return func.min(column)
    if aggregation == "max":
        return func.max(column)
    if aggregation == "count":
        return func.count(column)
    if aggregation == "distinct_count":
        return func.count(column.distinct())
    if aggregation == "median":
        if dialect_name != "postgresql":
            raise HTTPException(status_code=400, detail="Median aggregation currently requires PostgreSQL")
        return func.percentile_cont(0.5).within_group(column)
    raise HTTPException(status_code=400, detail=f"Unsupported report aggregation '{aggregation}'")


def _report_filters(
    source_model: type,
    report: dict[str, Any],
    role: str,
    raw_filters: Any,
) -> list[Any]:
    if raw_filters in (None, {}):
        return []
    if not isinstance(raw_filters, dict):
        raise HTTPException(status_code=400, detail="Report filters must be an object")
    allowed = {
        item["field"]: item for item in report.get("filters", [])
        if role in item.get("readable_roles", [])
    }

    def coerce(item: dict[str, Any], operand: Any) -> Any:
        if not isinstance(operand, str):
            return operand
        try:
            if item["data_type"] == "datetime":
                return datetime.fromisoformat(operand.replace("Z", "+00:00"))
            if item["data_type"] == "date":
                return date.fromisoformat(operand)
            if item["data_type"] == "int":
                return int(operand)
            if item["data_type"] == "float":
                return float(operand)
            if item["data_type"] == "bool":
                return operand.lower() in {"true", "1", "yes", "on"}
        except ValueError:
            raise HTTPException(status_code=400, detail=f"Invalid value for report filter '{item['field']}'")
        return operand

    expressions: list[Any] = []
    for field, value in raw_filters.items():
        if field not in allowed:
            raise HTTPException(status_code=400, detail=f"Report filter '{field}' is not allowed")
        column = getattr(source_model, field)
        declaration = allowed[field]
        if isinstance(value, dict):
            unsupported = set(value) - {"gte", "gt", "lte", "lt", "eq"}
            if unsupported:
                raise HTTPException(status_code=400, detail=f"Unsupported operators for report filter '{field}'")
            for operator, operand in value.items():
                operand = coerce(declaration, operand)
                expressions.append({
                    "gte": column >= operand,
                    "gt": column > operand,
                    "lte": column <= operand,
                    "lt": column < operand,
                    "eq": column == operand,
                }[operator])
        elif isinstance(value, list):
            expressions.append(column.in_([coerce(declaration, item) for item in value]))
        else:
            expressions.append(column == coerce(declaration, value))
    return expressions


async def query_model_report(
    session: AsyncSession,
    *,
    source_model: type,
    report: dict[str, Any],
    role: str,
    payload: Any,
    scope_filters: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Execute one allowlisted self-service report query."""
    if role not in report.get("permitted_roles", []):
        raise HTTPException(status_code=403, detail="Reports are not available for this role")
    data = payload.model_dump() if hasattr(payload, "model_dump") else dict(payload)
    category = data.get("category")
    chart = data.get("chart")
    spec = REPORT_CHARTS.get(chart)
    if category not in report["categories"] or not spec or spec["category"] != category:
        raise HTTPException(status_code=400, detail="Unsupported report category or chart")
    bindings = data.get("bindings")
    if not isinstance(bindings, dict):
        raise HTTPException(status_code=400, detail="Report bindings must be an object")

    dialect = getattr(getattr(session, "bind", None), "dialect", None)
    dialect_name = dialect.name if dialect else "sqlite"
    filters = [
        *_scope_expressions(source_model, scope_filters),
        *_report_filters(source_model, report, role, data.get("filters")),
    ]
    limit = min(max(int(data.get("limit") or report["limits"]["max_rows"]), 1), report["limits"]["max_rows"])

    if category == "composition":
        cls_binding = _report_binding(bindings.get("cls"), slot="cls")
        count_binding = _report_binding(bindings.get("count"), slot="count")
        _report_allowed(report, role, "cls", cls_binding["field"])
        _report_allowed(report, role, "count", count_binding["field"])
        cls_col = getattr(source_model, cls_binding["field"])
        value_expr = func.count() if count_binding["field"] == "$rows" else func.count(getattr(source_model, count_binding["field"]))
        limit = min(limit, report["limits"]["max_categories"])
        stmt = select(cls_col, value_expr).where(*filters).group_by(cls_col).order_by(value_expr.desc()).limit(limit + 1)
        result_rows = (await session.exec(stmt)).all()
        rows = [{"cls": row[0], "value": row[1]} for row in result_rows[:limit]]
        dimensions = [{"name": "cls", "type": "category"}, {"name": "value", "type": "number"}]
    else:
        x_binding = _report_binding(bindings.get("x"), slot="x")
        x_allowed = _report_allowed(report, role, "x", x_binding["field"])
        x_bin = str(x_binding.get("bin", "none"))
        if x_bin not in x_allowed.get("bins", []):
            raise HTTPException(status_code=400, detail=f"Bin '{x_bin}' is not allowed for '{x_binding['field']}'")
        x_expr = _report_bin(getattr(source_model, x_binding["field"]), x_bin, dialect_name)
        raw_y = bindings.get("y")
        y_bindings = raw_y if isinstance(raw_y, list) else [raw_y]
        y_bindings = [_report_binding(item, slot="y") for item in y_bindings]
        minimum, maximum = spec.get("y_count", [1, 1])
        if not minimum <= len(y_bindings) <= maximum:
            raise HTTPException(status_code=400, detail=f"Chart '{chart}' requires {minimum} to {maximum} Y inputs")
        if len({item["field"] for item in y_bindings}) != len(y_bindings):
            raise HTTPException(status_code=400, detail="Report Y inputs must use different fields")
        cls_binding = None
        cls_col = None
        if bindings.get("cls") is not None:
            cls_binding = _report_binding(bindings.get("cls"), slot="cls")
            _report_allowed(report, role, "cls", cls_binding["field"])
            cls_col = getattr(source_model, cls_binding["field"])
        if spec.get("requires_cls") and cls_col is None:
            raise HTTPException(status_code=400, detail=f"Chart '{chart}' requires input 'cls'")

        selections = [x_expr]
        if cls_col is not None:
            selections.append(cls_col)
        y_meta = []
        raw_mode = category == "scatter"
        for binding in y_bindings:
            allowed = _report_allowed(report, role, "y", binding["field"])
            aggregation = "raw" if raw_mode else str(binding.get("aggregation", "raw"))
            if aggregation not in allowed.get("aggregations", []):
                raise HTTPException(status_code=400, detail=f"Aggregation '{aggregation}' is not allowed for '{binding['field']}'")
            column = getattr(source_model, binding["field"])
            selections.append(column if aggregation == "raw" else _report_aggregate(column, aggregation, dialect_name))
            y_meta.append({"field": binding["field"], "aggregation": aggregation})
        aggregate_mode = any(item["aggregation"] != "raw" for item in y_meta)
        if aggregate_mode and any(item["aggregation"] == "raw" for item in y_meta):
            raise HTTPException(status_code=400, detail="Raw and aggregated Y inputs cannot be mixed")
        if x_bin != "none" and not aggregate_mode:
            raise HTTPException(status_code=400, detail="A binned X input requires aggregated Y inputs")
        if category == "scatter" and any(item["data_type"] not in {"int", "float"} for item in [x_allowed, *[_report_allowed(report, role, "y", item["field"]) for item in y_bindings]]):
            raise HTTPException(status_code=400, detail="Scatter X and Y inputs must be numeric")

        stmt = select(*selections).where(*filters)
        if aggregate_mode:
            groups = [x_expr] + ([cls_col] if cls_col is not None else [])
            stmt = stmt.group_by(*groups)
        stmt = stmt.order_by(x_expr).limit(limit + 1)
        result_rows = (await session.exec(stmt)).all()
        if cls_col is not None and len({str(row[1]) for row in result_rows}) > report["limits"]["max_series"]:
            raise HTTPException(status_code=400, detail="Report produces too many series; narrow the filters")
        rows = []
        for row in result_rows[:limit]:
            offset = 1
            item = {"x": _plain(row[0])}
            if cls_col is not None:
                item["cls"] = _plain(row[1])
                offset = 2
            for index, meta in enumerate(y_meta):
                value = row[offset + index]
                item["y" if len(y_meta) == 1 else f"y{index + 1}"] = _plain(value)
                if len(y_meta) > 1:
                    item[f"y{index + 1}_label"] = meta["field"]
            rows.append(item)
        dimensions = [{"name": "x", "type": x_allowed["data_type"]}]
        if cls_col is not None:
            dimensions.append({"name": "cls", "type": "category"})
        dimensions.extend({"name": "y" if len(y_meta) == 1 else f"y{index + 1}", "type": "number", "label": meta["field"]} for index, meta in enumerate(y_meta))

    return {
        "category": category,
        "chart": chart,
        "dimensions": dimensions,
        "rows": rows,
        "meta": {"truncated": len(result_rows) > limit, "limit": limit, "timezone": "UTC"},
    }


_BUCKET_SECONDS = {
    "1m": 60,
    "5m": 300,
    "15m": 900,
    "1h": 3600,
    "6h": 21600,
    "1d": 86400,
    "1w": 604800,
}
_POSTGRES_INTERVALS = {
    "1m": "1 minute",
    "5m": "5 minutes",
    "15m": "15 minutes",
    "1h": "1 hour",
    "6h": "6 hours",
    "1d": "1 day",
    "1w": "1 week",
}


def _plain(value: Any) -> Any:
    if isinstance(value, Enum):
        return value.value
    return value


def _as_dict(value: Any) -> dict[str, Any]:
    if isinstance(value, dict):
        return value
    if hasattr(value, "model_dump"):
        return value.model_dump()
    return {}


def _metric_option(metric_id: Any, raw: Any = None) -> dict[str, Any]:
    data = _as_dict(raw)
    data_type = _plain(data.get("data_type", "number"))
    if data_type in {"float", "int"}:
        data_type = "number"
    return {
        "id": metric_id,
        "label": data.get("display_name") or str(metric_id),
        "data_type": data_type or "number",
        "unit": data.get("unit"),
        "icon": data.get("icon"),
        "enum_values": [_plain(item) for item in (data.get("enum_values") or [])],
        "min": data.get("min_value"),
        "max": data.get("max_value"),
    }


def _scope_expressions(model: type, scope_filters: dict[str, Any] | None) -> list[Any]:
    return [
        getattr(model, field) == value
        for field, value in (scope_filters or {}).items()
        if value is not None and hasattr(model, field)
    ]


async def get_report_options(
    session: AsyncSession,
    *,
    source_model: type,
    report: dict[str, Any],
    entity_model: type | None = None,
    entity_id_field: str = "id",
    entity_label_field: str = "id",
    blueprint_model: type | None = None,
    entity_blueprint_field: str | None = None,
    blueprint_id_field: str = "id",
    blueprint_properties_field: str = "properties",
    entity_properties_field: str | None = None,
    scope_filters: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Return generic dimension/measure metadata without scanning history when possible."""
    entity_col = getattr(source_model, report["entity_field"])
    metric_col = getattr(source_model, report["metric_field"])
    entities: list[dict[str, Any]] = []
    metrics_by_id: dict[str, dict[str, Any]] = {}
    metric_entities: dict[str, list[Any]] = {}
    scope = _scope_expressions(source_model, scope_filters)
    allowed_entity_ids: set[Any] | None = None
    if scope:
        allowed_entity_ids = set((await session.exec(select(entity_col).distinct().where(*scope))).all())

    if entity_model is not None:
        entity_id_col = getattr(entity_model, entity_id_field)
        entity_stmt = select(entity_model).order_by(entity_id_col).limit(5000)
        if allowed_entity_ids is not None:
            entity_stmt = entity_stmt.where(entity_id_col.in_(allowed_entity_ids))
        entity_rows = (await session.exec(entity_stmt)).all()
        blueprints: dict[Any, Any] = {}
        if blueprint_model is not None and entity_blueprint_field:
            blueprint_rows = (await session.exec(select(blueprint_model))).all()
            blueprints = {
                getattr(item, blueprint_id_field): item for item in blueprint_rows
            }

        for entity in entity_rows:
            entity_id = getattr(entity, entity_id_field)
            label = getattr(entity, entity_label_field, entity_id)
            entities.append({"id": entity_id, "label": str(label)})
            definitions: dict[str, Any] = {}
            if blueprints and entity_blueprint_field:
                blueprint = blueprints.get(getattr(entity, entity_blueprint_field, None))
                if blueprint is not None:
                    definitions = _as_dict(
                        getattr(blueprint, blueprint_properties_field, {})
                    )
            configured = _as_dict(
                getattr(entity, entity_properties_field, {})
                if entity_properties_field else {}
            )
            metric_ids = list(configured) if configured else list(definitions)
            for metric_id in metric_ids:
                config = _as_dict(configured.get(metric_id))
                if config.get("enabled") is False:
                    continue
                key = str(metric_id)
                metrics_by_id.setdefault(key, _metric_option(metric_id, definitions.get(metric_id)))
                metric_entities.setdefault(key, []).append(entity_id)

    # Generic fallback for time-series models without an entity/model catalogue.
    if not entities or not metrics_by_id:
        observed_stmt = select(entity_col, metric_col).distinct().order_by(entity_col, metric_col).limit(10000)
        if scope:
            observed_stmt = observed_stmt.where(*scope)
        observed = (await session.exec(observed_stmt)).all()
        entity_ids: dict[str, Any] = {}
        for entity_id, metric_id in observed:
            entity_ids.setdefault(str(entity_id), entity_id)
            key = str(metric_id)
            metrics_by_id.setdefault(key, _metric_option(metric_id))
            metric_entities.setdefault(key, []).append(entity_id)
        if not entities:
            entities = [
                {"id": value, "label": str(value)} for value in entity_ids.values()
            ]

    public_report = {
        "key": report["key"],
        "title": report["title"],
        "buckets": report["buckets"],
        "aggregations": report["aggregations"],
        "views": report.get("views", ["auto"]),
        "default_range": report.get("default_range", "24h"),
    }
    return {
        "report": public_report,
        "dimensions": [
            {"key": "entity_id", "label": report.get("entity_label", "Entity"), "data_type": "category"},
            {"key": "time", "label": report.get("time_label", "Time"), "data_type": "datetime"},
        ],
        "measures": list(metrics_by_id.values()),
        # Compatibility aliases keep generated clients from breaking while the
        # report contract moves to dimensions/measures terminology.
        "entities": entities,
        "metrics": list(metrics_by_id.values()),
        "metric_entities": metric_entities,
    }


def _resolve_bucket(bucket: str, start: datetime, end: datetime, target_points: int) -> str:
    if bucket != "auto":
        return bucket
    seconds_per_point = max((end - start).total_seconds() / max(target_points, 1), 1)
    return next(
        (name for name, seconds in _BUCKET_SECONDS.items() if seconds >= seconds_per_point),
        "1w",
    )


async def query_report(
    session: AsyncSession,
    *,
    source_model: type,
    report: dict[str, Any],
    payload: Any,
    scope_filters: dict[str, Any] | None = None,
) -> dict[str, Any]:
    data = payload.model_dump() if hasattr(payload, "model_dump") else dict(payload)
    entity_ids = data.get("entity_ids") or []
    metric_ids = data.get("metric_ids") or []
    if not entity_ids or not metric_ids:
        raise HTTPException(status_code=400, detail="At least one entity and metric are required")
    if len(entity_ids) > 50 or len(metric_ids) > 100:
        raise HTTPException(status_code=400, detail="Too many entities or metrics")

    start_value = data.get("start_time")
    end_value = data.get("end_time")
    try:
        start = to_utc(start_value if isinstance(start_value, datetime) else datetime.fromisoformat(str(start_value).replace("Z", "+00:00")))
        end = to_utc(end_value if isinstance(end_value, datetime) else datetime.fromisoformat(str(end_value).replace("Z", "+00:00")))
    except (TypeError, ValueError):
        raise HTTPException(status_code=400, detail="Valid start_time and end_time are required")
    if end <= start:
        raise HTTPException(status_code=400, detail="end_time must be after start_time")
    if end - start > timedelta(days=report["max_span_days"]):
        raise HTTPException(status_code=400, detail="Report time range is too large")

    requested_bucket = str(data.get("bucket", "auto"))
    if requested_bucket not in report["buckets"]:
        raise HTTPException(status_code=400, detail="Unsupported report bucket")
    aggregation = str(data.get("aggregation", "avg"))
    if aggregation not in report["aggregations"]:
        raise HTTPException(status_code=400, detail="Unsupported report aggregation")
    target_points = min(max(int(data.get("target_points", 1000)), 100), 5000)
    bucket = _resolve_bucket(requested_bucket, start, end, target_points)
    limit = min(max(int(data.get("limit", 5000)), 1), 10000)

    entity_col = getattr(source_model, report["entity_field"])
    metric_col = getattr(source_model, report["metric_field"])
    time_col = getattr(source_model, report["time_field"])
    value_col = getattr(source_model, report["value_field"])
    try:
        entity_type = entity_col.type.python_type
        entity_ids = [entity_type(value) for value in entity_ids]
    except (AttributeError, LookupError, NotImplementedError, TypeError, ValueError):
        pass
    try:
        metric_type = metric_col.type.python_type
        metric_ids = [metric_type(value) for value in metric_ids]
    except (AttributeError, LookupError, NotImplementedError, TypeError, ValueError):
        pass

    dialect = getattr(getattr(session, "bind", None), "dialect", None)
    dialect_name = dialect.name if dialect else "sqlite"
    if dialect_name == "postgresql":
        json_value = value_col[report["value_path"]].as_string()
        numeric_value = cast(json_value, Float)
        numeric_guard = func.json_typeof(value_col[report["value_path"]]) == "number"
    else:
        json_value = func.json_extract(value_col, f'$.{report["value_path"]}')
        numeric_value = cast(json_value, Float)
        numeric_guard = func.json_type(value_col, f'$.{report["value_path"]}').in_(["integer", "real"])

    filters = [
        time_col >= start,
        time_col < end,
        entity_col.in_(entity_ids),
        metric_col.in_(metric_ids),
        *_scope_expressions(source_model, scope_filters),
    ]
    if bucket == "raw":
        stmt = (
            select(entity_col, metric_col, time_col, json_value)
            .where(*filters)
            .order_by(time_col)
            .limit(limit + 1)
        )
        result_rows = (await session.exec(stmt)).all()
        truncated = len(result_rows) > limit
        result_rows = result_rows[:limit]
        rows = [
            {"entity_id": row[0], "metric_id": row[1], "time": row[2], "value": row[3]}
            for row in result_rows
        ]
        return {
            "mode": "raw",
            "rows": rows,
            "meta": {"bucket": "raw", "requested_bucket": requested_bucket, "truncated": truncated, "limit": limit, "timezone": "UTC"},
        }

    if aggregation != "count":
        filters.append(numeric_guard)
    if dialect_name == "postgresql":
        bucket_expr = func.time_bucket(text(f"INTERVAL '{_POSTGRES_INTERVALS[bucket]}'"), time_col)
    else:
        seconds = _BUCKET_SECONDS[bucket]
        epoch = cast(func.strftime("%s", time_col), Integer)
        bucket_expr = func.datetime(func.floor(epoch / seconds) * seconds, "unixepoch")
    aggregate_expr = {
        "avg": func.avg(numeric_value),
        "min": func.min(numeric_value),
        "max": func.max(numeric_value),
        "sum": func.sum(numeric_value),
        "count": func.count(json_value),
    }[aggregation]
    stmt = (
        select(entity_col, metric_col, bucket_expr, aggregate_expr)
        .where(*filters)
        .group_by(entity_col, metric_col, bucket_expr)
        .order_by(bucket_expr)
        .limit(limit + 1)
    )
    result_rows = (await session.exec(stmt)).all()
    truncated = len(result_rows) > limit
    result_rows = result_rows[:limit]
    rows = [
        {"entity_id": row[0], "metric_id": row[1], "time": row[2], "value": float(row[3]) if row[3] is not None else None}
        for row in result_rows
    ]
    return {
        "mode": "aggregate",
        "rows": rows,
        "meta": {"bucket": bucket, "requested_bucket": requested_bucket, "truncated": truncated, "limit": limit, "timezone": "UTC"},
    }
