{% include "common/index.css.j2" %}

@layer components {
  [data-codegen-theme="anime"]::before {
    content: "";
    display: block;
    width: 5rem;
    height: 0.3rem;
    margin-bottom: 1rem;
    border-radius: 9999px;
    background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--accent)));
  }
  [data-codegen-theme="anime"] [data-ui="card"] {
    border-radius: 1.5rem;
    box-shadow: 0 18px 45px -24px hsl(var(--primary) / 0.55);
  }
}
