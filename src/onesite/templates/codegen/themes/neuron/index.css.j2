{% include "common/index.css.j2" %}

@layer components {
  [data-codegen-theme="neuron"] > div:first-of-type {
    border-bottom: 1px solid hsl(var(--primary) / 0.45);
    padding-bottom: 0.75rem;
  }
  [data-codegen-theme="neuron"] [data-ui="card"] {
    border-radius: 0.125rem;
    background-image: linear-gradient(135deg, hsl(var(--primary) / 0.025), transparent 45%);
  }
  [data-codegen-theme="neuron"] [data-page-region="detail-grid"] {
    align-items: start;
  }
}
