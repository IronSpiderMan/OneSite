{% include "common/index.css.j2" %}

@layer components {
  [data-codegen-theme="cute"] > div:first-of-type {
    padding: 1rem 1.25rem;
    border: 1px solid hsl(var(--primary) / 0.2);
    border-radius: 2rem;
    background: hsl(var(--card) / 0.78);
  }
  [data-codegen-theme="cute"] [data-ui="card"] {
    border-radius: 2rem;
    box-shadow: 0 18px 45px -28px hsl(var(--primary) / 0.6);
  }
}
