                                                    {% else %}
                                                    {typeof item.{{ field.name }} === 'object' ? JSON.stringify(item.{{ field.name }}) : String(item.{{ field.name }} ?? '-')}
                                                    {% endif %}
                                                </TableCell>
                                                {% endif %}
                                                {% endfor %}
                                                <TableCell className="sticky right-0 z-10 bg-card shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.08)]">
                                                    <div className="flex items-center gap-2">
                                                    {% for action_name, action_config in rfk.actions.items() %}
                                                    {(() => {
                                                        const actionPerms = {{ action_config.get("permissions", "da") | tojson }};
                                                        if (!actionPerms.includes(userRole[0])) return false;
                                                        {% if action_config.get("dynamic_availability") %}
                                                        const state = {{ rfk.name }}ActionStates[String(item.id)]?.[{{ action_name | tojson }}];
                                                        return Boolean(state?.visible);
                                                        {% else %}
                                                        const cond = {{ action_config.get("condition", None) | tojson }} as any;
                                                        if (!cond) return true;
                                                        const actual = (item as any)[cond.field];
                                                        const expected = cond.value;
                                                        if (cond.op === 'eq') return actual === expected;
                                                        if (cond.op === 'ne') return actual !== expected;
                                                        if (cond.op === 'in') return Array.isArray(expected) && expected.includes(actual);
                                                        if (cond.op === 'not_in') return !Array.isArray(expected) || !expected.includes(actual);
                                                        if (cond.op === 'gt') return actual > expected;
                                                        if (cond.op === 'gte') return actual >= expected;
                                                        if (cond.op === 'lt') return actual < expected;
                                                        if (cond.op === 'lte') return actual <= expected;
                                                        if (cond.op === 'contains') return actual?.includes(expected);
                                                        if (cond.op === 'startswith') return String(actual).startsWith(String(expected));
                                                        if (cond.op === 'endswith') return String(actual).endsWith(String(expected));
                                                        if (cond.op === 'is_null') return actual === null || actual === undefined;
                                                        if (cond.op === 'is_not_null') return actual !== null && actual !== undefined;
                                                        return true;
                                                        {% endif %}
                                                    })() && (
                                                    <Button
                                                        variant={% if action_config.get("toggle") %}{(item as any)[{{ action_config.get("toggle") | tojson }}] ? "destructive" : "default"}{% else %}"outline"{% endif %}
