                        {% if ts.metric_field %}
                        <div className="mb-3 flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
                            <div className="relative w-full sm:max-w-xs">
                                <Search className="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                                <Input value={ {{ ts.model_name }}RealtimeSearch } onChange={(event) => set{{ ts.model_name }}RealtimeSearch(event.target.value)} placeholder={t('common.search', 'Search point')} className="h-8 pl-8" />
                            </div>
                            <div className="flex flex-wrap items-center gap-2 lg:justify-end">
                                <span className="text-xs text-muted-foreground">{t('common.time_range', 'Time range')}:</span>
                                {['latest100', '1h', '6h', '24h', 'custom'].map(range => (
                                    <Button key={range} variant={ {{ ts.model_name }}TimeRange === range ? 'default' : 'outline' } size="sm" className="h-8 px-2.5 text-xs" onClick={() => set{{ ts.model_name }}TimeRange(range)}>
                                        {range === 'latest100' ? t('common.last_100', 'Last 100') : range === 'custom' ? t('common.custom', 'Custom') : range}
                                    </Button>
                                ))}
                                <span className="text-xs text-muted-foreground tabular-nums">{ {{ ts.model_name }}FilteredRealtime.length } / { {{ ts.model_name }}Realtime.length }</span>
