{% macro detail_read_field(field) -%}
hasFieldPerm('{{ field.name }}', 'r'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
<div className="space-y-1">
    <Label className="text-muted-foreground">{t('{{ field.label_key }}')}</Label>
    <div className="font-medium">
        {% if field.fk_info %}
        <span className="block max-w-[250px] truncate" title={String(currentItem.{{ field.name }}_label ?? currentItem.{{ field.name }} ?? '-')}>
            {String(currentItem.{{ field.name }}_label ?? currentItem.{{ field.name }} ?? '-')}
        </span>
        {% elif field.ui_type == 'bool' %}
        <Badge variant={currentItem.{{ field.name }} ? "default" : "secondary"}>
            {currentItem.{{ field.name }} ? 'Yes' : 'No'}
        </Badge>
        {% elif field.is_enum and field.is_multi_select %}
        <div className="flex flex-wrap gap-1">
        {Array.isArray(currentItem.{{ field.name }}) && currentItem.{{ field.name }}.map((v: string) => (
            <Badge key={v} variant="default" className="px-2.5 py-0.5 text-xs font-medium shadow-sm whitespace-nowrap">{String(t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v))}</Badge>
        ))}
        </div>
        {% elif field.is_enum %}
        {currentItem.{{ field.name }} != null ? (
            <Badge variant="default" className="px-2.5 py-0.5 text-xs font-medium shadow-sm whitespace-nowrap">{String(t(`models.{{ model.module_name }}.enums.{{ field.name }}.${currentItem.{{ field.name }}}`, currentItem.{{ field.name }}))}</Badge>
        ) : '-'}
        {% elif field.ui_type == 'image' %}
        {currentItem.{{ field.name }} ? (
            <div className="relative aspect-video w-full max-w-sm overflow-hidden rounded-lg border bg-muted">
                <img src={currentItem.{{ field.name }}} alt="{{ field.name }}" className="h-full w-full object-cover" />
            </div>
        ) : <span className="text-muted-foreground italic">No image</span>}
        {% elif field.ui_type == 'images' %}
        {Array.isArray(currentItem.{{ field.name }}) && currentItem.{{ field.name }}.length ? (
            <div className="grid grid-cols-2 gap-3 sm:grid-cols-3">
                {currentItem.{{ field.name }}.map((url: string, index: number) => (
                    <div key={`${url}-${index}`} className="aspect-video overflow-hidden rounded-lg border bg-muted">
                        <img src={url} alt={`{{ field.name }} ${index + 1}`} className="h-full w-full object-cover" />
                    </div>
                ))}
            </div>
        ) : <span className="text-muted-foreground italic">No images</span>}
        {% elif field.ui_type == 'file' %}
        {currentItem.{{ field.name }} ? (
            <FileUpload value={currentItem.{{ field.name }}} onChange={() => {}} readOnly={true} allowDownload={ {{ "true" if field.allow_download else "false" }} } />
        ) : <span className="text-muted-foreground italic">No file</span>}
        {% elif field.ui_type == 'video_stream' %}
        {currentItem.{{ field.name }} ? (
            <VideoStreamPlayer src={currentItem.{{ field.name }}} protocol="{{ field.stream_protocol }}" autoPlay={ {{ "true" if field.stream_autoplay else "false" }} } muted={ {{ "true" if field.stream_muted else "false" }} } controls={ {{ "true" if field.stream_controls else "false" }} } reconnect={ {{ "true" if field.stream_reconnect else "false" }} } className="max-w-3xl" />
        ) : <span className="text-muted-foreground italic">{t('video_stream.empty')}</span>}
        {% elif field.ui_type == 'location' %}
        <span className="text-muted-foreground">
            {currentItem.{{ field.name }}?.latitude != null && currentItem.{{ field.name }}?.longitude != null ? `${currentItem.{{ field.name }}.latitude}, ${currentItem.{{ field.name }}.longitude}` : '-'}
        </span>
        {% elif field.ui_type == 'json' and field.json_model_schema %}
        <JsonModelDetail schema={ {{ field.json_model_schema | tojson }} }
            value={currentItem.{{ field.name }}}
            rootValue={currentItem}
            className="max-h-80 overflow-auto overscroll-contain rounded-md border bg-muted/20 p-3"
        />
        {% elif field.ui_type == 'json' %}
        <pre className="max-h-80 overflow-auto overscroll-contain whitespace-pre-wrap break-words rounded-md border bg-muted/40 p-2 text-sm">
            {currentItem.{{ field.name }} !== undefined && currentItem.{{ field.name }} !== null ? JSON.stringify(currentItem.{{ field.name }}, null, 2) : '-'}
        </pre>
        {% elif field.ui_type == 'datetime' %}
        <span className="text-muted-foreground">{formatDateTime(currentItem.{{ field.name }}, timeZone)}</span>
        {% elif field.ui_type == 'time' %}
