                                                {% if ts.metric_field %}
                                                <TableCell className="font-medium">{row.{{ ts.metric_field }}}</TableCell>
                                                {% endif %}
                                                <TableCell>{(() => { const v = row.value?.value; return v !== null && v !== undefined ? (typeof v === 'object' ? JSON.stringify(v) : String(v)) : '-'; })()}</TableCell>
                                                <TableCell className="text-muted-foreground">{formatDateTime(row.{{ ts.time_field }}, timeZone)}</TableCell>
                                            </TableRow>
                                        ))
                                    ) : (
                                        <TableRow>
                                            <TableCell colSpan={ {{ 3 if ts.metric_field else 2 }} } className="h-24 text-center text-muted-foreground">
                                                No realtime data.
                                            </TableCell>
                                        </TableRow>
                                    )}
                                </TableBody>
                            </Table>
                        </div>
                        {% endif %}
                    </CardContent>
                </Card>

                {% if not ts.metric_field %}
                {/* Timeseries History */}
                <Card className="col-span-full">
                    <CardHeader className="pb-3">
                        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                            <div className="flex min-w-0 items-center gap-2">
