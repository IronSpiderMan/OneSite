                                        if (typeof rawValue === 'object') return JSON.stringify(rawValue);
                                        if (typeof rawValue === 'number') {
                                            if (meta.data_type === 'float' && meta.decimals != null) return rawValue.toFixed(meta.decimals);
                                            return new Intl.NumberFormat(undefined, { maximumFractionDigits: 6 }).format(rawValue);
                                        }
                                        return String(rawValue);
                                    })();
                                    return (
                                        <div key={metric ?? idx} className="group min-w-0 overflow-hidden rounded-xl border bg-gradient-to-br from-card to-muted/20 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">
                                            <div className="px-3 pt-3">
                                                <div className="flex min-w-0 items-center gap-2">
                                                    <span className="h-2 w-2 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.65)]" />
                                                    {meta.icon && <span className="shrink-0 text-sm">{meta.icon}</span>}
                                                    <span className="truncate text-sm font-medium text-muted-foreground" title={meta.display_name || metric}>{meta.display_name || metric}</span>
                                                </div>
                                                <div className={ {{ ts.model_name }}RealtimeDensity === 'compact' ? 'mt-2 flex min-w-0 items-baseline gap-2' : 'mt-3 flex min-w-0 items-baseline gap-2' }>
                                                    <span className={ {{ ts.model_name }}RealtimeDensity === 'compact' ? 'truncate text-2xl font-semibold tracking-tight tabular-nums' : 'truncate text-3xl font-semibold tracking-tight tabular-nums' } title={displayValue}>{displayValue}</span>
                                                    {meta.unit && <span className="shrink-0 text-sm font-medium text-muted-foreground">{meta.unit}</span>}
                                                </div>
                                            </div>
                                            <div className={ {{ ts.model_name }}RealtimeDensity === 'compact' ? 'mt-1 h-14 w-full px-1' : 'mt-2 h-20 w-full px-1' }>
