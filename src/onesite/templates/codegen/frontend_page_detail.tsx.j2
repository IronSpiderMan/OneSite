                                                            try {
                                                                await perform{{ rfk.source_model }}{{ action_name.capitalize() }}(item.id);
                                                                toast.success(t('common.success'));
                                                                await fetch{{ rfk.source_model }}s({% if 'str' in model.id_type %}id!{% else %}parseInt(id!){% endif %}, {{ rfk.name }}Page, {{ rfk.name }}Size);
                                                            } catch (error) {
                                                                toast.error(t('common.error'));
                                                            }
                                                        }}
                                                    >
                                                        {% if action_config.get("toggle") %}
                                                        {(item as any)[{{ action_config.get("toggle") | tojson }}] ? t('common.disable', 'Disable') : t('common.enable', 'Enable')}
                                                        {% else %}
                                                        {% if action_config.get("dynamic_availability") %}
                                                        { {{ rfk.name }}ActionStates[String(item.id)]?.[{{ action_name | tojson }}]?.label || {{ (action_config.get("label") or action_name) | tojson }} }
                                                        {% else %}
                                                        { {{ (action_config.get("label") or action_name) | tojson }} }
                                                        {% endif %}
                                                        {% endif %}
                                                    </Button>
                                                    )}
                                                    {% endfor %}
                                                    {( {{ rfk.role_permissions | tojson }}[userRole] || '').includes('r') && {{ rfk.standalone | tojson }} && (
                                                    <Button title={t('common.details')} variant="ghost" size="icon" onClick={() => navigate(`/{{ rfk.source_service }}s/${item.id}`)}>
                                                        <Eye className="h-4 w-4" />
                                                    </Button>
                                                    )}
                                                    {( {{ rfk.role_permissions | tojson }}[userRole] || '').includes('u') && {{ rfk.standalone | tojson }} && (
                                                    <Button title={t('common.edit')} variant="ghost" size="icon" onClick={() => navigate({% if rfk.page_edit %}`/{{ rfk.source_service }}s/${item.id}?edit=true`{% else %}`/{{ rfk.source_service }}s?edit=${item.id}`{% endif %})}>
                                                        <Pencil className="h-4 w-4" />
                                                    </Button>
                                                    )}
                                                    {( {{ rfk.role_permissions | tojson }}[userRole] || '').includes('d') && (
                                                    <Button
                                                        title={t('common.delete')}
                                                        variant="ghost"
                                                        size="icon"
                                                        className="text-destructive"
                                                        onClick={async () => {
                                                            if (!window.confirm(t('common.confirm_delete'))) return;
                                                            try {
                                                                await delete{{ rfk.source_model }}(item.id);
                                                                toast.success(t('toast.delete_success'));
                                                                await fetch{{ rfk.source_model }}s({% if 'str' in model.id_type %}id!{% else %}parseInt(id!){% endif %}, {{ rfk.name }}Page, {{ rfk.name }}Size);
                                                            } catch (error: any) {
                                                                toast.error(error?.response?.data?.detail || t('toast.delete_failed'));
                                                            }
                                                        }}
                                                    >
                                                        <Trash2 className="h-4 w-4" />
                                                    </Button>
                                                    )}
                                                    </div>
                                                </TableCell>
                                            </TableRow>
                                        ))
