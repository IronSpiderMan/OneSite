                                                    <ResponsiveContainer width="100%" height="100%">
                                                        <AreaChart data={trendData} margin={{"{{"}} top: 4, right: 2, bottom: 0, left: 2 {{"}}"}}>
                                                            <XAxis dataKey="time" hide />
                                                            <Tooltip
                                                                cursor={{"{{"}} stroke: '#10b981', strokeOpacity: 0.25 {{"}}"}}
                                                                content={(tooltipProps: any) => {
                                                                    const point = tooltipProps.payload?.[0]?.payload as { time: number; value: number } | undefined;
                                                                    if (!tooltipProps.active || !point) return null;
                                                                    const pointValue = meta.decimals != null ? Number(point.value).toFixed(meta.decimals) : new Intl.NumberFormat(undefined, { maximumFractionDigits: 6 }).format(point.value);
                                                                    return (
                                                                        <div className="max-w-40 rounded-md border bg-popover/95 px-2 py-1.5 text-popover-foreground shadow-lg backdrop-blur-sm">
                                                                            <div className="truncate text-xs font-semibold tabular-nums">{pointValue}{meta.unit ? ` ${meta.unit}` : ''}</div>
                                                                            <div className="mt-0.5 whitespace-nowrap text-[10px] text-muted-foreground tabular-nums">{formatDateTime(new Date(point.time).toISOString(), timeZone)}</div>
                                                                        </div>
                                                                    );
                                                                } }
                                                            />
                                                            <Area type="monotone" dataKey="value" stroke="#10b981" strokeWidth={2} fill="#10b981" fillOpacity={0.12} dot={false} activeDot={{"{{"}} r: 3 {{"}}"}} isAnimationActive={false} />
                                                        </AreaChart>
                                                    </ResponsiveContainer>
                                                ) : stateData.length > 0 ? (
                                                    <div className="flex h-full items-end gap-px overflow-hidden pb-2">
                                                        {stateData.slice(-40).map((entry: any, stateIndex: number) => {
                                                            const value = typeof entry.value === 'object' ? JSON.stringify(entry.value) : String(entry.value);
                                                            const tone = value.split('').reduce((sum, char) => sum + char.charCodeAt(0), 0) % 5;
                                                            return <span key={`${entry.time}-${stateIndex}`} className="min-w-px flex-1 rounded-t-sm bg-emerald-500" style={{"{{"}} height: `${30 + tone * 12}%`, opacity: 0.35 + tone * 0.12 {{"}}"}} title={`${value} — ${formatDateTime(new Date(entry.time).toISOString(), timeZone)}`} />;
                                                        })}
                                                    </div>
                                                ) : (
                                                    <div className="flex h-full items-end pb-3"><span className="h-px w-full bg-emerald-500/20" /></div>
                                                )}
                                            </div>
                                            <div className="flex items-center gap-1.5 border-t bg-muted/20 px-3 py-2 text-[11px] text-muted-foreground tabular-nums" title={formatDateTime(row.{{ ts.time_field }}, timeZone)}>
                                                <Clock className="h-3.5 w-3.5 shrink-0" />
                                                <span className="truncate">{formatDateTime(row.{{ ts.time_field }}, timeZone)}</span>
                                            </div>
                                        </div>
                                    );
                                })
                            ) : (
                                <div className="col-span-full flex h-24 items-center justify-center text-sm text-muted-foreground">
                                    { {{ ts.model_name }}Realtime.length > 0 ? t('common.no_matching_point', 'No matching point') : t('common.no_realtime_data', 'No realtime data')}
                                </div>
                            )}
                        </div>
                        {% else %}
                        {# Fallback table display when no metric_field #}
                        <div className="rounded-md border overflow-x-auto">
                            <Table>
                                <TableHeader>
                                    <TableRow>
                                        <TableHead>Value</TableHead>
                                        <TableHead>{{ ts.time_field.replace('_', ' ')|title }}</TableHead>
                                    </TableRow>
                                </TableHeader>
                                <TableBody>
                                    { {{ ts.model_name }}Realtime.length > 0 ? (
                                        {{ ts.model_name }}Realtime.map((row, idx) => (
                                            <TableRow key={idx}>
                                                <TableCell>{(() => { const v = row.value?.value; return v !== null && v !== undefined ? (typeof v === 'object' ? JSON.stringify(v) : String(v)) : '-'; })()}</TableCell>
                                                <TableCell className="text-muted-foreground">{formatDateTime(row.{{ ts.time_field }}, timeZone)}</TableCell>
                                            </TableRow>
                                        ))
                                    ) : (
                                        <TableRow>
                                            <TableCell colSpan={2} className="h-24 text-center text-muted-foreground">
                                                No realtime data.
                                            </TableCell>
                                        </TableRow>
                                    )}
                                </TableBody>
                            </Table>
                        </div>
                        {% endif %}
                        {% else %}
                        {# Legacy table display (no model table configured) #}
                        <div className="rounded-md border overflow-x-auto">
                            <Table>
                                <TableHeader>
                                    <TableRow>
                                        {% if ts.metric_field %}
                                        <TableHead>Metric</TableHead>
                                        {% endif %}
                                        <TableHead>Value</TableHead>
                                        <TableHead>{{ ts.time_field.replace('_', ' ')|title }}</TableHead>
                                    </TableRow>
                                </TableHeader>
                                <TableBody>
                                    { {{ ts.model_name }}Realtime.length > 0 ? (
                                        {{ ts.model_name }}Realtime.map((row, idx) => (
