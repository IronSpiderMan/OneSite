    {% if ts.metric_field %}
    const {{ ts.model_name }}FilteredRealtime = React.useMemo(() => {
        const query = {{ ts.model_name }}RealtimeSearch.trim().toLocaleLowerCase();
        if (!query) return {{ ts.model_name }}Realtime;
        return {{ ts.model_name }}Realtime.filter((row: any) => {
            const metric = String(row.{{ ts.metric_field }} ?? '');
            const meta = {{ ts.model_name }}Properties[row.{{ ts.metric_field }}] || {};
            return `${meta.display_name || ''} ${metric}`.toLocaleLowerCase().includes(query);
        });
    }, [{{ ts.model_name }}Realtime, {{ ts.model_name }}Properties, {{ ts.model_name }}RealtimeSearch]);

    const {{ ts.model_name }}Metrics = React.useMemo(() => {
        const set = new Set<string>();
        {{ ts.model_name }}History.forEach((row: any) => {
            if (row.{{ ts.metric_field }} !== undefined && row.{{ ts.metric_field }} !== null) {
                set.add(String(row.{{ ts.metric_field }}));
            }
        });
        return Array.from(set);
    }, [{{ ts.model_name }}History]);

    const {{ ts.model_name }}FilteredMetrics = React.useMemo(() => {
        const query = {{ ts.model_name }}HistorySearch.trim().toLocaleLowerCase();
        if (!query) return {{ ts.model_name }}Metrics;
        return {{ ts.model_name }}Metrics.filter((metric: string) => {
            const meta = {{ ts.model_name }}Properties[metric] || {};
            return `${meta.display_name || ''} ${metric} ${meta.unit || ''}`.toLocaleLowerCase().includes(query);
        });
    }, [{{ ts.model_name }}Metrics, {{ ts.model_name }}Properties, {{ ts.model_name }}HistorySearch]);

    useEffect(() => {
        if ({{ ts.model_name }}Metrics.length > 0 && !{{ ts.model_name }}HistorySelectionInitialized.current) {
            set{{ ts.model_name }}SelectedMetrics({{ ts.model_name }}Metrics);
            {{ ts.model_name }}HistorySelectionInitialized.current = true;
        }
    }, [{{ ts.model_name }}Metrics.length]);

    useEffect(() => {
        set{{ ts.model_name }}History([]);
        set{{ ts.model_name }}SelectedMetrics([]);
        set{{ ts.model_name }}HistorySearch('');
        set{{ ts.model_name }}HistoryChartLimit(6);
        {{ ts.model_name }}HistorySelectionInitialized.current = false;
    }, [id]);

    const {{ ts.model_name }}ChartData = React.useMemo(() => {
        let filtered = {{ ts.model_name }}History;
        if ({{ ts.model_name }}TimeRange === 'custom') {
            const cs = {{ ts.model_name }}CustomStartTime ? new Date({{ ts.model_name }}CustomStartTime).getTime() : 0;
            const ce = {{ ts.model_name }}CustomEndTime ? new Date({{ ts.model_name }}CustomEndTime).getTime() : Infinity;
            filtered = {{ ts.model_name }}History.filter((row: any) => {
                const t = new Date(row.{{ ts.time_field }}).getTime();
                return t >= cs && t <= ce;
            });
        } else if ({{ ts.model_name }}TimeRange !== 'latest100') {
            const cutoff = Date.now() - {
                '1h': 3600000, '6h': 21600000, '24h': 86400000,
            }[{{ ts.model_name }}TimeRange]!;
            filtered = {{ ts.model_name }}History.filter((row: any) =>
                new Date(row.{{ ts.time_field }}).getTime() >= cutoff
            );
        }

        const numGroups: Record<string, { time: number; value: number }[]> = {};
        const nonNumGroups: Record<string, { time: number; value: any }[]> = {};
        filtered.forEach((row: any) => {
            const metric = String(row.{{ ts.metric_field }} ?? '');
            const rawVal = row.value?.value;
            if (rawVal === undefined || rawVal === null) return;
            const numVal = Number(rawVal);
            if (!isNaN(numVal) && typeof rawVal !== 'boolean') {
                if (!numGroups[metric]) numGroups[metric] = [];
                numGroups[metric].push({ time: new Date(row.{{ ts.time_field }}).getTime(), value: numVal });
            } else {
                if (!nonNumGroups[metric]) nonNumGroups[metric] = [];
                nonNumGroups[metric].push({ time: new Date(row.{{ ts.time_field }}).getTime(), value: rawVal });
            }
        });
        Object.values(numGroups).forEach(g => g.sort((a, b) => a.time - b.time));
        Object.values(nonNumGroups).forEach(g => g.sort((a, b) => a.time - b.time));
        return { numeric: numGroups, nonNumeric: nonNumGroups };
    }, [{{ ts.model_name }}History, {{ ts.model_name }}TimeRange, {{ ts.model_name }}CustomStartTime, {{ ts.model_name }}CustomEndTime]);
    {% endif %}

    // Re-fetch history when time range changes
    useEffect(() => {
        if (!id) return;
        fetch{{ ts.model_name }}History({% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %});
    }, [{{ ts.model_name }}TimeRange, {{ ts.model_name }}CustomStartTime, {{ ts.model_name }}CustomEndTime]);
    {% endfor %}
    {% endif %}

    if (loading && !currentItem) {
        return (
            <div className="flex h-full items-center justify-center">
                <Loader2 className="h-8 w-8 animate-spin" />
            </div>
        );
    }

    if (!currentItem) {
        return (
            <div className="flex flex-col items-center justify-center space-y-4">
                <div className="text-xl font-semibold">Item not found</div>
                <Button onClick={() => navigate(-1)}>Go Back</Button>
            </div>
        );
    }

    // The layout is validated and normalized by the generator.  Keeping the
    // renderer data-driven lets a model author arrange fields and cards without
    // owning a generated page implementation.
    const detailLayout = {{ model.detail_layout | default([]) | tojson }} as any[];
    const hasDetailLayout = detailLayout.length > 0;
    const rowClasses: Record<number, string> = {
        1: 'grid grid-cols-1 gap-4',
        2: 'grid grid-cols-1 gap-4 md:grid-cols-2',
        3: 'grid grid-cols-1 gap-4 md:grid-cols-3',
        4: 'grid grid-cols-1 gap-4 md:grid-cols-4',
    };
    const spanClasses: Record<number, string> = {
        1: '',
        2: 'md:col-span-2',
        3: 'md:col-span-3',
        4: 'md:col-span-4',
    };
    const renderDetailField = (fieldName: string): React.ReactNode => {
        switch (fieldName) {
            {% for field in model.fields %}
            {% if field not in model.json_array_fields and field not in model.json_dict_fields and 'r' in field.permissions %}
            case '{{ field.name }}':
                return ({{ detail_read_field(field) }});
            {% endif %}
            {% endfor %}
            default:
                return null;
            }
    };
    {% if model.page_edit %}
    const renderDetailEditField = (fieldName: string): React.ReactNode => {
        switch (fieldName) {
            {% for field in model.fields %}
            {% if field not in model.json_array_fields and field not in model.json_dict_fields and ('u' in field.permissions or 'r' in field.permissions) %}
            case '{{ field.name }}':
                {% if 'u' in field.permissions %}
                return hasFieldPerm('{{ field.name }}', 'u')
                    ? ({{ detail_edit_field(field) }})
                    : ({{ detail_read_field(field) }});
                {% else %}
                return ({{ detail_read_field(field) }});
                {% endif %}
            {% endif %}
            {% endfor %}
            default:
                return null;
        }
    };
    {% endif %}
    const renderDetailLayoutNode = (node: any, key: string{% if model.page_edit %}, editing = false{% endif %}): React.ReactNode => {
        if (node.kind === 'field') {
            const content = {% if model.page_edit %}editing ? renderDetailEditField(node.field) : {% endif %}renderDetailField(node.field);
            return content ? <div key={key} className={`min-w-0 ${spanClasses[node.span] || ''}`}>{content}</div> : null;
        }
        if (node.kind === 'row') {
            const items = node.items
                .map((item: any, index: number) => renderDetailLayoutNode(item, `${key}-${index}`{% if model.page_edit %}, editing{% endif %}))
                .filter(Boolean);
            if (!items.length) return null;
            return (
                <div key={key} className={rowClasses[node.columns] || rowClasses[1]}>
                    {items}
                </div>
            );
        }
        if (node.kind === 'section') {
            const items = node.items
                .map((item: any, index: number) => renderDetailLayoutNode(item, `${key}-${index}`{% if model.page_edit %}, editing{% endif %}))
                .filter(Boolean);
            if (!items.length) return null;
            return (
                <Card key={key} className={spanClasses[node.span] || ''}>
                    <CardHeader><CardTitle>{node.title}</CardTitle></CardHeader>
                    <CardContent className="space-y-4">
                        {items}
                    </CardContent>
                </Card>
            );
        }
        return null;
    };

    {% if model.has_embedded_reverse %}
    const isEmbeddedTab = [
        {% for rfk in model.reverse_foreign_keys %}
        {% if rfk.editor == 'embedded' %}'reverse-fk-{{ rfk.name }}',{% endif %}
        {% endfor %}
    ].includes(activeTab);
    {% endif %}

    return (
        <div
            {% if model.has_embedded_reverse %}
            className={`{{ page_shell_class | default('space-y-6') }} ${isEmbeddedTab ? '!flex !h-full !min-h-0 !flex-col !gap-4 !space-y-0' : ''}`}
            {% else %}
            className="{{ page_shell_class | default('space-y-6') }}"
            {% endif %}
            data-codegen-theme="{{ codegen_theme | default('normal') }}"
            data-page-kind="detail"
        >
            <div className="flex flex-wrap items-center justify-between gap-3" data-page-region="page-header">
              <div className="flex min-w-0 items-center space-x-4">
                <Button variant="ghost" size="icon" onClick={() => navigate(-1)}>
                    <ArrowLeft className="h-4 w-4" />
                </Button>
                <h1 className="text-3xl font-bold tracking-tight">{t('models.{{ model.module_name }}.name')} {t('common.details')}</h1>
              </div>

              <div className="flex min-w-0 flex-wrap items-center justify-end gap-3" data-page-region="page-controls">
                {% if model.refresh_interval %}
                {% if model.page_edit %}
                {!isEditing && (
                {% endif %}
                <div className="flex shrink-0 items-center gap-2" data-page-region="auto-refresh-controls">
                   <span className="text-sm text-muted-foreground">{t('common.auto_refresh')}</span>
                   <Switch checked={autoRefresh} onCheckedChange={setAutoRefresh} />
                   {autoRefresh && (
                      <Select value={String(refreshInterval)} onValueChange={(v) => setRefreshInterval(Number(v))}>
                          <SelectTrigger className="h-8 w-[100px]">
                              <SelectValue />
                          </SelectTrigger>
                          <SelectContent>
                              <SelectItem value="1000">1s</SelectItem>
                              <SelectItem value="5000">5s</SelectItem>
                              <SelectItem value="10000">10s</SelectItem>
                              <SelectItem value="30000">30s</SelectItem>
                          </SelectContent>
                      </Select>
                   )}
                </div>
                {% if model.page_edit %}
                )}
                {% endif %}
                {% endif %}

              <div className="flex min-w-0 flex-wrap items-center justify-end gap-2" data-page-region="page-actions">
                {% if model.actions %}
                {% for action_name, action_config in model.actions.items() %}
                {(() => {
                    const actionPerms = {{ action_config.get("permissions", "da") | tojson }};
                    const roleChar = userRole[0];
                    if (!actionPerms.includes(roleChar)) return false;
                    {% if action_config.get("dynamic_availability") %}
                    if (!currentItem) return false;
                    const state = actionStates[String(currentItem.id)]?.[{{ action_name | tojson }}];
                    return Boolean(state?.visible);
                    {% else %}
                    const cond = {{ action_config.get("condition", None) | tojson }} as any;
                    let enabled = true;
                    if (cond && currentItem) {
                        const field = cond.field;
                        const op = cond.op;
                        const expected = cond.value;
                        const actual = (currentItem as any)[field];
                        if (op === 'eq') enabled = actual === expected;
                        else if (op === 'ne') enabled = actual !== expected;
                        else if (op === 'in') enabled = Array.isArray(expected) ? expected.includes(actual) : false;
                        else if (op === 'not_in') enabled = Array.isArray(expected) ? !expected.includes(actual) : true;
                        else if (op === 'gt') enabled = actual > expected;
                        else if (op === 'gte') enabled = actual >= expected;
                        else if (op === 'lt') enabled = actual < expected;
                        else if (op === 'lte') enabled = actual <= expected;
                        else if (op === 'contains') enabled = actual?.includes(expected);
                        else if (op === 'startswith') enabled = String(actual).startsWith(String(expected));
                        else if (op === 'endswith') enabled = String(actual).endsWith(String(expected));
                        else if (op === 'is_null') enabled = actual === null || actual === undefined;
                        else if (op === 'is_not_null') enabled = actual !== null && actual !== undefined;
                    }
                    return enabled;
                    {% endif %}
                })() && (
                <Button
                    variant={% if action_config.get("toggle") %}{(currentItem as any)[{{ action_config.get("toggle") | tojson }}] ? "destructive" : "default"}{% else %}"outline"{% endif %}
                    size="sm"
                    {% if action_config.get("dynamic_availability") %}
                    disabled={!currentItem || !actionStates[String(currentItem.id)]?.[{{ action_name | tojson }}]?.enabled}
                    title={currentItem ? actionStates[String(currentItem.id)]?.[{{ action_name | tojson }}]?.reason : undefined}
                    {% endif %}
                    onClick={async () => {
                        if (!currentItem) return;
                        try {
                            await perform{{ model.name }}{{ action_name.capitalize() }}(currentItem.id);
                            toast.success(t('common.success', 'Success'));
                            fetchItem(currentItem.id);
                        } catch (e) {
                            toast.error(t('common.error', 'Error'));
                        }
                    }}
                >
                    {% if action_config.get("toggle") %}
                    {(currentItem as any)[{{ action_config.get("toggle") | tojson }}] ? t('common.disable', 'Disable') : t('common.enable', 'Enable')}
                    {% else %}
                    {% if action_config.get("dynamic_availability") %}
                    {currentItem ? (actionStates[String(currentItem.id)]?.[{{ action_name | tojson }}]?.label || {{ (action_config.get("label") or action_name) | tojson }}) : {{ (action_config.get("label") or action_name) | tojson }}}
                    {% else %}
                    { {{ (action_config.get("label") or action_name) | tojson }} }
                    {% endif %}
                    {% endif %}
                </Button>
                )}
                {% endfor %}
                {% endif %}

                {% if model.page_edit %}
                {hasPermission('u') && !isEditing && (
                  <Button variant="outline" size="sm" onClick={startEditing}>
                    <Pencil className="mr-2 h-4 w-4" /> {t('common.edit')}
                  </Button>
                )}
                {isEditing && (
                  <>
                    <Button variant="outline" size="sm" disabled={isSaving} onClick={() => setIsEditing(false)}>
                      <X className="mr-2 h-4 w-4" /> {t('common.cancel')}
                    </Button>
                    <Button size="sm" type="button" disabled={isSaving} onClick={handleEditSubmit(onEditSave)}>
                      {isSaving ? (
                        <><Loader2 className="mr-2 h-4 w-4 animate-spin" /> {t('common.saving', 'Saving...')}</>
                      ) : (
                        <><Save className="mr-2 h-4 w-4" /> {t('common.save')}</>
                      )}
                    </Button>
                  </>
                )}
                {% endif %}
              </div>
              </div>
            </div>

            {% if model.reverse_m2m or model.reverse_foreign_keys or model.json_array_fields or model.json_dict_fields %}
            <div className="flex gap-1 overflow-x-auto border-b" role="tablist" aria-label={t('common.related_information')}>
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'detail'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'detail' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('detail')}
                >
                    {t('common.details')}
                </Button>
                {% for field in model.json_array_fields %}
                {hasFieldPerm('{{ field.name }}', 'r') && (
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'json-array-{{ field.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'json-array-{{ field.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('json-array-{{ field.name }}')}
                >
                    {t('{{ field.label_key }}')}
                </Button>
                )}
                {% endfor %}
                {% for field in model.json_dict_fields %}
                {hasFieldPerm('{{ field.name }}', 'r') && (
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'json-dict-{{ field.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'json-dict-{{ field.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('json-dict-{{ field.name }}')}
                >
                    {t('{{ field.label_key }}')}
                </Button>
                )}
                {% endfor %}
                {% for rel in model.reverse_m2m %}
                {% if rel.display %}
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'reverse-m2m-{{ rel.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'reverse-m2m-{{ rel.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('reverse-m2m-{{ rel.name }}')}
                >
                    {t('models.{{ rel.source_service }}.plural')}
                </Button>
                {% endif %}
                {% endfor %}
                {% for rfk in model.reverse_foreign_keys %}
                {% if rfk.display %}
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'reverse-fk-{{ rfk.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'reverse-fk-{{ rfk.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('reverse-fk-{{ rfk.name }}')}
                >
                    {t('models.{{ rfk.source_service }}.plural')}
                </Button>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

            <div
                {% if model.has_embedded_reverse %}
                className={`{{ detail_grid_class | default('grid grid-cols-1 gap-6') }} ${isEmbeddedTab ? '!flex-1 !min-h-0' : ''}`}
                {% else %}
                className="{{ detail_grid_class | default('grid grid-cols-1 gap-6') }}"
                {% endif %}
                data-page-region="detail-grid"
            >
                {activeTab === 'detail' && !hasDetailLayout && (
                <Card>
                    <CardHeader>
                        <CardTitle>{% if model.page_edit %}{isEditing ? t('common.edit') + ' ' : ''}{% endif %}{t('common.basic_information')}</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-4">
                        {% if model.page_edit %}{isEditing ? (
                        <form id="detail-edit-form" className="space-y-4">
                            {% for field in model.fields %}
                            {% if not field.fk_info and field not in model.json_array_fields and field not in model.json_dict_fields and 'u' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'u'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
                            <div className="space-y-2">
                                <Label htmlFor="edit-{{ field.name }}">{t('{{ field.label_key }}')}{ {{ 'true' if field.required and not field.update_optional else 'false' }} && <span className="text-destructive"> *</span>}</Label>
                                {% if field.ui_type == 'bool' %}
                                <div className="flex h-10 items-center justify-end rounded-md border px-3">
                                    <Controller
                                        control={editControl}
                                        name="{{ field.name }}"
                                        defaultValue={ {{ 'true' if field.default else 'false' }} }
                                        render={({ field: { onChange, value } }) => (
                                            <Switch checked={value} onCheckedChange={onChange} id="edit-{{ field.name }}" />
                                        )}
                                    />
                                </div>
                                {% elif field.ui_type == 'image' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <ImageUpload value={value} onChange={onChange} />
                                    )}
                                />
                                {% elif field.ui_type == 'images' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <ImagesUpload id="edit-{{ field.name }}" value={Array.isArray(value) ? value : []} onChange={onChange} />
                                    )}
                                />
                                {% elif field.ui_type == 'file' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <FileUpload
                                            value={value}
                                            onChange={onChange}
                                            allowDownload={ {{ "true" if field.allow_download else "false" }} }
                                        />
                                    )}
                                />
                                {% elif field.ui_type == 'video_stream' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <VideoStreamInput value={value} onChange={onChange} protocol="{{ field.stream_protocol }}" />
                                    )}
                                />
                                {% elif field.is_enum and field.is_multi_select %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <SearchableSelect
                                            value={value || []}
                                            onValueChange={onChange}
                                            multiple={true}
                                            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                            searchPlaceholder={`${t('common.search')}...`}
                                            loadOptions={async () => {{ field.enum_values | tojson }}.map((v: string) => ({
                                                label: t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v),
                                                value: v,
                                            }))}
                                        />
                                    )}
                                />
                                {% elif field.is_enum %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => {
                                        {% if model.module_name == "user" and model.name == "User" and field.name == "role" %}
                                        const filteredValues = userRole === 'developer'
                                            ? {{ field.enum_values | tojson }}
                                            : ({{ field.enum_values | tojson }} as string[]).filter(v => v !== 'developer');
                                        {% else %}
                                        const filteredValues = {{ field.enum_values | tojson }};
                                        {% endif %}
                                        return (
                                        <Select onValueChange={onChange} defaultValue={value}>
                                            <SelectTrigger>
                                                <SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
                                            </SelectTrigger>
                                            <SelectContent>
                                                {filteredValues.map((enumVal: string) => (
                                                    <SelectItem key={enumVal} value={enumVal}>{t(`models.{{ model.module_name }}.enums.{{ field.name }}.${enumVal}`, enumVal)}</SelectItem>
                                                ))}
                                            </SelectContent>
                                        </Select>
                                        );
                                    }}
                                />
                                {% elif field.ui_type == 'time' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <TimePicker
                                            value={value}
                                            onChange={onChange}
                                            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                        />
                                    )}
                                />
                                {% elif field.ui_type == 'location' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    defaultValue={null}
                                    render={({ field: { onChange, value } }) => (
                                        <LocationInput value={value} onChange={onChange} />
                                    )}
                                />
                                {% elif field.ui_type == 'json' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    defaultValue={ {% if field.json_kind == 'array' %}[]{% else %}{}{% endif %} }
                                    rules={ {
                                        required: {{ 'true' if field.required and not field.update_optional else 'false' }},
                                        {% if field.json_model_schema %}validate: (value) => validateJsonModelValue({{ field.json_model_schema | tojson }}, value, editRootValue),{% elif field.json_item_schema %}validate: (value) => validateJsonModelCollectionValue({{ field.json_item_schema | tojson }}, value, editRootValue),{% endif %}
                                    } }
                                    render={({ field: { onChange, value } }) => (
                                        {% if field.json_model_schema %}
                                        <JsonModelEditor
                                            schema={ {{ field.json_model_schema | tojson }} }
                                            value={value}
                                            onChange={onChange}
                                            rootValue={editRootValue}
                                        />
                                        {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
                                        <JsonModelDictEditor
                                            itemSchema={ {{ field.json_item_schema | tojson }} }
                                            value={value}
                                            onChange={onChange}
                                            rootValue={editRootValue}
                                            {% if field.json_fixed_keys %}
                                            fixedKeys={ {{ field.json_fixed_keys | tojson }} }
                                            {% endif %}
                                            {% if field.json_lock_keys %}
                                            lockKeys
                                            {% endif %}
                                        />
                                        {% elif field.json_item_kind %}
                                        <JsonScalarArrayEditor itemKind="{{ field.json_item_kind }}" value={value} onChange={onChange} />
                                        {% elif field.json_item_schema %}
                                        <JsonModelArrayEditor
                                            itemSchema={ {{ field.json_item_schema | tojson }} }
                                            value={value}
                                            onChange={onChange}
                                            rootValue={editRootValue}
