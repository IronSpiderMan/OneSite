                                    <span className="text-sm text-muted-foreground">{t('common.auto_refresh', 'Auto refresh')}</span>
                                    <Switch checked={tsAutoRefresh && tsHistoryAutoRefresh} onCheckedChange={(checked) => { setTsAutoRefresh(checked); setTsHistoryAutoRefresh(checked); }} />
                                </div>
                                {tsLastRefreshed && (
                                    <span className="text-xs text-muted-foreground tabular-nums">
                                        {tsLastRefreshed.toLocaleTimeString()}
                                    </span>
                                )}
                            </div>
                        </div>
                    </CardHeader>
                    <CardContent>
                        {% if ts.metric_field %}
                        {# Metric timeseries always use the dense Hub-style cards.  A
