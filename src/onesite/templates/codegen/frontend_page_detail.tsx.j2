                                <input type="datetime-local" className="h-8 rounded-md border border-input bg-background px-2 text-xs" value={ {{ ts.model_name }}CustomEndTime } onChange={(event) => set{{ ts.model_name }}CustomEndTime(event.target.value)} />
                            </div>
