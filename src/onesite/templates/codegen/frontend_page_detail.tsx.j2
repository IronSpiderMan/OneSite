                                        <TableRow>
                                            <TableCell colSpan={ {{ (rfk.source_readable_fields | length) }} } className="h-24 text-center">
                                                {t('common.no_result')}
                                            </TableCell>
                                        </TableRow>
                                    )}
                                </TableBody>
                            </Table>
