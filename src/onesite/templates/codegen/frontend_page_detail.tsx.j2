const JsonPreview: React.FC<{ value: unknown }> = ({ value }) => {
    if (value === undefined || value === null) {
        return <span className="text-muted-foreground">-</span>;
    }

    let parsedValue = value;
    if (typeof value === 'string') {
        try {
            parsedValue = JSON.parse(value);
        } catch {
            return <span className="block max-w-[250px] truncate" title={value}>{value}</span>;
        }
    }

    if (parsedValue === undefined || parsedValue === null) {
        return <span className="text-muted-foreground">-</span>;
    }

    if (typeof parsedValue !== 'object') {
        return <span>{String(parsedValue)}</span>;
    }

    // Format key-value pairs for objects
    const formatKeyValuePairs = (obj: Record<string, unknown>, maxLines: number = 3): { preview: string; full: string; hasMore: boolean } => {
        const entries = Object.entries(obj);
        const lines = entries.map(([key, value]) => {
            const valueStr = typeof value === 'object' ? JSON.stringify(value) : String(value);
            return `${key}: ${valueStr}`;
        });
        
        const preview = lines.slice(0, maxLines).join('\n');
        const full = lines.join('\n');
        const hasMore = lines.length > maxLines;
        
        return { preview, full, hasMore };
    };

    // Format array items for arrays
    const formatArrayItems = (arr: unknown[], maxLines: number = 3): { preview: string; full: string; hasMore: boolean } => {
        const lines = arr.map((item, index) => {
            const itemStr = typeof item === 'object' ? JSON.stringify(item) : String(item);
            return `[${index}]: ${itemStr}`;
        });
        
        const preview = lines.slice(0, maxLines).join('\n');
        const full = lines.join('\n');
        const hasMore = lines.length > maxLines;
        
        return { preview, full, hasMore };
    };

    const isArray = Array.isArray(parsedValue);
    const { preview, full, hasMore } = isArray
        ? formatArrayItems(parsedValue as unknown[])
        : formatKeyValuePairs(parsedValue as Record<string, unknown>);

    return (
        <Popover>
            <PopoverTrigger asChild>
                <button
                    type="button"
                    className="inline-flex max-w-[250px] items-start gap-1.5 rounded-md border border-border bg-muted/40 px-2 py-1 font-mono text-xs text-foreground transition-colors hover:bg-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                    title="View JSON"
                >
                    <span className="whitespace-pre-line break-all text-left">
                        {preview}
                        {hasMore && <span className="text-muted-foreground">...</span>}
                    </span>
                </button>
            </PopoverTrigger>
            <PopoverContent align="start" className="w-[min(32rem,calc(100vw-2rem))] p-0">
                <pre className="max-h-80 overflow-auto whitespace-pre-wrap break-words p-3 font-mono text-xs leading-relaxed">
                    {full}
                </pre>
            </PopoverContent>
        </Popover>
    );
};

const {{ model.name }}DetailPage: React.FC = () => {
    const { t } = useTranslation();
    const timeZone = getUserTimeZone();
    const { id } = useParams<{ id: string }>();
    const [searchParams] = useSearchParams();
    const navigate = useNavigate();
    const { fetchItem, currentItem, loading{% if model.page_edit %}, updateItem{% endif %} } = use{{ model.name }}Store();
    const userRole = (localStorage.getItem('user_role') || 'user') as 'user' | 'admin' | 'developer';
    const rolePermissions: Record<string, string> = {{ model.role_permissions | tojson }};
    const userPerms = rolePermissions[userRole] || '';
    const hasPermission = (perm: 'r' | 'c' | 'u' | 'd') => userPerms.includes(perm);
    const [activeTab, setActiveTab] = useState('detail');
    {% if model.has_dynamic_action_states %}
    const [actionStates, setActionStates] = useState<Record<string, Record<string, { visible: boolean; enabled: boolean; reason?: string; label?: string }>>>({});
    {% endif %}

    useEffect(() => {
        setActiveTab('detail');
    }, [id]);

    {% if model.has_dynamic_action_states %}
    useEffect(() => {
        let cancelled = false;
        if (!currentItem) {
            setActionStates({});
            return () => { cancelled = true; };
        }
        get{{ model.name }}ActionStates([currentItem.id])
            .then((states) => {
                if (!cancelled) setActionStates(states);
            })
            .catch(() => {
                if (!cancelled) setActionStates({});
            });
        return () => { cancelled = true; };
    }, [currentItem]);
    {% endif %}

    // Field-level role-based permissions (Layer 2)
    const fieldRolePerms: Record<string, Record<string, string>> = {
    {% for field in model.fields %}
    {% if field.role_permissions %}
      "{{ field.name }}": {{ field.role_permissions | tojson }},
    {% endif %}
    {% endfor %}
    };
    const hasFieldPerm = (fieldName: string, perm: 'c' | 'r' | 'u') => {
      const fp = fieldRolePerms[fieldName];
      if (!fp) return true;
