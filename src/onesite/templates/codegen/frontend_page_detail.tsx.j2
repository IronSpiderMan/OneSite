                            >
                                {t('common.previous')}
                            </Button>
                            <span className="text-sm">
                                {t('common.page_info')} { {{ rfk.name }}Page } {t('common.of_page')} { Math.ceil({{ rfk.name }}Total / {{ rfk.name }}Size) || 1 }
