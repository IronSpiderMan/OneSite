{% macro detail_edit_field(field) -%}
hasFieldPerm('{{ field.name }}', 'u'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
<div className="space-y-2">
    <Label htmlFor="edit-{{ field.name }}">{t('{{ field.label_key }}')}{ {{ 'true' if field.required and not field.update_optional else 'false' }} && <span className="text-destructive"> *</span>}</Label>
    {% if field.dict_key_reference %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <SearchableSelect
            value={value}
            onValueChange={onChange}
            disabled={!editRootValue?.{{ field.dict_key_reference.owner_fk }}}
            optionsKey={editRootValue?.{{ field.dict_key_reference.owner_fk }}}
            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
            searchPlaceholder={`${t('common.search')}...`}
            loadOptions={async (query) => {
                const ownerId = editRootValue?.{{ field.dict_key_reference.owner_fk }};
                if (ownerId === undefined || ownerId === null || ownerId === '') return [];
                const options = await get{{ model.name }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}KeyOptions(ownerId);
                const normalizedQuery = query.trim().toLocaleLowerCase();
                return options.filter((option) => !normalizedQuery
                    || option.label.toLocaleLowerCase().includes(normalizedQuery)
                    || option.value.toLocaleLowerCase().includes(normalizedQuery));
            }}
        />
    )} />
    {% elif field.fk_info %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <SearchableSelect
            value={value}
            onValueChange={(nextValue) => {
                onChange(nextValue);
                {% for reference in model.dict_key_reference_meta %}
                {% if reference.owner_fk == field.name %}
                setEditValue('{{ reference.field }}', '');
                {% endif %}
                {% endfor %}
            }}
            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
            searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
            valueLabels={ edit{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
            loadOptions={async (query) => {
                const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                return response.items.map((item: any) => ({
                    label: item.{{ field.fk_info.label_field }} || item.id,
                    value: item.id
                }));
            }}
        />
    )} />
    {% elif field.ui_type == 'bool' %}
    <div className="flex h-10 items-center justify-end rounded-md border px-3">
        <Controller control={editControl} name="{{ field.name }}" defaultValue={ {{ 'true' if field.default else 'false' }} } render={({ field: { onChange, value } }) => (
            <Switch checked={value} onCheckedChange={onChange} id="edit-{{ field.name }}" />
        )} />
    </div>
    {% elif field.ui_type == 'image' %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <ImageUpload value={value} onChange={onChange} />
    )} />
    {% elif field.ui_type == 'images' %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <ImagesUpload id="edit-{{ field.name }}" value={Array.isArray(value) ? value : []} onChange={onChange} />
    )} />
    {% elif field.ui_type == 'file' %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <FileUpload value={value} onChange={onChange} allowDownload={ {{ "true" if field.allow_download else "false" }} } />
    )} />
    {% elif field.ui_type == 'video_stream' %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <VideoStreamInput value={value} onChange={onChange} protocol="{{ field.stream_protocol }}" />
    )} />
    {% elif field.is_enum and field.is_multi_select %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <SearchableSelect value={value || []} onValueChange={onChange} multiple={true}
            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
            searchPlaceholder={`${t('common.search')}...`}
            loadOptions={async () => {{ field.enum_values | tojson }}.map((v: string) => ({ label: t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v), value: v }))} />
    )} />
    {% elif field.is_enum %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => {
        {% if model.module_name == "user" and model.name == "User" and field.name == "role" %}
        const filteredValues = userRole === 'developer' ? {{ field.enum_values | tojson }} : ({{ field.enum_values | tojson }} as string[]).filter(v => v !== 'developer');
        {% else %}
        const filteredValues = {{ field.enum_values | tojson }};
        {% endif %}
        return <Select onValueChange={onChange} defaultValue={value}>
            <SelectTrigger><SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} /></SelectTrigger>
            <SelectContent>{filteredValues.map((enumVal: string) => <SelectItem key={enumVal} value={enumVal}>{t(`models.{{ model.module_name }}.enums.{{ field.name }}.${enumVal}`, enumVal)}</SelectItem>)}</SelectContent>
        </Select>;
    }} />
    {% elif field.ui_type == 'time' %}
    <Controller control={editControl} name="{{ field.name }}" render={({ field: { onChange, value } }) => (
        <TimePicker value={value} onChange={onChange} placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
    )} />
    {% elif field.ui_type == 'location' %}
    <Controller control={editControl} name="{{ field.name }}" defaultValue={null} render={({ field: { onChange, value } }) => (
        <LocationInput value={value} onChange={onChange} />
    )} />
    {% elif field.ui_type == 'json' %}
    <Controller control={editControl} name="{{ field.name }}" defaultValue={ {% if field.json_kind == 'array' %}[]{% else %}{}{% endif %} }
        rules={ {
            required: {{ 'true' if field.required and not field.update_optional else 'false' }},
            {% if field.json_model_schema %}validate: (value) => validateJsonModelValue({{ field.json_model_schema | tojson }}, value, editRootValue),{% elif field.json_item_schema %}validate: (value) => validateJsonModelCollectionValue({{ field.json_item_schema | tojson }}, value, editRootValue),{% endif %}
        } }
        render={({ field: { onChange, value } }) => (
        {% if field.json_model_schema %}
        <JsonModelEditor schema={ {{ field.json_model_schema | tojson }} } value={value} onChange={onChange} rootValue={editRootValue} />
        {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
        <JsonModelDictEditor itemSchema={ {{ field.json_item_schema | tojson }} } value={value} onChange={onChange} rootValue={editRootValue}{% if field.json_fixed_keys %} fixedKeys={ {{ field.json_fixed_keys | tojson }} }{% endif %}{% if field.json_lock_keys %} lockKeys{% endif %} />
        {% elif field.json_item_kind %}
        <JsonScalarArrayEditor itemKind="{{ field.json_item_kind }}" value={value} onChange={onChange} />
        {% elif field.json_item_schema %}
        <JsonModelArrayEditor itemSchema={ {{ field.json_item_schema | tojson }} } value={value} onChange={onChange} rootValue={editRootValue}{% if model.definition_binding_meta and field.name == model.definition_binding_meta.config_field %} canAdd={ {{ 'true' if model.definition_binding_meta.key_policy == 'free' else 'false' }} } canRemove={ {{ 'false' if model.definition_binding_meta.key_policy == 'definition' else 'true' }} }{% endif %} />
        {% else %}
        <JsonInput value={value} onChange={onChange} jsonKind="{{ field.json_kind or 'object' }}" placeholder={ {% if field.json_kind == 'array' %}"[\\n  \\n]"{% else %}"{\\n  \\n}"{% endif %} } />
        {% endif %}
    )} />
    {% else %}
    <Input id="edit-{{ field.name }}"{% if field.ui_type == 'int' or field.ui_type == 'float' %} type="number"{% if field.minimum is not none %} min={ {{ field.minimum }} }{% endif %}{% if field.maximum is not none %} max={ {{ field.maximum }} }{% endif %}{% elif field.ui_type == 'datetime' %} type="datetime-local"{% elif field.ui_type == 'date' %} type="date"{% else %} type="text"{% endif %} {...register('{{ field.name }}', { required: {{ 'true' if field.required and not field.update_optional else 'false' }},{% if field.minimum is not none %} min: {{ field.minimum }},{% endif %}{% if field.maximum is not none %} max: {{ field.maximum }},{% endif %} })} />
    {% endif %}
</div>
)
