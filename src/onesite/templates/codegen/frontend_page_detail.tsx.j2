                            <Button
                                variant="outline"
                                size="sm"
                                onClick={() => fetch{{ rfk.source_model }}s({% if 'str' in model.id_type %}id!{% else %}parseInt(id!){% endif %}, {{ rfk.name }}Page + 1)}
