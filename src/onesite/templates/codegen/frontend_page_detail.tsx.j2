                        <div className={ {{ ts.model_name }}RealtimeDensity === 'compact' ? 'grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4' : 'grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3' }>
                            { {{ ts.model_name }}FilteredRealtime.length > 0 ? (
                                {{ ts.model_name }}FilteredRealtime.map((row, idx) => {
                                    const meta = {{ ts.model_name }}Properties[row.{{ ts.metric_field }}] || {};
                                    const metric = String(row.{{ ts.metric_field }} ?? '');
