                                            <Search className="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                                            <Input
                                                value={ {{ ts.model_name }}HistorySearch }
                                                onChange={(event) => set{{ ts.model_name }}HistorySearch(event.target.value)}
                                                placeholder={t('common.search', 'Search metric')}
                                                className="h-8 pl-8"
                                            />
                                        </div>
                                        <div className="flex items-center gap-2">
                                            <Button variant="outline" size="sm" className="h-8" onClick={() => set{{ ts.model_name }}SelectedMetrics({{ ts.model_name }}Metrics)}>
                                                {t('common.select_all', 'Select all')}
                                            </Button>
                                            <Button variant="ghost" size="sm" className="h-8" onClick={() => set{{ ts.model_name }}SelectedMetrics([])}>
                                                {t('common.clear', 'Clear')}
                                            </Button>
                                            <Select
                                                value={ {{ ts.model_name }}HistoryDensity }
                                                onValueChange={(value) => set{{ ts.model_name }}HistoryDensity(value as 'compact' | 'comfortable')}
                                            >
                                                <SelectTrigger className="h-8 w-[118px] text-xs"><SelectValue /></SelectTrigger>
                                                <SelectContent>
                                                    <SelectItem value="compact">{t('common.compact', 'Compact')}</SelectItem>
                                                    <SelectItem value="comfortable">{t('common.comfortable', 'Comfortable')}</SelectItem>
                                                </SelectContent>
                                            </Select>
                                        </div>
                                    </div>
                                    <div className="flex max-h-28 flex-wrap items-start gap-1.5 overflow-y-auto overscroll-contain pr-1">
                                    { {{ ts.model_name }}FilteredMetrics.map((metric: string) => {
