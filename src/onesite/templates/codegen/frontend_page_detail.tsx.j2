import React, { useEffect, useState, useRef } from 'react';
import { useParams, useNavigate, useSearchParams } from 'react-router-dom';
import { ArrowLeft, Eye, Loader2{% if model.page_edit or model.reverse_foreign_keys %}, Pencil{% endif %}{% if model.page_edit %}, Save, X{% endif %}{% if model.reverse_foreign_keys %}, Trash2{% endif %} } from 'lucide-react';
import { useTranslation } from 'react-i18next';
import { toast } from 'sonner';
import { use{{ model.name }}Store } from '../../stores/use{{ model.name }}Store';
import { Button } from '../../components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '../../components/ui/card';
import { Badge } from '../../components/ui/badge';
import { Label } from '../../components/ui/label';
import { formatDateTime, formatTime, getUserTimeZone } from '../../lib/datetime';
import { Separator } from '../../components/ui/separator';
import { FileUpload } from '../../components/ui/file-upload';
import { VideoStreamPlayer } from '../../components/ui/video-stream-player';
import { Switch } from '../../components/ui/switch';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../components/ui/select';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../../components/ui/table';
import { Input } from '../../components/ui/input';
import { TimePicker } from '../../components/ui/time-picker';
import { SearchableSelect } from '../../components/ui/searchable-select';
{% if model.page_edit %}
import { useForm, Controller } from 'react-hook-form';
import { JsonInput } from '../../components/ui/json-input';
import { JsonModelEditor, JsonModelArrayEditor, JsonModelDictEditor, JsonModelTableEditor, JsonDynamicTableEditor, JsonScalarArrayEditor } from '../../components/ui/json-model-editor';
import { ImageUpload } from '../../components/ui/image-upload';
import { ImagesUpload } from '../../components/ui/images-upload';
import { LocationInput } from '../../components/ui/location-input';
import { VideoStreamInput } from '../../components/ui/video-stream-input';
import { LinkTableOrderedSelect } from '../../components/ui/link-table-ordered-select';
{% for fk in model.foreign_keys %}
import { get{{ fk.target_model }}s } from '../../services/{{ fk.target_service }}';
{% endfor %}
{% if model.m2m_fields %}
{% for m2m in model.m2m_fields %}
import { get{{ m2m.target_model }}s } from '../../services/{{ m2m.target_service }}';
{% endfor %}
{% endif %}
{% endif %}
{% for fk in model.foreign_keys %}
import { get{{ fk.target_model }} } from '../../services/{{ fk.target_service }}';
{% endfor %}
{% if model.actions %}
import {
    {% for action_name, action_config in model.actions.items() %}
    perform{{ model.name }}{{ action_name.capitalize() }}{% if not loop.last %}, {% endif %}
    {% endfor %}
} from '../../services/{{ model.module_name }}';
{% endif %}
{% if model.m2m_fields %}
{% for m2m in model.m2m_fields %}
import { get{{ model.name }}{{ m2m.target_model }}s{% if m2m.order_field %}, get{{ model.name }}{{ m2m.target_model }}sWithMeta{% endif %} } from '../../services/{{ model.module_name }}';
{% endfor %}
{% endif %}
{% if model.reverse_m2m %}
{% for rel in model.reverse_m2m %}
{% if rel.display %}
import { get{{ model.name }}{{ rel.source_model }}s } from '../../services/{{ model.module_name }}';
{% endif %}
{% endfor %}
{% endif %}
{% if model.reverse_foreign_keys %}
{% for rfk in model.reverse_foreign_keys %}
{% if rfk.display or rfk.editor == 'inline' %}
import { get{{ rfk.source_model }}s{% if rfk.display %}, delete{{ rfk.source_model }}{% for action_name, action_config in rfk.actions.items() %}, perform{{ rfk.source_model }}{{ action_name.capitalize() }}{% endfor %}{% endif %} } from '../../services/{{ rfk.source_service }}';
{% endif %}
{% for field in rfk.source_search_fields %}
{% if field.fk_info %}
import * as {{ rfk.source_model }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}SearchService from '../../services/{{ field.fk_info.target_service }}';
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% if model.reverse_timeseries %}
{% for ts in model.reverse_timeseries %}
import { get{{ ts.model_name }}Realtime, get{{ ts.model_name }}History } from '../../services/{{ ts.module_name }}';
{% endfor %}
{% if model.reverse_timeseries %}
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from 'recharts';
{% endif %}
{% endif %}

const {{ model.name }}DetailPage: React.FC = () => {
    const { t } = useTranslation();
    const timeZone = getUserTimeZone();
    const { id } = useParams<{ id: string }>();
    const [searchParams] = useSearchParams();
    const navigate = useNavigate();
    const { fetchItem, currentItem, loading{% if model.page_edit %}, updateItem{% endif %} } = use{{ model.name }}Store();
    const userRole = (localStorage.getItem('user_role') || 'user') as 'user' | 'admin' | 'developer';
    const rolePermissions: Record<string, string> = {{ model.role_permissions | tojson }};
    const userPerms = rolePermissions[userRole] || '';
    const hasPermission = (perm: 'r' | 'c' | 'u' | 'd') => userPerms.includes(perm);
    const [activeTab, setActiveTab] = useState('detail');

    useEffect(() => {
        setActiveTab('detail');
    }, [id]);

    // Field-level role-based permissions (Layer 2)
    const fieldRolePerms: Record<string, Record<string, string>> = {
    {% for field in model.fields %}
    {% if field.role_permissions %}
      "{{ field.name }}": {{ field.role_permissions | tojson }},
    {% endif %}
    {% endfor %}
    };
    const hasFieldPerm = (fieldName: string, perm: 'c' | 'r' | 'u') => {
      const fp = fieldRolePerms[fieldName];
      if (!fp) return true;
      return (fp[userRole] || '').includes(perm);
    };
    
    // State to store resolved foreign key data
    {% for fk in model.foreign_keys %}
    const [{{ fk.target_service }}Data, set{{ fk.target_model }}Data] = useState<any>(null);
    {% endfor %}

    // State for M2M data
    {% if model.m2m_fields %}
    {% for m2m in model.m2m_fields %}
    const [{{ m2m.name }}Data, set{{ m2m.target_model }}Data] = useState<any[]>([]);
    const [{{ m2m.name }}Total, set{{ m2m.target_model }}Total] = useState(0);
    const [{{ m2m.name }}Page, set{{ m2m.target_model }}Page] = useState(1);
    const [{{ m2m.name }}Size, set{{ m2m.target_model }}Size] = useState(20);
    const [{{ m2m.name }}Loading, set{{ m2m.target_model }}Loading] = useState(false);
    {% endfor %}
    {% endif %}

    // State for Reverse M2M data
    {% if model.reverse_m2m %}
    {% for rel in model.reverse_m2m %}
    {% if rel.display %}
    const [{{ rel.name }}Data, set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Data] = useState<any[]>([]);
    const [{{ rel.name }}Total, set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Total] = useState(0);
    const [{{ rel.name }}Page, set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Page] = useState(1);
    const [{{ rel.name }}Size, set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Size] = useState(20);
    const [{{ rel.name }}Loading, set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Loading] = useState(false);
    {% endif %}
    {% endfor %}
    {% endif %}

    // State for Reverse FK data (One-to-Many)
    {% if model.reverse_foreign_keys %}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.display %}
    const [{{ rfk.name }}Data, set{{ rfk.source_model }}Data] = useState<any[]>([]);
    const [{{ rfk.name }}Total, set{{ rfk.source_model }}Total] = useState(0);
    const [{{ rfk.name }}Page, set{{ rfk.source_model }}Page] = useState(1);
    const [{{ rfk.name }}Size, set{{ rfk.source_model }}Size] = useState(20);
    const [{{ rfk.name }}Loading, set{{ rfk.source_model }}Loading] = useState(false);
    const [{{ rfk.name }}SearchValues, set{{ rfk.source_model }}SearchValues] = useState<Record<string, any>>({});
    {% for field in rfk.source_search_fields %}
    {% if field.fk_info %}
    const [{{ rfk.name }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}SearchLabels, set{{ rfk.source_model }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}SearchLabels] = useState<Record<string, string>>({});
    {% endif %}
    {% endfor %}
    {% endif %}
    {% endfor %}
    {% endif %}

    {% if model.reverse_timeseries %}
    {% for ts in model.reverse_timeseries %}
    const [{{ ts.model_name }}Realtime, set{{ ts.model_name }}Realtime] = useState<any[]>([]);
    const [{{ ts.model_name }}Properties, set{{ ts.model_name }}Properties] = useState<Record<string, any>>({});
    const [{{ ts.model_name }}History, set{{ ts.model_name }}History] = useState<any[]>([]);
    const [{{ ts.model_name }}HistoryLoading, set{{ ts.model_name }}HistoryLoading] = useState(false);
    const [tsHistoryAutoRefresh, setTsHistoryAutoRefresh] = useState(true);
    const [tsHistoryLastRefreshed, setTsHistoryLastRefreshed] = useState<Date | null>(null);
    const [{{ ts.model_name }}SelectedMetrics, set{{ ts.model_name }}SelectedMetrics] = useState<string[]>([]);
    const [{{ ts.model_name }}TimeRange, set{{ ts.model_name }}TimeRange] = useState('latest100');
    const [{{ ts.model_name }}CustomStartTime, set{{ ts.model_name }}CustomStartTime] = useState('');
    const [{{ ts.model_name }}CustomEndTime, set{{ ts.model_name }}CustomEndTime] = useState('');
    {% endfor %}
    const [tsAutoRefresh, setTsAutoRefresh] = useState(true);
    const [tsLastRefreshed, setTsLastRefreshed] = useState<Date | null>(null);
    {% endif %}

    const calcStartTime = (range: string): string | undefined => {
        const ms: Record<string, number> = { '1h': 3600000, '6h': 21600000, '24h': 86400000 };
        const m = ms[range];
        return m ? new Date(Date.now() - m).toISOString() : undefined;
    };

    {% if model.page_edit %}
    const [isEditing, setIsEditing] = useState(false);
    const { register, handleSubmit: handleEditSubmit, reset, setValue: setEditValue, control: editControl } = useForm();

    {% for field in model.fields %}
    {% if field.fk_info %}
    const [edit{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels, setEdit{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels] = useState<Record<string, string>>({});
    {% endif %}
    {% endfor %}
    {% if model.m2m_fields %}
    {% for m2m in model.m2m_fields %}
    const [edit{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels, setEdit{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels] = useState<Record<string, string>>({});
    {% endfor %}
    {% endif %}

    const onEditSave = async (values: any) => {
      try {
        await updateItem(currentItem!.id, values);
        toast.success(t('toast.update_success', 'Updated'));
        setIsEditing(false);
        fetchItem(currentItem!.id);
        {% if model.m2m_fields %}
        {% for m2m in model.m2m_fields %}
        fetch{{ m2m.target_model }}s(currentItem!.id, 1);
        {% endfor %}
        {% endif %}
      } catch (error) {
        toast.error(t('toast.save_failed', 'Save failed'));
        console.error(error);
      }
    };

    const startEditing = async () => {
      if (!currentItem) return;
      const item = currentItem;
      {% for field in model.fields %}
      {% if 'r' in field.permissions %}
      setEditValue('{{ field.name }}', item.{{ field.name }});
      {% endif %}
      {% endfor %}
      {% for field in model.fields %}
      {% if field.fk_info %}
      if (item.{{ field.name }}) {
        get{{ field.fk_info.target_model }}(item.{{ field.name }}).then((fkItem: any) => {
          if (fkItem) {
            setEdit{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({ [String(fkItem.id)]: fkItem.{{ field.fk_info.label_field }} || String(fkItem.id) });
          }
        });
      }
      {% endif %}
      {% endfor %}
      {% if model.m2m_fields %}
      {% for m2m in model.m2m_fields %}
      try {
        {% if m2m.editor == 'inline' %}
        const {{ m2m.name }}Rel = await get{{ model.name }}{{ m2m.target_model }}s(item.id, 1, -1);
        setEditValue('{{ m2m.write_name }}', {{ m2m.name }}Rel.items);
        {% elif m2m.order_field %}
        const {{ m2m.name }}Rel = await get{{ model.name }}{{ m2m.target_model }}sWithMeta(item.id, 1, 200);
        const {{ m2m.name }}Ordered = [...{{ m2m.name }}Rel.items].sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0));
        setEditValue('{{ m2m.name }}', {{ m2m.name }}Ordered.map((x: any) => x.id));
        setEdit{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels(Object.fromEntries({{ m2m.name }}Ordered.map((x: any) => [String(x.id), x.label || String(x.id)])));
        {% else %}
        const {{ m2m.name }}Rel = await get{{ model.name }}{{ m2m.target_model }}s(item.id, 1, 200);
        setEditValue('{{ m2m.name }}', {{ m2m.name }}Rel.items.map((x: any) => x.id));
        setEdit{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels(Object.fromEntries({{ m2m.name }}Rel.items.map((x: any) => [String(x.id), x.{{ m2m.label_field }} || String(x.id)])));
        {% endif %}
      } catch (error) {
        console.error(error);
        setEdit{{ m2m.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels({});
      }
      {% endfor %}
      {% endif %}
      {% for rfk in model.reverse_foreign_keys %}
      {% if rfk.editor == 'inline' %}
      try {
        const {{ rfk.name }}Rel = await get{{ rfk.source_model }}s(1, -1, { {{ rfk.source_fk_field }}: item.id });
        setEditValue('{{ rfk.write_name }}', {{ rfk.name }}Rel.items);
      } catch (error) {
        console.error(error);
        setEditValue('{{ rfk.write_name }}', []);
      }
      {% endif %}
      {% endfor %}
      setIsEditing(true);
    };

    // Auto-enter edit mode once per item when navigated from the list page.
    // React reuses this component when only the route id changes, so a boolean
    // ref would leave the next item's form populated with the previous item.
    const autoEditedItemId = useRef<string | null>(null);
    useEffect(() => {
        if (
            id &&
            currentItem &&
            String(currentItem.id) === id &&
            autoEditedItemId.current !== id &&
            searchParams.get('edit') === 'true' &&
            hasPermission('u')
        ) {
            autoEditedItemId.current = id;
            startEditing();
        }
    }, [currentItem, id, searchParams]);
    {% endif %}

    {% if model.refresh_interval %}
    const [autoRefresh, setAutoRefresh] = useState(true);
    const [refreshInterval, setRefreshInterval] = useState({{ model.refresh_interval }});

    useEffect(() => {
        let interval: ReturnType<typeof setInterval>;
        if (autoRefresh && id) {
            interval = setInterval(() => {
                const itemId = {% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %};
                fetchItem(itemId);
            }, refreshInterval);
        }
        return () => clearInterval(interval);
    }, [autoRefresh, refreshInterval, id, fetchItem]);
    {% endif %}

    useEffect(() => {
        if (id) {
            const itemId = {% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %};
            fetchItem(itemId).then((item) => {
                if (item) {
                    // Fetch FK data
                    {% for fk in model.foreign_keys %}
                    set{{ fk.target_model }}Data(null);
                    if (item.{{ fk.name.replace('_id', '') }}_id !== null && item.{{ fk.name.replace('_id', '') }}_id !== undefined) {
                        get{{ fk.target_model }}(item.{{ fk.name.replace('_id', '') }}_id).then(res => {
                             if (res) {
                                 set{{ fk.target_model }}Data(res);
                             }
                        });
                    }
                    {% endfor %}
                }
            });
            
            // Fetch M2M data
            {% if model.m2m_fields %}
            {% for m2m in model.m2m_fields %}
            fetch{{ m2m.target_model }}s(itemId, 1);
            {% endfor %}
            {% endif %}

            // Fetch Reverse M2M data
            {% if model.reverse_m2m %}
            {% for rel in model.reverse_m2m %}
            {% if rel.display %}
            fetch{{ model.name }}{{ rel.source_model }}s(itemId, 1);
            {% endif %}
            {% endfor %}
            {% endif %}

            // Fetch Reverse FK data
            {% if model.reverse_foreign_keys %}
            {% for rfk in model.reverse_foreign_keys %}
            {% if rfk.display %}
            fetch{{ rfk.source_model }}s(itemId, 1);
            {% endif %}
            {% endfor %}
            {% endif %}

            // Fetch Timeseries realtime data
            {% if model.reverse_timeseries %}
            {% for ts in model.reverse_timeseries %}
            fetch{{ ts.model_name }}Realtime(itemId);
            {% endfor %}
            {% endif %}

            // Fetch Timeseries history data
            {% if model.reverse_timeseries %}
            {% for ts in model.reverse_timeseries %}
            fetch{{ ts.model_name }}History(itemId);
            {% endfor %}
            {% endif %}
        }
    }, [id, fetchItem]);

    {% if model.m2m_fields %}
    {% for m2m in model.m2m_fields %}
    const fetch{{ m2m.target_model }}s = async (itemId: {{ 'string' if 'str' in model.id_type else 'number' }}, page: number, size: number = {{ m2m.name }}Size) => {
        set{{ m2m.target_model }}Loading(true);
        try {
            const result = await get{{ model.name }}{{ m2m.target_model }}s(itemId, page, size);
            set{{ m2m.target_model }}Data(result.items);
            set{{ m2m.target_model }}Total(result.total);
            set{{ m2m.target_model }}Page(result.page);
            set{{ m2m.target_model }}Size(result.size);
        } catch (error) {
            console.error(error);
        } finally {
            set{{ m2m.target_model }}Loading(false);
        }
    };
    {% endfor %}
    {% endif %}

    {% if model.reverse_m2m %}
    {% for rel in model.reverse_m2m %}
    {% if rel.display %}
    const fetch{{ model.name }}{{ rel.source_model }}s = async (itemId: {{ 'string' if 'str' in model.id_type else 'number' }}, page: number, size: number = {{ rel.name }}Size) => {
        set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Loading(true);
        try {
            const result = await get{{ model.name }}{{ rel.source_model }}s(itemId, page, size);
            set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Data(result.items);
            set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Total(result.total);
            set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Page(result.page);
            set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Size(result.size);
        } catch (error) {
            console.error(error);
        } finally {
            set{{ rel.name|replace('_', ' ')|title|replace(' ', '') }}Loading(false);
        }
    };
    {% endif %}
    {% endfor %}
    {% endif %}

    {% if model.reverse_foreign_keys %}
    {% for rfk in model.reverse_foreign_keys %}
    {% if rfk.display %}
    const build{{ rfk.source_model }}SearchFilters = (values: Record<string, any>) => {
        const filters: Record<string, any> = {};
        {% for field in rfk.source_search_fields %}
        {% if field.ui_type == 'bool' %}
        if (values['{{ field.name }}'] === 'true') filters['{{ field.name }}'] = true;
        if (values['{{ field.name }}'] === 'false') filters['{{ field.name }}'] = false;
        {% elif field.ui_type == 'datetime' %}
        if (values['{{ field.name }}_from']) filters['{{ field.name }}_from'] = `${values['{{ field.name }}_from']}T00:00:00`;
        if (values['{{ field.name }}_to']) filters['{{ field.name }}_to'] = `${values['{{ field.name }}_to']}T23:59:59`;
        {% elif field.ui_type == 'time' %}
        if (values['{{ field.name }}']) filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% elif field.is_enum and field.is_multi_select %}
        if (Array.isArray(values['{{ field.name }}']) && values['{{ field.name }}'].length > 0) filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% elif field.is_enum %}
        if (values['{{ field.name }}'] && values['{{ field.name }}'] !== '__all__') filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% elif field.fk_info %}
        if (values['{{ field.name }}']) filters['{{ field.name }}'] = Number(values['{{ field.name }}']);
        {% elif field.ui_type == 'str' %}
        if (values['{{ field.name }}']) filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% endif %}
        {% endfor %}
        return filters;
    };

    const fetch{{ rfk.source_model }}s = async (
        itemId: {{ 'string' if 'str' in model.id_type else 'number' }},
        page: number,
        size: number = {{ rfk.name }}Size,
        searchValues: Record<string, any> = {{ rfk.name }}SearchValues
    ) => {
        set{{ rfk.source_model }}Loading(true);
        try {
            // Keep the parent relation fixed while applying the child model's list filters.
            const filters = { {{ rfk.source_fk_field }}: itemId, ...build{{ rfk.source_model }}SearchFilters(searchValues) };
            const result = await get{{ rfk.source_model }}s(page, size, filters);
            set{{ rfk.source_model }}Data(result.items);
            set{{ rfk.source_model }}Total(result.total);
            set{{ rfk.source_model }}Page(result.page);
            set{{ rfk.source_model }}Size(result.size);
        } catch (error) {
            console.error(error);
        } finally {
            set{{ rfk.source_model }}Loading(false);
        }
    };

    const {{ rfk.name }}SearchListenerReady = useRef(false);
    useEffect(() => {
        if (!{{ rfk.name }}SearchListenerReady.current) {
            {{ rfk.name }}SearchListenerReady.current = true;
            return;
        }
        if (!id) return;
        const timer = setTimeout(() => {
            fetch{{ rfk.source_model }}s({% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %}, 1, {{ rfk.name }}Size, {{ rfk.name }}SearchValues);
        }, 300);
        return () => clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [{{ rfk.name }}SearchValues]);
    {% endif %}
    {% endfor %}
    {% endif %}

    {% if model.reverse_timeseries %}
    {% for ts in model.reverse_timeseries %}
    const fetch{{ ts.model_name }}Realtime = async (itemId: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
        try {
            const result = await get{{ ts.model_name }}Realtime(itemId);
            set{{ ts.model_name }}Realtime(result.data || []);
            set{{ ts.model_name }}Properties(result.properties || {});
            setTsLastRefreshed(new Date());
        } catch (error) {
            console.error(error);
        }
    };

    const fetch{{ ts.model_name }}History = async (itemId: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
        set{{ ts.model_name }}HistoryLoading(true);
        try {
            let limit = -1;
            let startTime: string | undefined;
            let endTime: string | undefined;
            if ({{ ts.model_name }}TimeRange === 'latest100') {
                limit = 100;
            } else if ({{ ts.model_name }}TimeRange === 'custom') {
                startTime = {{ ts.model_name }}CustomStartTime || undefined;
                endTime = {{ ts.model_name }}CustomEndTime || undefined;
            } else {
                startTime = calcStartTime({{ ts.model_name }}TimeRange);
            }
            const result = await get{{ ts.model_name }}History(itemId, undefined, startTime, endTime, limit);
            set{{ ts.model_name }}History(result);
            setTsHistoryLastRefreshed(new Date());
        } catch (error) {
            console.error(error);
        } finally {
            set{{ ts.model_name }}HistoryLoading(false);
        }
    };

    const refresh{{ ts.model_name }}History = async (itemId: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
        try {
            let limit = -1;
            let startTime: string | undefined;
            let endTime: string | undefined;
            if ({{ ts.model_name }}TimeRange === 'latest100') {
                limit = 100;
            } else if ({{ ts.model_name }}TimeRange === 'custom') {
                startTime = {{ ts.model_name }}CustomStartTime || undefined;
                endTime = {{ ts.model_name }}CustomEndTime || undefined;
            } else {
                startTime = calcStartTime({{ ts.model_name }}TimeRange);
            }
            const result = await get{{ ts.model_name }}History(itemId, undefined, startTime, endTime, limit);
            set{{ ts.model_name }}History(result);
            setTsHistoryLastRefreshed(new Date());
        } catch (error) {
            console.error(error);
        }
    };
    {% endfor %}

    // Auto-refresh realtime data
    useEffect(() => {
        let interval: ReturnType<typeof setInterval>;
        if (tsAutoRefresh && id) {
            interval = setInterval(() => {
                const itemId = {% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %};
                {% for ts in model.reverse_timeseries %}
                fetch{{ ts.model_name }}Realtime(itemId);
                {% endfor %}
            }, 5000);
        }
        return () => clearInterval(interval);
    }, [tsAutoRefresh, id]);

    // Auto-refresh history data (no loading state to avoid flicker)
    useEffect(() => {
        let interval: ReturnType<typeof setInterval>;
        if (tsHistoryAutoRefresh && id) {
            interval = setInterval(() => {
                const itemId = {% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %};
                {% for ts in model.reverse_timeseries %}
                refresh{{ ts.model_name }}History(itemId);
                {% endfor %}
            }, 10000);
        }
        return () => clearInterval(interval);
    // Recreate the interval when the selected range changes so it does not
    // retain the initial `latest100` closure after the user selects 1h/6h/24h.
    }, [
        tsHistoryAutoRefresh,
        id,
        {% for ts in model.reverse_timeseries %}
        {{ ts.model_name }}TimeRange,
        {{ ts.model_name }}CustomStartTime,
        {{ ts.model_name }}CustomEndTime,
        {% endfor %}
    ]);

    {% for ts in model.reverse_timeseries %}
    const toggle{{ ts.model_name }}Metric = (metric: string) => {
        set{{ ts.model_name }}SelectedMetrics(prev =>
            prev.includes(metric)
                ? prev.filter(m => m !== metric)
                : [...prev, metric]
        );
    };

    {% if ts.metric_field %}
    const {{ ts.model_name }}Metrics = React.useMemo(() => {
        const set = new Set<string>();
        {{ ts.model_name }}History.forEach((row: any) => {
            if (row.{{ ts.metric_field }}) set.add(row.{{ ts.metric_field }});
        });
        return Array.from(set);
    }, [{{ ts.model_name }}History]);

    useEffect(() => {
        if ({{ ts.model_name }}Metrics.length > 0 && {{ ts.model_name }}SelectedMetrics.length === 0) {
            set{{ ts.model_name }}SelectedMetrics({{ ts.model_name }}Metrics);
        }
    }, [{{ ts.model_name }}Metrics.length]);

    const {{ ts.model_name }}ChartData = React.useMemo(() => {
        let filtered = {{ ts.model_name }}History;
        if ({{ ts.model_name }}TimeRange === 'custom') {
            const cs = {{ ts.model_name }}CustomStartTime ? new Date({{ ts.model_name }}CustomStartTime).getTime() : 0;
            const ce = {{ ts.model_name }}CustomEndTime ? new Date({{ ts.model_name }}CustomEndTime).getTime() : Infinity;
            filtered = {{ ts.model_name }}History.filter((row: any) => {
                const t = new Date(row.{{ ts.time_field }}).getTime();
                return t >= cs && t <= ce;
            });
        } else if ({{ ts.model_name }}TimeRange !== 'latest100') {
            const cutoff = Date.now() - {
                '1h': 3600000, '6h': 21600000, '24h': 86400000,
            }[{{ ts.model_name }}TimeRange]!;
            filtered = {{ ts.model_name }}History.filter((row: any) =>
                new Date(row.{{ ts.time_field }}).getTime() >= cutoff
            );
        }

        const numGroups: Record<string, { time: number; value: number }[]> = {};
        const nonNumGroups: Record<string, { time: number; value: any }[]> = {};
        filtered.forEach((row: any) => {
            const metric = row.{{ ts.metric_field }};
            const rawVal = row.value?.value;
            if (rawVal === undefined || rawVal === null) return;
            const numVal = Number(rawVal);
            if (!isNaN(numVal) && typeof rawVal !== 'boolean') {
                if (!numGroups[metric]) numGroups[metric] = [];
                numGroups[metric].push({ time: new Date(row.{{ ts.time_field }}).getTime(), value: numVal });
            } else {
                if (!nonNumGroups[metric]) nonNumGroups[metric] = [];
                nonNumGroups[metric].push({ time: new Date(row.{{ ts.time_field }}).getTime(), value: rawVal });
            }
        });
        Object.values(numGroups).forEach(g => g.sort((a, b) => a.time - b.time));
        Object.values(nonNumGroups).forEach(g => g.sort((a, b) => a.time - b.time));
        return { numeric: numGroups, nonNumeric: nonNumGroups };
    }, [{{ ts.model_name }}History, {{ ts.model_name }}TimeRange, {{ ts.model_name }}CustomStartTime, {{ ts.model_name }}CustomEndTime]);
    {% endif %}

    // Re-fetch history when time range changes
    useEffect(() => {
        if (!id) return;
        fetch{{ ts.model_name }}History({% if 'str' in model.id_type %}id{% else %}parseInt(id){% endif %});
    }, [{{ ts.model_name }}TimeRange, {{ ts.model_name }}CustomStartTime, {{ ts.model_name }}CustomEndTime]);
    {% endfor %}
    {% endif %}

    if (loading && !currentItem) {
        return (
            <div className="flex h-full items-center justify-center">
                <Loader2 className="h-8 w-8 animate-spin" />
            </div>
        );
    }

    if (!currentItem) {
        return (
            <div className="flex flex-col items-center justify-center space-y-4">
                <div className="text-xl font-semibold">Item not found</div>
                <Button onClick={() => navigate(-1)}>Go Back</Button>
            </div>
        );
    }

    return (
        <div
            className="{{ page_shell_class | default('space-y-6') }}"
            data-codegen-theme="{{ codegen_theme | default('normal') }}"
            data-page-kind="detail"
        >
            <div className="flex flex-wrap items-center justify-between gap-3" data-page-region="page-header">
              <div className="flex min-w-0 items-center space-x-4">
                <Button variant="ghost" size="icon" onClick={() => navigate(-1)}>
                    <ArrowLeft className="h-4 w-4" />
                </Button>
                <h1 className="text-3xl font-bold tracking-tight">{t('models.{{ model.module_name }}.name')} {t('common.details')}</h1>
              </div>

              <div className="flex min-w-0 flex-wrap items-center justify-end gap-2" data-page-region="page-actions">
                {% if model.actions %}
                {% for action_name, action_config in model.actions.items() %}
                {(() => {
                    const actionPerms = {{ action_config.get("permissions", "da") | tojson }};
                    const roleChar = userRole[0];
                    if (!actionPerms.includes(roleChar)) return false;
                    const cond = {{ action_config.get("condition", None) | tojson }} as any;
                    let enabled = true;
                    if (cond && currentItem) {
                        const field = cond.field;
                        const op = cond.op;
                        const expected = cond.value;
                        const actual = (currentItem as any)[field];
                        if (op === 'eq') enabled = actual === expected;
                        else if (op === 'ne') enabled = actual !== expected;
                        else if (op === 'in') enabled = Array.isArray(expected) ? expected.includes(actual) : false;
                        else if (op === 'not_in') enabled = Array.isArray(expected) ? !expected.includes(actual) : true;
                        else if (op === 'gt') enabled = actual > expected;
                        else if (op === 'gte') enabled = actual >= expected;
                        else if (op === 'lt') enabled = actual < expected;
                        else if (op === 'lte') enabled = actual <= expected;
                        else if (op === 'contains') enabled = actual?.includes(expected);
                        else if (op === 'startswith') enabled = String(actual).startsWith(String(expected));
                        else if (op === 'endswith') enabled = String(actual).endsWith(String(expected));
                        else if (op === 'is_null') enabled = actual === null || actual === undefined;
                        else if (op === 'is_not_null') enabled = actual !== null && actual !== undefined;
                    }
                    return enabled;
                })() && (
                <Button
                    variant="outline"
                    size="sm"
                    onClick={async () => {
                        if (!currentItem) return;
                        try {
                            await perform{{ model.name }}{{ action_name.capitalize() }}(currentItem.id);
                            toast.success(t('common.success', 'Success'));
                            fetchItem(currentItem.id);
                        } catch (e) {
                            toast.error(t('common.error', 'Error'));
                        }
                    }}
                >
                    {{ action_name }}
                </Button>
                )}
                {% endfor %}
                {% endif %}

                {% if model.page_edit %}
                {hasPermission('u') && !isEditing && (
                  <Button variant="outline" size="sm" onClick={startEditing}>
                    <Pencil className="mr-2 h-4 w-4" /> {t('common.edit')}
                  </Button>
                )}
                {isEditing && (
                  <>
                    <Button variant="outline" size="sm" onClick={() => setIsEditing(false)}>
                      <X className="mr-2 h-4 w-4" /> {t('common.cancel')}
                    </Button>
                    <Button size="sm" type="button" onClick={handleEditSubmit(onEditSave)}>
                      <Save className="mr-2 h-4 w-4" /> {t('common.save')}
                    </Button>
                  </>
                )}
                {% endif %}
              </div>

              {% if model.refresh_interval %}
              <div className="flex items-center gap-2">
                 <span className="text-sm text-muted-foreground">{t('common.auto_refresh')}</span>
                 <Switch checked={autoRefresh} onCheckedChange={setAutoRefresh} />
                 {autoRefresh && (
                    <Select value={String(refreshInterval)} onValueChange={(v) => setRefreshInterval(Number(v))}>
                        <SelectTrigger className="w-[100px] h-8">
                            <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                            <SelectItem value="1000">1s</SelectItem>
                            <SelectItem value="5000">5s</SelectItem>
                            <SelectItem value="10000">10s</SelectItem>
                            <SelectItem value="30000">30s</SelectItem>
                        </SelectContent>
                    </Select>
                 )}
              </div>
              {% endif %}
            </div>

            {% if model.m2m_fields or model.reverse_m2m or model.reverse_foreign_keys or model.json_array_fields or model.json_dict_fields %}
            <div className="flex gap-1 overflow-x-auto border-b" role="tablist" aria-label={t('common.related_information')}>
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'detail'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'detail' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('detail')}
                >
                    {t('common.details')}
                </Button>
                {% for field in model.json_array_fields %}
                {hasFieldPerm('{{ field.name }}', 'r') && (
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'json-array-{{ field.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'json-array-{{ field.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('json-array-{{ field.name }}')}
                >
                    {t('{{ field.label_key }}')}
                </Button>
                )}
                {% endfor %}
                {% for field in model.json_dict_fields %}
                {hasFieldPerm('{{ field.name }}', 'r') && (
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'json-dict-{{ field.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'json-dict-{{ field.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('json-dict-{{ field.name }}')}
                >
                    {t('{{ field.label_key }}')}
                </Button>
                )}
                {% endfor %}
                {% for m2m in model.m2m_fields %}
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'm2m-{{ m2m.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'm2m-{{ m2m.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('m2m-{{ m2m.name }}')}
                >
                    {t('models.{{ m2m.target_service }}.plural')}
                </Button>
                {% endfor %}
                {% for rel in model.reverse_m2m %}
                {% if rel.display %}
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'reverse-m2m-{{ rel.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'reverse-m2m-{{ rel.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('reverse-m2m-{{ rel.name }}')}
                >
                    {t('models.{{ rel.source_service }}.plural')}
                </Button>
                {% endif %}
                {% endfor %}
                {% for rfk in model.reverse_foreign_keys %}
                {% if rfk.display %}
                <Button
                    type="button"
                    role="tab"
                    aria-selected={activeTab === 'reverse-fk-{{ rfk.name }}'}
                    variant="ghost"
                    className={`shrink-0 rounded-none border-b-2 px-4 ${activeTab === 'reverse-fk-{{ rfk.name }}' ? 'border-primary text-foreground' : 'border-transparent text-muted-foreground'}`}
                    onClick={() => setActiveTab('reverse-fk-{{ rfk.name }}')}
                >
                    {t('models.{{ rfk.source_service }}.plural')}
                </Button>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

            <div className="{{ detail_grid_class | default('grid grid-cols-1 gap-6') }}" data-page-region="detail-grid">
                {activeTab === 'detail' && (
                <Card>
                    <CardHeader>
                        <CardTitle>{% if model.page_edit %}{isEditing ? t('common.edit') + ' ' : ''}{% endif %}{t('common.basic_information')}</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-4">
                        {% if model.page_edit %}{isEditing ? (
                        <form id="detail-edit-form" className="space-y-4">
                            {% for field in model.fields %}
                            {% if not field.fk_info and field not in model.json_array_fields and field not in model.json_dict_fields and 'u' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'u'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
                            <div className="{% if field.ui_type == 'bool' %}flex min-h-14 items-center justify-between gap-4 rounded-md border px-4 py-3{% else %}space-y-2{% endif %}">
                                <Label htmlFor="edit-{{ field.name }}"{% if field.ui_type == 'bool' %} className="cursor-pointer"{% endif %}>{t('{{ field.label_key }}')}</Label>
                                {% if field.ui_type == 'bool' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    defaultValue={ {{ 'true' if field.default else 'false' }} }
                                    render={({ field: { onChange, value } }) => (
                                        <Switch checked={value} onCheckedChange={onChange} id="edit-{{ field.name }}" />
                                    )}
                                />
                                {% elif field.ui_type == 'image' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <ImageUpload value={value} onChange={onChange} />
                                    )}
                                />
                                {% elif field.ui_type == 'images' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <ImagesUpload id="edit-{{ field.name }}" value={Array.isArray(value) ? value : []} onChange={onChange} />
                                    )}
                                />
                                {% elif field.ui_type == 'file' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <FileUpload
                                            value={value}
                                            onChange={onChange}
                                            allowDownload={ {{ "true" if field.allow_download else "false" }} }
                                        />
                                    )}
                                />
                                {% elif field.ui_type == 'video_stream' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <VideoStreamInput value={value} onChange={onChange} protocol="{{ field.stream_protocol }}" />
                                    )}
                                />
                                {% elif field.is_enum and field.is_multi_select %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <SearchableSelect
                                            value={value || []}
                                            onValueChange={onChange}
                                            multiple={true}
                                            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                            searchPlaceholder={`${t('common.search')}...`}
                                            loadOptions={async () => {{ field.enum_values | tojson }}.map((v: string) => ({
                                                label: t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v),
                                                value: v,
                                            }))}
                                        />
                                    )}
                                />
                                {% elif field.is_enum %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => {
                                        {% if model.module_name == "user" and model.name == "User" and field.name == "role" %}
                                        const filteredValues = userRole === 'developer'
                                            ? {{ field.enum_values | tojson }}
                                            : ({{ field.enum_values | tojson }} as string[]).filter(v => v !== 'developer');
                                        {% else %}
                                        const filteredValues = {{ field.enum_values | tojson }};
                                        {% endif %}
                                        return (
                                        <Select onValueChange={onChange} defaultValue={value}>
                                            <SelectTrigger>
                                                <SelectValue placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`} />
                                            </SelectTrigger>
                                            <SelectContent>
                                                {filteredValues.map((enumVal: string) => (
                                                    <SelectItem key={enumVal} value={enumVal}>{t(`models.{{ model.module_name }}.enums.{{ field.name }}.${enumVal}`, enumVal)}</SelectItem>
                                                ))}
                                            </SelectContent>
                                        </Select>
                                        );
                                    }}
                                />
                                {% elif field.ui_type == 'time' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <TimePicker
                                            value={value}
                                            onChange={onChange}
                                            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                        />
                                    )}
                                />
                                {% elif field.ui_type == 'location' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    defaultValue={null}
                                    render={({ field: { onChange, value } }) => (
                                        <LocationInput value={value} onChange={onChange} />
                                    )}
                                />
                                {% elif field.ui_type == 'json' %}
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    defaultValue={ {% if field.json_kind == 'array' %}[]{% else %}{}{% endif %} }
                                    render={({ field: { onChange, value } }) => (
                                        {% if field.json_model_schema %}
                                        <JsonModelEditor
                                            schema={ {{ field.json_model_schema | tojson }} }
                                            value={value}
                                            onChange={onChange}
                                        />
                                        {% elif field.json_item_schema and field.get('type', '').startswith('Dict[str,') %}
                                        <JsonModelDictEditor
                                            itemSchema={ {{ field.json_item_schema | tojson }} }
                                            value={value}
                                            onChange={onChange}
                                            {% if field.json_fixed_keys %}
                                            fixedKeys={ {{ field.json_fixed_keys | tojson }} }
                                            {% endif %}
                                            {% if field.json_lock_keys %}
                                            lockKeys
                                            {% endif %}
                                        />
                                        {% elif field.json_item_kind %}
                                        <JsonScalarArrayEditor itemKind="{{ field.json_item_kind }}" value={value} onChange={onChange} />
                                        {% elif field.json_item_schema %}
                                        <JsonModelArrayEditor
                                            itemSchema={ {{ field.json_item_schema | tojson }} }
                                            value={value}
                                            onChange={onChange}
                                            {% if model.property_config_meta and field.name == model.property_config_meta.field_name %}
                                            canAdd={'{{ model.property_config_meta.field_permissions }}'.includes('a')}
                                            canRemove={'{{ model.property_config_meta.field_permissions }}'.includes('l')}
                                            {% endif %}
                                        />
                                        {% else %}
                                        <JsonInput
                                            value={value}
                                            onChange={onChange}
                                            jsonKind="{{ field.json_kind or 'object' }}"
                                            placeholder={ {% if field.json_kind == 'array' %}"[\\n  \\n]"{% else %}"{\\n  \\n}"{% endif %} }
                                        />
                                        {% endif %}
                                    )}
                                />
                                {% else %}
                                <Input
                                    id="edit-{{ field.name }}"
                                    {% if field.ui_type == 'int' or field.ui_type == 'float' %}
                                    type="number"
                                    {% elif field.ui_type == 'datetime' %}
                                    type="datetime-local"
                                    {% elif field.ui_type == 'date' %}
                                    type="date"
                                    {% else %}
                                    type="text"
                                    {% endif %}
                                    {...register('{{ field.name }}', { required: {{ 'true' if field.required and not field.update_optional else 'false' }} })}
                                />
                                {% endif %}
                            </div>
                            )}{% endif %}
                            {% endfor %}
                            {% for field in model.fields %}
                            {% if field.fk_info and 'u' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'u') && (
                            <div className="space-y-2">
                                <Label>{t('{{ field.label_key }}')}</Label>
                                <Controller
                                    control={editControl}
                                    name="{{ field.name }}"
                                    render={({ field: { onChange, value } }) => (
                                        <SearchableSelect
                                            value={value}
                                            onValueChange={onChange}
                                            placeholder={`${t('common.select')} ${t('{{ field.label_key }}')}`}
                                            searchPlaceholder={`${t('common.search')} ${t('models.{{ field.fk_info.target_service }}.name')}...`}
                                            valueLabels={ edit{{ field.name|replace('_', ' ')|title|replace(' ', '') }}ValueLabels }
                                            loadOptions={async (query) => {
                                                const filters = query ? { {{ field.fk_info.label_field }}: query } : undefined;
                                                const response = await get{{ field.fk_info.target_model }}s(1, 20, filters);
                                                return response.items.map((item: any) => ({
                                                    label: item.{{ field.fk_info.label_field }} || item.id,
                                                    value: item.id
                                                }));
                                            }}
                                        />
                                    )}
                                />
                            </div>
                            )}{% endif %}
                            {% endfor %}
                        </form>
                        ) : ({% endif %}
                        {% if model.page_edit %}<>{% endif %}
                        {% for field in model.fields %}
                        {% if not field.fk_info and field not in model.json_array_fields and field not in model.json_dict_fields and 'r' in field.permissions %}{hasFieldPerm('{{ field.name }}', 'r'){% if field.name == model.owner_field %} && userRole !== 'user'{% endif %} && (
                        <div className="space-y-1">
                            <Label className="text-muted-foreground">{t('{{ field.label_key }}')}</Label>
                            <div className="font-medium">
                                {% if field.ui_type == 'bool' %}
                                <Badge variant={currentItem.{{ field.name }} ? "default" : "secondary"}>
                                    {currentItem.{{ field.name }} ? 'Yes' : 'No'}
                                </Badge>
                                {% elif field.is_enum and field.is_multi_select %}
                                <div className="flex flex-wrap gap-1">
                                {Array.isArray(currentItem.{{ field.name }}) && currentItem.{{ field.name }}.map((v: string) => (
                                    <Badge key={v} variant="default" className="px-2.5 py-0.5 text-xs font-medium shadow-sm whitespace-nowrap">{String(t(`models.{{ model.module_name }}.enums.{{ field.name }}.${v}`, v))}</Badge>
                                ))}
                                </div>
                                {% elif field.is_enum %}
                                {currentItem.{{ field.name }} != null ? (
                                    <Badge variant="default" className="px-2.5 py-0.5 text-xs font-medium shadow-sm whitespace-nowrap">{String(t(`models.{{ model.module_name }}.enums.{{ field.name }}.${currentItem.{{ field.name }}}`, currentItem.{{ field.name }}))}</Badge>
                                ) : '-'}
                                {% elif field.ui_type == 'image' %}
                                {currentItem.{{ field.name }} ? (
