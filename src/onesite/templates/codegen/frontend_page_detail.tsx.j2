                            <div className="flex items-center gap-2">
                                <span className="text-sm text-muted-foreground whitespace-nowrap">{t('common.page_size', 'Page size')}:</span>
                                <Select
                                    value={String({{ rfk.name }}Size)}
                                    onValueChange={(value) => fetch{{ rfk.source_model }}s({% if 'str' in model.id_type %}id!{% else %}parseInt(id!){% endif %}, 1, Number(value))}
