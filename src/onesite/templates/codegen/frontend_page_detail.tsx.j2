                            >
                                {t('common.next')}
                            </Button>
                            </div>
                        </div>
                        {% if model.page_edit and rfk.editor == 'inline' %}</>)}{% endif %}
                        {% endif %}
                    </CardContent>
                </Card>
                )}
                {% endif %}
                {% endfor %}
                {% endif %}

                {% if model.reverse_timeseries %}
                {% for ts in model.reverse_timeseries %}
