    const build{{ rfk.source_model }}SearchFilters = (values: Record<string, any>) => {
        const filters: Record<string, any> = {};
        {% for field in rfk.source_search_fields %}
        {% if field.ui_type == 'bool' %}
        if (values['{{ field.name }}'] === 'true') filters['{{ field.name }}'] = true;
        if (values['{{ field.name }}'] === 'false') filters['{{ field.name }}'] = false;
        {% elif field.ui_type == 'datetime' %}
        if (values['{{ field.name }}_from']) filters['{{ field.name }}_from'] = `${values['{{ field.name }}_from']}T00:00:00`;
        if (values['{{ field.name }}_to']) filters['{{ field.name }}_to'] = `${values['{{ field.name }}_to']}T23:59:59`;
        {% elif field.ui_type == 'time' %}
        if (values['{{ field.name }}']) filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% elif field.is_enum and field.is_multi_select %}
        if (Array.isArray(values['{{ field.name }}']) && values['{{ field.name }}'].length > 0) filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% elif field.is_enum %}
        if (values['{{ field.name }}'] && values['{{ field.name }}'] !== '__all__') filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% elif field.fk_info %}
        if (values['{{ field.name }}']) filters['{{ field.name }}'] = Number(values['{{ field.name }}']);
        {% elif field.ui_type == 'str' %}
        if (values['{{ field.name }}']) filters['{{ field.name }}'] = values['{{ field.name }}'];
        {% endif %}
        {% endfor %}
        return filters;
