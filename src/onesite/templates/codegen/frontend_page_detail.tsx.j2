                                            const response = await {{ rfk.source_model }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}SearchService.get{{ field.fk_info.target_model }}s(1, 20, filters);
                                            const options = response.items.map((item: any) => ({ label: item.{{ field.fk_info.label_field }} || item.id, value: item.id }));
                                            set{{ rfk.source_model }}{{ field.name|replace('_', ' ')|title|replace(' ', '') }}SearchLabels((current) => ({ ...current, ...Object.fromEntries(options.map((option: any) => [String(option.value), String(option.label)])) }));
