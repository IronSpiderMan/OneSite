                                        multiple={true}
                                        placeholder={t('common.all', 'All')}
                                        searchPlaceholder={`${t('common.search')}...`}
                                        loadOptions={async () => [
                                            {% for enum_val in field.enum_values %}
                                            { label: t('models.{{ rfk.source_service }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}'), value: '{{ enum_val }}' },
                                            {% endfor %}
                                        ]}
                                    />
                                    {% elif field.is_enum %}
                                    <Select
                                        value={ {{ rfk.name }}SearchValues['{{ field.name }}'] || '__all__' }
                                        onValueChange={(value) => set{{ rfk.source_model }}SearchValues((current) => ({ ...current, ['{{ field.name }}']: value }))}
                                    >
                                        <SelectTrigger className="h-9 min-w-0 w-full"><SelectValue placeholder={t('common.all', 'All')} /></SelectTrigger>
                                        <SelectContent>
                                            <SelectItem value="__all__">{t('common.all', 'All')}</SelectItem>
                                            {% for enum_val in field.enum_values %}
                                            <SelectItem value="{{ enum_val }}">{t('models.{{ rfk.source_service }}.enums.{{ field.name }}.{{ enum_val }}', '{{ enum_val }}')}</SelectItem>
