                                                                await delete{{ rfk.source_model }}(item.id);
                                                                toast.success(t('toast.delete_success'));
                                                                await fetch{{ rfk.source_model }}s({% if 'str' in model.id_type %}id!{% else %}parseInt(id!){% endif %}, {{ rfk.name }}Page, {{ rfk.name }}Size);
                                                            } catch (error: any) {
