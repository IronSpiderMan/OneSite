{% raw %}
import { useCallback, useEffect, useRef, useState } from 'react';
import { AlertCircle, ArrowLeft, Check, ChevronDown, ChevronRight, CircleDot, Crosshair, Folder, FolderOpen, FolderTree, Home, Info, ListChecks, Loader2, Minus, Plus, Radio, RefreshCw, Search, Server, X } from 'lucide-react';
import { toast } from 'sonner';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { Dialog, DialogContent, DialogDescription, DialogTitle } from '../../components/ui/dialog';
import request, { getErrorMessage } from '../../utils/request';
import { createOpcuaNode, getOpcuaNodes, type OpcuaNode } from '../../services/opcua_node';
import { createOpcuaAc, getOpcuaAcs, type OpcuaAc } from '../../services/opcua_ac';

type Entry = { nodeid: string; stable_nodeid: string; title: string; node_class: string; is_condition: boolean };
type Location = { nodeid: string; title: string };
type LoadState = { items: Entry[]; loading: boolean; error?: string };
type Filter = 'all' | 'node' | 'ac';
type Result = { added: number; skipped: number; failed: number; message?: string };
const ROOT: Location = { nodeid: 'i=84', title: 'Root' };
const OBJECTS: Location = { nodeid: 'i=85', title: 'Objects' };
const normalId = (id?: string | null) => (id || '').trim().replace(/^ns=0;/, '');
const canSelect = (row: Entry) => row.is_condition || row.node_class === 'Variable';
const isDirectory = (row: Entry) => !row.is_condition && row.node_class !== 'Variable' && row.node_class !== 'Method';
const nodeKind = (row: Entry) => row.is_condition ? 'A&C' : row.node_class === 'Variable' ? '点位' : row.node_class === 'Object' ? '对象' : row.node_class;

function CheckBox({ checked, mixed, disabled, label, onChange }: { checked: boolean; mixed?: boolean; disabled?: boolean; label: string; onChange: () => void }) {
  return <button type="button" role="checkbox" aria-checked={mixed ? 'mixed' : checked} aria-label={label} disabled={disabled} onClick={onChange}
    className={`flex h-4 w-4 shrink-0 items-center justify-center rounded border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 ${checked || mixed ? 'border-primary bg-primary text-primary-foreground' : 'border-input bg-background hover:border-primary'}`}>
    {mixed ? <Minus className="h-3 w-3" /> : checked ? <Check className="h-3 w-3" /> : null}
  </button>;
}

export default function BrowsePanel({ serverId, serverTitle, open, onOpenChange, onAdded, onRestoreFocus, canReadNodes, canReadAcs, canAddNodes, canAddAcs }: {
  canReadNodes: boolean; canReadAcs: boolean; canAddNodes: boolean; canAddAcs: boolean;
  serverId: number; serverTitle: string; open: boolean; onOpenChange: (open: boolean) => void; onAdded: () => void; onRestoreFocus: () => void;
}) {
  const [path, setPath] = useState<Location[]>([ROOT, OBJECTS]);
  const [states, setStates] = useState<Record<string, LoadState>>({});
  const [expanded, setExpanded] = useState(new Set([ROOT.nodeid, OBJECTS.nodeid]));
  const [selected, setSelected] = useState<Record<string, Entry>>({});
  const [query, setQuery] = useState('');
  const [filter, setFilter] = useState<Filter>('all');
  const [showLocation, setShowLocation] = useState(false);
  const [address, setAddress] = useState('');
  const [notifier, setNotifier] = useState('i=2253');
  const [configured, setConfigured] = useState<{ nodes: OpcuaNode[]; acs: OpcuaAc[] }>({ nodes: [], acs: [] });
  const [configLoading, setConfigLoading] = useState(false);
  const [configError, setConfigError] = useState('');
  const [saving, setSaving] = useState(false);
  const [progress, setProgress] = useState({ done: 0, total: 0 });
  const [result, setResult] = useState<Result | null>(null);
  const [showSelection, setShowSelection] = useState(false);
  const [showTree, setShowTree] = useState(false);
  const cache = useRef(new Map<string, Entry[]>());
  const pending = useRef(new Map<string, Promise<void>>());
  const mounted = useRef(true);
  const searchRef = useRef<HTMLInputElement>(null);
  const current = path[path.length - 1];
  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);

  const load = useCallback((nodeid: string, force = false): Promise<void> => {
    const running = pending.current.get(nodeid);
    if (running) return running;
    if (!force && cache.current.has(nodeid)) return Promise.resolve();
    setStates(prev => ({ ...prev, [nodeid]: { items: prev[nodeid]?.items || [], loading: true } }));
    const task = request.get<{ items: Entry[] }>(`/opcua/${serverId}/browse`, { params: { nodeid }, suppressErrorToast: true })
      .then(({ data }) => {
        // A node can have several references under the same parent.
        const items = [...new Map(data.items.map(row => [row.nodeid, row])).values()];
        cache.current.set(nodeid, items);
        if (mounted.current) setStates(prev => ({ ...prev, [nodeid]: { items, loading: false } }));
      })
      .catch(error => { if (mounted.current) setStates(prev => ({ ...prev, [nodeid]: { items: prev[nodeid]?.items || [], loading: false, error: getErrorMessage(error, '无法读取节点，请检查服务器连接后重试') } })); })
      .finally(() => { pending.current.delete(nodeid); });
    pending.current.set(nodeid, task);
    return task;
  }, [serverId]);

  const loadConfigured = useCallback(async () => {
    setConfigLoading(true); setConfigError('');
    try {
      const [nodes, acs] = await Promise.all([
        canReadNodes ? getOpcuaNodes(1, -1, { opcua_server_id: serverId }) : Promise.resolve({ items: [] as OpcuaNode[] }),
        canReadAcs ? getOpcuaAcs(1, -1, { opcua_server_id: serverId }) : Promise.resolve({ items: [] as OpcuaAc[] }),
      ]);
      const next = { nodes: nodes.items, acs: acs.items };
      if (mounted.current) setConfigured(next);
      return next;
    } catch (error) {
      if (mounted.current) setConfigError(getErrorMessage(error, '无法读取已添加项，请刷新重试'));
      throw error;
    } finally { if (mounted.current) setConfigLoading(false); }
  }, [serverId, canReadNodes, canReadAcs]);

  useEffect(() => { if (open) { void load(ROOT.nodeid); void loadConfigured().catch(() => {}); } }, [open, load, loadConfigured]);
  useEffect(() => { if (open) void load(current.nodeid); }, [open, current.nodeid, load]);
  const navigate = (next: Location[]) => {
    setPath(next); setQuery(''); setShowLocation(false); setShowTree(false);
    setExpanded(prev => new Set([...prev, ...next.map(node => node.nodeid)]));
  };
  const enter = (row: Entry) => {
    const index = path.findIndex(p => p.nodeid === row.nodeid);
    navigate(index >= 0 ? path.slice(0, index + 1) : [...path, { nodeid: row.nodeid, title: row.title }]);
  };
  const isConfigured = (row: Entry, existing = configured) => {
    const ids = [normalId(row.nodeid), normalId(row.stable_nodeid)];
    return row.is_condition
      ? existing.acs.some(ac => ids.includes(normalId(ac.condition_id)) && normalId(ac.event_notifier_nodeid) === normalId(notifier))
      : existing.nodes.some(node => ids.includes(normalId(node.nodeid)));
  };
  const canAdd = (row: Entry) => row.is_condition ? canReadAcs && canAddAcs : canReadNodes && canAddNodes;
  const toggle = (row: Entry) => {
    if (!canAdd(row)) return;
    setResult(null);
    setSelected(prev => { const next = { ...prev }; if (next[row.nodeid]) delete next[row.nodeid]; else next[row.nodeid] = row; return next; });
  };
  const state = states[current.nodeid];
  const rows = state?.items || [];
  const matches = (row: Entry) => `${row.title} ${row.nodeid} ${row.stable_nodeid}`.toLowerCase().includes(query.toLowerCase());
  const counts = { all: rows.length, node: rows.filter(r => !r.is_condition && r.node_class === 'Variable').length, ac: rows.filter(r => r.is_condition).length };
  const visible = rows.filter(row => matches(row) && (filter === 'all' || (filter === 'ac' ? row.is_condition : !row.is_condition && row.node_class === 'Variable')))
    .sort((a, b) => Number(isDirectory(b)) - Number(isDirectory(a)) || a.title.localeCompare(b.title, 'zh-CN', { numeric: true }));
  const eligible = visible.filter(row => canSelect(row) && canAdd(row) && !isConfigured(row));
  const checkedCount = eligible.filter(row => selected[row.nodeid]).length;
  const selections = Object.values(selected);
  const nodesSelected = selections.filter(row => !row.is_condition);
  const acsSelected = selections.filter(row => row.is_condition);
  const editingDisabled = saving || configLoading;

  const add = async () => {
    if (saving || !selections.length) return;
    setSaving(true); setResult(null); setProgress({ done: 0, total: selections.length });
    const remaining = { ...selected };
    const outcome: Result = { added: 0, skipped: 0, failed: 0 };
    try {
      const latest = await loadConfigured();
      for (const [index, row] of selections.entries()) {
        if (!canAdd(row)) { outcome.failed++; outcome.message = '没有添加权限'; }
        else if (isConfigured(row, latest)) { outcome.skipped++; delete remaining[row.nodeid]; }
        else {
          try {
            const title = `${row.title} [${row.stable_nodeid}${row.is_condition ? `@${notifier.trim()}` : ''}]`;
            if (row.is_condition) await createOpcuaAc({ title, opcua_server_id: serverId, condition_id: row.stable_nodeid, event_notifier_nodeid: notifier.trim(), is_enabled: true });
            else await createOpcuaNode({ title, opcua_server_id: serverId, nodeid: row.stable_nodeid });
            outcome.added++; delete remaining[row.nodeid];
          } catch (error) { outcome.failed++; outcome.message = getErrorMessage(error, '请重试或在关联配置中手动添加'); }
        }
        setProgress({ done: index + 1, total: selections.length });
      }
      setSelected(remaining); setResult(outcome);
      if (outcome.failed) toast.error(`已添加 ${outcome.added} 项，${outcome.failed} 项未完成，已保留选择`);
      else toast.success(`已添加 ${outcome.added} 项${outcome.skipped ? `，跳过 ${outcome.skipped} 个已添加项` : ''}`);
    } catch (error) {
      setResult({ ...outcome, failed: selections.length, message: getErrorMessage(error, '无法读取现有配置，请重试') });
    } finally {
      setSaving(false);
      if (outcome.added) onAdded();
      void loadConfigured().catch(() => {});
    }
  };

  const renderTree = (location: Location, ancestry: Location[], depth = 0): React.ReactNode => {
    const nodeState = states[location.nodeid];
    const children = (nodeState?.items || []).filter(isDirectory);
    const isOpen = expanded.has(location.nodeid);
    const active = current.nodeid === location.nodeid;
    const loaded = cache.current.has(location.nodeid);
    const mayExpand = !loaded || children.length > 0;
    return <li key={location.nodeid}>
      <div className={`group flex h-9 min-w-0 items-center rounded-md pr-2 text-[13px] ${active ? 'bg-primary/10 font-medium text-primary' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`} style={{ paddingLeft: 8 + depth * 14 }}>
        <button type="button" className="flex h-7 w-5 shrink-0 items-center justify-center rounded focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-30" aria-label={`${isOpen ? '折叠' : '展开'} ${location.title}`} aria-expanded={mayExpand ? isOpen : undefined} disabled={saving || !mayExpand} onClick={() => {
          setExpanded(prev => { const next = new Set(prev); if (next.has(location.nodeid)) next.delete(location.nodeid); else next.add(location.nodeid); return next; });
          if (!isOpen) void load(location.nodeid);
        }}>{nodeState?.loading ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : mayExpand ? isOpen ? <ChevronDown className="h-3.5 w-3.5" /> : <ChevronRight className="h-3.5 w-3.5" /> : <span className="h-3.5 w-3.5" />}</button>
        <button type="button" disabled={saving} onClick={() => navigate(ancestry)} aria-current={active ? 'location' : undefined} title={location.nodeid} className="flex min-w-0 flex-1 items-center gap-2 rounded py-1 text-left focus-visible:ring-2 focus-visible:ring-ring">
          {isOpen ? <FolderOpen className="h-4 w-4 shrink-0" /> : <Folder className="h-4 w-4 shrink-0" />}<span className="truncate">{location.title}</span>
        </button>
      </div>
      {isOpen && <ul>{nodeState?.error && <li className="px-4 py-2 text-xs text-destructive"><button type="button" onClick={() => void load(location.nodeid, true)} disabled={saving}>读取失败，点击重试</button></li>}{children.filter(row => !ancestry.some(p => p.nodeid === row.nodeid)).map(row => renderTree(row, [...ancestry, { nodeid: row.nodeid, title: row.title }], depth + 1))}</ul>}
    </li>;
  };

  return <Dialog open={open} onOpenChange={next => { if (!saving) onOpenChange(next); }}>
    <DialogContent className="flex h-[min(840px,90dvh)] w-[96vw] max-w-[1480px] flex-col gap-0 overflow-hidden rounded-xl p-0 [&>button:last-child]:right-5 [&>button:last-child]:top-6" onOpenAutoFocus={event => { event.preventDefault(); searchRef.current?.focus(); }} onCloseAutoFocus={event => { event.preventDefault(); onRestoreFocus(); }} onEscapeKeyDown={event => { if (saving) event.preventDefault(); }} onInteractOutside={event => event.preventDefault()}>
      <header className="flex shrink-0 items-center gap-3 border-b px-5 py-4 pr-14 sm:px-6">
        <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary"><FolderTree className="h-5 w-5" /></div>
        <div className="min-w-0"><DialogTitle className="text-base">节点浏览器</DialogTitle><DialogDescription className="mt-1 flex items-center gap-1.5 text-xs"><Server className="h-3.5 w-3.5 shrink-0" /><span className="truncate">{serverTitle}</span><span className="hidden sm:inline">· 浏览服务器，选择需要接入的点位与 A&amp;C</span></DialogDescription></div>
      </header>
      <div className="relative grid min-h-0 flex-1 grid-cols-1 md:grid-cols-[200px_minmax(0,1fr)] xl:grid-cols-[216px_minmax(0,1fr)_288px]">
        {showTree && <button aria-label="收起目录" className="absolute inset-0 z-10 bg-black/20 md:hidden" onClick={() => setShowTree(false)} />}
        <aside className={`${showTree ? 'absolute inset-y-0 left-0 z-20 flex w-60 bg-background shadow-xl' : 'hidden'} min-h-0 flex-col border-r bg-muted/20 md:static md:flex md:w-auto md:shadow-none`}>
          <div className="flex h-12 shrink-0 items-center justify-between px-4"><span className="text-xs font-medium text-muted-foreground">服务器目录</span><button aria-label="收起目录" className="md:hidden" onClick={() => setShowTree(false)}><X className="h-4 w-4" /></button></div>
          <nav aria-label="服务器节点目录" className="min-h-0 flex-1 overflow-auto px-2 pb-4"><ul>{renderTree(ROOT, [ROOT])}</ul></nav>
          <p className="flex items-start gap-2 border-t p-4 text-[11px] leading-relaxed text-muted-foreground"><Info className="mt-0.5 h-3.5 w-3.5 shrink-0" />展开目录按需加载。此处始终显示目录，不受列表筛选影响。</p>
        </aside>
        <main className="flex min-h-0 min-w-0 flex-col bg-background">
          <div className="flex h-12 shrink-0 items-center gap-1 border-b px-3">
            <Button variant="ghost" size="icon" className="h-7 w-7 shrink-0 md:hidden" aria-label="打开服务器目录" onClick={() => setShowTree(true)}><FolderTree className="h-4 w-4" /></Button>
            <Button variant="ghost" size="icon" className="h-7 w-7 shrink-0" title="返回上层" aria-label="返回上层" disabled={saving || path.length <= 1} onClick={() => navigate(path.slice(0, -1))}><ArrowLeft className="h-4 w-4" /></Button>
            <nav aria-label="当前位置" className="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto whitespace-nowrap text-xs">{path.map((node, index) => <span className="flex shrink-0 items-center gap-1" key={`${node.nodeid}-${index}`}>
              {index > 0 && <ChevronRight className="h-3 w-3 text-muted-foreground/50" />}<button disabled={saving} title={node.nodeid} aria-label={index === 0 && node.nodeid === ROOT.nodeid ? '返回 Root' : node.title} aria-current={index === path.length - 1 ? 'location' : undefined} className={`max-w-44 truncate rounded px-1.5 py-1 hover:bg-muted ${index === path.length - 1 ? 'font-medium text-foreground' : 'text-muted-foreground'}`} onClick={() => navigate(path.slice(0, index + 1))}>{index === 0 && node.nodeid === ROOT.nodeid ? <Home className="h-3.5 w-3.5" /> : node.title}</button>
            </span>)}</nav>
            <Button variant="ghost" size="icon" className="h-7 w-7 shrink-0" aria-label="刷新当前层" title="刷新当前层" disabled={saving || state?.loading} onClick={() => { void load(current.nodeid, true); void loadConfigured().catch(() => {}); }}><RefreshCw className={`h-3.5 w-3.5 ${state?.loading ? 'animate-spin' : ''}`} /></Button>
            <Button variant="ghost" size="sm" className="h-7 gap-1.5 px-2 text-xs" aria-label="NodeId 定位" aria-expanded={showLocation} disabled={saving} onClick={() => { setAddress(current.nodeid); setShowLocation(v => !v); }}><Crosshair className="h-3.5 w-3.5" /><span className="hidden sm:inline">NodeId 定位</span></Button>
          </div>
          {showLocation && <form className="flex shrink-0 items-center gap-2 border-b bg-muted/20 px-4 py-3" onSubmit={event => { event.preventDefault(); if (address.trim()) navigate([{ nodeid: address.trim(), title: address.trim() }]); }}><Input autoFocus aria-label="定位 NodeId" className="h-8 font-mono text-xs" placeholder="ns=2;s=Device，或 nsu=URI;s=Device" disabled={saving} value={address} onChange={e => setAddress(e.target.value)} /><Button size="sm" className="h-8" disabled={saving || !address.trim()}>定位</Button></form>}
          <div className="shrink-0 space-y-3 px-4 pb-0 pt-4">
            <div className="relative"><Search className="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-muted-foreground" /><Input ref={searchRef} className="h-9 pl-9 pr-8 text-sm" aria-label="搜索当前层节点" placeholder="搜索当前层名称或 NodeId…" value={query} onChange={e => setQuery(e.target.value)} />{query && <button type="button" aria-label="清除搜索" className="absolute right-2.5 top-2.5 text-muted-foreground hover:text-foreground" onClick={() => setQuery('')}><X className="h-4 w-4" /></button>}</div>
            <div className="flex items-center justify-between gap-2 border-b"><div className="flex gap-4" role="group" aria-label="当前层节点类型">{([['all', '全部'], ['node', '点位'], ['ac', 'A&C']] as const).map(([key, label]) => <button type="button" key={key} aria-pressed={filter === key} onClick={() => setFilter(key)} className={`flex items-center gap-1.5 border-b-2 pb-2.5 text-xs font-medium transition-colors ${filter === key ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground'}`}>{label}<span className={`rounded px-1.5 py-0.5 text-[10px] ${filter === key ? 'bg-primary/10' : 'bg-muted'}`}>{counts[key]}</span></button>)}</div><button type="button" className="mb-2 flex items-center gap-1 text-xs text-primary xl:hidden" aria-expanded={showSelection} onClick={() => setShowSelection(true)}><ListChecks className="h-4 w-4" />已选 {selections.length}</button></div>
          </div>
          {configError && <div role="alert" className="mx-4 mt-3 flex items-center gap-2 rounded-md bg-destructive/5 p-2 text-xs text-destructive"><AlertCircle className="h-4 w-4 shrink-0" /><span className="min-w-0 flex-1">{configError}</span><button type="button" disabled={configLoading || saving} onClick={() => void loadConfigured().catch(() => {})}>重试</button></div>}
          <div className="min-h-0 flex-1 overflow-auto px-4" aria-busy={state?.loading || configLoading}>
            {state?.loading && !rows.length ? <div className="flex h-full min-h-48 flex-col items-center justify-center gap-3 text-muted-foreground"><Loader2 className="h-6 w-6 animate-spin text-primary" /><p className="text-sm">正在读取服务器节点…</p></div>
              : state?.error ? <div className="flex h-full min-h-48 flex-col items-center justify-center gap-3 px-6 text-center"><AlertCircle className="h-8 w-8 text-destructive/60" /><p className="max-w-sm text-sm text-muted-foreground">{state.error}</p><Button variant="outline" size="sm" disabled={saving} onClick={() => void load(current.nodeid, true)}><RefreshCw className="mr-2 h-3.5 w-3.5" />重新连接</Button></div>
              : !visible.length ? <div className="flex h-full min-h-48 flex-col items-center justify-center gap-2 text-center text-muted-foreground"><Search className="mb-1 h-8 w-8 opacity-30" /><p className="text-sm">{query ? '没有匹配的节点' : filter === 'ac' ? '当前层没有 A&C 条件' : filter === 'node' ? '当前层没有点位' : '这个节点下没有子节点'}</p><p className="max-w-xs text-xs leading-relaxed">{filter === 'ac' ? '可从目录继续查找设备下的条件；仅通过事件公开的条件仍需手动配置。' : '可切换目录、返回上层，或调整筛选条件。'}</p>{(query || filter !== 'all') && <Button variant="ghost" size="sm" onClick={() => { setQuery(''); setFilter('all'); }}>显示当前层全部节点</Button>}</div>
              : <table className="w-full table-fixed border-collapse text-left text-sm"><colgroup><col className="w-9" /><col /><col className="w-[76px]" /><col className="w-9" /></colgroup><thead className="sticky top-0 z-[1] bg-background text-[11px] text-muted-foreground"><tr className="h-10 border-b"><th className="font-normal"><CheckBox checked={eligible.length > 0 && checkedCount === eligible.length} mixed={checkedCount > 0 && checkedCount < eligible.length} disabled={editingDisabled || !eligible.length} label="全选当前层可添加项" onChange={() => { setResult(null); setSelected(prev => { const next = { ...prev }; eligible.forEach(row => { if (checkedCount === eligible.length) delete next[row.nodeid]; else next[row.nodeid] = row; }); return next; }); }} /></th><th className="font-normal">节点名称 / NodeId</th><th className="font-normal">类型</th><th><span className="sr-only">浏览子节点</span></th></tr></thead><tbody>{visible.map(row => {
                const exists = isConfigured(row); const checked = !!selected[row.nodeid]; const selectable = canSelect(row); const childrenKnownEmpty = cache.current.has(row.nodeid) && !cache.current.get(row.nodeid)?.length;
                return <tr key={row.nodeid} className={`group h-[68px] border-b border-border/60 transition-colors ${checked ? 'bg-primary/[0.045]' : 'hover:bg-muted/40'}`}>
                  <td className="align-middle">{selectable ? <CheckBox checked={exists || checked} disabled={editingDisabled || exists || !canAdd(row)} label={exists ? `${row.title} 已添加` : `选择 ${row.title}`} onChange={() => toggle(row)} /> : <span className="block h-4 w-4" />}</td>
                  <td className="py-3 pr-3"><div className="flex min-w-0 items-center gap-2"><span className={`flex h-7 w-7 shrink-0 items-center justify-center rounded-md ${row.is_condition ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400' : selectable ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground'}`}>{row.is_condition ? <Radio className="h-3.5 w-3.5" /> : selectable ? <CircleDot className="h-3.5 w-3.5" /> : <Folder className="h-3.5 w-3.5" />}</span><div className="min-w-0 flex-1"><button disabled={saving} onClick={() => enter(row)} title={`浏览 ${row.title}`} className="block max-w-full truncate text-left text-[13px] font-medium hover:text-primary focus-visible:underline">{row.title}</button><div title={row.nodeid} className="mt-0.5 truncate font-mono text-[11px] text-muted-foreground">{row.nodeid}</div></div></div></td>
                  <td><span className={`inline-flex rounded px-1.5 py-0.5 text-[10px] font-medium ${exists ? 'text-emerald-600 dark:text-emerald-400' : row.is_condition ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'bg-muted text-muted-foreground'}`}>{exists ? <><Check className="mr-0.5 h-3 w-3" />已添加</> : nodeKind(row)}</span></td>
                  <td><Button variant="ghost" size="icon" className="h-7 w-7 text-muted-foreground" aria-label={`浏览 ${row.title} 的子节点`} disabled={saving || childrenKnownEmpty} onClick={() => enter(row)}><ChevronRight className="h-4 w-4" /></Button></td>
                </tr>;
              })}</tbody></table>}
          </div>
          <div className="flex h-10 shrink-0 items-center justify-between border-t px-4 text-[11px] text-muted-foreground"><span aria-live="polite">{state?.loading ? '正在刷新…' : `${visible.length} 个节点${query ? '匹配' : ''}`}{configLoading ? ' · 正在核对配置' : ''}</span><span>勾选添加 · 点击名称浏览下级</span></div>
        </main>
        {showSelection && <button aria-label="收起已选项" className="absolute inset-0 z-10 bg-black/20 xl:hidden" onClick={() => setShowSelection(false)} />}
        <aside className={`${showSelection ? 'absolute inset-y-0 right-0 z-20 flex w-[min(320px,100%)] shadow-xl' : 'hidden'} min-h-0 flex-col border-l bg-muted/20 xl:static xl:flex xl:w-auto xl:shadow-none ${showSelection ? '!bg-background xl:!bg-muted/20' : ''}`}>
          <div className="flex h-12 shrink-0 items-center justify-between border-b px-4"><h3 className="flex items-center gap-2 text-xs font-medium"><ListChecks className="h-4 w-4 text-primary" />已选择<span className="rounded bg-primary/10 px-1.5 py-0.5 text-[10px] text-primary">{selections.length}</span></h3><div className="flex items-center gap-3"><button type="button" disabled={saving || !selections.length} className="text-[11px] text-muted-foreground hover:text-destructive disabled:opacity-30" onClick={() => { setSelected({}); setResult(null); }}>清空</button><button type="button" aria-label="收起已选项" className="xl:hidden" onClick={() => setShowSelection(false)}><X className="h-4 w-4" /></button></div></div>
          <div className="min-h-0 flex-1 overflow-auto p-4">
            {!selections.length ? <div className="flex min-h-48 flex-col items-center justify-center px-2 text-center"><div className="mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-dashed text-muted-foreground/50"><ListChecks className="h-5 w-5" /></div><p className="text-xs font-medium text-muted-foreground">选择需要接入的节点</p><p className="mt-2 text-[11px] leading-relaxed text-muted-foreground/70">勾选左侧列表中的点位或 A&amp;C<br />切换目录会保留已选项</p></div> : <div className="space-y-5">{[{ title: '点位', items: nodesSelected }, { title: 'A&C 条件', items: acsSelected }].filter(group => group.items.length).map(group => <section key={group.title}><h4 className="mb-2 text-[11px] font-medium text-muted-foreground">{group.title}<span className="ml-1.5">{group.items.length}</span></h4><ul className="space-y-2">{group.items.map(row => <li key={row.nodeid} className="flex items-center gap-2 rounded-lg border bg-background p-2.5"><span className={row.is_condition ? 'text-amber-600 dark:text-amber-400' : 'text-primary'}>{row.is_condition ? <Radio className="h-3.5 w-3.5" /> : <CircleDot className="h-3.5 w-3.5" />}</span><div className="min-w-0 flex-1"><p className="truncate text-xs font-medium" title={row.title}>{row.title}</p><p className="mt-1 truncate font-mono text-[10px] text-muted-foreground" title={row.nodeid}>{row.nodeid}</p></div><button type="button" aria-label={`移除 ${row.title}`} disabled={saving} onClick={() => toggle(row)} className="rounded p-1 text-muted-foreground/50 hover:bg-muted hover:text-destructive disabled:opacity-30"><X className="h-3 w-3" /></button></li>)}</ul></section>)}</div>}
          </div>
          {acsSelected.length > 0 && <div className="shrink-0 border-t p-4"><label htmlFor={`notifier-${serverId}`} className="flex items-center gap-1.5 text-xs font-medium"><Radio className="h-3.5 w-3.5 text-amber-600" />A&amp;C 事件入口</label><Input id={`notifier-${serverId}`} className="mt-2 h-8 bg-background font-mono text-xs" aria-describedby={`notifier-hint-${serverId}`} disabled={saving} value={notifier} onChange={event => setNotifier(event.target.value)} placeholder="i=2253" /><p id={`notifier-hint-${serverId}`} className="mt-2 text-[11px] leading-relaxed text-muted-foreground">默认使用 Server 对象 i=2253。所选条件将共用此事件订阅入口。</p></div>}
          <p className="flex items-start gap-1.5 border-t px-4 py-3 text-[10px] leading-relaxed text-muted-foreground"><Info className="mt-0.5 h-3 w-3 shrink-0" />关闭窗口会保留选择，已添加的节点会自动跳过。</p>
        </aside>
      </div>
      {result && <div role="status" className={`flex shrink-0 items-start gap-2 border-t px-5 py-2.5 text-xs ${result.failed ? 'bg-destructive/5 text-destructive' : 'bg-emerald-500/5 text-emerald-600 dark:text-emerald-400'}`}>{result.failed ? <AlertCircle className="h-4 w-4 shrink-0" /> : <Check className="h-4 w-4 shrink-0" />}<span>已添加 {result.added} 项{result.skipped > 0 ? `，跳过 ${result.skipped} 个已添加项` : ''}{result.failed > 0 ? `；${result.failed} 项未完成，保留选择供重试。${result.message || ''}` : '，可继续浏览或关闭窗口。'}</span></div>}
      <footer className="flex shrink-0 flex-wrap items-center justify-between gap-3 border-t bg-background px-5 py-3 sm:px-6">
        <div className="min-w-0 text-xs text-muted-foreground" aria-live="polite">{saving ? <span className="flex items-center gap-2"><Loader2 className="h-3.5 w-3.5 animate-spin text-primary" />正在添加 {progress.done} / {progress.total}，请稍候…</span> : selections.length ? <span>已选 <strong className="font-medium text-foreground">{selections.length}</strong> 项<span className="ml-2">{nodesSelected.length > 0 ? `${nodesSelected.length} 个点位` : ''}{nodesSelected.length > 0 && acsSelected.length > 0 ? ' · ' : ''}{acsSelected.length > 0 ? `${acsSelected.length} 个 A&C` : ''}</span></span> : '从列表中勾选节点，批量添加到当前服务器'}</div>
        <div className="ml-auto flex gap-2"><Button size="sm" variant="outline" disabled={saving} onClick={() => onOpenChange(false)}>{result && !selections.length ? '完成' : '关闭'}</Button><Button size="sm" className="gap-1.5" disabled={saving || configLoading || !!configError || !selections.length || (acsSelected.length > 0 && !notifier.trim())} onClick={add}>{saving ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Plus className="h-3.5 w-3.5" />}{saving ? '正在添加' : `添加到服务器${selections.length ? ` (${selections.length})` : ''}`}</Button></div>
      </footer>
    </DialogContent>
  </Dialog>;
}

{% endraw %}
