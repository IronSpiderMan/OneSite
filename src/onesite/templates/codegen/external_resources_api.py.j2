from datetime import datetime, timezone
from typing import Any

from fastapi import APIRouter, Depends, HTTPException
from fastapi.encoders import jsonable_encoder
from sqlalchemy import func
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core import db, deps
from app.core.external_resource_config import RESOURCE_CONFIGS
from app.core.external_resources import (
    ExternalResourceTask,
    TaskStatus,
    get_external_resource_provider,
)

router = APIRouter(dependencies=[Depends(deps.get_current_active_admin)])


@router.get("")
async def list_tasks(
    provider: str | None = None,
    resource: str | None = None,
    status: str | None = None,
    offset: int = 0,
    limit: int = 100,
    session: AsyncSession = Depends(db.get_session),
) -> dict[str, Any]:
    offset = max(0, offset)
    limit = min(500, max(1, limit))
    statement = select(ExternalResourceTask).order_by(ExternalResourceTask.id.desc())
    count_statement = select(func.count()).select_from(ExternalResourceTask)
    if provider:
        statement = statement.where(ExternalResourceTask.provider == provider)
        count_statement = count_statement.where(ExternalResourceTask.provider == provider)
    if resource:
        statement = statement.where(ExternalResourceTask.resource == resource)
        count_statement = count_statement.where(ExternalResourceTask.resource == resource)
    if status:
        statement = statement.where(ExternalResourceTask.status == status)
        count_statement = count_statement.where(ExternalResourceTask.status == status)
    rows = (await session.exec(statement.offset(offset).limit(limit))).all()
    total = (await session.exec(count_statement)).one()
    return {
        "items": jsonable_encoder(rows),
        "total": total,
        "offset": offset,
        "limit": limit,
    }


@router.get("/capabilities")
async def capabilities() -> dict[str, Any]:
    result: dict[str, Any] = {}
    for name in sorted({item["provider"] for item in RESOURCE_CONFIGS}):
        result[name] = await get_external_resource_provider(name).capabilities()
    return result


@router.post("/{task_id}/retry")
async def retry_task(
    task_id: int,
    session: AsyncSession = Depends(db.get_session),
) -> dict[str, str]:
    task = await session.get(ExternalResourceTask, task_id)
    if task is None:
        raise HTTPException(status_code=404, detail="External resource task not found")
    task.status = TaskStatus.retry.value
    task.attempts = 0
    task.next_attempt_at = datetime.now(timezone.utc)
    task.locked_until = None
    task.last_error = None
    await session.commit()
    return {"status": "queued"}
