import asyncio
from typing import Any

from fastapi import APIRouter, Depends, HTTPException
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core import db, deps
from app.core.external_resource_config import RESOURCE_CONFIGS
from app.core.external_resources import (
    ExternalProviderState,
    external_resource_manager,
    get_external_resource_provider,
)

router = APIRouter(dependencies=[Depends(deps.get_current_active_admin)])


@router.get("")
async def list_providers(
    session: AsyncSession = Depends(db.get_session),
) -> list[ExternalProviderState]:
    configured = sorted({item["provider"] for item in RESOURCE_CONFIGS})
    states = {
        state.provider: state
        for state in (await session.exec(select(ExternalProviderState))).all()
    }
    return [
        states.get(name) or ExternalProviderState(provider=name)
        for name in configured
    ]


@router.get("/capabilities")
async def capabilities() -> dict[str, Any]:
    result: dict[str, Any] = {}
    for name in sorted({item["provider"] for item in RESOURCE_CONFIGS}):
        result[name] = await get_external_resource_provider(name).capabilities()
    return result


@router.post("/reconcile", status_code=202)
async def reconcile_all() -> dict[str, int]:
    asyncio.create_task(external_resource_manager.reconcile_all())
    return {"providers": len({item["provider"] for item in RESOURCE_CONFIGS})}


@router.post("/{provider}/reconcile", status_code=202)
async def reconcile_provider(provider: str) -> dict[str, str]:
    configured = {item["provider"] for item in RESOURCE_CONFIGS}
    if provider not in configured:
        raise HTTPException(status_code=404, detail="External provider not found")
    asyncio.create_task(external_resource_manager.reconcile_provider(provider))
    return {"status": "scheduled"}
