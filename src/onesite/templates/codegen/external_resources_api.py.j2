from typing import Any

from fastapi import APIRouter, Depends, HTTPException
from fastapi.encoders import jsonable_encoder
from sqlalchemy import func
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core import db, deps
from app.core.external_resource_config import RESOURCE_CONFIGS
from app.core.external_resources import (
    ExternalResourceBinding,
    ExternalResourceOutbox,
    enqueue_external_resource_change,
    get_external_resource_provider,
)

router = APIRouter(dependencies=[Depends(deps.get_current_user)])


@router.get("")
async def list_bindings(
    provider: str | None = None,
    resource_type: str | None = None,
    status: str | None = None,
    include_deleted: bool = False,
    offset: int = 0,
    limit: int = 100,
    session: AsyncSession = Depends(db.get_session),
) -> dict[str, Any]:
    offset = max(0, offset)
    limit = min(500, max(1, limit))
    summary_fields = (
        "id", "provider", "resource_type", "entity_id", "external_id", "status",
        "desired_revision", "applied_revision", "retry_count", "drift_count",
        "last_error", "last_observed_at", "last_synced_at", "last_drift_at",
        "last_checked_at", "next_check_at", "created_at", "updated_at",
    )
    summary_columns = [getattr(ExternalResourceBinding, name) for name in summary_fields]
    statement = select(*summary_columns).order_by(ExternalResourceBinding.updated_at.desc())
    count_statement = select(func.count()).select_from(ExternalResourceBinding)
    if provider:
        statement = statement.where(ExternalResourceBinding.provider == provider)
        count_statement = count_statement.where(ExternalResourceBinding.provider == provider)
    if resource_type:
        statement = statement.where(ExternalResourceBinding.resource_type == resource_type)
        count_statement = count_statement.where(ExternalResourceBinding.resource_type == resource_type)
    if status:
        statement = statement.where(ExternalResourceBinding.status == status)
        count_statement = count_statement.where(ExternalResourceBinding.status == status)
    elif not include_deleted:
        statement = statement.where(ExternalResourceBinding.status != "deleted")
        count_statement = count_statement.where(ExternalResourceBinding.status != "deleted")
    rows = (await session.exec(statement.offset(offset).limit(limit))).all()
    total = (await session.exec(count_statement)).one()
    items = [dict(zip(summary_fields, row, strict=True)) for row in rows]
    return {"items": jsonable_encoder(items), "total": total, "offset": offset, "limit": limit}


@router.get("/capabilities")
async def capabilities() -> dict[str, Any]:
    result: dict[str, Any] = {}
    for name in sorted({item["provider"] for item in RESOURCE_CONFIGS}):
        result[name] = await get_external_resource_provider(name).capabilities()
    return result


@router.get("/{resource_type}/{entity_id}")
async def get_binding(
    resource_type: str,
    entity_id: str,
    provider: str | None = None,
    session: AsyncSession = Depends(db.get_session),
) -> dict[str, Any]:
    statement = select(ExternalResourceBinding).where(
        ExternalResourceBinding.resource_type == resource_type,
        ExternalResourceBinding.entity_id == entity_id,
    )
    if provider is not None:
        statement = statement.where(ExternalResourceBinding.provider == provider)
    matches = (await session.exec(statement.limit(2))).all()
    if not matches:
        raise HTTPException(status_code=404, detail="External resource binding not found")
    if len(matches) > 1:
        raise HTTPException(
            status_code=409,
            detail="Multiple providers match; specify the provider query parameter",
        )
    binding = matches[0]
    outbox = (await session.exec(select(ExternalResourceOutbox).where(
        ExternalResourceOutbox.provider == binding.provider,
        ExternalResourceOutbox.resource_type == resource_type,
        ExternalResourceOutbox.entity_id == entity_id,
    ).order_by(ExternalResourceOutbox.id.desc()).limit(20))).all()
    return {"binding": jsonable_encoder(binding), "recent_jobs": jsonable_encoder(outbox)}


@router.post(
    "/{resource_type}/{entity_id}/retry",
    dependencies=[Depends(deps.get_current_active_admin)],
)
async def retry_binding(
    resource_type: str,
    entity_id: str,
    provider: str | None = None,
    session: AsyncSession = Depends(db.get_session),
) -> dict[str, str]:
    statement = select(ExternalResourceBinding).where(
        ExternalResourceBinding.resource_type == resource_type,
        ExternalResourceBinding.entity_id == entity_id,
    )
    if provider is not None:
        statement = statement.where(ExternalResourceBinding.provider == provider)
    matches = (await session.exec(statement.limit(2))).all()
    if not matches:
        raise HTTPException(status_code=404, detail="External resource binding not found")
    if len(matches) > 1:
        raise HTTPException(
            status_code=409,
            detail="Multiple providers match; specify the provider query parameter",
        )
    binding = matches[0]
    await enqueue_external_resource_change(
        session,
        resource_type=resource_type,
        provider=binding.provider,
        entity_id=entity_id,
        bump_revision=False,
    )
    await session.commit()
    return {"status": "queued"}
