class UserService:
    async def get(self, session: AsyncSession, id: int) -> Optional[User]:
        return await crud.get(session, id)

    async def get_multi(
        self,
        session: AsyncSession,
        *,
        page: int = 1,
        size: int = 20,
        {% for field in model.fields %}
        {% if field.is_search_field %}
        {% if field.ui_type == 'bool' %}
        {{ field.name }}: Optional[bool] = None,
        {% elif field.ui_type == 'datetime' %}
        {{ field.name }}_from: Optional[datetime] = None,
        {{ field.name }}_to: Optional[datetime] = None,
        {% elif field.ui_type == 'time' %}
        {{ field.name }}: Optional[time] = None,
        {% elif field.is_enum %}
        {{ field.name }}: Optional[str] = None,
        {% elif field.ui_type == 'str' %}
        {{ field.name }}: Optional[str] = None,
        {% endif %}
        {% endif %}
        {% endfor %}
        {% for fk in model.foreign_keys %}
        {{ fk.name }}: Optional[int] = None,
        {% endfor %}
    ) -> PaginatedResponse[User]:
        """
        Get paginated list with optional search and filter support.
        Combines CRUD get_multi and count into PaginatedResponse.
        """
        # Get total count first
        total = await crud.count(
            session,
            {% for field in model.fields %}
            {% if field.is_search_field %}
            {% if field.ui_type == 'bool' %}
            {{ field.name }}={{ field.name }},
            {% elif field.ui_type == 'datetime' %}
            {{ field.name }}_from={{ field.name }}_from,
            {{ field.name }}_to={{ field.name }}_to,
            {% elif field.ui_type == 'time' %}
            {{ field.name }}={{ field.name }},
            {% elif field.is_enum %}
            {{ field.name }}={{ field.name }},
            {% elif field.ui_type == 'str' %}
            {{ field.name }}={{ field.name }},
            {% endif %}
            {% endif %}
            {% endfor %}
            {% for fk in model.foreign_keys %}
            {{ fk.name }}={{ fk.name }},
            {% endfor %}
        )
        
        # Get items with FK labels
        items = await crud.get_multi_with_fk_labels(
            session,
            page=page,
            size=size,
            {% for field in model.fields %}
            {% if field.is_search_field %}
            {% if field.ui_type == 'bool' %}
            {{ field.name }}={{ field.name }},
            {% elif field.ui_type == 'datetime' %}
            {{ field.name }}_from={{ field.name }}_from,
            {{ field.name }}_to={{ field.name }}_to,
            {% elif field.ui_type == 'time' %}
            {{ field.name }}={{ field.name }},
            {% elif field.is_enum %}
            {{ field.name }}={{ field.name }},
            {% elif field.ui_type == 'str' %}
            {{ field.name }}={{ field.name }},
            {% endif %}
            {% endif %}
            {% endfor %}
            {% for fk in model.foreign_keys %}
            {{ fk.name }}={{ fk.name }},
            {% endfor %}
        )
        
        # Build response
        if size == -1:
            return PaginatedResponse.create(data=items, total=total, page=1, size=total)
        return PaginatedResponse.create(data=items, total=total, page=page, size=size)

    async def create(self, session: AsyncSession, obj_in: UserCreate) -> User:
        {% if model.fields | selectattr('is_unique') | list %}
        # Check unique field constraints
        {% for field in model.fields %}
        {% if field.is_unique and field.name != 'id' %}
        if getattr(obj_in, "{{ field.name }}", None) is not None:
            if not await crud.check_unique_field(session, "{{ field.name }}", obj_in.{{ field.name }}):
                raise ValueError("{{ field.name }} already exists")
        {% endif %}
        {% endfor %}
        {% endif %}
        from app.core.security import get_password_hash
        user_data = obj_in.dict(exclude_none=True)
        {% for field in model.fields | selectattr('json_item_kind') | list %}
        if isinstance(user_data.get("{{ field.name }}"), list):
            user_data["{{ field.name }}"] = [value.isoformat() if hasattr(value, "isoformat") else value for value in user_data["{{ field.name }}"]]
        {% endfor %}
        if 'password' in user_data:
            password = user_data.pop('password')
            user_data['hashed_password'] = get_password_hash(password)
        db_obj = User(**user_data)
        hook_context = ModelHookContext(
            operation="create",
            input_data=dict(user_data),
            changed_fields=frozenset(user_data),
        )
        try:
            await invoke_model_hook(
                db_obj,
                "on_before_create",
                session=session,
                context=hook_context,
            )
            session.add(db_obj)
            await session.flush()
            await session.refresh(db_obj)
            await invoke_model_hook(
                db_obj,
                "on_after_create",
                session=session,
                context=hook_context,
            )
            await session.flush()
            await session.commit()
            await session.refresh(db_obj)
        except Exception:
            await session.rollback()
            raise
        try:
            await invoke_model_hook(db_obj, "on_after_commit_create", context=hook_context)
        except Exception:
            logger.exception("Post-commit create hook failed for User id=%s", getattr(db_obj, "id", None))
        return db_obj

    async def update(self, session: AsyncSession, id: int, obj_in: Union[UserUpdate, UserUpdateMe]) -> User:
        """
        Update User by ID with validation.
        Raises ValueError if unique constraint is violated.
        Raises NotFoundError if object doesn't exist.
        """
        db_obj = await crud.get(session, id)
        if not db_obj:
            raise ValueError("User not found")
        
        {% if model.fields | selectattr('is_unique') | list %}
        # Check unique field constraints (only for fields being updated)
        {% for field in model.fields %}
        {% if field.is_unique and field.name != 'id' %}
        if getattr(obj_in, "{{ field.name }}", None) is not None and getattr(obj_in, "{{ field.name }}") != getattr(db_obj, "{{ field.name }}"):
            if not await crud.check_unique_field(session, "{{ field.name }}", obj_in.{{ field.name }}, exclude_id=id):
                raise ValueError("{{ field.name }} already exists")
        {% endif %}
        {% endfor %}
        {% endif %}
        
        old = snapshot_model(db_obj)
        changes = obj_in.dict(exclude_unset=True)
        new_password_hash = None
        if hasattr(obj_in, 'password') and obj_in.password:
            from app.core.security import get_password_hash
            new_password_hash = get_password_hash(obj_in.password)
            changes.pop("password", None)
            changes.pop("old_password", None)
            changes["hashed_password"] = new_password_hash
        hook_context = ModelHookContext(
            operation="update",
            input_data=dict(changes),
            changed_fields=frozenset(changes),
        )
        try:
            await invoke_model_hook(
                db_obj,
                "on_before_update",
                session=session,
                old=old,
                changes=changes,
                context=hook_context,
            )
            for key, value in changes.items():
                if hasattr(obj_in, key):
                    setattr(obj_in, key, value)
            if new_password_hash is not None:
                db_obj.hashed_password = changes.get("hashed_password", new_password_hash)
            obj = await crud.update(session, db_obj, obj_in, auto_commit=False)
            await invoke_model_hook(
                obj,
                "on_after_update",
                session=session,
                old=old,
                changes=changes,
                context=hook_context,
            )
            await session.flush()
            await session.commit()
            await session.refresh(obj)
        except Exception:
            await session.rollback()
            raise
        try:
            await invoke_model_hook(
                obj,
                "on_after_commit_update",
                old=old,
                changes=changes,
                context=hook_context,
            )
        except Exception:
            logger.exception("Post-commit update hook failed for User id=%s", id)
        return obj

    async def delete(self, session: AsyncSession, id: int) -> User:
        db_obj = await crud.get(session, id)
        if not db_obj:
            raise ValueError("User not found")
        old = snapshot_model(db_obj)
        hook_context = ModelHookContext(operation="delete")
        try:
            await invoke_model_hook(
                db_obj,
                "on_before_delete",
                session=session,
                old=old,
                context=hook_context,
            )
            deleted = await crud.delete(session, id, auto_commit=False)
            await invoke_model_hook(
                deleted,
                "on_after_delete",
                session=session,
                old=old,
                context=hook_context,
            )
            await session.flush()
            await session.commit()
        except Exception:
            await session.rollback()
            raise
        try:
            await invoke_model_hook(
                deleted,
                "on_after_commit_delete",
                old=old,
                context=hook_context,
            )
        except Exception:
            logger.exception("Post-commit delete hook failed for User id=%s", id)
        return deleted

    async def bulk_delete(self, session: AsyncSession, ids: List[int]) -> int:
        unique_ids = list(dict.fromkeys(ids))
        objects = []
        olds = []
        for id in unique_ids:
            obj = await crud.get(session, id)
            if obj is not None:
                objects.append(obj)
                olds.append(snapshot_model(obj))

        if not objects:
            return 0

        hook_context = ModelHookContext(
            operation="bulk_delete",
            input_data={"ids": unique_ids},
            changed_fields=frozenset(),
        )
        try:
            for obj, old in zip(objects, olds):
                delete_context = ModelHookContext(operation="delete")
                await invoke_model_hook(
                    obj,
                    "on_before_delete",
                    session=session,
                    old=old,
                    context=delete_context,
                )
                await crud.delete(session, obj.id, auto_commit=False)
                await invoke_model_hook(
                    obj,
                    "on_after_delete",
                    session=session,
                    old=old,
                    context=delete_context,
                )
            await invoke_model_hook(
                User,
                "on_after_bulk_delete",
                session=session,
                olds=olds,
                context=hook_context,
            )
            await session.flush()
            await session.commit()
        except Exception:
            await session.rollback()
            raise

        for obj, old in zip(objects, olds):
            try:
                await invoke_model_hook(
                    obj,
                    "on_after_commit_delete",
                    old=old,
                    context=ModelHookContext(operation="delete"),
                )
            except Exception:
                logger.exception(
                    "Post-commit delete hook failed for User id=%s",
                    getattr(obj, "id", None),
                )
        try:
            await invoke_model_hook(
                User,
                "on_after_commit_bulk_delete",
                olds=olds,
                context=hook_context,
            )
        except Exception:
            logger.exception(
                "Post-commit bulk delete hook failed for User ids=%s",
                unique_ids,
            )
        return len(objects)

    {% if model.reverse_m2m %}
    # Reverse M2M Relationship methods
    {% for rel in model.reverse_m2m %}
    async def get_{{ rel.name }}(
        self,
        session: AsyncSession,
        {{ model.lower_name }}_id: int,
        page: int = 1,
        size: int = 20,
    ) -> PaginatedResponse[{{ rel.source_model }}Read]:
        """
        Get {{ rel.source_model }}s related to {{ model.name }} (via M2M).
        """
        # Get total count
        total = await crud.count_{{ rel.name }}(session, {{ model.lower_name }}_id)

        if total == 0:
            return PaginatedResponse.create(data=[], total=0, page=page, size=size)

        # Get items (CRUD returns objects directly with pagination)
        items = await crud.get_{{ rel.name }}(session, {{ model.lower_name }}_id, page=page, size=size)

        # Convert to ReadSchema
        items_read = [{{ rel.source_model }}Read.model_validate(item) for item in items]
        if size == -1:
            return PaginatedResponse.create(data=items_read, total=total, page=1, size=total)
        return PaginatedResponse.create(data=items_read, total=total, page=page, size=size)
    {% endfor %}
    {% endif %}

service = UserService()
