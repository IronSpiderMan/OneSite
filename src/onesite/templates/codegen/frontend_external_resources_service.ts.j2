import request from '../utils/request';

export interface ExternalResourceBinding {
  id: number;
  provider: string;
  resource: string;
  entity_id: string;
  status: string;
  desired_version: number;
  synced_version: number;
  pending_count: number;
  retry_count: number;
  desired_hash?: string;
  observed_hash?: string;
  last_error?: string;
  last_synced_at?: string;
  last_checked_at?: string;
  last_drift_at?: string;
  updated_at: string;
}

export interface ExternalResourcePage {
  items: ExternalResourceBinding[];
  total: number;
  offset: number;
  limit: number;
}

export async function getExternalResources(includeDeleted = false, offset = 0, limit = 100) {
  return (await request.get<ExternalResourcePage>('/external-resources', {
    params: { include_deleted: includeDeleted, offset, limit },
  })).data;
}

export async function retryExternalResource(provider: string, resource: string, entityId: string) {
  return (await request.post(
    `/external-resources/${encodeURIComponent(provider)}/${encodeURIComponent(resource)}/${encodeURIComponent(entityId)}/retry`,
  )).data;
}

export async function checkExternalResources() {
  return (await request.post('/external-resources/check')).data;
}
