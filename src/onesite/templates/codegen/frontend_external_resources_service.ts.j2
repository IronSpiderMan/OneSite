import request from '../utils/request';

export interface ExternalProviderState {
  provider: string;
  status: 'unknown' | 'syncing' | 'synced' | 'degraded';
  desired_generation: number;
  synced_generation: number;
  checked_count: number;
  changed_count: number;
  failed_count: number;
  last_error?: string;
  last_started_at?: string;
  last_synced_at?: string;
  updated_at: string;
}

export async function getExternalProviders() {
  return (await request.get<ExternalProviderState[]>('/external-resources')).data;
}

export async function reconcileExternalProviders() {
  return (await request.post('/external-resources/reconcile')).data;
}

export async function reconcileExternalProvider(provider: string) {
  return (await request.post(
    `/external-resources/${encodeURIComponent(provider)}/reconcile`,
  )).data;
}
