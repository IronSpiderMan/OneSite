import request from '../utils/request';

export interface ExternalResourceTask {
  id: number;
  provider: string;
  resource: string;
  entity_id: string;
  operation: 'create' | 'update' | 'delete';
  status: 'pending' | 'processing' | 'retry' | 'failed';
  attempts: number;
  next_attempt_at: string;
  locked_until?: string;
  last_error?: string;
  created_at: string;
  updated_at: string;
}

export interface ExternalResourceTaskPage {
  items: ExternalResourceTask[];
  total: number;
  offset: number;
  limit: number;
}

export async function getExternalResourceTasks(offset = 0, limit = 100) {
  return (await request.get<ExternalResourceTaskPage>('/external-resources', {
    params: { offset, limit },
  })).data;
}

export async function retryExternalResourceTask(taskId: number) {
  return (await request.post(`/external-resources/${taskId}/retry`)).data;
}

export async function getExternalResourceCapabilities() {
  return (await request.get<Record<string, unknown>>('/external-resources/capabilities')).data;
}
