    for id in ids:
        obj = await service.get(session, id)
        if obj:
            objects.append(obj)
    {% if model.module_name == "user" and model.name == "User" %}
    # Validate the full request before deleting anything, so a protected user
    # cannot leave a bulk operation only partially applied.
    for obj in objects:
        if obj.id == current_user.id:
            raise HTTPException(status_code=403, detail="You cannot delete your own account")
        if getattr(obj, "email", "").casefold() == settings.FIRST_SUPERUSER.casefold():
            raise HTTPException(status_code=403, detail="The initial administrator cannot be deleted")
    {% endif %}
    delete_ids = []
    for obj in objects:
        {% if model.owner_field %}
        # Owner-scoped: non-admin users can only delete their own records
        if user_level < deps.ROLE_HIERARCHY.get("admin", 1):
            if getattr(obj, "{{ model.owner_field }}", None) != current_user.id:
                continue
        {% endif %}
