@router.post("/", response_model={{ model.name }}Read{% if model.is_notification_table %}, dependencies=[Depends(deps.get_current_user)]{% else %}, dependencies=[Depends(deps.require_role(deps.UserRole.{{ model.min_role_for_create }}))]{% endif %})
async def create_{{ model.lower_name }}(
    *,
    session: AsyncSession = Depends(db.get_session),
    {% if model.is_notification_table or model.actions or model.importable or model.exportable or model.module_name == "user" or model.owner_field or model.inline_relations %}
    current_user: User = Depends(deps.get_current_user),
    {% endif %}
    {{ model.lower_name }}_in: {{ model.name }}Create,
) -> Any:
    # Special permission check: admin cannot create developer role
    {% if model.module_name == "user" and model.name == "User" %}
    if hasattr({{ model.lower_name }}_in, 'role') and {{ model.lower_name }}_in.role == 'developer':
        user_level = deps.ROLE_HIERARCHY.get(current_user.role, 0)
        if user_level < deps.ROLE_HIERARCHY.get('developer', 2):
            raise HTTPException(status_code=403, detail="Only developers can create developer accounts")
    {% endif %}
    {% if model.owner_field %}
    # Owner-scoped: force owner_field to current_user.id for non-admin users
    user_level = deps.ROLE_HIERARCHY.get(current_user.role, 0)
    if user_level < deps.ROLE_HIERARCHY.get("admin", 1):
        setattr({{ model.lower_name }}_in, "{{ model.owner_field }}", current_user.id)
    {% endif %}
    {% if model.inline_relations %}
    _check_inline_relation_permissions({{ model.lower_name }}_in, current_user, updating=False)
    {% endif %}
    try:
        return await service.create(session, {{ model.lower_name }}_in)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

