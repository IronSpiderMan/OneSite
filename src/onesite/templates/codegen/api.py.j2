def _check_{{ model.module_name }}_import_permissions(current_user: User) -> str:
    """Return the caller's role after enforcing both import write operations."""
    raw_role = getattr(current_user, "role", "user")
    role = str(getattr(raw_role, "value", raw_role))
    permissions = {{ model.role_permissions | tojson }}.get(role, "")
    if "c" not in permissions or "u" not in permissions:
        raise HTTPException(
            status_code=403,
            detail="Import requires both create and update permissions",
        )
    return role


