@router.post("/export")
async def export_{{ model.lower_name }}s(
    *,
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
    language: str = Query("en", description="CSV header language"),
    filters: Optional[dict] = Body(None),
) -> Any:
    """
    Export {{ model.name }} records to CSV (async).
    Publishes a background task and returns immediately.
    The user will be notified via WebSocket when the export is complete.
    """
    raw_role = getattr(current_user, "role", "user")
    current_role = str(getattr(raw_role, "value", raw_role))
    if "r" not in {{ model.role_permissions | tojson }}.get(current_role, ""):
        raise HTTPException(status_code=403, detail="Export requires read permission")
    task_id = str(uuid.uuid4())
    effective_filters = dict(filters or {})
    {% if model.owner_field %}
    user_level = deps.ROLE_HIERARCHY.get(current_role, 0)
    if user_level < deps.ROLE_HIERARCHY.get("admin", 1):
        # Service/CRUD use ``owner_id`` as the stable scope argument even when
        # the configured model field has another name (for example creator_id).
        effective_filters["owner_id"] = current_user.id
    {% endif %}
    execution = BackgroundExecution(
        id=task_id,
        kind="export",
        name="{{ model.module_name }}",
        trigger="manual",
        requested_by=current_user.id,
        status="queued",
        progress=0,
        message="queued",
        inputs_json=json.dumps(
            {
                "language": language,
                "filters": effective_filters,
                "current_role": current_role,
            },
            ensure_ascii=False,
            default=str,
        ),
    )
    session.add(execution)
    await session.commit()

    try:
        task_queue.publish(
            "export.{{ model.module_name }}",
            {
                "task_id": task_id,
                "user_id": current_user.id,
                "filters": effective_filters,
                "language": language,
                "current_role": current_role,
            },
        )
    except Exception as exc:
        await mark_failed(task_id, f"Failed to queue export: {exc}")
        raise HTTPException(status_code=503, detail="Unable to queue export") from exc

    return execution_to_dict(execution)
{% endif %}

{% if model.importable %}
@router.post("/import")
async def import_{{ model.lower_name }}s(
    *,
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
    file: UploadFile = File(...),
    dry_run: bool = Query(False, description="Validate without importing"),
    background: bool = Query({{ 'True' if model.custom_importable else 'False' }}, description="Queue a trackable background import"),
) -> Any:
    """Import immediately for compatibility, or queue a trackable background job."""
    current_role = _check_{{ model.module_name }}_import_permissions(current_user)
    scoped_owner_id = None
    {% if model.owner_field %}
    user_level = deps.ROLE_HIERARCHY.get(current_role, 0)
    if user_level < deps.ROLE_HIERARCHY.get("admin", 1):
        scoped_owner_id = current_user.id
    {% endif %}

    {% if not model.custom_importable %}
    if not background:
        return await service.import_from_csv(
            session,
            task_id=str(uuid.uuid4()),
            user_id=current_user.id,
            file=file,
            dry_run=dry_run,
            current_role=current_role,
            scoped_owner_id=scoped_owner_id,
        )
    {% endif %}

    task_id = str(uuid.uuid4())
    upload_dir = Path(settings.UPLOAD_DIR) / "imports"
    upload_dir.mkdir(parents=True, exist_ok=True)
    filename = Path(file.filename or "upload").name or "upload"
    filepath = upload_dir / f"{{ model.module_name }}_{task_id}_{filename}"
    written = 0

    try:
        with filepath.open("wb") as destination:
            while chunk := await file.read(1024 * 1024):
                destination.write(chunk)
                written += len(chunk)
    except Exception:
        filepath.unlink(missing_ok=True)
        raise
    finally:
        await file.close()

    execution = BackgroundExecution(
        id=task_id,
        kind="import",
        name="{{ model.module_name }}",
        trigger="manual",
        requested_by=current_user.id,
        status="queued",
        progress=0,
        message="queued",
        inputs_json=json.dumps(
            {"filename": filename, "size": written, "dry_run": dry_run},
            ensure_ascii=False,
            default=str,
        ),
    )
    session.add(execution)
    try:
        await session.commit()
    except Exception:
        filepath.unlink(missing_ok=True)
        raise

    try:
        _publish_{{ model.module_name }}_import(
            {
                "task_id": task_id,
                "user_id": current_user.id,
                "file_path": str(filepath),
                "dry_run": dry_run,
                "current_role": current_role,
                "scoped_owner_id": scoped_owner_id,
            }
        )
    except Exception as exc:
        filepath.unlink(missing_ok=True)
        await mark_failed(task_id, f"Failed to queue import: {exc}")
        raise HTTPException(status_code=503, detail="Unable to queue import") from exc

    return execution_to_dict(execution)

{% if model.importable and not model.exportable and not model.custom_importable %}
@router.get("/export/template")
async def export_{{ model.lower_name }}_template(
    *,
    current_user: User = Depends(deps.get_current_user),
) -> Any:
    """
    Download CSV template for importing {{ model.name }} records.
    """
    from fastapi.responses import StreamingResponse
    import io
    import csv

    output = io.StringIO()
    writer = csv.writer(output)

    # Write header with field names - exclude id, created_at, updated_at
    fields = [{% for field in model.fields %}{% if field.name not in ['id', 'created_at', 'updated_at'] and 'c' in field.permissions %}"{{ field.name }}"{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
    writer.writerow(fields)

    # Write sample row
    sample = [{% for field in model.fields %}{% if field.name not in ['id', 'created_at', 'updated_at'] and 'c' in field.permissions %}{% if field.ui_type == 'int' %}0{% elif field.ui_type == 'float' %}0.0{% elif field.ui_type == 'bool' %}True{% else %}"sample"{% endif %}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
    writer.writerow(sample)

    output.seek(0)

    return StreamingResponse(
        io.BytesIO(output.getvalue().encode("utf-8-sig")),
        media_type="text/csv",
        headers={"Content-Disposition": f"attachment; filename={{ model.module_name }}_template.csv"}
    )
{% endif %}
{% endif %}
{% endif %}
