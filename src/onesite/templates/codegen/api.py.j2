    ids: List[{{ model.id_type }}] = Body(..., embed=True),
) -> dict[str, dict[str, dict[str, Any]]]:
    """Return dynamic action presentation state in one request per page."""
    if not ids:
        return {}
    if len(ids) > 200:
        raise HTTPException(status_code=400, detail="At most 200 action states may be requested")

    statement = select({{ model.name }}).where({{ model.name }}.id.in_(ids))
    {% if model.owner_field %}
    user_level = deps.ROLE_HIERARCHY.get(current_user.role.value, 0)
    if user_level < deps.ROLE_HIERARCHY.get("admin", 1):
        statement = statement.where({{ model.name }}.{{ model.owner_field }} == current_user.id)
    {% endif %}
    objects = (await session.exec(statement)).all()
    role_char_map = {"user": "u", "admin": "a", "developer": "d"}
    user_role_char = role_char_map.get(current_user.role.value, "")
    result: dict[str, dict[str, dict[str, Any]]] = {}

    for obj in objects:
        object_states: dict[str, dict[str, Any]] = {}
        {% for action_name, action_config in model.actions.items() %}
        {% if action_config.get("dynamic_availability") %}
        if user_role_char not in {{ action_config.get("permissions", "da") | tojson }}:
            object_states["{{ action_name }}"] = {"visible": False, "enabled": False}
        else:
            context = ActionContext(
                session=session,
                user=current_user,
                action_name="{{ action_name }}",
            )
            state = await evaluate_action_state(
                obj,
                availability_handler={% if action_config.get("availability_handler") %}{{ action_config.get("availability_handler") | tojson }}{% else %}None{% endif %},
                unavailable={{ action_config.get("unavailable", "hide") | tojson }},
                context=context,
            )
            {% if action_config.get("label") %}
            if state.label is None:
                state.label = {{ action_config.get("label") | tojson }}
            {% endif %}
            object_states["{{ action_name }}"] = state.as_dict()
        {% endif %}
        {% endfor %}
        result[str(obj.id)] = object_states
    return result

{% endif %}
{% for action_name, action_config in model.actions.items() %}
@router.post("/{id}/actions/{{ action_name }}", response_model={{ model.name }}Read)
async def perform_{{ model.lower_name }}_{{ action_name }}(
    *,
    session: AsyncSession = Depends(db.get_session),
    current_user: User = Depends(deps.get_current_user),
    id: {{ model.id_type }},
) -> Any:
    {% if action_config.get("function") %}
    obj = await crud.get(session, id)
    {% else %}
    obj = await service.get(session, id)
    {% endif %}
    if not obj:
        raise HTTPException(status_code=404, detail="{{ model.name }} not found")
    {% if model.owner_field %}
    user_level = deps.ROLE_HIERARCHY.get(current_user.role.value, 0)
    if user_level < deps.ROLE_HIERARCHY.get("admin", 1):
        if getattr(obj, "{{ model.owner_field }}", None) != current_user.id:
            raise HTTPException(status_code=404, detail="{{ model.name }} not found")
    {% endif %}

    import json
    action_data = json.loads("""{{ action_config | tojson }}""")

    # Check action-level permissions
    action_perms = action_data.get("permissions", "da")
    role_char_map = {"user": "u", "admin": "a", "developer": "d"}
    user_role_char = role_char_map.get(current_user.role.value, "")
    if user_role_char not in action_perms:
        raise HTTPException(status_code=403, detail="Permission denied")

    # Check condition if defined
    condition = action_data.get("condition")
    if condition:
        field = condition.get("field")
        op = condition.get("op")
        expected_value = condition.get("value")
        actual_value = getattr(obj, field, None)

        # Evaluate condition
        condition_passed = False
        if op == "eq":
            condition_passed = actual_value == expected_value
        elif op == "ne":
            condition_passed = actual_value != expected_value
        elif op == "in":
            condition_passed = actual_value in (expected_value if isinstance(expected_value, list) else [expected_value])
        elif op == "not_in":
            condition_passed = actual_value not in (expected_value if isinstance(expected_value, list) else [expected_value])
        elif op == "gt":
            condition_passed = actual_value > expected_value
        elif op == "gte":
            condition_passed = actual_value >= expected_value
        elif op == "lt":
            condition_passed = actual_value < expected_value
        elif op == "lte":
            condition_passed = actual_value <= expected_value
        elif op == "contains":
            condition_passed = expected_value in actual_value if actual_value else False
        elif op == "startswith":
            condition_passed = str(actual_value).startswith(expected_value) if actual_value else False
        elif op == "endswith":
            condition_passed = str(actual_value).endswith(expected_value) if actual_value else False
        elif op == "is_null":
            condition_passed = actual_value is None
        elif op == "is_not_null":
            condition_passed = actual_value is not None

        if not condition_passed:
            raise HTTPException(status_code=400, detail=f"Action '{{ action_name }}' not allowed: condition not met")

    {% if action_config.get("function") %}
    context = ActionContext(
        session=session,
        user=current_user,
        action_name="{{ action_name }}",
    )
    state = await evaluate_action_state(
        obj,
        availability_handler={% if action_config.get("availability_handler") %}{{ action_config.get("availability_handler") | tojson }}{% else %}None{% endif %},
        unavailable={{ action_config.get("unavailable", "hide") | tojson }},
        context=context,
    )
    if not state.visible or not state.enabled:
        raise HTTPException(
            status_code=409,
            detail=state.reason or "Action '{{ action_name }}' is not available",
        )

    try:
        await invoke_action_callable(getattr(obj, "{{ action_config.get('handler', action_name) }}"), context)
        session.add(obj)
        await session.commit()
        await session.refresh(obj)
        return obj
    except HTTPException:
        await session.rollback()
        raise
    except Exception as exc:
        await session.rollback()
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    {% else %}
    # Resolve special placeholders in data
    import re
    from datetime import datetime, timedelta

    resolved_data = {}
    for k, v in action_data.get("data", {}).items():
        if isinstance(v, str) and v == "{% raw %}{{user_id}}{% endraw %}":
            resolved_data[k] = current_user.id
        elif isinstance(v, str) and "{% raw %}{{value}}{% endraw %}" in v:
            current_val = getattr(obj, k, None)
            v_stripped = v.strip()
            # Simple {% raw %}{{value}}{% endraw %} - return current value as-is
            if v_stripped == "{% raw %}{{value}}{% endraw %}":
                resolved_data[k] = current_val
            # Boolean toggle: !{% raw %}{{value}}{% endraw %}
            elif isinstance(current_val, bool) and v_stripped == "!{% raw %}{{value}}{% endraw %}":
                resolved_data[k] = not current_val
            # String concatenation: {% raw %}{{value}}{% endraw %} + "suffix"
            elif isinstance(current_val, str):
                m = re.match(r'\{\{value\}\}\s*\+\s*["\'](.+?)["\']', v_stripped)
                if m:
                    resolved_data[k] = current_val + m.group(1)
                else:
                    resolved_data[k] = v
            # Numeric operations: {% raw %}{{value}}{% endraw %} + N, {% raw %}{{value}}{% endraw %} - N, {% raw %}{{value}}{% endraw %} * N, {% raw %}{{value}}{% endraw %} / N
            elif isinstance(current_val, (int, float)):
                m = re.match(r'\{\{value\}\}\s*([+\-*/])\s*(\d+(?:\.\d+)?)', v_stripped)
                if m:
                    op, num_str = m.groups()
                    num = float(num_str) if '.' in num_str else int(num_str)
                    if op == '+':
                        resolved_data[k] = current_val + num
                    elif op == '-':
                        resolved_data[k] = current_val - num
                    elif op == '*':
                        resolved_data[k] = current_val * num
                    elif op == '/':
                        resolved_data[k] = current_val / num
                else:
                    resolved_data[k] = v
            # Datetime operations: {% raw %}{{value}}{% endraw %} + N or {% raw %}{{value}}{% endraw %} - N (seconds)
            elif isinstance(current_val, datetime):
                m = re.match(r'\{\{value\}\}\s*([+\-])\s*(\d+)', v_stripped)
                if m:
                    op, num_str = m.groups()
                    seconds = int(num_str)
                    if op == '+':
                        resolved_data[k] = current_val + timedelta(seconds=seconds)
                    elif op == '-':
                        resolved_data[k] = current_val - timedelta(seconds=seconds)
                else:
                    resolved_data[k] = v
            else:
                resolved_data[k] = v
        else:
            resolved_data[k] = v

    try:
        update_obj = {{ model.name }}Update(**resolved_data)
        return await service.update(session, id, update_obj)
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))
    {% endif %}
{% endfor %}
{% endif %}

