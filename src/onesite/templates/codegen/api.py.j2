{% if model.inline_relations %}
def _check_inline_relation_permissions(payload: Any, current_user: User, *, updating: bool) -> None:
    raw_role = getattr(current_user, "role", "user")
    role = str(getattr(raw_role, "value", raw_role))
    {% for rel in model.inline_relations %}
    {{ rel.write_name }}_items = getattr(payload, "{{ rel.write_name }}", None)
    if {{ rel.write_name }}_items is not None:
        permissions = {{ rel.role_permissions | tojson }}.get(role, "")
        for item in {{ rel.write_name }}_items:
            required = "u" if getattr(item, "id", None) is not None else "c"
            if required not in permissions:
                raise HTTPException(
                    status_code=403,
                    detail=f"No {required} permission for {{ rel.target_model }}",
                )
        {% if rel.remove_permission %}
        if updating and "{{ rel.remove_permission }}" not in permissions:
            raise HTTPException(
                status_code=403,
                detail="No {{ rel.remove_permission }} permission for removing {{ rel.target_model }} items",
            )
        {% endif %}
    {% endfor %}

{% endif %}

