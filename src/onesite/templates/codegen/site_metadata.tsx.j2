import { useEffect } from 'react';
{% if system_model and site_name_field %}
import { use{{ system_model.name }}Store } from './stores/use{{ system_model.name }}Store';
{% endif %}

const fallbackSiteName = import.meta.env.VITE_PROJECT_NAME || 'OneSite';

const applySiteName = (value: unknown) => {
  const siteName = typeof value === 'string' && value.trim() ? value.trim() : fallbackSiteName;
  document.title = siteName;
  localStorage.setItem('onesite_site_name', siteName);
  window.dispatchEvent(new CustomEvent('onesite:site_name_updated', { detail: siteName }));
};

export default function SiteMetadata() {
{% if system_model and site_name_field %}
{% if site_name_field.is_local_storage %}
  const siteName = use{{ system_model.name }}Store((state) => state.localData.site_name);
{% else %}
  const siteName = use{{ system_model.name }}Store((state) => state.data?.site_name);
{% endif %}
  const fetchData = use{{ system_model.name }}Store((state) => state.fetchData);

  useEffect(() => {
    void fetchData();
  }, [fetchData]);

  useEffect(() => {
    applySiteName(siteName ?? localStorage.getItem('onesite_site_name'));
  }, [siteName]);
{% else %}
  useEffect(() => {
    applySiteName(localStorage.getItem('onesite_site_name'));
  }, []);
{% endif %}

  return null;
}
