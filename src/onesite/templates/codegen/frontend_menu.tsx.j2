import React from 'react';
import { {% for icon in used_icons %}{{ icon }}{% if not loop.last %}, {% endif %}{% endfor %} } from 'lucide-react';

type RoleVisibility = Record<string, boolean>;

export type GeneratedMenuItem = {
  type: 'item';
  key: string;
  icon: React.ReactNode;
  label: string;
  myLabel?: string;
  visible: RoleVisibility;
};

export type GeneratedMenuGroup = {
  type: 'group';
  key: string;
  icon: React.ReactNode;
  label: string;
  visible: RoleVisibility;
  defaultOpen: boolean;
  children: GeneratedMenuNode[];
};

export type GeneratedMenuNode = GeneratedMenuItem | GeneratedMenuGroup;

{% macro render_node(node) -%}
{% if node.type == 'group' -%}
{
  type: 'group',
  key: {{ node.key | tojson }},
  icon: <{{ node.icon }} className="h-4 w-4" />,
  label: {{ node.label | tojson }},
  visible: {{ node.visible | tojson }},
  defaultOpen: {{ node.default_open | tojson }},
  children: [
    {% for child in node.children %}{{ render_node(child) | indent(4, true) }}{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
}
{% else -%}
{
  type: 'item',
  key: {{ node.key | tojson }},
  icon: <{{ node.icon }} className="h-4 w-4" />,
  label: {{ node.label | tojson }},{% if node.my_label %}
  myLabel: {{ node.my_label | tojson }},{% endif %}
  visible: {{ node.visible | tojson }},
}
{% endif -%}
{%- endmacro %}

export const GeneratedMenu: GeneratedMenuNode[] = [
{% for node in navigation %}  {{ render_node(node) | indent(2, true) }}{% if not loop.last %},{% endif %}
{% endfor %}];

function isVisible(visible: RoleVisibility, userRole: string): boolean {
  return visible[userRole] ?? false;
}

export function filterMenuByRole(
  menu: GeneratedMenuNode[],
  userRole: string,
): GeneratedMenuNode[] {
  return menu.flatMap<GeneratedMenuNode>((node): GeneratedMenuNode[] => {
    if (!isVisible(node.visible, userRole)) return [];
    if (node.type === 'item') {
      return [
        userRole === 'user' && node.myLabel
          ? { ...node, label: node.myLabel }
          : node,
      ];
    }
    const children = filterMenuByRole(node.children, userRole);
    return children.length ? [{ ...node, children }] : [];
  });
}

export function findMenuItem(
  menu: GeneratedMenuNode[],
  pathname: string,
): GeneratedMenuItem | undefined {
  for (const node of menu) {
    if (node.type === 'item' && node.key === pathname) return node;
    if (node.type === 'group') {
      const item = findMenuItem(node.children, pathname);
      if (item) return item;
    }
  }
  return undefined;
}

export function findMenuPath(
  menu: GeneratedMenuNode[],
  pathname: string,
): GeneratedMenuNode[] {
  for (const node of menu) {
    if (node.type === 'item' && node.key === pathname) return [node];
    if (node.type === 'group') {
      const childPath = findMenuPath(node.children, pathname);
      if (childPath.length) return [node, ...childPath];
    }
  }
  return [];
}
