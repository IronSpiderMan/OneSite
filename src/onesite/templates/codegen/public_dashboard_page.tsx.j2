import React, { useEffect, useState } from 'react';
import { Loader2 } from 'lucide-react';
import VisualizationChart from '../components/visualization-chart';
import {
  getPublicVisualizations, queryPublicVisualization,
  type VisualizationData, type VisualizationSpec,
} from '../services/visualizations';

const PublicDashboardPage: React.FC = () => {
  const [specs, setSpecs] = useState<VisualizationSpec[]>([]);
  const [data, setData] = useState<Record<string, VisualizationData>>({});
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const load = async () => {
      try {
        const nextSpecs = await getPublicVisualizations();
        setSpecs(nextSpecs);
        const results = await Promise.all(nextSpecs.map(async (spec) => [spec.key, await queryPublicVisualization(spec.key)] as const));
        setData(Object.fromEntries(results));
      } catch (reason: any) {
        setError(reason?.response?.data?.detail || 'Unable to load this dashboard.');
      }
    };
    void load();
  }, []);

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-8 sm:px-8">
      <div className="mx-auto max-w-7xl">
        <h1 className="mb-8 text-2xl font-semibold text-slate-900">{{ public_dashboard.title }}</h1>
        {error && <p className="rounded bg-red-50 p-4 text-red-700">{error}</p>}
        {!error && specs.length === 0 && <Loader2 className="mx-auto mt-20 animate-spin text-slate-400" />}
        <section className="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {specs.map((spec) => data[spec.key] && (
            <article key={spec.key} className="rounded-xl border bg-white p-5 shadow-sm">
              <h2 className="mb-4 text-lg font-medium text-slate-800">{spec.title}</h2>
              <VisualizationChart spec={spec} data={data[spec.key]} />
            </article>
          ))}
        </section>
      </div>
    </main>
  );
};

export default PublicDashboardPage;
