logger = logging.getLogger(__name__)


def _supports_context(function) -> bool:
    """Keep existing one-argument custom hooks backwards compatible."""
    try:
        parameters = inspect.signature(function).parameters.values()
    except (TypeError, ValueError):
        return False
    return any(
        parameter.name == "context" or parameter.kind == inspect.Parameter.VAR_KEYWORD
        for parameter in parameters
    )


async def _invoke_hook(function, *args, **kwargs):
    """Run synchronous custom hooks off the event loop."""
    if inspect.iscoroutinefunction(function):
        return await function(*args, **kwargs)
    value = await asyncio.to_thread(function, *args, **kwargs)
    if inspect.isawaitable(value):
        return await value
    return value


def _import_summary(value) -> dict:
    if not isinstance(value, dict):
        raise ValueError("Import must return a result dictionary")
    summary = dict(value)
    for key in ("success", "failed", "created", "updated"):
        if key in summary or key in {"success", "failed"}:
            summary[key] = int(summary.get(key, 0))
    raw_errors = summary.get("errors", [])
    errors = raw_errors if isinstance(raw_errors, list) else [str(raw_errors)]
    try:
        reported_error_count = int(summary.get("error_count", len(errors)))
    except (TypeError, ValueError):
        reported_error_count = len(errors)
    summary["error_count"] = max(reported_error_count, len(errors))
    summary["errors"] = [str(error)[:4000] for error in errors[:200]]
    summary["errors_truncated"] = bool(summary.get("errors_truncated")) or (
        summary["error_count"] > len(summary["errors"])
    )
    return summary


{% if model.exportable %}
@task_queue.handler("export.{{ model.module_name }}")
async def handle_export_{{ model.module_name }}(payload: dict) -> None:
    task_id = payload.get("task_id")
    user_id = payload.get("user_id")
    filters = payload.get("filters") or {}
    language = payload.get("language", "en")
    current_role = str(payload.get("current_role", "developer") or "developer")
    if not task_id:
        logger.warning("No task_id in export payload for {{ model.name }}")
        return

    context = ImportExportContext(
        task_id,
        current_role=current_role,
        {% if model.owner_field %}
        scoped_owner_id=filters.get("owner_id"),
        {% endif %}
    )
    await mark_running(task_id, "preparing_export")
    try:
        {% if model.custom_exportable %}
        from app.custom_io.{{ model.module_name }} import export_{{ model.module_name }}

        await context.set_progress(10, "running_custom_export")
        kwargs = {"context": context} if _supports_context(export_{{ model.module_name }}) else {}
        result = await _invoke_hook(export_{{ model.module_name }}, filters, **kwargs)
        filepath = Path(result)
        if not filepath.is_file():
            raise ValueError("Custom export must return the path of an existing file")

        export_dir = Path(settings.UPLOAD_DIR) / "exports"
        export_dir.mkdir(parents=True, exist_ok=True)
        filename = f"{{ model.module_name }}_export_{task_id}_{filepath.name}"
        destination = export_dir / filename
        if filepath.resolve() != destination.resolve():
            shutil.copy2(filepath, destination)
        filepath = destination
        await context.set_progress(98, "finalizing_export")
        {% else %}
        from sqlmodel.ext.asyncio.session import AsyncSession

        from app.core.db import engine
        from app.services.{{ model.module_name }} import service

        async with AsyncSession(engine, expire_on_commit=False) as session:
            filepath = await service.export_to_csv(
                session,
                task_id=task_id,
                user_id=user_id,
                filters=filters,
                language=language,
                current_role=current_role,
                progress_callback=context.set_progress,
            )
        filename = Path(filepath).name
        {% endif %}

        download_url = f"/uploads/exports/{filename}"
        await mark_succeeded(
            task_id,
            message="completed",
            result={"filename": filename},
            download_url=download_url,
        )
        logger.info("Export completed for {{ model.name }}: %s", filepath)
    except Exception as exc:
        logger.exception("Export failed for {{ model.name }}")
        await mark_failed(task_id, str(exc) or "Export failed")
        {% if "export" in model.tracked_operations %}
        await record_operation(
            user_id=user_id,
            resource="{{ model.module_name }}",
            operation="export",
            status="failed",
        )
        {% endif %}
        if user_id is not None:
            try:
                await manager.send_personal_message(
                    {
                        "type": "export_complete",
                        "task_id": task_id,
                        "module": "{{ model.module_name }}",
                        "error": True,
                    },
                    user_id,
                )
            except Exception:
                logger.exception("Failed to send export error notification")
        return

    {% if "export" in model.tracked_operations %}
    await record_operation(
        user_id=user_id,
        resource="{{ model.module_name }}",
        operation="export",
        status="success",
    )
    {% endif %}

    if user_id is not None:
        try:
            await manager.send_personal_message(
                {
                    "type": "export_complete",
                    "task_id": task_id,
                    "module": "{{ model.module_name }}",
                    "download_url": download_url,
                    "filename": filename,
                },
                user_id,
            )
        except Exception:
            logger.exception("Failed to send export completion notification")


{% endif %}
{% if model.importable %}
@task_queue.handler("import.{{ model.module_name }}")
async def handle_import_{{ model.module_name }}(payload: dict) -> None:
    task_id = payload.get("task_id")
    user_id = payload.get("user_id")
    file_path = payload.get("file_path")
    dry_run = bool(payload.get("dry_run", False))
    current_role = str(payload.get("current_role", "developer") or "developer")
    scoped_owner_id = payload.get("scoped_owner_id")
    if not task_id:
        logger.warning("No task_id in import payload for {{ model.name }}")
        return

    uploaded_file = Path(file_path) if file_path else None
    context = ImportExportContext(
        task_id,
        current_role=current_role,
        scoped_owner_id=scoped_owner_id,
    )
    await mark_running(task_id, "reading_import_file")
    try:
        if uploaded_file is None or not uploaded_file.is_file():
            raise ValueError("Uploaded import file is missing")

        {% if model.custom_importable %}
        from app.custom_io.{{ model.module_name }} import import_{{ model.module_name }}

        await context.set_progress(10, "running_custom_import")
        kwargs = {"context": context} if _supports_context(import_{{ model.module_name }}) else {}
        result = await _invoke_hook(import_{{ model.module_name }}, uploaded_file, **kwargs)
        {% else %}
        from sqlmodel.ext.asyncio.session import AsyncSession

        from app.core.db import engine
        from app.services.{{ model.module_name }} import service

        async with AsyncSession(engine, expire_on_commit=False) as session:
            result = await service.import_from_csv(
                session,
                task_id=task_id,
                user_id=user_id,
                file=uploaded_file,
                dry_run=dry_run,
                current_role=current_role,
                scoped_owner_id=scoped_owner_id,
                progress_callback=context.set_progress,
            )
        {% endif %}

        summary = _import_summary(result)
        await mark_succeeded(
            task_id,
            message="completed",
            result=summary,
        )
        logger.info("Import completed for {{ model.name }}: %s", uploaded_file)
    except Exception as exc:
        logger.exception("Import failed for {{ model.name }}")
        await mark_failed(task_id, str(exc) or "Import failed")
        {% if "import" in model.tracked_operations %}
        if not dry_run:
            await record_operation(
                user_id=user_id,
                resource="{{ model.module_name }}",
                operation="import",
                status="failed",
            )
        {% endif %}
        if user_id is not None:
            try:
                await manager.send_personal_message(
                    {
                        "type": "import_complete",
                        "module": "{{ model.module_name }}",
                        "task_id": task_id,
                        "error": "Import failed. Please try again.",
                    },
                    user_id,
                )
            except Exception:
                logger.exception("Failed to send import error notification")
        return
    finally:
        if uploaded_file is not None:
            try:
                uploaded_file.unlink(missing_ok=True)
            except OSError:
                logger.exception("Failed to remove import upload %s", uploaded_file)

    {% if "import" in model.tracked_operations %}
    if not dry_run:
        await record_operation(
            user_id=user_id,
            resource="{{ model.module_name }}",
            operation="import",
            status="failed" if int(summary.get("failed", 0)) else "success",
        )
    {% endif %}

    if user_id is not None:
        try:
            await manager.send_personal_message(
                {
                    "type": "import_complete",
                    "module": "{{ model.module_name }}",
                    "task_id": task_id,
                    "result": {
                        key: summary[key]
                        for key in (
                            "success",
                            "failed",
                            "created",
                            "updated",
                            "error_count",
                            "errors_truncated",
                        )
                        if key in summary
                    },
                    "message": "{{ model.name }} import completed",
                },
                user_id,
            )
        except Exception:
            logger.exception("Failed to send import completion notification")
{% endif %}
