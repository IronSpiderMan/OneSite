"""Background export handler for {{ model.name }}.

Generates CSV exports in the background and notifies the user via WebSocket
when the export is complete.
"""

import logging
from app.core.task_queue import task_queue

logger = logging.getLogger(__name__)


@task_queue.handler("export.{{ model.module_name }}")
async def handle_export_{{ model.module_name }}(payload: dict):
    task_id = payload.get("task_id")
    user_id = payload.get("user_id")
    filters = payload.get("filters")

    if user_id is None:
        logger.warning("No user_id in export payload for {{ model.name }}")
        return

    from app.core.db import engine
    from app.core.ws import manager
    from sqlmodel.ext.asyncio.session import AsyncSession
    from app.services.{{ model.module_name }} import service

    async with AsyncSession(engine) as session:
        try:
            filepath = await service.export_to_csv(
                session,
                task_id=task_id or "",
                user_id=user_id,
                filters=filters,
            )

            import os
            filename = os.path.basename(filepath)
            download_url = f"/uploads/exports/{filename}"

            await manager.send_personal_message(
                {
                    "type": "export_complete",
                    "download_url": download_url,
                    "filename": filename,
                    "message": f"{{ model.name }} export completed",
                },
                user_id,
            )
            logger.info("Export completed for {{ model.name }}: %s", filepath)
        except Exception:
            logger.exception("Export failed for {{ model.name }}")
            try:
                await manager.send_personal_message(
                    {
                        "type": "export_complete",
                        "error": "Export failed. Please try again.",
                    },
                    user_id,
                )
            except Exception:
                logger.exception("Failed to send export error notification")
