"""OPC UA connection profiles provided by the opcua plugin."""

from typing import Optional, List
from enum import Enum
from urllib.parse import urlsplit
from sqlalchemy import Column, Enum as SAEnum
from onesite_runtime import override_field
from onesite.config import OneSiteConfig
from sqlmodel import Field, SQLModel, Relationship


class OpcuaAuthType(str, Enum):
    anonymous = "anonymous"
    username = "username"
    __i18n__ = {"zh": {"anonymous": "匿名", "username": "用户名密码"}}


class OpcuaSecurityPolicy(str, Enum):
    none = "None"
    basic256sha256 = "Basic256Sha256"
    __i18n__ = {"zh": {"None": "无", "Basic256Sha256": "Basic256Sha256"}}


class OpcuaSecurityMode(str, Enum):
    none = "None"
    sign = "Sign"
    sign_and_encrypt = "SignAndEncrypt"
    __i18n__ = {"zh": {"None": "无", "Sign": "签名", "SignAndEncrypt": "签名并加密"}}


class OpcuaServer(SQLModel, table=True):
    __tablename__ = "opcua_server"
    __onesite__ = OneSiteConfig(
        icon="Server",
        page_edit=True,
        permissions={"admin": "r", "developer": "crud"},
        visible={"user": False, "admin": False, "developer": True},
        track=["c", "u", "d", "bulk_delete"],
        network_device="endpoint",
        groups=[
            {"key": "default", "zh": "基本信息", "en": "General"},
            {"key": "auth", "zh": "用户认证", "en": "User authentication"},
            {"key": "security", "zh": "连接安全", "en": "Connection security"},
        ],
        translations={
            "zh": {
                "name": "OPCUA 服务",
                "fields": {
                    "title": "名称",
                    "description": "描述",
                    "endpoint": "地址",
                    "is_enabled": "是否启用",
                    "request_timeout_seconds": "请求超时（秒）",
                    "reconnect_interval_seconds": "重连间隔（秒）",
                    "publishing_interval_ms": "订阅发布间隔（毫秒）",
                    "auth_type": "用户认证方式",
                    "username": "用户名",
                    "password": "密码（编辑时留空保留）",
                    "security_policy": "安全策略",
                    "security_mode": "安全模式",
                    "app_uri": "客户端应用 URI",
                    "cert_path": "客户端证书",
                    "key_path": "客户端私钥（私有上传）",
                    "server_cert_path": "受信任的服务器证书",
                },
            }
        },
    )

    id: Optional[int] = Field(default=None, primary_key=True)

    title: str = Field(unique=True, min_length=1)
    description: Optional[str] = Field(default=None)

    endpoint: str = Field(nullable=False)
    is_enabled: bool = True
    request_timeout_seconds: float = Field(default=10, gt=0)
    reconnect_interval_seconds: float = Field(default=5, gt=0)
    publishing_interval_ms: float = Field(default=1000, gt=0)

    auth_type: OpcuaAuthType = Field(
        default=OpcuaAuthType.anonymous,
        sa_column=Column(
            SAEnum(
                OpcuaAuthType,
                values_callable=lambda cls: [item.value for item in cls],
                validate_strings=True,
            ),
            nullable=False,
            default="anonymous",
            info={"group": "auth"},
        ),
    )
    username: Optional[str] = Field(
        default=None,
        sa_column_kwargs={
            "info": {"group": "auth", "site_props": {"visible_when": {"auth_type": ["username"]}}}
        },
    )
    password: Optional[str] = Field(
        default=None,
        sa_column_kwargs={
            "info": {"group": "auth", "site_props": {"visible_when": {"auth_type": ["username"]}}}
        },
    )
    security_policy: OpcuaSecurityPolicy = Field(
        default=OpcuaSecurityPolicy.none,
        sa_column=Column(
            SAEnum(
                OpcuaSecurityPolicy,
                values_callable=lambda cls: [item.value for item in cls],
                validate_strings=True,
            ),
            nullable=False,
            default="None",
            info={"group": "security"},
        ),
    )
    security_mode: OpcuaSecurityMode = Field(
        default=OpcuaSecurityMode.none,
        sa_column=Column(
            SAEnum(
                OpcuaSecurityMode,
                values_callable=lambda cls: [item.value for item in cls],
                validate_strings=True,
            ),
            nullable=False,
            default="None",
            info={
                "group": "security",
                "site_props": {"visible_when": {"security_policy": ["Basic256Sha256"]}},
            },
        ),
    )

    @override_field("password")
    def hide_password(self, value) -> str:
        return ""

    @override_field("password", direction="write")
    def accept_password(self, value):
        return value

    @staticmethod
    def _validate_connection(values):
        import math

        for name in (
            "request_timeout_seconds",
            "reconnect_interval_seconds",
            "publishing_interval_ms",
        ):
            value = values.get(name)
            if not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
                raise ValueError(f"{name} 必须为大于 0 的有限数值")
        if not isinstance(values.get("title"), str) or not values["title"].strip():
            raise ValueError("名称不能为空")
        endpoint = urlsplit(values["endpoint"])
        _ = endpoint.port
        if (
            endpoint.scheme != "opc.tcp"
            or not endpoint.hostname
            or endpoint.username is not None
            or endpoint.password is not None
        ):
            raise ValueError("地址必须为不含账号密码的 opc.tcp:// 地址")
        auth = values["auth_type"]
        if auth not in ("anonymous", "username"):
            raise ValueError("不支持的用户认证方式")
        if auth == "username" and not (values.get("username") or "").strip():
            raise ValueError("用户名密码认证必须填写用户名")
        policy, mode = values["security_policy"], values["security_mode"]
        if policy == "None" and mode == "None":
            return
        if policy != "Basic256Sha256" or mode not in ("Sign", "SignAndEncrypt"):
            raise ValueError("安全策略和安全模式不匹配")
        if not all(values.get(name) for name in ("cert_path", "key_path", "server_cert_path")):
            raise ValueError(
                "安全连接需要客户端证书、私钥、受信任服务器证书；应用 URI 留空时从证书读取"
            )

    async def on_before_create(self):
        if self.security_policy == "None":
            self.security_mode = OpcuaSecurityMode.none
        self._validate_connection(
            {name: getattr(self, name) for name in self.__table__.columns.keys()}
        )

    async def on_before_update(self, changes):
        if not changes.get("password"):
            changes.pop("password", None)
        if changes.get("security_policy", self.security_policy) == "None":
            changes["security_mode"] = OpcuaSecurityMode.none
        self._validate_connection(
            {name: changes.get(name, getattr(self, name)) for name in self.__table__.columns.keys()}
        )

    # 应用证书，与用户认证独立
    app_uri: Optional[str] = Field(
        default=None,
        sa_column_kwargs={
            "info": {
                "group": "security",
                "site_props": {"visible_when": {"security_policy": ["Basic256Sha256"]}},
            }
        },
    )
    cert_path: Optional[str] = Field(
        default=None,
        sa_column_kwargs={
            "info": {
                "group": "security",
                "site_props": {
                    "component": "file",
                    "visible_when": {"security_policy": ["Basic256Sha256"]},
                    "allow_download": False,
                },
            }
        },
    )
    # OneSite 私有上传，不对外提供预览或下载。
    key_path: Optional[str] = Field(
        default=None,
        sa_column_kwargs={
            "info": {
                "group": "security",
                "site_props": {
                    "component": "file",
                    "private": True,
                    "visible_when": {"security_policy": ["Basic256Sha256"]},
                },
            }
        },
    )
    server_cert_path: Optional[str] = Field(
        default=None,
        nullable=True,
        sa_column_kwargs={
            "info": {
                "group": "security",
                "site_props": {
                    "component": "file",
                    "visible_when": {"security_policy": ["Basic256Sha256"]},
                    "allow_download": False,
                },
            }
        },
    )

    # Child resources are edited in the server detail page.
    opcua_nodes: List["OpcuaNode"] = Relationship(cascade_delete=True)

    ac_conditions: List["OpcuaAc"] = Relationship(cascade_delete=True)
