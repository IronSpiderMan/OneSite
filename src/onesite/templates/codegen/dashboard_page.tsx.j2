                }));
            }
            const total = pieData.reduce((sum, d) => sum + d.value, 0);
            return (
                <div className="relative">
                    <ResponsiveContainer width="100%" height={320}>
                        <PieChart>
                            <Pie
                                data={pieData}
                                cx="50%"
                                cy="50%"
                                innerRadius={72}
                                outerRadius={116}
                                paddingAngle={4}
                                cornerRadius={6}
                                dataKey="value"
                                name={title}
                                strokeWidth={0}
                                label={({ name, percent }) => percent > 0.03 ? `${(percent * 100).toFixed(0)}%` : ''}
                                labelLine={false}
                            >
                                {pieData.map((_, i) => (
                                    <Cell key={`cell-${i}`} fill={CHART_COLORS[i % CHART_COLORS.length]} stroke="hsl(var(--card))" strokeWidth={2} />
                                ))}
                            </Pie>
                            <Tooltip content={<CustomTooltip />} />
                            <Legend
                                iconType="circle"
                                iconSize={8}
                                formatter={(value: string) => <span className="text-sm text-muted-foreground">{value}</span>}
                            />
                        </PieChart>
                    </ResponsiveContainer>
                    <div className="absolute inset-0 flex items-center pointer-events-none -top-2">
                        <div className="text-center mx-auto w-[120px]">
                            <div className="text-2xl font-bold tracking-tight tabular-nums">{total.toLocaleString()}</div>
                            <div className="mt-0.5 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">{t('dashboard.total', 'Total')}</div>
                        </div>
                    </div>
                </div>
            );
        }

        if (isMultiSeries) {
            const multiData = data.labels.map((label, i) => {
                const point: Record<string, string | number> = { name: label };
                data.series!.forEach(s => { point[s.name] = s.values[i] || 0; });
                return point;
            });

            if (chartType === 'line') {
                return (
                    <ResponsiveContainer width="100%" height={320}>
                        <AreaChart data={multiData} margin={{ top: 12, right: 12, left: -12, bottom: 0 }}>
                            <defs>
                                {data.series!.map((s, i) => (
                                    <linearGradient key={s.name} id={`${gradId}-${i}`} x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stopColor={CHART_COLORS[i % CHART_COLORS.length]} stopOpacity={0.28} />
                                        <stop offset="100%" stopColor={CHART_COLORS[i % CHART_COLORS.length]} stopOpacity={0} />
                                    </linearGradient>
                                ))}
                            </defs>
                            <CartesianGrid strokeDasharray="4 4" stroke="hsl(var(--border))" strokeOpacity={0.45} vertical={false} />
                            <XAxis dataKey="name" tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                            <YAxis tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                            <Tooltip content={<CustomTooltip />} />
                            <Legend
                                iconType="circle"
                                iconSize={8}
                                formatter={(value: string) => <span className="text-sm text-muted-foreground">{value}</span>}
                            />
                            {data.series!.map((s, i) => (
                                <Area
                                    key={s.name}
                                    type="monotone"
                                    dataKey={s.name}
                                    stroke={CHART_COLORS[i % CHART_COLORS.length]}
                                    strokeWidth={2.5}
                                    fill={`url(#${gradId}-${i})`}
                                    fillOpacity={1}
                                    dot={false}
                                    activeDot={{ r: 5, strokeWidth: 2, stroke: '#fff' }}
                                    name={s.name}
                                />
                            ))}
                        </AreaChart>
                    </ResponsiveContainer>
                );
            }

            return (
                <ResponsiveContainer width="100%" height={320}>
                    <BarChart data={multiData} barGap={5} barCategoryGap="22%" margin={{ top: 12, right: 12, left: -12, bottom: 0 }}>
                        <defs>
                            {data.series!.map((s, i) => (
                                <linearGradient key={s.name} id={`${gradId}-${i}`} x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stopColor={CHART_COLORS[i % CHART_COLORS.length]} stopOpacity={1} />
                                    <stop offset="100%" stopColor={CHART_COLORS[i % CHART_COLORS.length]} stopOpacity={0.6} />
                                </linearGradient>
                            ))}
                        </defs>
                        <CartesianGrid strokeDasharray="4 4" stroke="hsl(var(--border))" strokeOpacity={0.45} vertical={false} />
                        <XAxis dataKey="name" tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                        <YAxis tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                        <Tooltip content={<CustomTooltip />} cursor={{ fill: 'hsl(var(--muted))', opacity: 0.3, radius: 4 }} />
                        <Legend
                            iconType="circle"
                            iconSize={8}
                            formatter={(value: string) => <span className="text-sm text-muted-foreground">{value}</span>}
                        />
                        {data.series!.map((s, i) => (
                            <Bar
                                key={s.name}
                                dataKey={s.name}
                                fill={`url(#${gradId}-${i})`}
                                radius={[6, 6, 2, 2]}
                                name={s.name}
                            />
                        ))}
                    </BarChart>
                </ResponsiveContainer>
            );
        }

        // Single-series
        const chartData = data.labels.map((label, i) => ({
            name: label,
            value: (data.values || [])[i] || 0,
        }));

        if (chartType === 'line') {
            return (
                <ResponsiveContainer width="100%" height={320}>
                    <AreaChart data={chartData} margin={{ top: 12, right: 12, left: -12, bottom: 0 }}>
                        <defs>
                            <linearGradient id={`${gradId}-area`} x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stopColor={CHART_COLORS[index % CHART_COLORS.length]} stopOpacity={0.3} />
                                <stop offset="100%" stopColor={CHART_COLORS[index % CHART_COLORS.length]} stopOpacity={0} />
                            </linearGradient>
                        </defs>
                        <CartesianGrid strokeDasharray="4 4" stroke="hsl(var(--border))" strokeOpacity={0.45} vertical={false} />
                        <XAxis dataKey="name" tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                        <YAxis tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                        <Tooltip content={<CustomTooltip />} />
                        <Legend iconType="circle" iconSize={8} formatter={(value: string) => <span className="text-sm text-muted-foreground">{value}</span>} />
                        <Area
                            type="monotone"
                            dataKey="value"
                            stroke={CHART_COLORS[index % CHART_COLORS.length]}
                            strokeWidth={2.5}
                            fill={`url(#${gradId}-area)`}
                            fillOpacity={1}
                            dot={false}
                            activeDot={{ r: 5, strokeWidth: 2, stroke: '#fff' }}
                            name={title}
                        />
                    </AreaChart>
                </ResponsiveContainer>
            );
        }

        return (
            <ResponsiveContainer width="100%" height={320}>
                <BarChart data={chartData} barCategoryGap="28%" margin={{ top: 12, right: 12, left: -12, bottom: 0 }}>
                    <defs>
                        <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stopColor={CHART_COLORS[index % CHART_COLORS.length]} stopOpacity={1} />
                            <stop offset="100%" stopColor={CHART_COLORS[index % CHART_COLORS.length]} stopOpacity={0.5} />
                        </linearGradient>
                    </defs>
                    <CartesianGrid strokeDasharray="4 4" stroke="hsl(var(--border))" strokeOpacity={0.45} vertical={false} />
                    <XAxis dataKey="name" tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                    <YAxis tick={{ fontSize: 12 }} stroke="hsl(var(--muted-foreground))" tickLine={false} axisLine={false} />
                    <Tooltip content={<CustomTooltip />} cursor={{ fill: 'hsl(var(--muted))', opacity: 0.3, radius: 4 }} />
                    <Legend iconType="circle" iconSize={8} formatter={(value: string) => <span className="text-sm text-muted-foreground">{value}</span>} />
                    <Bar dataKey="value" fill={`url(#${gradId})`} radius={[8, 8, 2, 2]} name={title} />
                </BarChart>
            </ResponsiveContainer>
        );
    };
{% endraw %}

    return (
        <div
            className="{{ page_shell_class | default('space-y-6') }}"
            data-codegen-theme="{{ codegen_theme | default('normal') }}"
            data-page-kind="dashboard"
        >
            {% if site_logger %}
            <style>{`
                @keyframes log-highlight {
                    0% { background-color: rgb(59 130 246 / 0.3); box-shadow: inset 4px 0 0 0 rgb(59 130 246); }
                    50% { background-color: rgb(59 130 246 / 0.15); }
                    100% { background-color: transparent; box-shadow: inset 0 0 0 0 transparent; }
                }
                .log-new { animation: log-highlight 2s ease-out forwards; }
            `}</style>
            {% endif %}
            <div className="flex items-center justify-between gap-4">
                <div>
                    <h1 className="text-3xl font-bold tracking-tight">
                        {t('menu.dashboard', 'Dashboard')}
                    </h1>
                    <p className="mt-1 text-sm text-muted-foreground">
                        {t('dashboard.overview_description', 'A clear overview of your key data and recent activity')}
                    </p>
                </div>
            </div>

            {% if show_dashboard_announcement %}
            {systemConfig?.announcement_content && (
                <div className="rounded-xl border bg-card p-6 shadow-sm">
                    <div className="prose prose-sm max-w-none dark:prose-invert">
                        <Markdown>{systemConfig.announcement_content}</Markdown>
                    </div>
                </div>
            )}
            {% endif %}

            {dashboardMetrics.length > 0 && (
                <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                    {dashboardMetrics.map((metric, index) => {
                        const MetricIcon = METRIC_ICONS[metric.icon] || Activity;
                        const accentColor = ({
                            blue: '#3b82f6', green: '#10b981', red: '#f43f5e',
                            amber: '#f59e0b', purple: '#8b5cf6', cyan: '#06b6d4',
                        } as Record<string, string>)[metric.color] || metric.color || '#3b82f6';
                        const content = (
                            <div className="group relative overflow-hidden rounded-2xl border border-border/60 bg-card p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
                                <div className="flex items-start justify-between gap-3">
                                    <div className="min-w-0">
                                        <p className="truncate text-sm font-medium text-muted-foreground">
                                            {t(metric.i18n_key, metric.title)}
                                        </p>
                                        {metric.values?.length ? (
                                            <div className="mt-2 flex flex-wrap items-baseline gap-x-2 text-3xl font-bold tracking-tight tabular-nums">
                                                {metric.values.map((value, valueIndex) => (
                                                    <React.Fragment key={valueIndex}>
                                                        {valueIndex > 0 && <span className="text-muted-foreground">{metric.separator || ' / '}</span>}
                                                        <span>{formatMetricNumber(value.value, value.format)}</span>
                                                    </React.Fragment>
                                                ))}
                                            </div>
                                        ) : (
                                            <p className="mt-2 truncate text-3xl font-bold tracking-tight tabular-nums">
                                                {formatMetricValue(metric)}
                                            </p>
                                        )}
                                    </div>
                                    <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style={metricIconStyle(accentColor)}>
                                        <MetricIcon className="h-5 w-5" />
                                    </span>
                                </div>
                                {metric.previous_value !== null && (
                                    <div className="mt-4 flex items-center gap-1.5 text-xs">
                                        {metric.change === null ? (
                                            <span className="font-medium text-primary">{t('dashboard.metric_new', 'New')}</span>
                                        ) : (
                                            <span className={`inline-flex items-center gap-0.5 font-semibold ${metric.change >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                                                {metric.change >= 0 ? <ArrowUpRight className="h-3.5 w-3.5" /> : <ArrowDownRight className="h-3.5 w-3.5" />}
                                                {Math.abs(metric.change).toLocaleString(undefined, { maximumFractionDigits: 1 })}%
                                            </span>
                                        )}
                                        <span className="text-muted-foreground">{t('dashboard.vs_previous_period', 'vs previous period')}</span>
                                    </div>
                                )}
                                <div className="absolute inset-x-0 bottom-0 h-0.5 opacity-0 transition-opacity group-hover:opacity-100" style={metricAccentStyle(accentColor)} />
                            </div>
                        );
                        return metric.link ? <a key={`${metric.key}-${index}`} href={metric.link}>{content}</a> : <React.Fragment key={`${metric.key}-${index}`}>{content}</React.Fragment>;
                    })}
                </div>
            )}

            {% if visualizations | default([]) %}
            {visualizationSpecs.length > 0 && (
                <div className="grid grid-cols-12 gap-5">
                    {visualizationSpecs.map((spec) => {
                        const data = visualizationData[spec.key];
                        const error = visualizationErrors[spec.key];
                        const filters = visualizationFilters[spec.key] || {};
                        const options = visualizationOptions[spec.key]?.filters || {};
                        const spanClass = spec.placement.span === 4 ? 'xl:col-span-4'
                            : spec.placement.span === 6 ? 'xl:col-span-6'
                            : spec.placement.span === 8 ? 'xl:col-span-8'
                            : 'xl:col-span-12';
                        const updateFilter = (key: string, value: any) => setVisualizationFilters((current) => ({
                            ...current,
                            [spec.key]: { ...(current[spec.key] || {}), [key]: value },
                        }));
                        return (
                            <section key={spec.key} className={`col-span-12 overflow-hidden rounded-2xl border border-border/60 bg-card shadow-sm ${spanClass}`}>
                                <div className="flex flex-wrap items-start justify-between gap-3 border-b border-border/60 px-5 py-4">
                                    <div className="min-w-0">
                                        <h2 className="truncate text-base font-semibold">{spec.title}</h2>
                                        <p className="mt-1 text-xs text-muted-foreground">{spec.preset}</p>
                                    </div>
                                    {spec.filters.length > 0 && (
                                        <div className="flex max-w-full flex-wrap justify-end gap-2">
                                            {spec.filters.map((filter) => {
                                                const available = options[filter.key] || [];
                                                const optionLabel = (option: { label: string; value: any }) => filter.option_i18n_key
                                                    ? t(`${filter.option_i18n_key}.${String(option.value)}`, option.label)
                                                    : option.label;
                                                if (filter.type === 'date_range' || filter.type === 'number_range') {
                                                    const range = filters[filter.key] || {};
                                                    const inputType = filter.type === 'date_range' ? 'datetime-local' : 'number';
                                                    return <div key={filter.key} className="flex items-center gap-1 rounded-lg border bg-background/60 px-2 py-1">
                                                        <span className="mr-1 text-[11px] text-muted-foreground">{filter.label}</span>
                                                        <input type={inputType} value={range.start ?? range.min ?? ''} onChange={(event) => updateFilter(filter.key, { ...range, [filter.type === 'date_range' ? 'start' : 'min']: event.target.value })} className="w-32 bg-transparent text-xs outline-none" />
                                                        <span className="text-muted-foreground">–</span>
                                                        <input type={inputType} value={range.end ?? range.max ?? ''} onChange={(event) => updateFilter(filter.key, { ...range, [filter.type === 'date_range' ? 'end' : 'max']: event.target.value })} className="w-32 bg-transparent text-xs outline-none" />
                                                    </div>;
                                                }
                                                if (filter.type === 'multi_select') {
                                                    return <select key={filter.key} multiple value={filters[filter.key] || []} onChange={(event) => updateFilter(filter.key, Array.from(event.currentTarget.selectedOptions, (option) => option.value))} className="min-h-9 max-w-44 rounded-lg border bg-background/60 px-2 text-xs">
                                                        {available.map((option) => <option key={String(option.value)} value={String(option.value)}>{optionLabel(option)}</option>)}
                                                    </select>;
                                                }
                                                return <select key={filter.key} value={filters[filter.key] ?? ''} onChange={(event) => updateFilter(filter.key, event.target.value)} className="h-9 max-w-44 rounded-lg border bg-background/60 px-2 text-xs">
                                                    <option value="">{filter.label}</option>
                                                    {available.map((option) => <option key={String(option.value)} value={String(option.value)}>{optionLabel(option)}</option>)}
                                                </select>;
                                            })}
                                        </div>
                                    )}
                                </div>
                                <div className="p-4">
                                    {error ? (
                                        <div className="flex h-[340px] items-center justify-center text-sm text-destructive">{error}</div>
                                    ) : !data ? (
                                        <div className="flex h-[340px] items-center justify-center"><Loader2 className="h-6 w-6 animate-spin text-primary" /></div>
                                    ) : data.rows.length === 0 ? (
                                        <div className="flex h-[340px] items-center justify-center text-sm text-muted-foreground">{t('dashboard.no_data', 'No data available')}</div>
                                    ) : (
                                        <VisualizationChart spec={spec} data={data} />
                                    )}
                                    {data?.meta.truncated && <p className="mt-2 text-center text-xs text-amber-600">{t('dashboard.visualization_truncated', 'Result was truncated to the configured limit')}</p>}
                                </div>
                            </section>
                        );
                    })}
                </div>
            )}
            {% endif %}

            {chartModels.length > 0 && (
                <div className="grid gap-5 md:grid-cols-2">
                    {chartModels.map((chart, idx) => (
                        <div
                            key={chart.moduleName}
                            className={`group relative isolate overflow-hidden rounded-2xl border border-border/60 bg-gradient-to-br from-card via-card to-muted/30 text-card-foreground shadow-sm shadow-black/[0.03] transition-all duration-300 hover:-translate-y-0.5 hover:border-border hover:shadow-xl hover:shadow-black/[0.06]${chart.fullRow ? ' md:col-span-2' : ''}`}
                        >
                            <div className="absolute inset-x-0 top-0 h-px opacity-80" style={ gradientLineStyle(CHART_COLORS[idx % CHART_COLORS.length]) } />
                            <div className="pointer-events-none absolute -right-16 -top-20 h-44 w-44 rounded-full opacity-[0.08] blur-3xl transition-opacity duration-300 group-hover:opacity-[0.14]" style={ dotStyle(CHART_COLORS[idx % CHART_COLORS.length]) } />
                            <div className="relative px-5 pb-2 pt-5 sm:px-6">
                                <div className="mb-4 flex flex-col justify-between gap-3 xl:flex-row xl:items-center">
                                    <div className="flex min-w-0 items-center gap-3">
                                        <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-muted/60 ring-1 ring-border/50" style={ colorStyle(CHART_COLORS[idx % CHART_COLORS.length]) }>
                                            {chart.chartType === 'pie' ? <PieChartIcon className="h-4 w-4" /> : chart.chartType === 'line' ? <LineChartIcon className="h-4 w-4" /> : <BarChart3 className="h-4 w-4" />}
                                        </span>
                                        <h3 className="truncate text-base font-semibold tracking-tight">
                                            {t(`models.${chart.moduleName}.name`, chart.title) as string}
                                        </h3>
                                        <span className="hidden rounded-full border border-border/50 bg-background/50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground sm:inline-flex">
                                            {chart.chartType}
                                        </span>
                                    </div>
                                    {chart.hasTimeField && (
                                        <div className="flex max-w-full flex-wrap items-center gap-1.5">
                                            <div className="flex max-w-full items-center gap-1 rounded-xl border border-border/40 bg-background/55 px-1.5 py-1 shadow-sm backdrop-blur-sm">
                                                <button
                                                    className="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                                    onClick={() => {
                                                        setChartPeriods(prev => {
                                                            const cur = prev[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' };
                                                            const shifted = shiftDateRange(cur.startTime || getDefaultStartTime(), cur.endTime || todayStr(), 'left');
                                                            const err = validateDateSpan(shifted.startTime, shifted.endTime, cur.period);
                                                            if (err) { toast.error(err); return prev; }
                                                            return { ...prev, [chart.moduleName]: { ...cur, ...shifted } };
                                                        });
                                                    }}
                                                    title={t('dashboard.shift_left', 'Previous period')}
                                                >
                                                    <ChevronLeft className="w-3.5 h-3.5" />
                                                </button>
                                                <input
                                                    type="date"
                                                    className="min-w-0 bg-transparent p-0.5 text-xs tabular-nums outline-none focus:ring-0"
                                                    value={(chartPeriods[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).startTime}
                                                    onChange={(e) => {
                                                        const newStart = e.target.value;
                                                        setChartPeriods(prev => {
                                                            const cur = prev[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' };
                                                            if (newStart && cur.endTime) {
                                                                const err = validateDateSpan(newStart, cur.endTime, cur.period);
                                                                if (err) { toast.error(err); return prev; }
                                                            }
                                                            return { ...prev, [chart.moduleName]: { ...cur, startTime: newStart } };
                                                        });
                                                    }}
                                                />
                                                <span className="text-xs text-muted-foreground/60">&mdash;</span>
                                                <input
                                                    type="date"
                                                    className="min-w-0 bg-transparent p-0.5 text-xs tabular-nums outline-none focus:ring-0"
                                                    value={(chartPeriods[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).endTime}
                                                    onChange={(e) => {
                                                        const newEnd = e.target.value;
                                                        setChartPeriods(prev => {
                                                            const cur = prev[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' };
                                                            if (cur.startTime && newEnd) {
                                                                const err = validateDateSpan(cur.startTime, newEnd, cur.period);
                                                                if (err) { toast.error(err); return prev; }
                                                            }
                                                            return { ...prev, [chart.moduleName]: { ...cur, endTime: newEnd } };
                                                        });
                                                    }}
                                                />
                                                <button
                                                    className="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                                    onClick={() => {
                                                        setChartPeriods(prev => {
                                                            const cur = prev[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' };
                                                            const shifted = shiftDateRange(cur.startTime || getDefaultStartTime(), cur.endTime || todayStr(), 'right');
                                                            const err = validateDateSpan(shifted.startTime, shifted.endTime, cur.period);
                                                            if (err) { toast.error(err); return prev; }
                                                            return { ...prev, [chart.moduleName]: { ...cur, ...shifted } };
                                                        });
                                                    }}
                                                    title={t('dashboard.shift_right', 'Next period')}
                                                >
                                                    <ChevronRight className="w-3.5 h-3.5" />
                                                </button>
                                                <button
                                                    className="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                                                    onClick={() => {
                                                        setChartPeriods(prev => ({
                                                            ...prev,
                                                            [chart.moduleName]: { period: (prev[chart.moduleName] || { period: 'day' }).period, startTime: getDefaultStartTime(), endTime: '' },
                                                        }));
                                                    }}
                                                    title={t('dashboard.reset_today', 'Reset to today')}
                                                >
                                                    <CalendarDays className="w-3.5 h-3.5" />
                                                </button>
                                            </div>
                                            <select
                                                className="cursor-pointer rounded-xl border border-border/40 bg-background/55 px-2.5 py-2 text-xs font-medium shadow-sm outline-none backdrop-blur-sm focus:ring-2 focus:ring-primary/20"
                                                value={(chartPeriods[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).period}
                                                onChange={(e) => {
                                                    const newPeriod = e.target.value;
                                                    setChartPeriods(prev => ({
                                                        ...prev,
                                                        [chart.moduleName]: { period: newPeriod, startTime: getDefaultStartTime(), endTime: '' },
                                                    }));
                                                }}
                                            >
                                                <option value="day">{t('dashboard.period_day', 'Daily')}</option>
                                                <option value="week">{t('dashboard.period_week', 'Weekly')}</option>
                                                <option value="month">{t('dashboard.period_month', 'Monthly')}</option>
                                            </select>
                                        </div>
                                    )}
                                </div>
                            </div>
                            {% if ns.has_filters %}
                            {(() => {
                                const chartFilters: Record<string, { key: string; loadOptions: (q: string) => Promise<any[]>; placeholder: string }[]> = {
                                    {% for model in models %}
                                    {% if model.visualize and model.visualize.get('show') and model.visualize.get('resolved_filters') %}
                                    '{{ model.module_name }}': [
                                        {% for rf in model.visualize.resolved_filters %}
                                        {
                                            key: '{{ rf.filter_key }}',
                                            loadOptions: async (query: string) => {
                                                const opts = await get{{ model.name }}StatsFilters('{{ rf.name }}');
                                                if (!query) return opts.map(o => ({ label: o.label, value: String(o.id) }));
                                                const q = query.toLowerCase();
                                                return opts.filter(o => o.label.toLowerCase().includes(q)).map(o => ({ label: o.label, value: String(o.id) }));
                                            },
                                            placeholder: t('dashboard.filter_{{ rf.name }}', '{{ rf.name }}'),
                                        },
                                        {% endfor %}
                                    ],
                                    {% endif %}
                                    {% endfor %}
                                };
                                const filters = chartFilters[chart.moduleName] || [];
                                return filters.length > 0 ? (
                                    <div className="relative mx-5 mb-2 rounded-xl border border-border/40 bg-muted/25 p-2.5 sm:mx-6">
                                        <div className="flex min-w-0 flex-wrap items-center gap-2">
                                            {filters.map((f) => (
                                                <div key={f.key} className="w-40">
                                                    <SearchableSelect
                                                        value={filterValues[chart.moduleName]?.[f.key] || ''}
                                                        defaultLabel={filterLabels[chart.moduleName]?.[f.key] || ''}
                                                        onValueChange={(val) => {
                                                            setFilterValues(prev => ({
                                                                ...prev,
                                                                [chart.moduleName]: {
                                                                    ...(prev[chart.moduleName] || {}),
                                                                    [f.key]: val as string,
                                                                },
                                                            }));
                                                        }}
                                                        onLabelChange={(label) => {
                                                            setFilterLabels(prev => ({
                                                                ...prev,
                                                                [chart.moduleName]: {
                                                                    ...(prev[chart.moduleName] || {}),
                                                                    [f.key]: label,
                                                                },
                                                            }));
                                                        }}
                                                        placeholder={f.placeholder}
                                                        searchPlaceholder={f.placeholder}
                                                        loadOptions={f.loadOptions}
                                                    />
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                ) : null;
                            })()}
                            {% endif %}
                            <div className="relative px-2 pb-4 pt-1 sm:px-4">
                                {renderChart(chart.moduleName, chart.chartType, chart.title, idx)}
                            </div>
                        </div>
                    ))}
                </div>
            )}

            {% if site_logger %}
            {/* Log Panel */}
            <div className="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
                <div className="flex items-center justify-between mb-4">
                    <div className="flex items-center gap-2">
                        <Terminal className="w-5 h-5" />
                        <h3 className="text-lg font-semibold">
                            {t('dashboard.app_logs', 'Application Logs')}
                        </h3>
                    </div>
                    <div className="flex items-center gap-2">
                        <select
                            className="border border-input bg-background text-foreground rounded-md px-2 py-1.5 text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                            value={logLevel}
                            onChange={(e) => setLogLevel(e.target.value)}
                        >
                            <option value="">{t('dashboard.all_levels', 'All Levels')}</option>
                            <option value="DEBUG">DEBUG</option>
                            <option value="INFO">INFO</option>
                            <option value="WARNING">WARNING</option>
                            <option value="ERROR">ERROR</option>
                        </select>
                        <Button variant="outline" size="sm" onClick={() => {
                            setLogEntries([]);
                            setLogPage(1);
                            setHasMoreLogs(true);
                            logInitialized.current = false;
                            loadLogs(1).then(() => {
                                setTimeout(() => {
                                    logScrollRef.current?.scrollTo({ top: logScrollRef.current.scrollHeight });
                                    logInitialized.current = true;
                                }, 50);
                            });
                        }}>
                            <RefreshCw className="w-4 h-4" />
                        </Button>
                    </div>
                </div>
                <div className="rounded-md border bg-muted/30 overflow-hidden">
                    <div ref={logScrollRef} onScroll={handleLogScroll} className="max-h-80 overflow-y-auto font-mono text-xs">
                        {logEntries.length === 0 ? (
                            <div className="p-4 text-center text-muted-foreground">
                                {t('dashboard.no_logs', 'No log entries')}
                            </div>
                        ) : (
                            <table className="w-full">
                                <thead className="sticky top-0 bg-muted z-10">
                                    <tr className="text-left">
                                        <th className="px-3 py-2 font-medium">Time</th>
                                        <th className="px-3 py-2 font-medium">Level</th>
                                        <th className="px-3 py-2 font-medium">Source</th>
                                        <th className="px-3 py-2 font-medium">Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {logLoading && hasMoreLogs && (
                                        <tr>
                                            <td colSpan={4} className="p-2 text-center">
                                                <Loader2 className="w-4 h-4 animate-spin inline-block text-muted-foreground" />
                                            </td>
                                        </tr>
                                    )}
                                    {logEntries.map((entry, idx) => (
                                        <tr key={entry.id || idx} className={`border-t border-border/50 hover:bg-muted/20${entry.id && newEntryIds.has(entry.id) ? ' log-new' : ''}`}>
                                            <td className="px-3 py-1.5 whitespace-nowrap text-muted-foreground">
                                                {entry.created_at ? formatDateTime(entry.created_at, timeZone) : ''}
                                            </td>
                                            <td className="px-3 py-1.5">
                                                <span className={`px-1.5 py-0.5 rounded text-xs font-medium ${
                                                    entry.level === 'ERROR' ? 'bg-red-100 text-red-700' :
                                                    entry.level === 'WARNING' ? 'bg-yellow-100 text-yellow-700' :
                                                    entry.level === 'INFO' ? 'bg-blue-100 text-blue-700' :
                                                    'bg-gray-100 text-gray-500'
                                                }`}>
                                                    {entry.level}
                                                </span>
                                            </td>
                                            <td className="px-3 py-1.5 text-muted-foreground">{entry.source}</td>
                                            <td className="px-3 py-1.5 break-all">{entry.message}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        )}
                    </div>
                </div>
            </div>
            {% endif %}

            {% if scheduled_tasks %}
            {/* Scheduled Tasks Section */}
            <div className="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
                <div className="flex items-center justify-between mb-4">
                    <h3 className="text-lg font-semibold">
                        {t('dashboard.scheduled_tasks', 'Scheduled Tasks')}
                    </h3>
                    <Button
                        variant="outline"
                        size="sm"
                        onClick={handleRefresh}
                        disabled={taskLoading}
                    >
                        <RefreshCw className={`w-4 h-4 ${taskLoading ? 'animate-spin' : ''}`} />
                    </Button>
                </div>

                {taskLoading && tasks.length === 0 ? (
                    <div className="flex justify-center items-center h-32">
                        <Loader2 className="w-6 h-6 animate-spin text-muted-foreground" />
                    </div>
                ) : tasks.length === 0 ? (
                    <div className="text-center py-8 text-muted-foreground">
                        {t('dashboard.no_tasks', 'No scheduled tasks configured')}
                    </div>
                ) : (
                    <div className="space-y-3">
                        {tasks.map((task) => (
                            <div
                                key={task.name}
                                className="flex items-center justify-between p-4 rounded-lg border bg-background"
                            >
                                <div className="flex-1">
                                    <div className="flex items-center gap-2">
                                        <span className="font-medium">{task.name}</span>
                                        <span
                                            className={`px-2 py-0.5 rounded text-xs ${
                                                task.enabled
                                                    ? 'bg-green-100 text-green-700'
                                                    : 'bg-gray-100 text-gray-500'
                                            }`}
                                        >
                                            {task.enabled
                                                ? t('dashboard.enabled', 'Enabled')
                                                : t('dashboard.disabled', 'Disabled')}
                                        </span>
                                    </div>
                                    <div className="text-sm text-muted-foreground mt-1">
                                        <span>
                                            {task.interval > 0 ? formatInterval(task.interval, t) : formatCron(task.cron, t)}
                                        </span>
                                        {task.description && (
                                            <span className="ml-2">- {task.description}</span>
                                        )}
                                    </div>
                                    {task.params && Object.keys(task.params).length > 0 && (
                                        <div className="text-xs text-muted-foreground mt-1 font-mono">
                                            {Object.entries(task.params).map(([k, v]) => `${k}: ${String(v.value)}`).join(' | ')}
                                        </div>
                                    )}
                                    {task.next_run && task.enabled && (
                                        <div className="text-xs text-muted-foreground mt-1">
                                            {t('dashboard.next_run', 'Next run')}: {formatLocalDateTime(task.next_run)}
                                        </div>
                                    )}
                                    {task.last_execution && (
                                        <div className="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                                            <span>{t('dashboard.last_execution', 'Last execution')}:</span>
                                            <span className={
                                                task.last_execution.status === 'succeeded' ? 'text-green-600' :
                                                task.last_execution.status === 'failed' ? 'text-red-600' :
                                                'text-blue-600'
                                            }>
                                                {task.last_execution.status}
                                            </span>
                                            {(task.last_execution.status === 'queued' || task.last_execution.status === 'running') && (
                                                <span>{task.last_execution.progress}%</span>
                                            )}
                                            {task.last_execution.message && <span>- {task.last_execution.message}</span>}
                                        </div>
                                    )}
                                </div>
                                <div className="flex items-center gap-2">
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => handleRunTask(task.name)}
                                        disabled={runningTasks.has(task.name)}
                                        title={t('dashboard.run_now', 'Run now')}
                                    >
                                        {runningTasks.has(task.name) ? (
                                            <Loader2 className="w-4 h-4 animate-spin" />
                                        ) : (
                                            <Play className="w-4 h-4" />
                                        )}
                                    </Button>
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => {
                                            setEditingTask(task);
                                            if (task.interval > 0) {
                                                setScheduleMode('interval');
                                                if (task.interval % 86400 === 0) {
                                                    setIntervalValue(task.interval / 86400);
                                                    setIntervalUnit('days');
                                                } else if (task.interval % 3600 === 0) {
                                                    setIntervalValue(task.interval / 3600);
                                                    setIntervalUnit('hours');
                                                } else {
                                                    setIntervalValue(Math.max(1, Math.floor(task.interval / 60)));
                                                    setIntervalUnit('minutes');
                                                }
                                                setCronTimes([]);
                                            } else {
                                                setScheduleMode('cron');
                                                setCronTimes(parseCronToTimes(task.cron));
                                                setIntervalValue(5);
                                                setIntervalUnit('minutes');
                                            }
                                            setEditModalOpen(true);
                                        }}
                                        title={t('dashboard.edit', 'Edit')}
                                    >
                                        <Pencil className="w-4 h-4" />
                                    </Button>
                                    {task.enabled ? (
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => handleDisableTask(task.name)}
                                            title={t('dashboard.disable', 'Disable')}
                                        >
                                            <PowerOff className="w-4 h-4" />
                                        </Button>
                                    ) : (
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => handleEnableTask(task.name)}
                                            title={t('dashboard.enable', 'Enable')}
                                        >
                                            <Power className="w-4 h-4" />
                                        </Button>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>
            {% endif %}

            {% if tools %}
            <DashboardTools />
            {% endif %}

            {% if scheduled_tasks %}
            {/* Edit Task Modal */}
            {editingTask && (
                <Modal
                    isOpen={isEditModalOpen}
                    onClose={() => setEditModalOpen(false)}
                    title={t('dashboard.edit_task', 'Edit Task')}
                >
                    <div className="space-y-4">
                        <div>
                            <Label>{t('dashboard.task_name', 'Task Name')}</Label>
                            <div className="font-medium">{editingTask.name}</div>
                        </div>
                        <div>
                            <Label>{t('dashboard.schedule_type', 'Schedule Type')}</Label>
                            <div className="flex gap-4 mt-1">
                                <label className="flex items-center gap-2">
                                    <input
                                        type="radio"
                                        name="taskType"
                                        value="cron"
                                        checked={scheduleMode === 'cron'}
                                        onChange={() => setScheduleMode('cron')}
                                    />
                                    {t('dashboard.type_cron', 'Scheduled Time')}
                                </label>
                                <label className="flex items-center gap-2">
                                    <input
                                        type="radio"
                                        name="taskType"
                                        value="interval"
                                        checked={scheduleMode === 'interval'}
                                        onChange={() => setScheduleMode('interval')}
                                    />
                                    {t('dashboard.type_interval', 'Interval')}
                                </label>
                            </div>
                        </div>
                        {scheduleMode === 'cron' ? (
                            <div>
                                <Label>{t('dashboard.scheduled_times', 'Scheduled Times')}</Label>
                                <div className="space-y-2 mt-1">
                                    {cronTimes.map((time, idx) => (
                                        <div key={idx} className="flex items-center gap-2">
                                            <Input
                                                type="time"
                                                value={time}
                                                className="w-32"
                                                onChange={(e) => {
                                                    const newTimes = [...cronTimes];
                                                    newTimes[idx] = e.target.value;
                                                    setCronTimes(newTimes);
                                                }}
                                            />
                                            <Button
                                                variant="outline"
                                                size="sm"
                                                onClick={() => {
                                                    const newTimes = cronTimes.filter((_, i) => i !== idx);
                                                    setCronTimes(newTimes);
                                                }}
                                            >
                                                {t('common.remove', 'Remove')}
                                            </Button>
                                        </div>
                                    ))}
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => setCronTimes([...cronTimes, '08:00'])}
                                    >
                                        + {t('dashboard.add_time', 'Add Time')}
                                    </Button>
                                </div>
                                <p className="text-xs text-muted-foreground mt-1">
                                    {t('dashboard.cron_help', 'Select the times to run each day')}
                                </p>
                            </div>
                        ) : (
                            <div>
                                <Label>{t('dashboard.interval_value', 'Run Every')}</Label>
                                <div className="flex items-center gap-2 mt-1">
                                    <Input
                                        type="number"
                                        min="1"
                                        className="w-24"
                                        value={intervalValue}
                                        onChange={(e) => setIntervalValue(Math.max(1, parseInt(e.target.value) || 1))}
                                    />
                                    <select
                                        className="border rounded px-3 py-2 bg-background text-sm"
                                        value={intervalUnit}
                                        onChange={(e) => setIntervalUnit(e.target.value as 'minutes' | 'hours' | 'days')}
                                    >
                                        <option value="minutes">{t('dashboard.minutes', 'minutes')}</option>
                                        <option value="hours">{t('dashboard.hours', 'hours')}</option>
                                        <option value="days">{t('dashboard.days', 'days')}</option>
                                    </select>
                                </div>
                            </div>
                        )}
                        <div>
                            <Label>{t('dashboard.description', 'Description')}</Label>
                            <Input
                                id="description"
                                defaultValue={editingTask.description}
                                placeholder={t('dashboard.description_placeholder', 'Task description')}
                            />
                        </div>
                        {editingTask.params && Object.keys(editingTask.params).length > 0 && (
                            <div className="border-t pt-4">
                                <Label className="mb-2 block">{t('dashboard.parameters', 'Parameters')}</Label>
                                <div className="space-y-3">
                                    {Object.entries(editingTask.params).map(([key, param]) => (
                                        <div key={key}>
                                            <Label className="text-sm">{param.label || key}</Label>
                                            {param.type === 'bool' ? (
                                                <div className="flex items-center gap-2 mt-1">
                                                    <input
                                                        type="checkbox"
                                                        id={`param-${key}`}
                                                        defaultChecked={!!param.value}
                                                        className="h-4 w-4"
                                                    />
                                                </div>
                                            ) : param.type === 'multi_select' ? (
                                                <Input
                                                    id={`param-${key}`}
                                                    defaultValue={Array.isArray(param.value) ? param.value.join(', ') : String(param.value ?? '')}
                                                    placeholder="a, b, c"
                                                    className="mt-1"
                                                />
                                            ) : (
                                                <Input
                                                    id={`param-${key}`}
                                                    defaultValue={String(param.value ?? '')}
                                                    type={param.type === 'number' ? 'number' : 'text'}
                                                    className="mt-1"
                                                />
                                            )}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}
                        <div className="flex justify-end gap-2 pt-4">
                            <Button variant="outline" onClick={() => setEditModalOpen(false)}>
                                {t('common.cancel', 'Cancel')}
                            </Button>
                            <Button
                                onClick={() => {
                                    const descInput = document.getElementById('description') as HTMLInputElement;
                                    const params: Record<string, string | number | boolean | string[]> = {};
                                    for (const [key, param] of Object.entries(editingTask.params || {})) {
                                        const el = document.getElementById(`param-${key}`) as HTMLInputElement;
                                        if (el) {
                                            if (param.type === 'bool') {
                                                params[key] = el.checked;
                                            } else if (param.type === 'number') {
                                                params[key] = parseFloat(el.value) || 0;
                                            } else if (param.type === 'multi_select') {
                                                params[key] = el.value.split(',').map(s => s.trim()).filter(Boolean);
                                            } else {
                                                params[key] = el.value;
                                            }
                                        }
                                    }
                                    let interval = 0;
                                    let cron = '';
                                    if (scheduleMode === 'interval') {
                                        const multipliers: Record<string, number> = { minutes: 60, hours: 3600, days: 86400 };
                                        interval = intervalValue * (multipliers[intervalUnit] || 60);
                                    } else {
                                        cron = cronTimes.length > 0 ? timesToCron(cronTimes) : '* * * * *';
                                    }
                                    updateTask(editingTask.name, {
                                        cron,
                                        interval,
                                        description: descInput.value,
                                        params,
                                    });
                                    toast.success(t('dashboard.task_updated', { name: editingTask.name }));
                                }}
                            >
                                {t('common.save', 'Save')}
                            </Button>
                        </div>
                    </div>
                </Modal>
            )}
            {% endif %}
        </div>
    );
};

export default DashboardPage;
