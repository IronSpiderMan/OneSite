// frontend/src/pages/Dashboard.tsx
import React, { useEffect, useRef, useState } from 'react';
import { Loader2, RefreshCw{% if scheduled_tasks %}, Play, Pencil, Power, PowerOff{% endif %}{% if site_logger %}, Terminal{% endif %} } from 'lucide-react';
import { useTranslation } from 'react-i18next';
import { BarChart, Bar, LineChart, Line, PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { toast } from 'sonner';
import { Button } from '../components/ui/button';
{% if site_logger %}
import { getAppLogs } from '../services/app_log';
import { buildNotificationWsUrl } from '../services/notification-center';
import { formatDateTime, getUserTimeZone } from '../lib/datetime';
{% endif %}
{% if scheduled_tasks %}
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Modal } from '../components/ui/modal';
{% endif %}
{% for model in models %}
{% if model.visualize and model.visualize.get('show') %}
import { get{{ model.name }}Stats } from '../services/{{ model.module_name }}';
{% endif %}
{% endfor %}
{% if scheduled_tasks %}
import { useTaskStore } from '../stores/useTaskStore';
{% endif %}

interface ChartSeries {
    name: string;
    values: number[];
}

interface ChartData {
    labels: string[];
    values?: number[];
    series?: ChartSeries[];
    title: string;
}

const CHART_COLORS = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#06b6d4', '#84cc16'];

const getDefaultStartTime = (): string => {
    const d = new Date();
    d.setDate(d.getDate() - 15);
    return d.toISOString().split('T')[0];
};

const MAX_SPAN_DAYS: Record<string, number> = {
    day: 30,
    week: 210,
    month: 900,
};

const validateDateSpan = (startTime: string, endTime: string, period: string): string | null => {
    if (!startTime || !endTime) return null;
    const start = new Date(startTime);
    const end = new Date(endTime);
    if (isNaN(start.getTime()) || isNaN(end.getTime())) return null;
    if (end <= start) return 'End date must be after start date';
    const spanDays = Math.ceil((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
    const maxSpan = MAX_SPAN_DAYS[period] || 30;
    if (spanDays > maxSpan) {
        return `Time span cannot exceed ${maxSpan} days for ${period} period`;
    }
    return null;
};

const formatLocalDateTime = (dateStr: string | null): string => {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        return date.toLocaleString(undefined, {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
        });
    } catch {
        return dateStr;
    }
};

const formatInterval = (seconds: number): string => {
    if (seconds <= 0) return '';
    if (seconds < 60) return `Every ${seconds}s`;
    if (seconds < 3600) return `Every ${Math.floor(seconds / 60)}m`;
    return `Every ${Math.floor(seconds / 3600)}h`;
};

const DashboardPage: React.FC = () => {
    const { t } = useTranslation();
    const [chartsData, setChartsData] = useState<Record<string, ChartData>>({});
    const [loading, setLoading] = useState(true);
    const [chartPeriods, setChartPeriods] = useState<Record<string, { period: string; startTime: string; endTime: string }>>({});
    {% if site_logger %}
    const [logEntries, setLogEntries] = useState<any[]>([]);
    const [logLevel, setLogLevel] = useState<string>('');
    const [newEntryIds, setNewEntryIds] = useState<Set<number>>(new Set());
    const [logPage, setLogPage] = useState(1);
    const [hasMoreLogs, setHasMoreLogs] = useState(true);
    const [logLoading, setLogLoading] = useState(false);
    const logScrollRef = useRef<HTMLDivElement>(null);
    const timeZone = getUserTimeZone();
    const logInitialized = useRef(false);
    {% endif %}
    {% if scheduled_tasks %}
    const [runningTasks, setRunningTasks] = useState<Set<string>>(new Set());

    // Task store
    const {
        tasks,
        loading: taskLoading,
        fetchTasks,
        runTask,
        enableTask,
        disableTask,
        updateTask,
        editingTask,
        isEditModalOpen,
        setEditingTask,
        setEditModalOpen,
    } = useTaskStore();
    {% endif %}

    useEffect(() => {
        const fetchAllStats = async () => {
            setLoading(true);
            const results: Record<string, ChartData> = {};

            {% for model in models %}
            {% if model.visualize and model.visualize.get('show') %}
            try {
                const data = await get{{ model.name }}Stats({% if model.visualize.get('time_field') %}
                    (chartPeriods['{{ model.module_name }}'] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).period,
                    (chartPeriods['{{ model.module_name }}'] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).startTime || undefined,
                    (chartPeriods['{{ model.module_name }}'] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).endTime || undefined
                {% endif %});
                results['{{ model.module_name }}'] = data;
            } catch (error) {
                console.error('Failed to fetch stats for {{ model.module_name }}:', error);
            }
            {% endif %}
            {% endfor %}

            setChartsData(results);
            setLoading(false);
        };

        fetchAllStats();
    }, [chartPeriods]);

    {% if site_logger %}
    const loadLogs = async (page: number, append = false) => {
        if (logLoading) return;
        setLogLoading(true);
        try {
            const filters: Record<string, any> = {};
            if (logLevel) filters.level = logLevel;
            const data = await getAppLogs(page, 50, filters);
            const items: any[] = Array.isArray(data) ? data : (data.items || data.data || []);
            const total = data.total_pages || 1;
            // Backend returns desc (newest first), reverse for chronological display
            const sorted = items.slice().reverse();
            if (append) {
                setLogEntries(prev => [...sorted, ...prev]);
            } else {
                setLogEntries(sorted);
            }
            setLogPage(page);
            setHasMoreLogs(page < total);
        } catch (error) {
            console.error('Failed to fetch logs:', error);
        } finally {
            setLogLoading(false);
        }
    };

    useEffect(() => {
        setLogEntries([]);
        setLogPage(1);
        setHasMoreLogs(true);
        logInitialized.current = false;
        loadLogs(1).then(() => {
            setTimeout(() => {
                logScrollRef.current?.scrollTo({ top: logScrollRef.current.scrollHeight });
                logInitialized.current = true;
            }, 50);
        });
    }, [logLevel]);

    const handleLogScroll = () => {
        const el = logScrollRef.current;
        if (!el || logLoading || !hasMoreLogs || !logInitialized.current) return;
        if (el.scrollTop < 24) {
            const prevHeight = el.scrollHeight;
            loadLogs(logPage + 1, true).then(() => {
                setTimeout(() => {
                    const newHeight = el.scrollHeight;
                    el.scrollTop = newHeight - prevHeight;
                }, 50);
            });
        }
    };

    useEffect(() => {
        let ws: WebSocket | null = null;
        let retryCount = 0;
        let timeoutId: ReturnType<typeof setTimeout>;

        const connect = () => {
            const url = buildNotificationWsUrl();
            if (!url) return;

            ws = new WebSocket(url);
            ws.onopen = () => { retryCount = 0; };
            ws.onmessage = (event) => {
                try {
                    const msg = JSON.parse(event.data);
                    if (msg.type === 'site_log' && msg.data?.id) {
                        setLogEntries(prev => [...prev.slice(-199), msg.data]);
                        setNewEntryIds(prev => new Set(prev).add(msg.data.id));
                        setTimeout(() => {
                            setNewEntryIds(prev => {
                                const next = new Set(prev);
                                next.delete(msg.data.id);
                                return next;
                            });
                        }, 2000);
                        setTimeout(() => {
                            const el = logScrollRef.current;
                            if (el && el.scrollHeight - el.scrollTop - el.clientHeight < 100) {
                                el.scrollTo({ top: el.scrollHeight, behavior: 'smooth' });
                            }
                        }, 50);
                    }
                } catch {}
            };
            ws.onclose = () => {
                const delay = Math.min(1000 * Math.pow(2, retryCount), 30000);
                timeoutId = setTimeout(() => { retryCount++; connect(); }, delay);
            };
            ws.onerror = () => ws?.close();
        };

        connect();
        return () => {
            if (timeoutId) clearTimeout(timeoutId);
            if (ws) { ws.onclose = null; ws.close(); }
        };
    }, []);
    {% endif %}

    {% if scheduled_tasks %}
    useEffect(() => {
        fetchTasks();
    }, []);

    const handleRunTask = async (name: string) => {
        setRunningTasks(prev => new Set(prev).add(name));
        try {
            await runTask(name);
            toast.success(t('dashboard.task_run_success', `Task "${name}" executed successfully`));
        } catch (error: any) {
            toast.error(t('dashboard.task_run_error', `Task "${name}" failed: ${error.message}`));
        } finally {
            setRunningTasks(prev => {
                const next = new Set(prev);
                next.delete(name);
                return next;
            });
        }
    };

    const handleEnableTask = async (name: string) => {
        try {
            await enableTask(name);
            toast.success(t('dashboard.task_enabled', `Task "${name}" enabled`));
        } catch (error: any) {
            toast.error(error.message);
        }
    };

    const handleDisableTask = async (name: string) => {
        try {
            await disableTask(name);
            toast.success(t('dashboard.task_disabled', `Task "${name}" disabled`));
        } catch (error: any) {
            toast.error(error.message);
        }
    };

    const handleRefresh = async () => {
        try {
            await fetchTasks();
            toast.success(t('dashboard.refresh_success', 'Tasks refreshed'));
        } catch (error: any) {
            toast.error(error.message);
        }
    };
    {% endif %}

    if (loading) {
        return (
            <div className="flex justify-center items-center h-64">
                <Loader2 className="w-8 h-8 animate-spin text-primary" />
            </div>
        );
    }

    const chartModels: { moduleName: string; chartType: string; title: string; fullRow: boolean; hasTimeField?: boolean }[] = [
        {% for model in models %}
        {% if model.visualize and model.visualize.get('show') %}
        {
            moduleName: '{{ model.module_name }}',
            chartType: '{{ model.visualize.get('chart_type', 'bar') }}',
            title: '{{ model.visualize.get('title', model.name) }}',
            fullRow: {{ 'true' if model.visualize.get('full_row') else 'false' }},
            {% if model.visualize.get('time_field') %}
            hasTimeField: true,
            {% endif %}
        },
        {% endif %}
        {% endfor %}
    ];

    if (chartModels.length === 0 {% if scheduled_tasks %}&& tasks.length === 0{% endif %}{% if site_logger %}&& false{% endif %}) {
        return (
            <div className="space-y-6">
                <div className="flex items-center justify-between">
                    <h1 className="text-3xl font-bold tracking-tight">
                        {t('menu.dashboard', 'Dashboard')}
                    </h1>
                </div>
                <div className="text-center py-12 text-muted-foreground">
                    {t('dashboard.no_visualizations', 'No visualizations or tasks configured')}
                </div>
            </div>
        );
    }

    const renderChart = (moduleName: string, chartType: string, title: string) => {
        const data = chartsData[moduleName];
        if (!data || !data.labels.length) {
            return (
                <div className="flex justify-center items-center h-64 text-muted-foreground">
                    {t('dashboard.no_data', 'No data available')}
                </div>
            );
        }

        const isMultiSeries = data.series && data.series.length > 0;

        if (chartType === 'pie') {
            // Pie chart: aggregate series into per-label totals
            let pieData: { name: string; value: number }[];
            if (isMultiSeries) {
                const totals: Record<string, number> = {};
                data.series!.forEach(s => {
                    s.values.forEach((v, i) => {
                        const label = data.labels[i];
                        totals[label] = (totals[label] || 0) + v;
                    });
                });
                pieData = data.labels.map(label => ({ name: label, value: totals[label] || 0 }));
            } else {
                pieData = data.labels.map((label, index) => ({
                    name: label,
                    value: (data.values || [])[index] || 0,
                }));
            }
            return (
                <ResponsiveContainer width="100%" height={300}>
                    <PieChart>
                        <Pie
                            data={pieData}
                            cx="50%"
                            cy="50%"
                            labelLine={false}
                            label={({ name, percent }) => `${name}: ${(percent * 100).toFixed(0)}%`}
                            outerRadius={100}
                            fill="#8884d8"
                            dataKey="value"
                            name={title}
                        >
                            {pieData.map((_, index) => (
                                <Cell key={`cell-${index}`} fill={CHART_COLORS[index % CHART_COLORS.length]} />
                            ))}
                        </Pie>
                        <Tooltip />
                        <Legend />
                    </PieChart>
                </ResponsiveContainer>
            );
        }

        if (isMultiSeries) {
            // Multi-series: each series becomes a separate Bar/Line
            const multiData = data.labels.map((label, index) => {
                const point: Record<string, string | number> = { name: label };
                data.series!.forEach(s => { point[s.name] = s.values[index] || 0; });
                return point;
            });

            if (chartType === 'line') {
                return (
                    <ResponsiveContainer width="100%" height={300}>
                        <LineChart data={multiData}>
                            <CartesianGrid strokeDasharray="3 3" />
                            <XAxis dataKey="name" />
                            <YAxis />
                            <Tooltip />
                            <Legend />
                            {data.series!.map((s, i) => (
                                <Line
                                    key={s.name}
                                    type="monotone"
                                    dataKey={s.name}
                                    stroke={CHART_COLORS[i % CHART_COLORS.length]}
                                    strokeWidth={2}
                                    name={s.name}
                                />
                            ))}
                        </LineChart>
                    </ResponsiveContainer>
                );
            }

            // Default: multi-series bar chart
            return (
                <ResponsiveContainer width="100%" height={300}>
                    <BarChart data={multiData}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="name" />
                        <YAxis />
                        <Tooltip />
                        <Legend />
                        {data.series!.map((s, i) => (
                            <Bar
                                key={s.name}
                                dataKey={s.name}
                                fill={CHART_COLORS[i % CHART_COLORS.length]}
                                name={s.name}
                            />
                        ))}
                    </BarChart>
                </ResponsiveContainer>
            );
        }

        // Single-series fallback
        const chartData = data.labels.map((label, index) => ({
            name: label,
            value: (data.values || [])[index] || 0,
        }));

        if (chartType === 'line') {
            return (
                <ResponsiveContainer width="100%" height={300}>
                    <LineChart data={chartData}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="name" />
                        <YAxis />
                        <Tooltip />
                        <Legend />
                        <Line type="monotone" dataKey="value" stroke="#3b82f6" strokeWidth={2} name={title} />
                    </LineChart>
                </ResponsiveContainer>
            );
        }

        // Default to bar chart
        return (
            <ResponsiveContainer width="100%" height={300}>
                <BarChart data={chartData}>
                    <CartesianGrid strokeDasharray="3 3" />
                    <XAxis dataKey="name" />
                    <YAxis />
                    <Tooltip />
                    <Legend />
                    <Bar dataKey="value" fill="#3b82f6" name={title} />
                </BarChart>
            </ResponsiveContainer>
        );
    };

    return (
        <div className="space-y-6">
            {% if site_logger %}
            <style>{`
                @keyframes log-highlight {
                    0% { background-color: rgb(59 130 246 / 0.3); box-shadow: inset 4px 0 0 0 rgb(59 130 246); }
                    50% { background-color: rgb(59 130 246 / 0.15); }
                    100% { background-color: transparent; box-shadow: inset 0 0 0 0 transparent; }
                }
                .log-new { animation: log-highlight 2s ease-out forwards; }
            `}</style>
            {% endif %}
            <div className="flex items-center justify-between">
                <h1 className="text-3xl font-bold tracking-tight">
                    {t('menu.dashboard', 'Dashboard')}
                </h1>
            </div>

            {chartModels.length > 0 && (
                <div className="grid gap-6 md:grid-cols-2">
                    {chartModels.map((chart) => (
                        <div key={chart.moduleName} className={`rounded-xl border bg-card text-card-foreground shadow-sm p-6${chart.fullRow ? ' md:col-span-2' : ''}`}>
                            <div className="flex items-center justify-between mb-4">
                                <h3 className="text-lg font-semibold">
                                    {t(`models.${chart.moduleName}.name`, chart.title) as string}
                                </h3>
                                {chart.hasTimeField && (
                                    <div className="flex items-center gap-2">
                                        <input
                                            type="date"
                                            className="border rounded-md px-2 py-1.5 text-xs"
                                            value={(chartPeriods[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).startTime}
                                            onChange={(e) => {
                                                const newStart = e.target.value;
                                                setChartPeriods(prev => {
                                                    const cur = prev[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' };
                                                    if (newStart && cur.endTime) {
                                                        const err = validateDateSpan(newStart, cur.endTime, cur.period);
                                                        if (err) { toast.error(err); return prev; }
                                                    }
                                                    return { ...prev, [chart.moduleName]: { ...cur, startTime: newStart } };
                                                });
                                            }}
                                        />
                                        <span className="text-xs text-muted-foreground">—</span>
                                        <input
                                            type="date"
                                            className="border rounded-md px-2 py-1.5 text-xs"
                                            value={(chartPeriods[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).endTime}
                                            onChange={(e) => {
                                                const newEnd = e.target.value;
                                                setChartPeriods(prev => {
                                                    const cur = prev[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' };
                                                    if (cur.startTime && newEnd) {
                                                        const err = validateDateSpan(cur.startTime, newEnd, cur.period);
                                                        if (err) { toast.error(err); return prev; }
                                                    }
                                                    return { ...prev, [chart.moduleName]: { ...cur, endTime: newEnd } };
                                                });
                                            }}
                                        />
                                        <select
                                            className="border rounded-md px-2 py-1.5 text-xs"
                                            value={(chartPeriods[chart.moduleName] || { period: 'day', startTime: getDefaultStartTime(), endTime: '' }).period}
                                            onChange={(e) => {
                                                const newPeriod = e.target.value;
                                                setChartPeriods(prev => ({
                                                    ...prev,
                                                    [chart.moduleName]: { period: newPeriod, startTime: getDefaultStartTime(), endTime: '' },
                                                }));
                                            }}
                                        >
                                            <option value="day">{t('dashboard.period_day', 'Daily')}</option>
                                            <option value="week">{t('dashboard.period_week', 'Weekly')}</option>
                                            <option value="month">{t('dashboard.period_month', 'Monthly')}</option>
                                        </select>
                                    </div>
                                )}
                            </div>
                            {renderChart(chart.moduleName, chart.chartType, chart.title)}
                        </div>
                    ))}
                </div>
            )}

            {% if site_logger %}
            {/* Log Panel */}
            <div className="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
                <div className="flex items-center justify-between mb-4">
                    <div className="flex items-center gap-2">
                        <Terminal className="w-5 h-5" />
                        <h3 className="text-lg font-semibold">
                            {t('dashboard.app_logs', 'Application Logs')}
                        </h3>
                    </div>
                    <div className="flex items-center gap-2">
                        <select
                            className="border rounded-md px-2 py-1.5 text-xs"
                            value={logLevel}
                            onChange={(e) => setLogLevel(e.target.value)}
                        >
                            <option value="">{t('dashboard.all_levels', 'All Levels')}</option>
                            <option value="DEBUG">DEBUG</option>
                            <option value="INFO">INFO</option>
                            <option value="WARNING">WARNING</option>
                            <option value="ERROR">ERROR</option>
                        </select>
                        <Button variant="outline" size="sm" onClick={() => {
                            setLogEntries([]);
                            setLogPage(1);
                            setHasMoreLogs(true);
                            logInitialized.current = false;
                            loadLogs(1).then(() => {
                                setTimeout(() => {
                                    logScrollRef.current?.scrollTo({ top: logScrollRef.current.scrollHeight });
                                    logInitialized.current = true;
                                }, 50);
                            });
                        }}>
                            <RefreshCw className="w-4 h-4" />
                        </Button>
                    </div>
                </div>
                <div className="rounded-md border bg-muted/30 overflow-hidden">
                    <div ref={logScrollRef} onScroll={handleLogScroll} className="max-h-80 overflow-y-auto font-mono text-xs">
                        {logEntries.length === 0 ? (
                            <div className="p-4 text-center text-muted-foreground">
                                {t('dashboard.no_logs', 'No log entries')}
                            </div>
                        ) : (
                            <table className="w-full">
                                <thead className="sticky top-0 bg-muted z-10">
                                    <tr className="text-left">
                                        <th className="px-3 py-2 font-medium">Time</th>
                                        <th className="px-3 py-2 font-medium">Level</th>
                                        <th className="px-3 py-2 font-medium">Source</th>
                                        <th className="px-3 py-2 font-medium">Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {logLoading && hasMoreLogs && (
                                        <tr>
                                            <td colSpan={4} className="p-2 text-center">
                                                <Loader2 className="w-4 h-4 animate-spin inline-block text-muted-foreground" />
                                            </td>
                                        </tr>
                                    )}
                                    {logEntries.map((entry, idx) => (
                                        <tr key={entry.id || idx} className={`border-t border-border/50 hover:bg-muted/20${entry.id && newEntryIds.has(entry.id) ? ' log-new' : ''}`}>
                                            <td className="px-3 py-1.5 whitespace-nowrap text-muted-foreground">
                                                {entry.created_at ? formatDateTime(entry.created_at, timeZone) : ''}
                                            </td>
                                            <td className="px-3 py-1.5">
                                                <span className={`px-1.5 py-0.5 rounded text-xs font-medium ${
                                                    entry.level === 'ERROR' ? 'bg-red-100 text-red-700' :
                                                    entry.level === 'WARNING' ? 'bg-yellow-100 text-yellow-700' :
                                                    entry.level === 'INFO' ? 'bg-blue-100 text-blue-700' :
                                                    'bg-gray-100 text-gray-500'
                                                }`}>
                                                    {entry.level}
                                                </span>
                                            </td>
                                            <td className="px-3 py-1.5 text-muted-foreground">{entry.source}</td>
                                            <td className="px-3 py-1.5 break-all">{entry.message}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        )}
                    </div>
                </div>
            </div>
            {% endif %}

            {% if scheduled_tasks %}
            {/* Scheduled Tasks Section */}
            <div className="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
                <div className="flex items-center justify-between mb-4">
                    <h3 className="text-lg font-semibold">
                        {t('dashboard.scheduled_tasks', 'Scheduled Tasks')}
                    </h3>
                    <Button
                        variant="outline"
                        size="sm"
                        onClick={handleRefresh}
                        disabled={taskLoading}
                    >
                        <RefreshCw className={`w-4 h-4 ${taskLoading ? 'animate-spin' : ''}`} />
                    </Button>
                </div>

                {taskLoading && tasks.length === 0 ? (
                    <div className="flex justify-center items-center h-32">
                        <Loader2 className="w-6 h-6 animate-spin text-muted-foreground" />
                    </div>
                ) : tasks.length === 0 ? (
                    <div className="text-center py-8 text-muted-foreground">
                        {t('dashboard.no_tasks', 'No scheduled tasks configured')}
                    </div>
                ) : (
                    <div className="space-y-3">
                        {tasks.map((task) => (
                            <div
                                key={task.name}
                                className="flex items-center justify-between p-4 rounded-lg border bg-background"
                            >
                                <div className="flex-1">
                                    <div className="flex items-center gap-2">
                                        <span className="font-medium">{task.name}</span>
                                        <span
                                            className={`px-2 py-0.5 rounded text-xs ${
                                                task.enabled
                                                    ? 'bg-green-100 text-green-700'
                                                    : 'bg-gray-100 text-gray-500'
                                            }`}
                                        >
                                            {task.enabled
                                                ? t('dashboard.enabled', 'Enabled')
                                                : t('dashboard.disabled', 'Disabled')}
                                        </span>
                                    </div>
                                    <div className="text-sm text-muted-foreground mt-1">
                                        <span className="font-mono">
                                            {task.interval > 0 ? formatInterval(task.interval) : task.cron}
                                        </span>
                                        {task.description && (
                                            <span className="ml-2">- {task.description}</span>
                                        )}
                                    </div>
                                    {task.params && Object.keys(task.params).length > 0 && (
                                        <div className="text-xs text-muted-foreground mt-1 font-mono">
                                            {Object.entries(task.params).map(([k, v]) => `${k}: ${String(v.value)}`).join(' | ')}
                                        </div>
                                    )}
                                    {task.next_run && task.enabled && (
                                        <div className="text-xs text-muted-foreground mt-1">
                                            {t('dashboard.next_run', 'Next run')}: {formatLocalDateTime(task.next_run)}
                                        </div>
                                    )}
                                </div>
                                <div className="flex items-center gap-2">
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => handleRunTask(task.name)}
                                        disabled={runningTasks.has(task.name)}
                                        title={t('dashboard.run_now', 'Run now')}
                                    >
                                        {runningTasks.has(task.name) ? (
                                            <Loader2 className="w-4 h-4 animate-spin" />
                                        ) : (
                                            <Play className="w-4 h-4" />
                                        )}
                                    </Button>
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        onClick={() => {
                                            setEditingTask(task);
                                            setEditModalOpen(true);
                                        }}
                                        title={t('dashboard.edit', 'Edit')}
                                    >
                                        <Pencil className="w-4 h-4" />
                                    </Button>
                                    {task.enabled ? (
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => handleDisableTask(task.name)}
                                            title={t('dashboard.disable', 'Disable')}
                                        >
                                            <PowerOff className="w-4 h-4" />
                                        </Button>
                                    ) : (
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => handleEnableTask(task.name)}
                                            title={t('dashboard.enable', 'Enable')}
                                        >
                                            <Power className="w-4 h-4" />
                                        </Button>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>

            {/* Edit Task Modal */}
            {editingTask && (
                <Modal
                    isOpen={isEditModalOpen}
                    onClose={() => setEditModalOpen(false)}
                    title={t('dashboard.edit_task', 'Edit Task')}
                >
                    <div className="space-y-4">
                        <div>
                            <Label>{t('dashboard.task_name', 'Task Name')}</Label>
                            <div className="font-medium">{editingTask.name}</div>
                        </div>
                        <div>
                            <Label>{t('dashboard.task_type', 'Task Type')}</Label>
                            <div className="flex gap-4 mt-1">
                                <label className="flex items-center gap-2">
                                    <input
                                        type="radio"
                                        name="taskType"
                                        value="cron"
                                        defaultChecked={editingTask.interval === 0}
                                        onChange={() => {
                                            const intervalInput = document.getElementById('interval') as HTMLInputElement;
                                            if (intervalInput) intervalInput.value = '0';
                                        }}
                                    />
                                    {t('dashboard.type_cron', 'Cron')}
                                </label>
                                <label className="flex items-center gap-2">
                                    <input
                                        type="radio"
                                        name="taskType"
                                        value="interval"
                                        defaultChecked={editingTask.interval > 0}
                                        onChange={() => {
                                            const cronInput = document.getElementById('cron') as HTMLInputElement;
                                            if (cronInput) cronInput.value = '';
                                        }}
                                    />
                                    {t('dashboard.type_interval', 'Interval')}
                                </label>
                            </div>
                        </div>
                        <div id="cron-section">
                            <Label>{t('dashboard.cron_expression', 'Cron Expression')}</Label>
                            <Input
                                id="cron"
                                defaultValue={editingTask.cron}
                                placeholder="0 8 * * *"
                                className="font-mono"
                                disabled={editingTask.interval > 0}
                            />
                            <p className="text-xs text-muted-foreground mt-1">
                                {t('dashboard.cron_help', 'e.g. 0 8 * * * = daily at 8:00')}
                            </p>
                        </div>
                        <div id="interval-section">
                            <Label>{t('dashboard.interval_seconds', 'Interval (seconds)')}</Label>
                            <Input
                                id="interval"
                                type="number"
                                min="1"
                                defaultValue={editingTask.interval > 0 ? editingTask.interval : 60}
                                placeholder="60"
                                disabled={editingTask.interval === 0}
                            />
                            <p className="text-xs text-muted-foreground mt-1">
                                {t('dashboard.interval_help', 'e.g. 60 = every 60 seconds')}
                            </p>
                        </div>
                        <div>
                            <Label>{t('dashboard.description', 'Description')}</Label>
                            <Input
                                id="description"
                                defaultValue={editingTask.description}
                                placeholder={t('dashboard.description_placeholder', 'Task description')}
                            />
                        </div>
                        {editingTask.params && Object.keys(editingTask.params).length > 0 && (
                            <div className="border-t pt-4">
                                <Label className="mb-2 block">{t('dashboard.parameters', 'Parameters')}</Label>
                                <div className="space-y-3">
                                    {Object.entries(editingTask.params).map(([key, param]) => (
                                        <div key={key}>
                                            <Label className="text-sm">{param.label || key}</Label>
                                            {param.type === 'boolean' ? (
                                                <div className="flex items-center gap-2 mt-1">
                                                    <input
                                                        type="checkbox"
                                                        id={`param-${key}`}
                                                        defaultChecked={!!param.value}
                                                        className="h-4 w-4"
                                                    />
                                                </div>
                                            ) : param.type === 'list' ? (
                                                <Input
                                                    id={`param-${key}`}
                                                    defaultValue={Array.isArray(param.value) ? param.value.join(', ') : String(param.value ?? '')}
                                                    placeholder="a, b, c"
                                                    className="mt-1"
                                                />
                                            ) : (
                                                <Input
                                                    id={`param-${key}`}
                                                    defaultValue={String(param.value ?? '')}
                                                    type={param.type === 'number' ? 'number' : 'text'}
                                                    className="mt-1"
                                                />
                                            )}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}
                        <div className="flex justify-end gap-2 pt-4">
                            <Button variant="outline" onClick={() => setEditModalOpen(false)}>
                                {t('common.cancel', 'Cancel')}
                            </Button>
                            <Button
                                onClick={() => {
                                    const cronInput = document.getElementById('cron') as HTMLInputElement;
                                    const intervalInput = document.getElementById('interval') as HTMLInputElement;
                                    const descInput = document.getElementById('description') as HTMLInputElement;
                                    const taskTypeRadio = document.querySelector('input[name="taskType"]:checked') as HTMLInputElement;
                                    const isInterval = taskTypeRadio?.value === 'interval';
                                    const params: Record<string, string | number | boolean | string[]> = {};
                                    for (const [key, param] of Object.entries(editingTask.params || {})) {
                                        const el = document.getElementById(`param-${key}`) as HTMLInputElement;
                                        if (el) {
                                            if (param.type === 'boolean') {
                                                params[key] = el.checked;
                                            } else if (param.type === 'number') {
                                                params[key] = parseFloat(el.value) || 0;
                                            } else if (param.type === 'list') {
                                                params[key] = el.value.split(',').map(s => s.trim()).filter(Boolean);
                                            } else {
                                                params[key] = el.value;
                                            }
                                        }
                                    }
                                    updateTask(editingTask.name, {
                                        cron: isInterval ? '' : cronInput.value,
                                        interval: isInterval ? parseInt(intervalInput.value) || 0 : 0,
                                        description: descInput.value,
                                        params,
                                    });
                                    toast.success(t('dashboard.task_updated', `Task "${editingTask.name}" updated`));
                                }}
                            >
                                {t('common.save', 'Save')}
                            </Button>
                        </div>
                    </div>
                </Modal>
            )}
            {% endif %}
        </div>
    );
};

export default DashboardPage;
