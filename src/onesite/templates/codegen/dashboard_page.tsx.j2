const shiftDateRange = (startTime: string, endTime: string, direction: 'left' | 'right'): { startTime: string; endTime: string } => {
    const end = endTime ? new Date(endTime) : new Date();
    const start = new Date(startTime);
    const spanMs = end.getTime() - start.getTime();
    const spanDays = Math.max(Math.ceil(spanMs / (1000 * 60 * 60 * 24)), 1);
    const offset = direction === 'left' ? -spanDays : spanDays;

    const newStart = new Date(start);
    newStart.setDate(newStart.getDate() + offset);
    const newEnd = new Date(end);
    newEnd.setDate(newEnd.getDate() + offset);

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    if (newEnd > today) {
        newEnd.setTime(today.getTime());
        newStart.setTime(today.getTime() - spanMs);
    }

    return {
        startTime: newStart.toISOString().split('T')[0],
        endTime: newEnd.toISOString().split('T')[0],
    };
};

