const getDefaultStartTime = (): string => {
    const d = new Date();
    d.setDate(d.getDate() - 15);
    return d.toISOString().split('T')[0];
};

const MAX_SPAN_DAYS: Record<string, number> = {
    day: 30,
    week: 210,
    month: 900,
};

const validateDateSpan = (startTime: string, endTime: string, period: string): string | null => {
    if (!startTime || !endTime) return null;
    const start = new Date(startTime);
    const end = new Date(endTime);
    if (isNaN(start.getTime()) || isNaN(end.getTime())) return null;
    if (end <= start) return 'End date must be after start date';
    const spanDays = Math.ceil((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
    const maxSpan = MAX_SPAN_DAYS[period] || 30;
    if (spanDays > maxSpan) {
        return `Time span cannot exceed ${maxSpan} days for ${period} period`;
    }
    return null;
};

const formatLocalDateTime = (dateStr: string | null): string => {
    if (!dateStr) return '';
    try {
        const date = new Date(dateStr);
        return date.toLocaleString(undefined, {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
        });
    } catch {
        return dateStr;
    }
};

const formatInterval = (seconds: number, t: (key: string, fallback: string) => string): string => {
    if (seconds <= 0) return '';
    const every = t('dashboard.every', 'Every');
    if (seconds < 60) return `${every} ${seconds}${t('dashboard.seconds_short', 's')}`;
    if (seconds < 3600) return `${every} ${Math.floor(seconds / 60)}${t('dashboard.minutes_short', 'm')}`;
    if (seconds < 86400) return `${every} ${Math.floor(seconds / 3600)}${t('dashboard.hours_short', 'h')}`;
    return `${every} ${Math.floor(seconds / 86400)}${t('dashboard.days_short', 'd')}`;
};

const parseCronToTimes = (cron: string): string[] => {
    if (!cron || cron === '* * * * *') return [];
    const parts = cron.trim().split(/\s+/);
    if (parts.length < 2) return [];
    const minutePart = parts[0];
    const hourPart = parts[1];
    if (minutePart === '*' || hourPart === '*') return [];
    const hours = hourPart.split(',').filter(h => h !== '*');
    const minutes = minutePart.split(',').filter(m => m !== '*');
    const times: string[] = [];
    for (const h of hours) {
        for (const m of minutes) {
            times.push(`${h.padStart(2, '0')}:${m.padStart(2, '0')}`);
        }
    }
    return times.length > 0 ? times : [];
};

const timesToCron = (times: string[]): string => {
    if (times.length === 0) return '* * * * *';
    const hours = [...new Set(times.map(t => t.split(':')[0]))].sort();
    const minutes = [...new Set(times.map(t => t.split(':')[1]))].sort();
    return `${minutes.join(',')} ${hours.join(',')} * * *`;
};

const formatCron = (cron: string, t: (key: string, fallback: string) => string): string => {
    if (!cron) return '';
    const times = parseCronToTimes(cron);
    if (times.length === 0) return cron;
    const prefix = t('dashboard.every_day_at', 'Every day at');
    if (times.length === 1) return `${prefix} ${times[0]}`;
    return `${prefix} ${times.join(', ')}`;
};

