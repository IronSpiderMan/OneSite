import { create } from 'zustand';
import { {{ model.name }}, get{{ model.name }}s, get{{ model.name }}, create{{ model.name }}, update{{ model.name }}, delete{{ model.name }}, bulkDelete{{ model.name }} } from '../services/{{ model.module_name }}';

interface {{ model.name }}State {
    data: {{ model.name }}[];
    total: number;
    page: number;
    size: number;
    loading: boolean;
    currentItem: {{ model.name }} | null;
    filters: Record<string, any>;
    sorting: { sort_by?: string; sort_order?: 'asc' | 'desc' };
    setSorting: (field?: string, direction?: 'asc' | 'desc') => Promise<void>;
    fetchData: (page?: number, size?: number, filters?: Record<string, any>) => Promise<void>;
    refreshData: (page?: number, size?: number, filters?: Record<string, any>) => Promise<void>;
    fetchItem: (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => Promise<{{ model.name }} | null>;
    createItem: (item: any) => Promise<void>;
    updateItem: (id: {{ 'string' if 'str' in model.id_type else 'number' }}, item: any) => Promise<void>;
    deleteItem: (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => Promise<void>;
    bulkDeleteItem: (ids: {{ 'string[]' if 'str' in model.id_type else 'number[]' }}) => Promise<void>;
}

export const use{{ model.name }}Store = create<{{ model.name }}State>((set, get) => ({
    data: [],
    total: 0,
    page: 1,
    size: 20,
    loading: false,
    currentItem: null,
    filters: {},
    sorting: {},
    setSorting: async (field, direction) => {
        set({ sorting: field ? { sort_by: field, sort_order: direction } : {} });
        await get().fetchData(1, get().size);
    },
    fetchData: async (page = 1, size = 20, filters?: Record<string, any>) => {
        set({ loading: true });
        try {
            const f = filters !== undefined ? filters : get().filters;
            const result = await get{{ model.name }}s(page, size, { ...f, ...get().sorting });
            if (result && Array.isArray(result.items)) {
                set({ 
                    data: result.items,
                    total: result.total,
                    page: result.page,
                    size: result.size,
                    filters: f
                });
            } else {
                console.error("Expected paginated response but got:", result);
                set({ data: [], total: 0 });
            }
        } catch (error) {
            console.error(error);
            set({ data: [], total: 0 });
        } finally {
            set({ loading: false });
        }
    },
    refreshData: async (page?: number, size?: number, filters?: Record<string, any>) => {
        try {
            const currentPage = page ?? get().page;
            const currentSize = size ?? get().size;
            const f = filters !== undefined ? filters : get().filters;
            const result = await get{{ model.name }}s(currentPage, currentSize, { ...f, ...get().sorting });
            if (result && Array.isArray(result.items)) {
                set({
                    data: result.items,
                    total: result.total,
                    page: result.page,
                    size: result.size,
                    filters: f
                });
            } else {
                console.error("Expected paginated response but got:", result);
            }
        } catch (error) {
            console.error(error);
        }
    },
    fetchItem: async (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
        set({ loading: true });
        try {
            const result = await get{{ model.name }}(id);
            set({ currentItem: result });
            return result;
        } catch (error) {
            console.error(error);
            set({ currentItem: null });
            return null;
        } finally {
            set({ loading: false });
        }
    },
    createItem: async (item: any) => {
        try {
            await create{{ model.name }}(item);
            const { page, size, filters } = get();
            await get().fetchData(page, size, filters);
        } catch (error) {
            console.error(error);
            throw error;
        }
    },
    updateItem: async (id: {{ 'string' if 'str' in model.id_type else 'number' }}, item: any) => {
        try {
            await update{{ model.name }}(id, item);
            const { page, size, filters } = get();
            await get().fetchData(page, size, filters);
        } catch (error) {
            console.error(error);
            throw error;
        }
    },
    deleteItem: async (id: {{ 'string' if 'str' in model.id_type else 'number' }}) => {
        try {
            await delete{{ model.name }}(id);
            const { page, size, filters } = get();
            await get().fetchData(page, size, filters);
        } catch (error) {
            console.error(error);
            throw error;
        }
    },
    bulkDeleteItem: async (ids: {{ 'string[]' if 'str' in model.id_type else 'number[]' }}) => {
        try {
            await bulkDelete{{ model.name }}(ids);
            const { page, size, filters } = get();
            await get().fetchData(page, size, filters);
        } catch (error) {
            console.error(error);
            throw error;
        }
    },
}));
