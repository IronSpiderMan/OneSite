One provider represents one external system and can handle any number of
resource kinds. This file is developer-owned and is never overwritten by
subsequent ``site sync`` runs.
"""

from __future__ import annotations

from typing import Any

from app.core.external_resources import ExternalResourceProvider


class Provider(ExternalResourceProvider):
    """Implement CUD delivery for {{ provider_name }} resources."""

    async def create(self, resource: str, payload: dict[str, Any]) -> None:
        raise NotImplementedError

    async def update(
        self,
        resource: str,
        payload: dict[str, Any],
        previous: dict[str, Any],
    ) -> None:
        raise NotImplementedError

    async def delete(self, resource: str, payload: dict[str, Any]) -> None:
        raise NotImplementedError


provider = Provider()
