{
  "model": "SecretConfig",
  "description": "Singleton, developer only. Only developer role can read/update. Admin and user get 403. Menu hidden from non-developers via visible_roles.",
  "endpoint": "/api/v1/secret_config",
  "get_payload": null,
  "update_payload": {
    "api_key": "sk-new-key-67890",
    "internal_url": "https://new-internal.example.com",
    "debug_mode": true
  },
  "samples": [
    {
      "api_key": "sk-demo-secret-key-12345",
      "internal_url": "https://internal.permission-demo.example.com",
      "debug_mode": false
    }
  ],
  "tests": [
    {
      "role": "user",
      "expect": { "get": 403, "update": 403 }
    },
    {
      "role": "admin",
      "expect": { "get": 403, "update": 403 }
    },
    {
      "role": "developer",
      "expect": { "get": 200, "update": 200 }
    }
  ]
}
